-- ==================== Steal An Egg Hub ====================
-- Built on the AR2 Hub core: re-run guard, loop supervisor, drawing registry,
-- validated library loader. Those exist because of specific failures, and the
-- comments explaining why are kept rather than rewritten - see each block.
--
-- What this executor can and cannot do, MEASURED in this game, not assumed:
--
--   CFrame writes        WORK. 40, 100, 200 and 300 stud hops all held. One
--                        350 stud hop was dragged back after ~1.2s, cause not
--                        yet established. (An earlier note claiming CFrame
--                        writes were silently discarded was a bad measurement:
--                        the test moved 8 studs UP and read back 150ms later,
--                        by which point gravity had returned the character.)
--   Velocity writes      WORK, with no speed ceiling found. 205 studs/s
--                        sustained - 12.8x walk speed - covering 411 studs in
--                        two seconds, with no pull-back afterwards.
--   Flight               WORKS. Climbed 135 studs in 3s, descended, landed at
--                        the starting height on full health. Zero vertical
--                        velocity still drifts down ~12 studs/s, so holding an
--                        altitude needs a small positive Y every tick.
--   WalkSpeed            NOT writable. "Unknown property: WalkSpeed".
--   Humanoid:Move        Missing.
--   HoldDuration etc     NOT writable as properties. Reads return nil, writes
--                        error. The memory route is the only one that works.
--   InputHoldBegin/End   Missing on ProximityPrompt.
--   fireproximityprompt  Missing.
--   workspace:Raycast    Returns nil always. No ground-height queries, so a
--                        landing has to be detected by altitude going still.
--   Hooking              ENTIRELY ABSENT - no hookfunction, hookmetamethod,
--                        getnamecallmethod, getrawmetatable, getconnections,
--                        and debug carries none of the useful members. Nothing
--                        that works by intercepting traffic can be built here.
--
-- Everything starts DISABLED.

-- ---------------- re-run guard ----------------
-- Loading this script a second time (which a loadstring URL makes easy) would
-- otherwise stack a second copy of every task.spawn loop and a second UI window
-- on top of the first. Bumping the generation makes every loop from the previous
-- load exit on its next tick.
_G.SEHUB_GEN = (_G.SEHUB_GEN or 0) + 1
local GEN = _G.SEHUB_GEN
if GEN > 1 then
    print(string.format("[Steal An Egg] reload #%d - retiring previous instance", GEN))
    -- Hand back anything the previous generation was holding open. Prompt
    -- patches are memory writes, so a reload that forgets them leaves the game
    -- permanently modified with nothing tracking it.
    if _G.SEHUB_RESTORE then pcall(_G.SEHUB_RESTORE) end
    if _G.SEHUB_WIN then
        for _, m in ipairs({ "Destroy", "Unload", "Close", "Remove" }) do
            pcall(function() _G.SEHUB_WIN[m](_G.SEHUB_WIN) end)
        end
        _G.SEHUB_WIN = nil
    end
    if setrobloxinput then pcall(function() setrobloxinput(true) end) end
    task.wait(0.2)
end

-- ---------------- loop supervisor ----------------
-- Every feature runs in its own task.spawn loop, and an error inside one kills it
-- outright - no message, no restart, the feature simply stops while the rest of the
-- menu carries on looking fine. That is what "the script crashed" turned out to mean
-- more than once in AR2: one stale instance read, one dead loop.
-- Bisect switch. Set _G.SEHUB_SKIP = { ["night watch"] = true, ... } BEFORE loading and
-- those loops never start. Added because the executor began crashing within a second of
-- load and no amount of reading the code found it - with ten background loops, arguing
-- about which one is at fault is slower than switching them off one at a time.
_G.SEHUB_SKIP = _G.SEHUB_SKIP or {}
_G.SEHUB_LOOPS = {}
local function SESPAWN(name, fn)
    if _G.SEHUB_SKIP[name] then
        print("[Steal An Egg] skipping loop: " .. name)
        return
    end
    local restarts = 0
    task.spawn(function()
        while _G.SEHUB_GEN == GEN do
            local ok, err = pcall(fn)
            if ok then return end
            if _G.SEHUB_GEN ~= GEN then return end
            restarts = restarts + 1
            _G.SEHUB_LOOPS[name] = restarts
            if restarts > 5 then
                warn(string.format("[Steal An Egg] '%s' died %d times, leaving it stopped: %s",
                    name, restarts, tostring(err)))
                return
            end
            warn(string.format("[Steal An Egg] '%s' errored (restart %d): %s",
                name, restarts, tostring(err)))
            task.wait(0.5)
        end
    end)
end

-- ---------------- Drawing registry ----------------
-- Nothing draws yet, but ESP is coming and the leak it prevents is invisible until
-- it is severe: a loop killed mid-sweep never removes its own Drawings, and twenty
-- reloads of that is enough to destabilise the client. Wrapping Drawing.new once,
-- globally, costs nothing now and cannot be retrofitted after the fact.
_G.SEHUB_DRAWINGS = _G.SEHUB_DRAWINGS or {}
if GEN > 1 then
    local n = 0
    for _, d in ipairs(_G.SEHUB_DRAWINGS) do
        if pcall(function() d.Visible = false end) then n = n + 1 end
        pcall(function() d:Remove() end)
    end
    if n > 0 then print(string.format("[Steal An Egg] cleared %d drawings from the previous load", n)) end
end
_G.SEHUB_DRAWINGS = {}
if Drawing and not _G.SEHUB_DRAWWRAP then
    _G.SEHUB_DRAWWRAP = true
    local realNew = Drawing.new
    Drawing.new = function(...)
        local obj = realNew(...)
        if obj then table.insert(_G.SEHUB_DRAWINGS, obj) end
        return obj
    end
end

-- INS-ui captures game:GetService("Players") ONCE, at library load, and reads the
-- mouse only through LocalPlayer:GetMouse(). If the handle is nil at that instant the
-- menu renders but can never be clicked, for the life of that instance. Matcha's
-- service lookup does go nil, so wait for it rather than loading into a dead menu.
do
    local waited, limit = 0, 10
    local function handleOk()
        local ok, lp = pcall(function() return game:GetService("Players").LocalPlayer end)
        return ok and lp ~= nil
    end
    while not handleOk() and waited < limit do
        task.wait(0.5)
        waited = waited + 0.5
    end
    if not handleOk() then
        warn("[Steal An Egg] Players handle is stale after " .. limit .. "s - the menu will")
        warn("[Steal An Egg] render but not accept clicks. Reinject Matcha, then reload.")
    elseif waited > 0 then
        print(string.format("[Steal An Egg] waited %.1fs for the Players handle", waited))
    end
end

-- ---------------- UI library ----------------
-- Fetched fresh on every load, and every reload is another request. Seventeen reloads
-- in one AR2 session earned a "429: Too Many Requests" from GitHub, which loadstring
-- then tried to parse as Luau, leaving no menu at all - after the re-run guard had
-- already retired the working instance. The library also has two shapes in the wild:
-- the older build returns its table, the newer returns nil and publishes a global
-- named INSUI. So: fetch, RUN, and keep only a source that yields a table with
-- CreateWindow. The cache is written after that test, never before, so a broken
-- upstream cannot poison a working local copy.
local LIB_CACHE = "insui_cache.lua"
local LIB_URLS = {
    "https://raw.githubusercontent.com/neaxusxgod-png/INS-ui/main/uilib.min.lua",
    "https://cdn.jsdelivr.net/gh/neaxusxgod-png/INS-ui@main/uilib.min.lua",
}
local Lib
do
    local function usableSrc(s)
        return type(s) == "string" and #s > 5000 and not string.find(s, "^%s*%d%d%d:")
    end
    local function usableLib(t) return type(t) == "table" and type(t.CreateWindow) == "function" end
    local function try(src)
        if not usableSrc(src) then return nil end
        local chunk = loadstring(src)
        if not chunk then return nil end
        local okr, ret = pcall(chunk)
        if okr and usableLib(ret) then return ret end
        for _, name in ipairs({ "INSUI", "INSui", "insui" }) do
            local g = _G[name] or rawget(getfenv(), name)
            if usableLib(g) then return g end
        end
        return nil
    end
    local okc, cached = pcall(function() return readfile(LIB_CACHE) end)
    if okc then Lib = try(cached) end
    if not Lib then
        for _, u in ipairs(LIB_URLS) do
            local okh, body = pcall(function() return game:HttpGet(u) end)
            if okh then
                local got = try(body)
                if got then
                    Lib = got
                    pcall(function() writefile(LIB_CACHE, body) end)
                    break
                end
            end
        end
    end
    if not Lib then
        warn("[Steal An Egg] no working UI library from cache or any mirror - menu cannot load")
        return
    end
end

-- ---------------- helpers ----------------
local function svcPlayers()
    local ok, p = pcall(function() return game:GetService("Players") end)
    return ok and p or nil
end
local function localPlayer()
    local P = svcPlayers()
    if not P then return nil end
    local ok, lp = pcall(function() return P.LocalPlayer end)
    return ok and lp or nil
end
-- Guarded because the character is nil through every respawn, and an unguarded read
-- here is exactly what silently killed AR2's dash loop.
local function myRoot()
    local lp = localPlayer()
    if not lp then return nil end
    local ok, ch = pcall(function() return lp.Character end)
    if not ok or not ch then return nil end
    local okr, r = pcall(function()
        return ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso")
    end)
    return okr and r or nil
end
local function notify(title, msg, dur)
    if Lib and Lib.Notify then pcall(function() Lib.Notify(title, msg, dur or 2) end) end
end
local function getCamera()
    local ok, c = pcall(function() return workspace.CurrentCamera end)
    if ok and c then return c end
    local ok2, c2 = pcall(function() return workspace:FindFirstChildOfClass("Camera") end)
    return ok2 and c2 or nil
end

-- Matcha delivers KeyCode as a raw number about as often as an Enum, and never
-- delivers gameProcessed, so every key test has to accept both forms. The letter is
-- converted to its virtual-key code because that is what iskeypressed wants.
local function keyMatches(input, letter)
    if not input then return false end
    local want = string.byte(string.upper(letter))
    local ok, kc = pcall(function() return input.KeyCode end)
    if not ok or kc == nil then return false end
    if type(kc) == "number" then return kc == want end
    local okv, v = pcall(function() return kc.Value end)
    if okv and v == want then return true end
    local okn, n = pcall(function() return kc.Name end)
    return okn and type(n) == "string" and string.upper(n) == string.upper(letter)
end
local function keyDown(letter)
    if not iskeypressed then return false end
    local ok, d = pcall(function() return iskeypressed(string.byte(string.upper(letter))) end)
    return (ok and d) and true or false
end

-- ---------------- scheduler health ----------------
-- A watchdog that measures its own lateness. Sweeps scale their budgets by it, so a
-- struggling client scans less rather than falling further behind. Falls fast, recovers
-- slowly, on the basis that being wrong about "recovered" is what causes the freezes.
_G.SEHUB_HEALTH = 1.0
SESPAWN("health", function()
    local last = tick()
    while _G.SEHUB_GEN == GEN do
        task.wait(0.05)
        local now = tick()
        local dt = now - last
        last = now
        local score = 0.05 / math.max(dt, 0.0001)
        if score > 1 then score = 1 end
        local blend = (score < _G.SEHUB_HEALTH) and 0.6 or 0.1
        _G.SEHUB_HEALTH = _G.SEHUB_HEALTH * (1 - blend) + score * blend
        if _G.SEHUB_HEALTH < 0.05 then _G.SEHUB_HEALTH = 0.05 end
    end
end)

