riftSec:Toggle("Prioritize Current Eggs", true, function(v)
    FM.RiftPrio = v
end, "Go for the three pets being asked for right now before anything else in those areas. A pet you already OWN stops being prioritised - one copy is all the rift needs, so a backpack full of Centapedes means Centapede eggs are treated as done. Once you own one of each the section reads COMPLETE and priority switches off, though it keeps farming those areas. Off means nearest-first from the start.")

FM.riftUi = riftSec:Label("off")

-- Areas, in the map's own west-to-east order, straight from AREA_BOUNDS rather than from
-- whatever the detector happened to find. Detection produced a list that changed length
-- between sessions, so a toggle could silently go missing; these eleven always exist.
--
-- The escape gets its OWN loop, on the tightest interval in the script, because it
-- cannot afford to wait for anything else. When it lived inside the farm loop it was
-- blocked by the very stage that needs it most: while waiting to deliver an egg, that
-- loop polls at 0.25s intervals for up to 25 seconds, so being grabbed mid-carry went
-- unanswered for as long as a quarter of a second - long enough to lose the egg. It
-- also only ran while the farm was on, leaving manual play unprotected.
-- Counters, because this loop failed silently once and no amount of reading the code
-- explained it. If escapes are not happening, these say which half is at fault: ticks
-- climbing with ragSeen flat means the detection never fired; both climbing with
-- escapes flat means the guard conditions blocked it.
_G.SEHUB_WATCH = { ticks = 0, ragSeen = 0, escapes = 0, blocked = 0, lastRag = "never" }
-- Chase watch. This is the escape trigger that matters; the ragdoll watch below is now
-- only a backstop for when this one is too slow.
SESPAWN("boss chase watch", function()
    local hist = {}
    while _G.SEHUB_GEN == GEN do
        local __t0 = tick()
        -- Refreshed often, because a stale guard handle is what crashed this loop.
        if (tick() - (GU.at or 0)) > 1.0 then GU.at = tick(); refreshGuards() end
        -- NOT `local ok, p = root and pcall(...)`. An `and` expression truncates a
        -- multiple return to one value, so the position silently came back nil forever
        -- and the whole chase check did nothing. Same trap as the cam-and-pcall bug in
        -- the AR2 script.
        local root = myRoot()
        local pos
        if root then
            local okp, p = pcall(function() return root.Position end)
            if okp then pos = p end
        end
        if pos then
            -- THE GRAB IS THE TRIGGER. Measured from five manual escapes during real
            -- play: 0.3, 0.2, 0.3, 0.3, 0.3 seconds after taking an egg, every time,
            -- with no guard waking anywhere near - the only wakes in that window were
            -- 957 and 2272 studs away. Reacting to a boss was never what worked; the
            -- egg leaving the nest is the cue.
            --
            -- This was the original design, dropped after it "fired too early". It did
            -- not: it teleported to FM.Home plus a 35 stud offset, an invented spot that
            -- happened to be lethal. A position bug diagnosed as a timing one.
            -- The per-area override may only make the escape FASTER. It used to replace
            -- your setting outright, so Titan Temple's 0.05 would have overridden a 0 you
            -- had deliberately chosen - an override that slows down the thing you asked to
            -- speed up is just a bug wearing a table.
            local myDelay = FM.WakeDelay or 0.15
            local areaOverride = FM.grabArea and FM.AreaDelay[FM.grabArea]
            if areaOverride and areaOverride < myDelay then myDelay = areaOverride end
            if FM.hasEgg and FM.grabbedAt and not FM.grabEscaped
               and (tick() - FM.grabbedAt) >= myDelay then
                FM.grabEscaped = true
                if FM.AutoBoss and AB.Zone then
                    local W = _G.SEHUB_WATCH
                    W.chaseEscapes = (W.chaseEscapes or 0) + 1
                    gotoZone(true)
                    FM.LastEscape = string.format("%s, %.2fs after grab",
                        tostring(FM.grabArea or "?"), tick() - FM.grabbedAt)
                    FM.LastEscapeAt = tick()
                    FM.State = "took an egg - escaped home"
                end
            end

            local waking, area, d = wakingGuardNear(pos)
            -- LATCH the sighting. The highlight lives well under a second, so a design
            -- that re-tests the condition while counting down the delay would reset the
            -- timer the moment the glow vanished and never fire at all.
            -- Not within 2s of an escape we just made. The guard wakes at the exact
            -- moment you steal - measured at 0.00s after the grab, 9 to 18 studs away -
            -- so without this the grab trigger and the wake trigger both fire, half a
            -- second apart, and the second teleport interrupts the run home.
            local justEscaped = (tick() - (AB.lastEscape or 0)) < 2.0
            if waking and not FM.wakeAt and not justEscaped then
                FM.wakeAt = tick()
                FM.wakeArea = tostring(area)
                FM.BossDist = d or -1
                FM.BossHunting = FM.wakeArea
            end
            if FM.wakeAt then
                local waited = tick() - FM.wakeAt
                if waited >= (FM.WakeDelay or 0.8) then
                    if FM.AutoBoss and AB.Zone then
                        local W = _G.SEHUB_WATCH
                        W.chaseEscapes = (W.chaseEscapes or 0) + 1
                        gotoZone(true)
                        FM.State = string.format("%s guard woke %.1fs ago (%.0f studs) - escaped",
                            tostring(FM.wakeArea), waited, FM.BossDist or -1)
                        -- Kept separately, because FM.State is shared by every subsystem
                        -- and the next night reload or grab overwrites it within seconds
                        -- - which made a working escape look like it never happened.
                        FM.LastEscape = string.format("%s guard, %.0f studs, %.1fs delay",
                            tostring(FM.wakeArea), FM.BossDist or -1, waited)
                        FM.LastEscapeAt = tick()
                    end
                    FM.wakeAt, FM.wakeArea = nil, nil
                    FM.BossHunting = nil
                    task.wait(1.0)   -- let the escape settle before arming again
                end
            end
        end
        PROFTICK("boss chase watch", __t0)
        -- 10Hz. The wake highlight was observed appearing and disappearing inside half a
        -- second, so a slower poll would miss it outright. These are FindFirstChild
        -- calls, which are safe at this rate - unlike the attribute reads they replaced.
        task.wait(0.1)
    end
end)

SESPAWN("anti-boss watch", function()
    local wasDown = false
    while _G.SEHUB_GEN == GEN do
        local W = _G.SEHUB_WATCH
        W.ticks = W.ticks + 1
        local down = isRagdolled()
        if down then
            W.ragSeen = W.ragSeen + 1
            W.lastRag = string.format("%.1fs ago", 0)
            W.lastRagAt = tick()
        end
        if FM.AutoBoss and AB.Zone then
            -- fire on the EDGE, so one grab is one escape rather than a burst of them
            -- NO COOLDOWN on a genuine ragdoll. There used to be a 0.75s guard here and
            -- it suppressed every rescue that mattered: grabbing an egg teleports you
            -- and stamps lastEscape, a guard catches you a fraction of a second later,
            -- and the guard clause then threw away the escape. Measured over three
            -- ragdolls: 3 edges detected, 3 blocked, 0 escapes, 3 deaths. The edge test
            -- alone is enough to stop it firing repeatedly.
            -- Fires on ANY ragdoll, carrying or not. Gating it on knowing you hold an
            -- egg is impossible here, and gating on the farm's own flag left manual play
            -- unprotected - 0 escapes across 759 observed ragdolls between the two
            -- attempts. A ragdoll only happens when something has genuinely caught you,
            -- and a needless walk back is cheaper than the void.
            if down and not wasDown then
                W.escapes = W.escapes + 1
                -- EXACTLY what pressing the key does, nothing else. The manual escape
                -- has worked perfectly throughout, so this calls the same function
                -- rather than a second implementation of it.
                --
                -- Two separate mistakes got us here. First a 0.75s cooldown sat in front
                -- of this call and suppressed every rescue, because grabbing an egg
                -- stamps lastEscape and the guard catches you a moment later. Then, in
                -- removing the cooldown, this call was ALSO swapped for a hand-rolled
                -- hold loop - so the obvious combination, working function with no gate,
                -- was never actually run. Two changes at once, neither one tested alone.
                gotoZone(true)
                FM.State = "caught - escaped"
            end
            wasDown = down
        else
            W.blocked = W.blocked + (down and 1 or 0)
        end
        task.wait(0.02)
    end
end)

-- Death watch. Health hitting zero is easy to miss - the character is destroyed and
-- replaced, so a loop holding a reference just sees it go stale. Watching the Character
-- instance change catches both, and it is the same trap that cost half an hour in AR2
-- when cached references outlived a respawn.
SESPAWN("death watch", function()
    local lastChar, wasDead = nil, false
    while _G.SEHUB_GEN == GEN do
        local lp = localPlayer()
        local okc, ch = pcall(function() return lp and lp.Character end)
        if okc and ch then
            if lastChar ~= nil and ch ~= lastChar then
                FM.needRally = true      -- respawned into the base
                FM.Deaths = (FM.Deaths or 0) + 1
                FM.hasEgg = false        -- whatever you were carrying is gone
                FM.depositAt = nil
            end
            lastChar = ch
            local hum = ch:FindFirstChild("Humanoid")
            local okh, h = pcall(function() return hum and hum.Health end)
            local dead = (okh and type(h) == "number" and h <= 0)
            if dead and not wasDead then
                FM.needRally = true
                FM.Deaths = (FM.Deaths or 0) + 1
            end
            wasDead = dead
        end
        task.wait(0.2)
    end
end)

-- Night reload watch. Lighting is no help - ClockTime, TimeOfDay and Brightness all
-- read nil under this executor - so the cycle is detected from its actual effect: the
-- egg slots being torn down and rebuilt. When the set changes wholesale, the visited
-- cooldowns are cleared so the farm immediately re-sweeps the fresh eggs instead of
-- sitting out the cooldown on slots that are no longer the same eggs.
SESPAWN("night watch", function()
    while _G.SEHUB_GEN == GEN do
        local __t0 = tick()
        local folder = workspace:FindFirstChild("AreaEggSlotsClient")
        if folder then
            local okc, kids = pcall(function() return folder:GetChildren() end)
            if okc and kids then
                -- signature: count plus a cheap sum of name lengths, enough to notice a
                -- wholesale swap without stringing 55 names together every second
                -- COUNT, not a name signature. The first version summed slot name
                -- lengths, and slot names alternate between 32-character GUIDs and
                -- 44-character "FirstAreaEgg_..._Forest:Slot_005" strings - so two
                -- slots changing hands moved the signature by ~24 and tripped the
                -- threshold. Dying and watching one egg respawn read as nightfall.
                --
                -- Measured through an actual night: the slot folder empties to about 5
                -- and then refills to 55 over four seconds, seven per half-second. A
                -- single egg returning changes the count by one. Nothing in between.
                -- Rare eggs, scanned here rather than in the target loop. One pass a
                -- second over the slots, cached by position key for looksRare().
                local rare, rareN = {}, 0
                for _, m in ipairs(kids) do
                    local okh, hl = pcall(function()
                        return m:FindFirstChild("RareAreaEggHighlight")
                    end)
                    if okh and hl then
                        local hb = m:FindFirstChild("Hitbox")
                        local okp, p = pcall(function() return hb and hb.Position end)
                        if okp and p then
                            rare[string.format("%d_%d_%d", p.X, p.Y, p.Z)] = true
                            rareN = rareN + 1
                        end
                    end
                end
                FM.rareSet, FM.RareCount = rare, rareN

                -- Identify egg types, once a second, while anything needs it: the rift
                -- farm to find its pets, and Rare Priority to know a Yeti from a Penguin.
                -- Skipped otherwise: it reads every child's Size across 55 slots, which
                -- is fine at 1Hz but has no business running when nothing uses it.
                -- Always Target needs names too: an egg with no name has no tier, and an
                -- egg with no tier can never match the list. Without this the option was
                -- silently inert unless Rare Priority or the rift happened to be on.
                if FM.Rift or FM.RarePri or (FM.AlwaysN or 0) > 0 then
                    sweepEggNames()
                    -- SAY SO WHEN IT CANNOT WORK. Without the egg templates nothing can
                    -- be identified, so Rare Priority, Always Target and the rift farm
                    -- all silently degrade to nearest-first. Every one of those has been
                    -- reported as "not working" at some point, and the real answer was
                    -- always that they had no data - which nothing on screen ever said.
                    if _G.SEHUB_FPCOUNT() == 0 and (tick() - (FM.identWarnAt or 0)) > 30 then
                        FM.identWarnAt = tick()
                        notify("Egg identification",
                            "No egg templates loaded - rarity features are running blind. Reinject Matcha.", 6)
                    end
                    -- EGGS WITH NO KNOWN TIER ARE INVISIBLE TO ALWAYS TARGET, and that is
                    -- the one failure mode it has that looks exactly like nothing being
                    -- there. An egg can be identified perfectly - the shape matched, the
                    -- name is right - and still have no entry in the rarity table, at
                    -- which point alwaysTier returns nil and no list can ever match it.
                    -- A Secret sat on the map untouched that way.
                    --
                    -- So they are collected by name and reported. The name is the thing
                    -- that is missing from the table, so the name is what is worth saying.
                    -- Walked over the SLOTS rather than the name table, so each egg's area
                    -- is known - alwaysTier falls back to the Pet Index's area/slot
                    -- mapping when a name is missing from the rarity table, and without
                    -- the area that fallback cannot run.
                    local noTier = {}
                    local nNoTier = 0
                    for _, e in ipairs(eggSlots()) do
                        local k2 = string.format("%d_%d_%d", e.pos.X, e.pos.Y, e.pos.Z)
                        local nm = (FM.eggName or {})[k2]
                        if nm and not alwaysTier(nm, areaOf(e.pos)) then
                            if not noTier[nm] then nNoTier = nNoTier + 1 end
                            noTier[nm] = true
                        end
                    end
                    FM.NoTier, FM.NoTierN = noTier, nNoTier
                    if (FM.AlwaysN or 0) > 0 and nNoTier > 0
                       and (tick() - (FM.tierWarnAt or 0)) > 60 then
                        FM.tierWarnAt = tick()
                        local list = {}
                        for nm in pairs(noTier) do list[#list + 1] = nm end
                        table.sort(list)
                        notify("Always Target",
                            string.format("%d egg type%s have no known rarity and cannot be matched: %s",
                                nNoTier, (nNoTier == 1) and "" or "s",
                                table.concat(list, ", "):sub(1, 90)), 8)
                    end
                end

                -- Re-read the Pet Index every 30s. Cheap, and entries change under you:
                -- a locked pet reads "???" until you hatch one, at which point its name
                -- and its rarity slot become available.
                if (tick() - (FM.indexAt or 0)) > 30 then
                    FM.indexAt = tick()
                    pcall(harvestPetIndex)
                end

                -- rift progress, checked here too rather than in another loop
                if FM.Rift then
                    local have, total, held = riftProgress()
                    FM.RiftHave = held
                    -- Say so, loudly, when the panel has gone unreadable. Silently farming
                    -- a stale target list is how you end up hunting Centapede, Orca and
                    -- Cosmic Gorilla while the rift is asking for something else entirely.
                    local age = tick() - (FM.RiftReadAt or 0)
                    if age > 30 then
                        FM.RiftState = string.format("PANEL UNREADABLE for %.0fs - targets stale, priority off", age)
                        if not FM.riftStaleWarned then
                            FM.riftStaleWarned = true
                            notify("Rift Farm", "Rift panel unreadable - targets may be stale, priority off", 6)
                            warn("[Steal An Egg] rift panel unreadable: PlayerGui is out of reach, " ..
                                 "which happens when the executor loses its DataModel bindings. " ..
                                 "Rejoin or re-inject to restore it.")
                        end
                    else
                        FM.riftStaleWarned = false
                    end
                    -- Everything below reports on the target list, so it is skipped while
                    -- that list is stale - otherwise the status line would cheerfully print
                    -- progress against pets the rift may no longer be asking for, which is
                    -- the exact thing that made this hard to notice.
                    if age <= 30 then
                    -- Only a COMPLETE read may stop the farm. A partial one satisfies
                    -- "have >= total" as soon as the two pets it could see are done, which
                    -- would park you at the safe zone with a third still outstanding.
                    -- COMPLETE means stop PRIORITISING, not stop farming. Owning one of each
                    -- pet makes hunting those specific eggs pointless, but the banner's
                    -- areas are still worth farming for everything else in them - and the
                    -- requirements reroll, at which point priority comes back on its own.
                    -- The farm used to switch itself off here, which threw away the run.
                    if have >= total and total >= 3 and FM.RiftComplete then
                        FM.RiftState = string.format("COMPLETE - one of each owned, priority off (%d/%d)",
                            have, total)
                        if not FM.riftDoneNotified then
                            FM.riftDoneNotified = true
                            notify("Rift Farm", "One of each pet owned - priority off, still farming", 5)
                            print("[Steal An Egg] rift pets complete - all owned:")
                            for _, t in ipairs(FM.RiftTargets or {}) do
                                print("   " .. t.name .. " (" .. tostring(t.area) .. ")")
                            end
                        end
                    else
                        FM.riftDoneNotified = false
                        -- Say what is actually on the map, not just what is missing from
                        -- the backpack. These eggs rotate: a target can be at zero for a
                        -- while, and without this the farm looks stuck when it is really
                        -- just waiting for the right egg to spawn.
                        local spawned = {}
                        for _, nm in pairs(FM.eggName or {}) do
                            spawned[nm] = (spawned[nm] or 0) + 1
                        end
                        local missing, onMap = {}, 0
                        for _, t in ipairs(FM.RiftTargets or {}) do
                            if not held[t.name] then
                                local c = spawned[t.egg] or 0
                                onMap = onMap + c
                                missing[#missing + 1] = string.format("%s(%d)", t.name, c)
                            end
                        end
                        FM.RiftState = string.format("%d/%d - need %s%s",
                            have, total, table.concat(missing, ", "),
                            (onMap == 0) and " - none spawned, waiting" or "")
                    end
                    end   -- age <= 30
                end

                local n = #kids
                if FM.slotCount and (n - FM.slotCount) >= 10 then
                    FM.visited = {}
                    -- Every slot is a different egg now, so the cached positions and the
                    -- cached identities are both worthless. Say so explicitly rather than
                    -- waiting for the 0.25s TTL to notice.
                    eggSlotsInvalidate()
                    FM.eggName, FM.eggTried = {}, {}
                    FM.Reloads = (FM.Reloads or 0) + 1
                    FM.State = "eggs reloaded (night) - sweeping again"
                    notify("Auto Farm", "Night reload - fresh eggs", 3)
                    -- Report what the respawn actually brought, once it has finished
                    -- arriving. The folder refills over about four seconds, so asking
                    -- immediately would count a third of the map and call the rest missing.
                    if FM.Rift then
                        task.spawn(function()
                            task.wait(5)
                            if _G.SEHUB_GEN ~= GEN or not FM.Rift then return end
                            sweepEggNames()
                            notifyRiftSpawns("Eggs respawned")
                        end)
                    end
                end
                FM.slotCount = n
            end
        end
        PROFTICK("night watch", __t0)
        task.wait(1.0)
    end
end)

-- One tick of the farm, as a function so each phase can bail out with `return`.
-- Luau has no goto, and nesting the phases as if/else instead produced a pyramid deep
-- enough that the grab logic sat sixteen levels in.
local function farmStep()
    -- Every task.wait below this line is PWAIT, so the profiler measures work rather than
    -- sleep. See PROF_TASK at the top of the file.
    local task = PROF_TASK
    if not FM.On then task.wait(0.2) return end
    local root = myRoot()
    if not root then
        FM.State = "waiting for character"
        task.wait(0.5)
        return
    end
    local okp, me = pcall(function() return root.Position end)
    if not okp or not me then task.wait(0.2) return end
    do
        do
            do
                do
                    -- (the caught check runs in its own loop - see "anti-boss watch")
                    local now = tick()

                    -- PHASE 1: after a death, go to the rally point BEFORE anything
                    -- else. Dying returns you to your base, and running at an egg from
                    -- there means crossing whatever geometry sits between - which is
                    -- how you end up wedged against a wall. The rally point is a spot
                    -- you have confirmed has a clear run to the areas, so every
                    -- respawn starts from the same known-good place.
                    local homeP = homePos()
                    if FM.needRally and homeP then
                        local d = (Vector3.new(homeP.X, me.Y, homeP.Z) - me).Magnitude
                        if d > (FM.RallyReach or 14) then
                            local flat = Vector3.new(homeP.X - me.X, 0, homeP.Z - me.Z)
                            local m = flat.Magnitude
                            if m > 0.01 then
                                local sp = FM.Speed
                                if d < (FM.Brake or 60) then
                                    sp = math.max(25, FM.Speed * (d / (FM.Brake or 60)))
                                end
                                local v = (flat / m) * sp
                                pcall(function()
                                    root.AssemblyLinearVelocity =
                                        Vector3.new(v.X, -(FM.Stick or 18), v.Z)
                                end)
                            end
                            FM.State = string.format("died - returning to rally point, %.0f studs", d)
                            task.wait(0.03)
                            return
                        else
                            FM.needRally = false
                            FM.State = "at rally point - resuming"
                        end
                    end

                    -- PHASE 2: holding an egg means the job is to deliver it, not to
                    -- take another. RUN back to the safe zone rather than teleporting -
                    -- the teleport is the emergency escape, this is the delivery.
                    -- Did that grab actually land? Answered while running, not while
                    -- standing still. The slot model is destroyed server-side within a
                    -- round trip, so anything still there after 0.8s was never taken.
                    -- CARRYING SOMETHING BEATS EVERY OTHER SIGNAL. Big eggs overlap the one
                    -- being aimed at, so the press often takes the NEIGHBOUR - which leaves
                    -- the target's slot sitting there, reads as a failed grab, and sends the
                    -- farm back for it while an egg is already in your hands. That is the
                    -- back-and-forth: it returns, gets chased, the anti-boss teleports, and
                    -- it repeats until something kills you.
                    --
                    -- The slot check answers "did THAT egg go", which is the wrong question.
                    -- This answers "am I holding an egg", which is the one that decides
                    -- whether to deliver or turn round.
                    if FM.pendingSlot ~= nil and not FM.pendingHadEgg and heldEggTool() then
                        FM.eggIsTool = true    -- this kind of egg DOES show as a Tool
                        FM.Confirmed = (FM.Confirmed or 0) + 1
                        if FM.grabRetry and FM.pendingKey then
                            FM.grabRetry[FM.pendingKey] = nil
                            FM.fails[FM.pendingKey] = nil
                        end
                        -- The target is still there, so we took a neighbour. Leave it for
                        -- later rather than immediately trying again and repeating the mix-up.
                        if FM.pendingKey and not slotGone(FM.pendingSlot) then
                            FM.visited[FM.pendingKey] = tick()
                            FM.WrongEgg = (FM.WrongEgg or 0) + 1
                        end
                        FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                    elseif FM.pendingSlot ~= nil then
                        if slotGone(FM.pendingSlot) then
                            FM.Confirmed = (FM.Confirmed or 0) + 1
                            if FM.grabRetry and FM.pendingKey then
                                FM.grabRetry[FM.pendingKey] = nil
                                FM.fails[FM.pendingKey] = nil   -- it worked; forget the misses
                            end
                            FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                        elseif (tick() - (FM.pendingAt or 0)) > 0.8 then
                            local key = FM.pendingKey
                            FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                            FM.grabRetry = FM.grabRetry or {}
                            local tries = (FM.grabRetry[key or ""] or 0) + 1
                            FM.grabRetry[key or ""] = tries
                            if tries < 2 then
                                -- Turn around and take it properly. Clearing the cooldown
                                -- matters: leave it set and the retry picks a DIFFERENT
                                -- egg, which is what had you cycling between two areas.
                                FM.hasEgg = false
                                if key then FM.visited[key] = nil end
                                FM.State = "grab did not register - going back for it"
                                task.wait(0.05)
                                return
                            end
                            -- Twice now. Keep the egg flag and deliver anyway rather than
                            -- bouncing forever: a wasted trip home is a bad outcome, a farm
                            -- that never delivers is a broken one.
                            FM.Misses = (FM.Misses or 0) + 1
                            -- And stop coming back to it. Two full attempts, each with its
                            -- own retry from a different side, is enough to call an egg
                            -- unreachable - almost always a bigger egg sitting over it.
                            -- Banned for two minutes, by which point the map has usually
                            -- reshuffled it anyway.
                            if key then
                                FM.fails[key] = (FM.fails[key] or 0) + 1
                                if FM.fails[key] >= 2 then
                                    FM.banned[key] = tick() + 120
                                    FM.Banned = (FM.Banned or 0) + 1
                                    FM.State = "egg unreachable (blocked) - skipping it"
                                end
                            end
                        end
                    end

                    -- THE TOOL IN YOUR HAND IS THE TRUTH, and it outranks the flag. If an
                    -- egg is held, the farm is carrying one - whether it took it, you took
                    -- it by hand, or the flag was cleared by a misread a moment earlier.
                    -- Without this the farm would walk off to grab a second egg while one
                    -- was already in your hands.
                    -- ONLY OUT IN THE FIELD. At the safe zone a held egg is the one the game
                    -- just handed you for delivering - you said it puts it in your hands
                    -- there - so treating that as "carrying, go deliver" left the farm
                    -- standing on the delivery point waiting to deliver an egg it had
                    -- already delivered. That is why you had to unequip it by hand before
                    -- anything would move.
                    --
                    -- Out in an area, a held egg still means exactly what it did: you are
                    -- carrying one, whoever picked it up.
                    local homeNow = homePos()
                    local farFromHome = true
                    if homeNow then
                        farFromHome = (Vector3.new(homeNow.X, me.Y, homeNow.Z) - me).Magnitude
                                      > ((FM.ZoneReach or 12) + 8)
                    end
                    -- AND NOT THE ONE WE ALREADY DELIVERED. Stowing only succeeds about half
                    -- the time, so the egg the hand-over put in your hands often stays
                    -- there. Walk out of the safe zone still holding it and this decided you
                    -- were carrying cargo, turned round, ran home, "delivered" it again, and
                    -- set off - which is the farm pulling you back to the eggs and back to
                    -- the safe zone at the same time. Remembering the instance breaks it:
                    -- a tool that has already been delivered is scenery, not cargo.
                    local heldNow = heldEggTool()
                    if heldNow and heldNow == FM.deliveredTool then heldNow = nil end
                    if heldNow and not FM.hasEgg and farFromHome then
                        FM.hasEgg = true
                        FM.eggIsTool = true
                        FM.grabbedAt = FM.grabbedAt or tick()
                        FM.depositAt = nil
                    end

                    -- ABSENCE OF A TOOL PROVES NOTHING unless this egg was one.
                    --
                    -- The Tool was verified on a Riftbeasts Egg from the rift machine and I
                    -- assumed every egg behaved the same. Stolen area eggs appear not to -
                    -- which matches this file's original finding of no Tool across 541
                    -- ragdolls, a note I had just finished calling wrong. So for a stolen
                    -- egg heldEggTool() returns nil the whole way home, this check fired
                    -- 1.5s after every grab, cleared the flag, and sent the farm off to the
                    -- next area still carrying the egg. That is the "grabs one then goes
                    -- somewhere else" bug.
                    --
                    -- FM.eggIsTool records whether a Tool actually appeared for THIS egg.
                    -- Only then does its disappearance mean anything.
                    if FM.hasEgg and FM.eggIsTool and FM.pendingSlot == nil and FM.grabbedAt
                       and (tick() - FM.grabbedAt) > 1.5 and not heldEggTool() then
                        FM.hasEgg = false
                        FM.depositAt = nil
                        FM.Dropped = (FM.Dropped or 0) + 1
                        FM.State = "no egg in hand - back to farming"
                        task.wait(0.05)
                        return
                    end

                    if FM.hasEgg and homeP then
                        local zp = homeP
                        local d = (Vector3.new(zp.X, me.Y, zp.Z) - me).Magnitude
                        -- FRIEND DROP. Let go a short way short of the delivery point, so
                        -- the egg lands on the floor near the safe zone rather than being
                        -- banked. Checked before the arrival branch, or the hand-over would
                        -- take it first - by the time you are standing on the delivery
                        -- point the game has already claimed the egg.
                        if FM.FriendDrop and d <= (FM.DropRange or 55) then
                            pcall(function()
                                root.AssemblyLinearVelocity = Vector3.new(0, -(FM.Stick or 18), 0)
                            end)
                            local dropped = dropHeldEgg()
                            FM.hasEgg = false
                            FM.depositAt = nil
                            FM.deliveredTool = heldEggTool()
                            FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                            FM.State = dropped
                                and string.format("dropped for a friend, %.0f studs out (%d)", d, FM.Drops or 0)
                                or "could not drop - no drop button on screen"
                            task.wait(0.35)
                            return
                        end
                        if d > (FM.ZoneReach or 12) then
                            -- Same avoidance on the way home, which is the leg that matters
                            -- most: you are carrying an egg and being chased, and a trap
                            -- here costs the whole run.
                            local hx, hz = zp.X, zp.Z
                            if d > 20 then
                                local ox, oz, nTrap = trapAvoid(me, FM.TrapRadius or 30)
                                if nTrap > 0 then
                                    hx, hz = hx + ox, hz + oz
                                    FM.TrapDodges = (FM.TrapDodges or 0) + 1
                                end
                            end
                            local flat = Vector3.new(hx - me.X, 0, hz - me.Z)
                            local m = flat.Magnitude
                            if m > 0.01 then
                                -- Full run speed for a normal egg. The old blanket "carry
                                -- speed" was a guess that carrying slows you server-side
                                -- and it just made every trip home crawl - it is not
                                -- carrying that is punished, it is carrying something BIG.
                                local sp = FM.Speed
                                -- BIG EGGS CANNOT BE RUN WITH. A wide hitbox is welded into
                                -- your assembly and the server refuses the positions that
                                -- result, so commanding 300 does not give you 300 - it gives
                                -- you a fight. Measured on the same route:
                                --
                                --   width 13.5 at cmd 300 -> 32 studs/s, then killed
                                --   width  1.7 at cmd 300 -> 220 studs/s
                                --
                                -- So ask for less and keep what you ask for. 32 studs/s of
                                -- rubber-banding is worse than a clean walk, and the deaths
                                -- come from the fight rather than from the distance.
                                if (FM.carryW or 1) > (FM.BigWidth or 6) then
                                    sp = math.min(sp, FM.BigCarrySpeed or 120)
                                    FM.BigCarries = FM.BigCarries or 0
                                end
                                if d < (FM.Brake or 60) then
                                    sp = math.max(40, sp * (d / (FM.Brake or 60)))
                                end
                                local v = (flat / m) * sp
                                pcall(function()
                                    root.AssemblyLinearVelocity =
                                        Vector3.new(v.X, -(FM.Stick or 18), v.Z)
                                end)
                            end
                            FM.State = string.format("carrying an egg - running home, %.0f studs (%d/s)",
                                d, FM.Speed)
                        else
                            pcall(function()
                                root.AssemblyLinearVelocity = Vector3.new(0, -(FM.Stick or 18), 0)
                            end)
                            -- Standing on the spot should hand it over. If it does not,
                            -- give up rather than parking here permanently - a grab
                            -- that never actually landed would otherwise end the run.
                            FM.depositAt = FM.depositAt or tick()
                            local held = tick() - FM.depositAt
                            -- Delivery is a fact ONLY for eggs that were a Tool to begin
                            -- with. For those, the Tool leaving the character is the
                            -- hand-over. For the rest - stolen area eggs, which never show
                            -- one - this test would be true the instant you arrived and
                            -- would declare delivery before it happened, so they fall
                            -- through to the timer below.
                            if FM.eggIsTool and not heldEggTool() then
                                FM.hasEgg = false
                                FM.depositAt = nil
                                FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                                local pause = FM.PostDeliver or 0
                                if pause > 0 then
                                    FM.State = string.format("delivered - letting the boss reset (%.1fs)", pause)
                                    local t0d = tick()
                                    while (tick() - t0d) < pause and FM.On do
                                        pcall(function()
                                            root.AssemblyLinearVelocity =
                                                Vector3.new(0, -(FM.Stick or 18), 0)
                                        end)
                                        task.wait(0.05)
                                    end
                                end
                                FM.State = "delivered - back to farming"
                                task.wait(0.05)
                                return
                            end
                            if held > (FM.DeliverSettle or 2.5) then
                                FM.hasEgg = false
                                FM.depositAt = nil
                                -- Remember what the hand-over left us holding, so walking
                                -- out of the safe zone with it does not read as carrying.
                                FM.deliveredTool = heldEggTool()
                                -- NOT stowed here. Delivering is the moment the server
                                -- destroys the egg Tool, so re-parenting it right now is a
                                -- race against a free - and losing that race takes the whole
                                -- executor down rather than raising an error. The stow is
                                -- deferred to the start of the next run instead, by which
                                -- point a Tool that still exists is one the game has decided
                                -- to leave you, and is safe to move.
                                FM.stowPending = true
                                -- Never carry a slot reference past the run it belongs to.
                                FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                                -- Wait before setting off again. Sprinting straight back
                                -- out means arriving at the next egg while the guard that
                                -- chased you is still out of position and still hostile,
                                -- and it throws you the moment you have something in your
                                -- hands. Standing still for a couple of seconds lets it
                                -- walk back to its post first.
                                local pause = FM.PostDeliver or 2.0
                                if pause > 0 then
                                    FM.State = string.format("delivered - letting the boss reset (%.1fs)", pause)
                                    local t0d = tick()
                                    while (tick() - t0d) < pause and FM.On do
                                        pcall(function()
                                            root.AssemblyLinearVelocity =
                                                Vector3.new(0, -(FM.Stick or 18), 0)
                                        end)
                                        task.wait(0.05)
                                    end
                                end
                                FM.State = "delivered - back to farming"
                                task.wait(0.05)
                                return
                            end
                            if held > (FM.DepositWait or 20) then
                                FM.hasEgg = false
                                FM.depositAt = nil
                                FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                                FM.visited = {}
                                FM.State = "delivery did not register - back to farming"
                                task.wait(0.3)
                                return
                            end
                            FM.State = string.format("at the delivery point - handing over (%.0fs)", held)
                            task.wait(0.2)
                        end
                        task.wait(0.03)
                        return
                    end

                    -- nothing in hand: the delivery clock resets for next time
                    FM.depositAt = nil

                    -- Deferred stow. We are past the delivery, the egg Tool has either been
                    -- consumed (nothing to do) or survived it (safe to move), so putting it
                    -- away here cannot collide with the server destroying it.
                    -- Kill switch. Run  _G.FARM.NoStow = true  to disable the auto-unequip
                    -- without reloading, so if crashes continue this can be ruled in or out
                    -- in one line rather than by another round of guessing.
                    if FM.stowPending then
                        FM.stowPending = nil
                        if heldEggTool() and not FM.NoStow then
                            if stowHeldEgg() then
                                FM.Stowed = (FM.Stowed or 0) + 1
                            else
                                FM.StowFail = (FM.StowFail or 0) + 1
                            end
                        end
                    end

                    -- PHASE 3: nothing in hand, so go take one.
                    --
                    -- Rift farming takes EVERY egg in the selected banners' areas, and
                    -- only orders them by what the rift is asking for right now. An
                    -- earlier version filtered instead of ordered - it skipped anything
                    -- that was not one of the three current pets - which sounds more
                    -- efficient and is not: the three get rerolled constantly, so a
                    -- Chillin Chilli skipped this hour is a Chillin Chilli you have to go
                    -- back for next hour. Banking the whole pool is the efficient play;
                    -- priority just decides what to grab first.
                    local best, bestScore
                    local anyAllowed = 0        -- targets in range of the filter at all
                    -- Collected only in random mode, and only to re-roll when the current
                    -- pick is gone. Grouping by area first and then picking inside it is
                    -- deliberate: picking uniformly across all slots would just favour
                    -- whichever area happens to hold the most eggs.
                    local cands, sawRandom = {}, false
                    for _, t in ipairs(farmTargets()) do
                        -- Explicit: All Areas, or this area was ticked. No inferring
                        -- intent from an empty table - that is what turned "I unticked
                        -- Snow" into "farm the entire map".
                        local allowed = (FM.Areas[t.area] == true)
                        local key = string.format("%d_%d_%d", t.pos.X, t.pos.Y, t.pos.Z)
                        -- ALWAYS TARGET opens the gate. A listed rarity is fetched from
                        -- anywhere, so this has to be decided BEFORE the area filter
                        -- rather than as a priority bonus afterwards - a bonus cannot
                        -- rescue an egg that was never considered a candidate.
                        local always = false
                        if (FM.AlwaysN or 0) > 0 then
                            local en2 = FM.eggName[key]
                            if en2 then
                                local tier = alwaysTier(en2, t.area)
                                if tier and FM.Always[tier] then
                                    always = true
                                    allowed = true
                                end
                            end
                        end
                        local cool = (now - (FM.visited[key] or 0)) > FM.Cooldown
                        -- An egg that cannot be taken must stop being chosen. A big
                        -- neighbour overlapping it does not go away, so without this the
                        -- highest-scoring ungrabbable egg becomes a permanent magnet: run
                        -- out, fail, 6 second cooldown, run out again - forever, and every
                        -- one of those trips is time spent standing in a guard's area
                        -- getting caught for nothing.
                        if (FM.banned[key] or 0) > now then allowed = false end
                        if allowed then anyAllowed = anyAllowed + 1 end

                        if allowed and cool then
                            -- HORIZONTAL distance. The character only ever moves in X and
                            -- Z, so the Y gap is a constant it can never close - and eggs
                            -- sit about 2.06 studs below the HumanoidRootPart. Measured in
                            -- 3D, standing dead on top of an egg still reads 2.06 studs
                            -- away, which is more than the 1.5 arrival threshold: it could
                            -- never arrive, so it hovered on the spot forever. Worse, while
                            -- hovering, the tiny drift in position kept flipping which egg
                            -- scored nearest - that is the switching between eggs.
                            local d = (Vector3.new(t.pos.X, me.Y, t.pos.Z) - me).Magnitude
                            local en = FM.eggName[key]
                            -- Priority is a LADDER, and distance only ever breaks ties
                            -- within a rung. 20000 per rank is wider than the map is long
                            -- (about 4600 studs corner to corner), so a Secret on the far
                            -- side always outranks a Legendary next door - which is what
                            -- "rarest first" has to mean to be worth anything.
                            --
                            -- The two priorities STACK rather than compete, which is what
                            -- makes "the rarest of the current eggs" fall out for free: a
                            -- wanted egg is lifted clear of everything else by the 10M, and
                            -- the rarity rung then decides the order among the wanted ones.
                            local pri = 0
                            local wanted = false
                            -- 20M: above the rift's 10M, so a listed rarity beats a rift
                            -- pet. That is what "#1 priority" has to mean or the option
                            -- would only work while the rift farm was off.
                            if always then pri = pri + 20000000 end
                            -- STALE TARGETS ARE NOT TARGETS. If the rift panel has not been
                            -- readable for a while - which happens when this executor loses
                            -- its DataModel bindings and PlayerGui becomes unreachable - the
                            -- list still in memory is whatever the rift wanted before that.
                            -- Chasing it sends the farm after three pets the rift may no
                            -- longer want, which is worse than not prioritising at all.
                            local riftFresh = (tick() - (FM.RiftReadAt or 0)) < 30
                            if FM.Rift and FM.RiftPrio and riftFresh then
                                for _, want in ipairs(FM.RiftTargets or {}) do
                                    if not (FM.RiftHave or {})[want.name] then
                                        -- Normal case: we know which egg drops this pet.
                                        if en and want.egg == en then
                                            wanted = true
                                        -- Fallback: the pet's egg has no template we can
                                        -- recognise, so the most we honestly know is the
                                        -- AREA it comes from. Prioritising everything there
                                        -- is worse than picking the right egg and far better
                                        -- than the old behaviour, which was to ignore the
                                        -- target completely and farm as if it did not exist.
                                        elseif want.known == false and want.area == t.area then
                                            wanted = true
                                        end
                                        if wanted then
                                            pri = pri + 10000000    -- above every rarity
                                            break
                                        end
                                    end
                                end
                            end
                            -- One Rare Priority for everything, shared with the rift section.
                            -- It briefly had its own copy, which was two switches for one
                            -- idea and made "which of these is ordering my eggs" a question
                            -- you had to think about.
                            if FM.RarePri then
                                local W = FM.RareWeight or 400
                                local rank = rarityRank(en, t.area)
                                if rank > 0 then
                                    pri = pri + rank * W
                                elseif looksRare(t) then
                                    -- Unidentified, but wearing the rare glow. Worth more
                                    -- than a known common and less than a known Legendary,
                                    -- so it slots in at the middle rung rather than
                                    -- pretending to a precision we do not have.
                                    pri = pri + 5 * W
                                end
                            end
                            -- SIZE PRIORITY. Biggest first, bucketed to whole studs so
                            -- distance still separates eggs of the same size instead of
                            -- the farm crossing the map for a tenth of a stud. Cannot run
                            -- alongside Rare Priority - the toggles turn each other off -
                            -- so the two ladders never have to be reconciled.
                            -- Negate sizeRank here to make it smallest-first instead.
                            if FM.SizePri then
                                local sizeRank = math.floor(t.w or 0)
                                if sizeRank > 0 then
                                    pri = pri + sizeRank * (FM.SizeWeight or 5000)
                                end
                            end
                            -- Buried under a bigger egg. Not skipped outright - if it is the
                            -- only thing left, it is still worth a try - but it goes to the
                            -- back of the queue so the farm exhausts every clean egg first.
                            -- 4000 is comfortably more than the map is wide.
                            if (FM.eggBlocked or {})[key] then pri = pri - 4000 end
                            -- RANDOM MODE. With Rare Priority off the farm used to take
                            -- whatever was nearest, which walks the same short loop round
                            -- the same few slots. A sticky random pick spreads the run out
                            -- instead. Sticky matters: the target is re-scored every tick,
                            -- so re-rolling each time would mean never committing to
                            -- anything and standing still while the choice flickered.
                            -- The bonus sits BELOW the rift's 10M, so a wanted egg still
                            -- wins - the rift farm exists to fetch particular pets, and
                            -- randomising that away would defeat it.
                            if not FM.RarePri and not FM.SizePri then
                                cands[#cands + 1] = { key = key, area = t.area }
                                if key == FM.randomKey then
                                    sawRandom = true
                                    pri = pri + 5000000
                                end
                            end
                            -- FURTHEST FIRST WITHIN A RARITY RUNG. Rare Priority used to
                            -- break ties by nearest, which meant working outwards from
                            -- home and finishing every session with the longest carries
                            -- still to do. Negating the distance term inverts just the
                            -- tie-break: the far side of the map gets cleared while it is
                            -- still full, and the run shortens as it goes.
                            --
                            -- The ladder is untouched. One rung is worth 10000 studs and
                            -- the map is about 4600 across, so -d can only ever reorder
                            -- eggs that already share a rank - a rank 7 anywhere still
                            -- beats a rank 6 next door, in either direction.
                            --
                            -- Only Rare Priority. Size Priority still takes the nearest of
                            -- its size bucket, and with neither on the random pick decides.
                            local score = (FM.RarePri and -d or d) - pri
                            if not bestScore or score < bestScore then
                                best, bestScore = t, score
                                best.key = key
                                -- Carried for the diagnostics, so "is Rare Priority even
                                -- doing anything" is a question with an answer rather than
                                -- an impression.
                                best.name = en
                                best.rank = FM.RarePri and rarityRank(en, t.area) or 0
                                best.w    = t.w
                                best.always = always
                            end
                        end
                    end
                    -- RE-ROLL when the sticky pick is no longer on the board - taken by us,
                    -- taken by someone else, on cooldown, or banned. Area first, then an egg
                    -- inside it, so a dense area does not swallow the whole distribution.
                    -- One tick of latency: the new pick is used from the next pass, which
                    -- costs 30ms and keeps this out of the scoring loop.
                    if not FM.RarePri and not FM.SizePri and not sawRandom then
                        if #cands > 0 then
                            local byArea, areas = {}, {}
                            for _, cd in ipairs(cands) do
                                local a = tostring(cd.area)
                                if not byArea[a] then byArea[a] = {} areas[#areas + 1] = a end
                                local g = byArea[a]
                                g[#g + 1] = cd.key
                            end
                            local pickArea = areas[math.random(1, #areas)]
                            local pool = byArea[pickArea]
                            FM.randomKey  = pool[math.random(1, #pool)]
                            FM.randomArea = pickArea
                            FM.Rerolls = (FM.Rerolls or 0) + 1
                        else
                            FM.randomKey, FM.randomArea = nil, nil
                        end
                    end
                    if not best and anyAllowed == 0 then
                        -- The map is genuinely out of eggs in the areas we farm - not a
                        -- cooldown, not a filter mistake. Wait it out at the safe zone
                        -- rather than wherever the last steal left us: standing in an area
                        -- is only safe while empty-handed, and the respawn drops fresh
                        -- eggs everywhere at once, so home is the shortest average trip to
                        -- the next one.
                        local home = homePos()
                        local dh = home and (home - me).Magnitude or 0
                        if home and dh > 20 then
                            local flat = Vector3.new(home.X - me.X, 0, home.Z - me.Z)
                            local m = flat.Magnitude
                            if m > 0.01 then
                                local sp = FM.Speed
                                if dh < (FM.Brake or 60) then
                                    sp = FM.Speed * (dh / (FM.Brake or 60))
                                    if sp < 25 then sp = 25 end
                                end
                                local v = (flat / m) * sp
                                pcall(function()
                                    root.AssemblyLinearVelocity =
                                        Vector3.new(v.X, -(FM.Stick or 18), v.Z)
                                end)
                            end
                            FM.State = string.format("no eggs left - heading to the safe zone (%.0f studs)", dh)
                            task.wait(0.03)
                        else
                            pcall(function()
                                root.AssemblyLinearVelocity = Vector3.new(0, -(FM.Stick or 18), 0)
                            end)
                            FM.State = "waiting at the safe zone for eggs to respawn"
                            task.wait(0.5)
                        end
                        return
                    end
                    if not best then
                        FM.State = "nothing to farm (all on cooldown or no area on)"
                        task.wait(0.5)
                    else
                        -- APPROACH FROM A DIFFERENT SIDE ON A RETRY. Eggs vary enormously
                        -- in size - hitboxes run from 0.6 to 13.6 studs across - so a big
                        -- neighbour can sit on top of the one being aimed at, blocking the
                        -- line of sight the game needs to show its prompt. Standing in the
                        -- same spot and pressing again just fails again.
                        --
                        -- Each retry rotates the standing position 137 degrees around the
                        -- egg, which walks around it without ever repeating a side. The aim
                        -- point stays 1.2 studs out, so you are still inside the egg and
                        -- still unambiguously nearest to it.
                        local aim = best.pos
                        local tries = (FM.grabRetry or {})[best.key or ""] or 0
                        if tries > 0 then
                            local ang = tries * 2.39   -- radians; 137 degrees, the awkward angle
                            aim = best.pos + Vector3.new(math.cos(ang) * 1.2, 0, math.sin(ang) * 1.2)
                        end
                        -- Horizontal, for the same reason as the scoring above: the Y gap
                        -- to an egg is roughly 2 studs and the character cannot close it,
                        -- so a 3D test against a 1.5 stud reach never passes.
                        local d = (Vector3.new(aim.X, me.Y, aim.Z) - me).Magnitude
                        if d > FM.Reach then
                            -- Run there, glued to the floor, but SLOW DOWN on approach.
                            -- Driving at full speed until the moment you are in range
                            -- means arriving with all that momentum still on you: you
                            -- sail straight past and end up out of reach with the
                            -- prompt behind you. Speed is tapered from BRAKE_DIST so
                            -- the last stretch is walked, not sprinted.
                            -- Bend around any player traps on the way. Not applied within
                            -- the last few studs, or the push would shove you off the egg
                            -- you are trying to stand on.
                            local ax, az = aim.X, aim.Z
                            if d > 12 then
                                local ox, oz, nTrap = trapAvoid(me, FM.TrapRadius or 30)
                                if nTrap > 0 then
                                    ax, az = ax + ox, az + oz
                                    FM.TrapDodges = (FM.TrapDodges or 0) + 1
                                end
                            end
                            -- Inside the snap window: write the position instead of
                            -- creeping into it. Land 0.9 studs short of the aim point
                            -- along the approach, NOT dead centre - 0.9 is still well
                            -- inside the 1.5 stud reach (so we are unambiguously the
                            -- nearest prompt, which is the whole point of the tight
                            -- reach) while keeping us out of the middle of a hitbox that
                            -- can be 13.6 studs across.
                            --
                            -- Y is left alone. The egg sits ~2 studs below the HRP and
                            -- writing the egg's own Y would bury the character in the
                            -- floor - the same 3D-vs-horizontal trap the distance test
                            -- above already had to be fixed for.
                            if FM.SnapOn and d <= (FM.Snap or 12) then
                                local sx, sz = aim.X - me.X, aim.Z - me.Z
                                local sm = math.sqrt(sx*sx + sz*sz)
                                if sm > 0.01 then
                                    local back = math.min(0.9, sm)
                                    local tx = aim.X - (sx/sm) * back
                                    local tz = aim.Z - (sz/sm) * back
                                    -- 6-arg CFrame.new is (position, lookAt) - verified
                                    -- against LookVector - so we land already facing the
                                    -- egg. Worth doing: with Instant Steal off nothing
                                    -- is patched, and an unpatched prompt can still want
                                    -- line of sight. The lookAt is held at OUR Y so the
                                    -- character stays upright instead of tipping down
                                    -- towards an egg that sits ~2 studs below.
                                    -- (CFrame.new(Vector3) does NOT exist in Matcha - it
                                    -- takes 0, 3, 6 or 12 numbers and nothing else.)
                                    pcall(function()
                                        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                        root.CFrame = CFrame.new(tx, me.Y, tz,
                                                                 aim.X, me.Y, aim.Z)
                                    end)
                                    FM.Snaps = (FM.Snaps or 0) + 1
                                    FM.State = string.format("snapping onto %s (%.0f studs)",
                                        best.area, d)
                                end
                                task.wait(0.03)
                                return
                            end
                            local flat = Vector3.new(ax - me.X, 0, az - me.Z)
                            local m = flat.Magnitude
                            if m > 0.01 then
                                local sp = FM.Speed
                                local brakeAt = FM.Brake or 30
                                if d < brakeAt then
                                    sp = FM.Speed * (d / brakeAt)
                                    -- 14, not 25. The last stretch is now a 1.5 stud
                                    -- approach rather than a 5 stud one, and 25 studs/s
                                    -- covers 0.75 studs per tick - half the target - so it
                                    -- overshot and had to creep back.
                                    if sp < 14 then sp = 14 end   -- still enough to close
                                end
                                local v = (flat / m) * sp
                                pcall(function()
                                    root.AssemblyLinearVelocity =
                                        Vector3.new(v.X, -(FM.Stick or 18), v.Z)
                                end)
                            end
                            -- Say WHAT is being fetched, not just where. "running to Snow"
                            -- gave no way to tell whether Rare Priority was ordering
                            -- anything; "running to Snow for Polar Bear (Legendary)" does.
                            -- Built in pieces, because the name is only known when the
                            -- identification sweep is running (Rare Priority or the rift)
                            -- and the WIDTH is always known. The old single-expression
                            -- version hung the size on the name being present, so Size
                            -- Priority showed a bare "running to Prehistoric" and gave no
                            -- way to see what it was ordering by.
                            local what = ""
                            if best.name then what = " for " .. best.name end
                            -- Worth saying out loud: an Always Target pick is the one
                            -- case where the farm leaves the areas you selected, and
                            -- "running to Cosmic" with Cosmic unticked looks like a bug
                            -- unless the line says why.
                            if best.always then what = what .. " [always]" end
                            if FM.SizePri and best.w then
                                what = what .. string.format(" (%.1f wide)", best.w)
                            elseif best.rank and best.rank > 0 then
                                what = what .. string.format(" (rank %d)", best.rank)
                            end
                            FM.State = string.format("running to %s, %.0f studs%s%s", best.area, d,
                                what, (d < (FM.Brake or 60)) and " (braking)" or "")
                        else
                            -- Full stop FIRST. A press while still sliding is a press from
                            -- wherever the slide takes you. ONE frame, not three: three was
                            -- 0.09s of standing on the spot you are about to rob, and the
                            -- approach now brakes to 14 studs/s so there is barely any slide
                            -- left to kill.
                            pcall(function()
                                root.AssemblyLinearVelocity =
                                    Vector3.new(0, -(FM.Stick or 18), 0)
                            end)
                            task.wait(0.03)
                            -- INSTANT PICK UP, the one piece kept from the reference
                            -- script. Patch this prompt, then READ THE HOLD TIME BACK:
                            -- a patched prompt takes an instant tap, an unpatched one
                            -- still wants its real hold, which is why some eggs looked
                            -- immune. Measured rather than assumed.
                            -- Instant Steal is a CHOICE, not an assumption. With it off,
                            -- nothing is patched and the egg is taken the way the game
                            -- intends - hold E for however long this prompt actually wants.
                            -- The farm used to switch the patch on behind your back and
                            -- then take the instant path regardless, so turning it off in
                            -- the menu changed nothing except that the taps stopped working.
                            if ST.On then _G.SEHUB_PATCHNEAR(best.pos, 30) end
                            -- CLEAR THE COMPETITION before pressing. The game takes the
                            -- closest eligible prompt, and a big neighbour overlapping
                            -- this egg is closer than the egg itself no matter how well
                            -- we stand - which is why aiming harder never fixed it and
                            -- FM.WrongEgg kept climbing. Every other prompt within reach
                            -- has its activation distance dropped to something it cannot
                            -- satisfy, so for the moment of the press there is only one
                            -- prompt the game can choose. The sweep restores them after.
                            --
                            -- Radius is small on purpose: 14 studs covers the widest egg
                            -- measured (13.6) without reaching across the whole cluster
                            -- and suppressing eggs we may want to take next.
                            if ST.On and FM.Suppress then
                                FM.SuppressedNow = _G.SEHUB_SUPPRESS(best.pos, 14)
                            end
                            local hd = _G.SEHUB_HOLDTIME(best.pos, 20)
                            -- Watch the actual egg, so the moment it is gone we stop
                            -- pressing and leave. Everything below used to run to
                            -- completion whether or not the egg had already been taken -
                            -- three presses at 0.11s each, or a flat 1.3s hold - which is
                            -- the standing-around you were seeing after the pickup.
                            -- The model we AIMED at, carried through from target selection,
                            -- not re-found by position afterwards. slotAt() had to match a
                            -- hitbox within a stud of where the egg was when it was chosen,
                            -- and it returned nil whenever that egg had since been taken -
                            -- by another player, or by a grab that had already worked. nil
                            -- meant "unknown", which the verification treats as success, so
                            -- those runs walked home empty and were counted as taken. Three
                            -- of your last twenty-one went that way.
                            local slot = best.model or slotAt(best.pos)
                            -- hd >= 0, not just hd < 0.05. A NEGATIVE hold time is not a
                            -- fast prompt, it is a nonsense reading - unpatched egg prompts
                            -- read back -0.5 - and `-0.5 < 0.05` is true, so the old test
                            -- classified every one of them as "already patched, tap it".
                            -- Three taps at a prompt that actually wants a real hold takes
                            -- nothing, and with no success check the farm set hasEgg anyway
                            -- and ran all the way home empty. That is the bug that made
                            -- instant steal look like it broke on its own.
                            if ST.On and hd ~= nil and hd >= 0 and hd < 0.05 then
                                -- ONE press, then leave. This was three presses spaced
                                -- 0.04s apart - 0.27s of standing still - because a single
                                -- press could land in the frame before the prompt had
                                -- registered you as in range. Two things killed that
                                -- reason: the approach now stops 1.5 studs away instead of
                                -- 5, so you are unambiguously inside the prompt when the
                                -- key goes down, and a missed grab is no longer silent -
                                -- the pending check turns you round within 0.8s. Paying
                                -- 0.27s on EVERY egg to insure against a rare miss is the
                                -- wrong trade when the miss now costs 0.8s and self-heals.
                                --
                                -- Re-suppressed RIGHT HERE, one line before the key goes
                                -- down. Measured: a suppression is gone within 0.3s because
                                -- the game recreates prompt objects constantly - new object,
                                -- new address, default range - so suppressing once at the
                                -- top of the grab and pressing a moment later is a race.
                                --   t+0.0s  neighbours 0.5  0.5  0.5
                                --   t+0.3s  neighbours 5.0  5.0  5.0
                                -- Doing it immediately before the press costs one pass over
                                -- a handful of prompts and cannot go stale in between.
                                if ST.On and FM.Suppress then
                                    FM.SuppressedNow = _G.SEHUB_SUPPRESS(best.pos, 14)
                                end
                                pressE(0.04)
                            else
                                -- Three cases, and the middle one is the one that was
                                -- getting this wrong:
                                --   hd known and sane -> hold it out, plus a margin
                                --   hd unknown or negative -> we have NO idea what this
                                --      prompt wants, so use the 2s you established works
                                --      by hand rather than a slider value that happened to
                                --      read 0.5 and was far too short to take anything
                                --   otherwise -> the configured fallback
                                local hold
                                if hd and hd > 0 then
                                    hold = hd + 0.3
                                else
                                    hold = 2.0
                                end
                                local cfg = FM.GrabHold or 1.3
                                if cfg > hold then hold = cfg end
                                -- Only a FALLBACK when the patch was meant to work. With
                                -- Instant Steal off this is simply how the egg is taken, and
                                -- counting it as a failure would make the diagnostics lie.
                                if ST.On then FM.Fallbacks = (FM.Fallbacks or 0) + 1 end
                                FM.State = string.format("holding E for %.1fs in %s", hold, best.area)
                                -- Same as the instant path: suppress immediately before the
                                -- key goes down, not seconds earlier.
                                if ST.On and FM.Suppress then
                                    FM.SuppressedNow = _G.SEHUB_SUPPRESS(best.pos, 14)
                                end
                                if keypress then pcall(function() keypress(0x45) end) end
                                local t0h = tick()
                                while (tick() - t0h) < hold do
                                    pcall(function()
                                        root.AssemblyLinearVelocity =
                                            Vector3.new(0, -(FM.Stick or 18), 0)
                                    end)
                                    -- Out the instant the egg is taken. A prompt that
                                    -- wants 2s of hold still releases the egg the moment
                                    -- it completes, so sitting out the rest of the timer
                                    -- is pure loss.
                                    if slotGone(slot) then break end
                                    task.wait(0.03)
                                end
                                if keyrelease then pcall(function() keyrelease(0x45) end) end
                            end
                            FM.visited[best.key] = now
                            FM.Taken = FM.Taken + 1

                            -- VERIFY. "Am I carrying an egg" is unanswerable on this client
                            -- - not a Tool, not an attribute, nothing near your hand - but
                            -- that was always the wrong question. The answerable one is
                            -- whether the EGG IS STILL THERE: taking it destroys the model,
                            -- so a slot that still exists means the grab failed.
                            --
                            -- Without this the farm assumed every press worked, so one
                            -- missed grab cost a full round trip home with nothing in hand,
                            -- and the counters happily reported it as an egg taken.
                            --
                            -- Only trusted when we actually have a handle on the slot. If
                            -- slotAt could not match one - the hitbox moved, the model was
                            -- renamed - `slot` is nil and we fall back to assuming success,
                            -- because refusing to ever set hasEgg would wedge the farm in a
                            -- loop pressing E at the same egg forever. Unknown is not the
                            -- same as failed.
                            --
                            -- Verification does NOT happen here. The model is destroyed by
                            -- the server, so it is still sitting there for a round trip
                            -- after a perfectly good grab - but waiting for it means
                            -- standing on the spot you just robbed, which is the delay that
                            -- gets you ragdolled. Two failed attempts at this:
                            --   check immediately -> called 8 of 11 good grabs a miss
                            --   wait 0.7s for it  -> correct, but reintroduced the delay
                            -- So: leave NOW, assume it worked, and confirm during the run
                            -- home. The check costs nothing there, and a grab that turns
                            -- out to have failed is caught within a second - having already
                            -- spent that second running in the right direction.
                            FM.pendingSlot = slot
                            FM.pendingKey  = best.key
                            FM.pendingAt   = tick()
                            -- Whether anything was in hand BEFORE the press, so a Tool
                            -- appearing afterwards is proof this grab landed - even if it
                            -- landed on the wrong egg.
                            FM.pendingHadEgg = (heldEggTool() ~= nil)
                            -- Set true only if a Tool actually turns up for this egg, which
                            -- the pending window below watches for. Until then, assume not:
                            -- assuming it does is what sent the farm off mid-carry.
                            FM.eggIsTool = false
                            FM.hasEgg = true
                            FM.grabbedAt = tick()
                            FM.grabEscaped = false    -- arm the post-grab escape
                            FM.grabArea = best.area   -- some areas need a faster escape
                            FM.carryW = best.w or 1   -- how big the thing we just picked up is
                            -- The headstart hop used to fire here. Removed: it was worth a
                            -- measured 0.27s a leg and it spent the same instant the safe
                            -- zone touch needs, so it traded the thing that keeps the egg
                            -- for a fraction of a second on the way home.
                            FM.State = string.format("took an egg in %s (%d) - running home",
                                best.area, FM.Taken)
                            -- Straight into the run, no settle. The delivery phase picks
                            -- it up on the very next tick, and the escape happens later
                            -- when a boss actually closes - running first means a failed
                            -- teleport still leaves you moving in the right direction
                            -- rather than standing on the spot you just robbed.
                            return
                            -- NO teleport here. Escaping on the grab spends the escape
                            -- before the boss has started moving, and by the time it
                            -- catches up the teleport is long finished - that is why
                            -- the manual key worked and this did not. Run home instead;
                            -- the chase watch fires the escape when a guard actually
                            -- starts closing on you.
                            task.wait(FM.AfterSteal or 0.4)
                        end
                    end
                end
            end
        end
    end
end

