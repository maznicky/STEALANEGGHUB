    end
end, "Farms the areas the selected rift eggs draw their pets from, and starts the farm. Turning it off puts your area selection back and stops the farm if it was started by this toggle.")

-- One toggle per rift egg. Leave all three off and it follows whichever banner is live,
-- which is the sensible default and means the section works without configuring it.
for _, r in ipairs(FM.RiftEggAreas) do
    local areas = table.concat(r.areas, ", ")
    riftSec:Toggle(r.name, false, function(v)
        FM.RiftPick[r.name] = v or nil
        applyRiftAreas()
