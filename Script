-- Rank of an identified egg, 0 when we have never been told its tier.
-- [area][template] = 1..8, the pet's slot in that area's Pet Index. Filled in by
-- harvestPetIndex() further down, which reads PlayerGui.Index.
--
-- Survives reloads via _G and restarts via a file, because the source is only readable in
-- a narrow window: the index builds its per-area frames when you OPEN it and tears them
-- down again afterwards, so a harvest run at the wrong moment sees three empty children
-- and nothing else. Persisting turns "open the Pet Index every session" into "open the Pet
-- Index once, ever".
--
-- AREAS AND TIERS ARE DIFFERENT NAMESPACES and must never be mixed: "Cosmic" is both an
-- area on the map and a rarity tier, so this table is keyed by area on the outside and
-- holds slot NUMBERS, never tier names. RARITY_RANK above is keyed by tier and never sees
-- an area string.
local INDEX_FILE = "sehub_petindex.lua"
_G.SEHUB_INDEXSLOT = _G.SEHUB_INDEXSLOT or {}
local INDEX_SLOT = _G.SEHUB_INDEXSLOT

-- Load the cached index off disk when memory has nothing. Written as Lua source rather
-- than JSON because loadstring is already here and a JSON parser is not.
if not next(INDEX_SLOT) and readfile then
    local ok, src = pcall(readfile, INDEX_FILE)
    if ok and type(src) == "string" and #src > 0 then
        local okc, chunk = pcall(loadstring, src)
        if okc and chunk then
            local okr, tbl = pcall(chunk)
            if okr and type(tbl) == "table" then
                for area, slots in pairs(tbl) do
                    if type(slots) == "table" then INDEX_SLOT[area] = slots end
                end
            end
        end
    end
end

local function saveIndexSlots()
    if not writefile then return end
    local parts = { "return {" }
    for area, slots in pairs(INDEX_SLOT) do
        parts[#parts + 1] = string.format("[%q]={", area)
        for tmpl, slot in pairs(slots) do
            parts[#parts + 1] = string.format("[%q]=%d,", tmpl, slot)
        end
        parts[#parts + 1] = "},"
    end
    parts[#parts + 1] = "}"
    pcall(writefile, INDEX_FILE, table.concat(parts))
end

-- Rank of an identified egg. Two sources, and BOTH are now exact - there is no estimating
-- left in here. An earlier version guessed a rank from the slot number plus an offset,
-- which was wrong in a way that mattered: each area starts at a different rung, so Snow's
-- slot 1 is Rare while Cosmic's slot 1 is Epic, and a single offset could not express that.
--
--   1. EGG_RARITY, keyed by template. Works with no index harvest at all.
--   2. The pet's slot in that area's index, read through AREA_TIER. Covers the pets whose
--      display name has no confirmed template, which is exactly where (1) has holes.
--
-- Returns 0 for genuinely unknown, and 0 means "sort by distance" rather than "sort last",
-- which is the honest behaviour when we do not know.
local function rarityRank(eggName, area)
    if not eggName then return 0 end
    local tier = EGG_RARITY[eggName]
    if not tier then
        local byArea = area and INDEX_SLOT[area]
        local slot = byArea and byArea[eggName]
        local tiers = area and AREA_TIER[area]
        if slot and tiers then tier = tiers[slot] end
    end
    if not tier then return 0 end
    return RARITY_RANK[string.lower(tier)] or 0
end

-- Record a pet's tier from the rift panel. Free information: it is on screen every reroll
-- whether or not we use it, and three new pets every few hours fills the table in on its own.
local function learnRarity(template, tier)
    if not template or not tier then return end
    if not RARITY_RANK[string.lower(tier)] then return end
    if EGG_RARITY[template] == tier then return end
    EGG_RARITY[template] = tier
    _G.FARM.RarityLearned = (_G.FARM.RarityLearned or 0) + 1
end
_G.SEHUB_RARITY = function() return EGG_RARITY, RARITY_RANK end

-- A rare egg's slot gains a "RareAreaEggHighlight" child - the glow you see on it.
--
-- Read from a CACHE, refreshed once a second by the night watch, never per tick. The
-- first attempt at this did the child lookup inside the target loop, which meant an
-- extra 55 lookups every tick at 30Hz on top of everything else. Rare eggs sit there
-- for a while; a second of staleness costs nothing and keeps the hot path cheap.
--
-- Reading WHICH rarity is impossible: the label above each egg is a TextLabel and this
-- executor returns the literal string "failed to fetch text" for it, so Divine, Eternal
-- and Secret cannot be told apart. Rare or not is all there is.
local function looksRare(t)
    if not t or not t.pos then return false end
    local key = string.format("%d_%d_%d", t.pos.X, t.pos.Y, t.pos.Z)
    return (_G.FARM.rareSet or {})[key] == true
end

-- ---- egg identification ----
-- Every egg type has a template model in ReplicatedStorage.Assets.Models.Eggs, named
-- after its pet - 115 of them. World eggs are clones of those, so an egg can be
-- identified by shape. Nothing in the world says which is which: the slot is named with
-- a GUID, the models carry no labels, and ProximityPrompt.ObjectText reads nil. Shape is
-- the only channel there is.
--
-- Two earlier attempts at this were wrong, and both failed the same way - they threw
-- away the information that mattered:
--
--   1. Relative part VOLUMES. Matched the templates against each other well, but nothing
--      in the world, because world eggs are randomly scaled clones.
--   2. Aspect ratios of the three biggest parts. Scale-invariant, which fixed (1), but
--      the biggest part of every egg is the SHELL, and the shell is the same shape on
--      all of them - ax=1.721 az=0.980 turns up on eggs in seven different areas. So the
--      fingerprint was mostly measuring the one feature every egg shares, and whole
--      families scored 0.0000 against each other.
--
-- What actually identifies an egg is the DECORATION: how many extra parts are stuck to
-- the shell and their proportions. So the fingerprint is now every part, normalised by
-- the size of the largest one, and the part COUNT has to match exactly. Count alone is
-- most of the answer - in Cosmic, Centapede is 12 parts, Galaxy Gecko 5, La Vacca 7,
-- Cyclops Gorilla 9 - and the normalised sizes settle the rest.
--
-- This version was checked against ground truth rather than against itself. Every world
-- egg on the map matches some template with an error of exactly 0.0000 and a real margin
-- over the runner-up, the areas read as themed sets on their own (Volcano returns Lava
-- Iguana and Lava frog, Prehistoric returns Dodo, Pterodactyl and Ankylosaurus, Abyss
-- Ocean returns Orca, Swordfish and Parrotfish), and in Cosmic - the one area whose real
-- egg list is known - every name it produces is on that list.
--
-- Known limit: 29 of the 115 templates are empty shells in ReplicatedStorage with no
-- children at all (Unicorn, Void Dragon, Boss Egg and friends). Those can never be
-- matched, so eggs of those types come back nil rather than wrong.
local EGG_FP = nil

-- Every part, sorted biggest first, with X/Y/Z divided by the cube root of the biggest
-- part's volume. That normalisation makes it scale-invariant while keeping the relative
-- proportions BETWEEN parts, which is what the aspect-ratio version discarded.
-- GetDescendants, not GetChildren: the decorations are often nested a level down, and
-- reading only the top level is what made these models look like they had 2-5 parts.
local function eggFingerprint(m)
    if not m then return nil end
    -- PARENT CHECK FIRST, and it is not paranoia. This is handed models from the eggSlots
    -- cache, which can be up to a quarter second old, and eggs are destroyed constantly as
    -- other players take them. A destroyed instance answers some calls and crashes the
    -- executor on others - GetDescendants being one of the others - and a native crash is
    -- not something pcall can catch. Before the cache existed every model here came
    -- straight out of a fresh GetChildren and was live by construction.
    local okp, par = pcall(function() return m.Parent end)
    if not okp or par == nil then return nil end
    local parts = {}
    local okd, kids = pcall(function() return m:GetDescendants() end)
    if not okd or not kids then return nil end
    for _, c in ipairs(kids) do
        local okn, n = pcall(function() return c.Name end)
        if okn and n ~= "Hitbox" and n ~= "CustomBoundingBox" then
            local oks, s = pcall(function() return c.Size end)
            if oks and s and typeof(s) == "Vector3" and s.X > 0 and s.Y > 0 and s.Z > 0 then
                parts[#parts + 1] = s
            end
        end
    end
    if #parts == 0 then return nil end
    table.sort(parts, function(a, b) return a.X * a.Y * a.Z > b.X * b.Y * b.Z end)
    local big = parts[1]
    local k = (big.X * big.Y * big.Z) ^ (1 / 3)
    if k <= 0 then return nil end
    local out = {}
    for i, s in ipairs(parts) do out[i] = { s.X / k, s.Y / k, s.Z / k } end
    return out
end

-- nil when the part counts differ. That is a feature: a 12-part Centapede must not be
-- allowed to half-match a 5-part Galaxy Gecko.
local function eggScore(a, b)
    if #a ~= #b then return nil end
    local sum = 0
    for i = 1, #a do
        sum = sum + math.abs(a[i][1] - b[i][1])
              + math.abs(a[i][2] - b[i][2])
              + math.abs(a[i][3] - b[i][3])
    end
    return sum / #a
end

local function buildEggFingerprints()
    if EGG_FP then return EGG_FP end
    EGG_FP = {}
    local RS = game:GetService("ReplicatedStorage")
    local ok, folder = pcall(function()
        return RS.Assets and RS.Assets.Models and RS.Assets.Models:FindFirstChild("Eggs")
    end)
    if not ok or not folder then return EGG_FP end
    local okc, kids = pcall(function() return folder:GetChildren() end)
    if not okc or not kids then return EGG_FP end
    for _, m in ipairs(kids) do
        local r = eggFingerprint(m)
        if r then EGG_FP[#EGG_FP + 1] = { name = tostring(m.Name), r = r } end
    end
    return EGG_FP
end

-- What each area can actually spawn, as internal template names. This is the only
-- outside knowledge in the file, and it is what turns the matcher from "a shape that
-- resembles X" into a real answer, because it is the one thing shape cannot supply: two
-- eggs built from identically proportioned parts are separated by where they are.
--
-- Sources: Cosmic came from the in-game list, Volcano and Abyss Ocean from the wiki.
-- Areas absent here still identify fine whenever the shape is unambiguous; they just
-- have no way to break a tie, so they return nil instead of guessing.
--
-- Some names differ between the display and the files, resolved by elimination against
-- the area list rather than by picking the nearest-looking template:
--   Cosmic Gecko Egg   -> Galaxy Gecko        Cosmic lists one gecko, Ash Gecko is Volcano's
--   Lava Gecko Egg     -> Ash Gecko           Volcano lists one gecko, Galaxy Gecko is Cosmic's
--   Cosmic Gorilla Egg -> Cyclops Gorilla     the other gorillas do not fit the part count
--   Cosmic Skeleton    -> Alien Skeleton Boss name structure only; UNCONFIRMED
--   Cosmic Dragon Egg  -> unknown             every candidate dragon template is empty
--
-- EMPTY: 29 of the 115 templates have no children in ReplicatedStorage and can never be
-- matched, so eggs of those types come back nil rather than wrong. On these three lists
-- that is Unicorn, Phoenix, Beluga Whale and Kraken.
--
-- Worth knowing about the pairs that matter for the current rotation: Orca and Whale
-- Shark are both 4-part Abyss Ocean eggs but sit 1.04 apart, so they are never confused.
-- Ash Gecko and Chimpanzee are 0.0001 apart - genuinely identical to this metric - and
-- only Volcano's list separates them.
local AREA_EGGS = {
    Cosmic = { "Centapede", "Galaxy Gecko", "Cyclops Gorilla",
               "La Vacca Saturno Saturnita", "Alien Skeleton Boss",
               "Eternal Lunar Dragon", "Unicorn" },
    Volcano = { "Ash Gecko", "Lava frog", "Flaming Bull", "Lava Iguana",
                "Chillin Chilli", "Cerberus", "Ascended Vermilion Phoenix" },
    ["Abyss Ocean"] = { "Parrotfish", "Swordfish", "Shark", "Orca", "Whale Shark",
                        "Belula Beluga", "Kraken" },
}

-- Best-scoring template, but only when the answer is CLEAR: a low error and a real
-- margin over the runner-up. Anything else returns nil - "unknown" is a useful answer
-- and a wrong name is not.
--
-- An earlier version resolved ambiguity by preferring whichever candidate happened to be
-- a rift target. That is confirmation bias in code - it reported a Frog egg in Cosmic as
-- a Centapede purely because Centapede was what we wanted, and produced a confident "4
-- Centapede eggs" that was not real. The tie-break below asks a different question: not
-- "which of these do we want" but "which of these can spawn here", against a list that
-- came from the game rather than from our hopes.
--
-- Being wrong here stays cheap by design: the rift farm only runs in the areas its pets
-- come from and takes every egg there eventually, so identification changes the ORDER it
-- visits slots and nothing else.
local EGG_MAXERR, EGG_MARGIN = 0.01, 0.002
local function eggNameFor(model, area)
    local list = buildEggFingerprints()
    local r = eggFingerprint(model)
    if not r or #list == 0 then return nil end
    local fits = {}
    for _, t in ipairs(list) do
        local s = eggScore(r, t.r)
        if s and s <= EGG_MAXERR then fits[#fits + 1] = { name = t.name, s = s } end
    end
    if #fits == 0 then return nil end
    table.sort(fits, function(a, b) return a.s < b.s end)
    local allow = area and AREA_EGGS[area]

    if #fits == 1 or (fits[2].s - fits[1].s) >= EGG_MARGIN then
        -- A confident answer the area list has never heard of is NOT overruled here.
        -- The lists are transcriptions and may be incomplete - Abyss Ocean produced a
        -- confident Finned Thresher that is not on the wiki page - and quietly discarding
        -- a good match to protect a list would hide exactly the disagreement worth
        -- seeing. Record it instead, and let Check Rift Progress report it.
        if allow then
            local ok = false
            for _, want in ipairs(allow) do
                if fits[1].name == want then ok = true break end
            end
            if not ok then
                _G.FARM.EggOdd = _G.FARM.EggOdd or {}
                _G.FARM.EggOdd[area .. ": " .. fits[1].name] = true
            end
        end
        return fits[1].name
    end

    -- Shape shared by more than one template; only location separates them.
    if allow then
        for _, want in ipairs(allow) do
            for _, c in ipairs(fits) do
                if c.name == want then return c.name end
            end
        end
    end
    return nil    -- ambiguous and nothing local to break the tie
end

-- ---- reading the rift requirements out of the game ----
-- These used to be typed in by hand because the requirements looked unreadable: the
-- decompiler fails on RiftTradeIn, GetAttribute is fatal, and TextLabel.Text came back
-- nil everywhere it was tried. That last one was the mistake. Text is NOT globally
-- unreadable in this executor - it reads fine on this GUI. The labels tested early on
-- happened to be ones that read nil, and the conclusion got generalised to "no text
-- anywhere", which closed off a door that was open the whole time.
--
-- The one real trick is which label to read. Each input slot has a Full frame and an
-- Empty frame stacked on top of each other, and the REQUIREMENT lives on Empty:
--
--   Input1.Empty.Name   = "Cosmic Gecko"    Input1.Full.Name = "Cosmic Gecko"
--   Input2.Empty.Name   = "Whale Shark"     Input2.Full.Name = "Pet Name"   <- placeholder
--   Input3.Empty.Name   = "Centapede"       Input3.Full.Name = "Pet Name"   <- placeholder
--
-- Full only gets written once you actually insert that pet, so reading Full gives you
-- one real name and two bits of template text. Empty is populated for all three.
--
-- All of it reads with the panel CLOSED, from anywhere on the map, and it stays live -
-- the rotation timer ticks down while nothing is open. So the requirements no longer
-- need configuring, and a rotation is picked up on its own.
local RIFT_GUI = { "RiftTradeIn", "RiftTradeInMain", "SacrificeInputs" }

-- Display name -> template name in Assets.Models.Eggs, for the pets the files keep under
-- a different name than the UI shows. Each of these was resolved by elimination against
-- the area's real egg list rather than by picking whichever template looked close:
--   Cosmic Gecko -> Galaxy Gecko   no "Cosmic Gecko" exists anywhere in ReplicatedStorage,
--                                  and Ash Gecko is demonstrably the Volcano one
--   Lava Gecko   -> Ash Gecko      same trick in reverse: Volcano lists exactly one gecko
--                                  and Ash Gecko is the only one left
-- The last two are here for completeness; both templates are empty, so they can never be
-- matched in the world - see the EMPTY note below.
local RIFT_EGG_ALIAS = {
    ["cosmic gecko"]        = "Galaxy Gecko",
    ["lava gecko"]          = "Ash Gecko",
    ["cosmic gorilla"]      = "Cyclops Gorilla",
    ["cosmic skeleton"]     = "Alien Skeleton Boss",
    ["cosmic skeleton boss"] = "Alien Skeleton Boss",
    ["king mammoth"]        = "Colossal Mammoth",
    ["beluga whale"]        = "Belula Beluga",
    ["phoenix"]             = "Ascended Vermilion Phoenix",
    -- Titan Temple. Every display name there is invented, so all four of these are renames.
    -- The evidence is that the shape matcher finds exactly these four templates in Titan
    -- Temple, sweep after sweep, and they are four of the eight names the Pet Index lists
    -- for it - with the creature surviving each rename the way it does everywhere else.
    -- I had already worked this out for the rarity table and then failed to write it here,
    -- which is the same oversight that made Cosmic Gorilla undetectable.
    ["spideron"]            = "Kaiju Spider",
    ["crustacia"]           = "Crab",
    ["bladehide"]           = "Blade Head",
    ["mantaris"]            = "Mantis",
}

-- Case matters more than you would think: the rift panel writes "Lava frog" with a
-- lowercase f, matching the template exactly, but the same pet is "Lava Frog" everywhere
-- a human writes it. An exact-only lookup would silently fail on one of those, so the
-- resolver falls back to a case-insensitive scan before giving up.
local function resolveEggTemplate(name, area)
    if not name then return nil end
    local alias = RIFT_EGG_ALIAS[string.lower(name)]
    if alias then name = alias end
    local RS = game:GetService("ReplicatedStorage")
    local ok, folder = pcall(function()
        return RS.Assets and RS.Assets.Models and RS.Assets.Models:FindFirstChild("Eggs")
    end)
    if not ok or not folder then return name end
    local oke, exact = pcall(function() return folder:FindFirstChild(name) end)
    if oke and exact then return name end
    local okc, kids = pcall(function() return folder:GetChildren() end)
    if okc and kids then
        local want = string.lower(name)
        for _, t in ipairs(kids) do
            if string.lower(tostring(t.Name)) == want then return tostring(t.Name) end
        end
    end

    -- There WAS a fuzzy fallback here that matched on the animal - the last word - on the
    -- reasoning that every rename keeps the creature and swaps the adjective (Cosmic
    -- Gorilla -> Cyclops Gorilla, King Mammoth -> Colossal Mammoth). It is gone, because
    -- the first thing it did in the wild was map "Cosmic Dragon" to "Eternal Lunar Dragon"
    -- - two different pets that both happen to end in Dragon, both in Cosmic.
    --
    -- A wrong mapping is strictly worse than no mapping. No mapping means the farm takes
    -- any egg in the area; a wrong one sends it at the wrong egg while reporting success.
    -- Unmapped names are recorded so they can be turned into real aliases, which is a
    -- thing to fix rather than a thing to guess.
    local FMx = _G.FARM
    FMx.EggUnmapped = FMx.EggUnmapped or {}
    FMx.EggUnmapped[tostring(name) .. (area and (" [" .. area .. "]") or "")] = true
    return name    -- no template; the farm falls back to taking any egg in the area
end

-- ---- the Pet Index ----
-- PlayerGui.Index is the in-game collection screen, and it is the best data source in this
-- game: one frame per area, eight entries per area named IndexEntry1..8, each carrying the
-- pet's display name - and the entries are ordered by RARITY.
--
-- It answers two separate problems that were both being solved by hand:
--
--   1. Rare Priority had nothing to work with. Only 14 of 115 egg types had a known
--      rarity, so almost every egg scored 0, tied, and quietly fell back to distance.
--      That is why the toggle appeared to do nothing.
--   2. AREA_EGGS and the alias table were transcriptions - from you, or from the wiki -
--      and went stale silently. "Cosmic Gorilla" cost a farming session precisely because
--      a hand-maintained mapping had a hole in it.
--
-- Verified against the Snow list you supplied: slots 1-7 read Penguin, Walrus, Polar Bear,
-- Sabertooth Tiger, Mammoth, King Mammoth, Yeti, which is exactly Rare through Secret.
--
-- Reads fine with the index CLOSED. Locked pets read "???" and are skipped rather than
-- guessed at.
local function harvestPetIndex()
    local lp = localPlayer()
    local pg = lp and lp:FindFirstChild("PlayerGui")
    local idx = pg and pg:FindFirstChild("Index")
    local node = idx
    for _, step in ipairs({ "Frame", "List", "ScrollingFrame" }) do
        if not node then return 0 end
        local ok, nxt = pcall(function() return node:FindFirstChild(step) end)
        if not ok or not nxt then return 0 end
        node = nxt
    end
    local learned = 0
    for _, b in ipairs(AREA_BOUNDS) do
        local area = b.name
        local f = node:FindFirstChild(area)
        local pets = f and f:FindFirstChild("Pets")
        if pets then
            local slots, order = {}, {}
            for i = 1, 8 do
                local e = pets:FindFirstChild("IndexEntry" .. i)
                local lbl = e and e:FindFirstChild("TextLabel")
                local ok, t = pcall(function() return lbl and lbl.Text end)
                if ok and type(t) == "string" and #t > 0 and t ~= "???" then
                    -- Display name -> template. Goes through the same resolver the rift
                    -- panel uses, so "Cosmic Gorilla" lands on Cyclops Gorilla here too.
                    -- Only kept if a template of that name actually EXISTS: a name that
                    -- resolves to nothing can never match a world egg, and storing it
                    -- would put a phantom into the area list that the matcher then has to
                    -- rule out. Unmapped names are recorded by the resolver instead.
                    local tmpl = resolveEggTemplate(t, area)
                    local RS = game:GetService("ReplicatedStorage")
                    local okf, folder = pcall(function()
                        return RS and RS.Assets and RS.Assets.Models
                               and RS.Assets.Models:FindFirstChild("Eggs")
                    end)
                    local real = okf and folder and tmpl and folder:FindFirstChild(tmpl)
                    if real then
                        slots[tmpl] = i
                        order[#order + 1] = tmpl
                        learned = learned + 1
                    end
                end
            end
            if next(slots) then
                INDEX_SLOT[area] = slots
                -- Replace the transcribed list with the game's own. Keyed by AREA; the
                -- values are template names, never tiers.
                AREA_EGGS[area] = order
            end
        end
    end
    if learned > 0 then saveIndexSlots() end
    _G.FARM.IndexPets = learned
    return learned
end
_G.SEHUB_INDEX = harvestPetIndex

-- Rebuild the area lists from whatever the cache holds, so a restart is as good as a fresh
-- harvest without needing the index open.
local function areaEggsFromIndex()
    local n = 0
    for area, slots in pairs(INDEX_SLOT) do
        local order = {}
        for tmpl, slot in pairs(slots) do order[#order + 1] = { t = tmpl, s = slot } end
        if #order > 0 then
            table.sort(order, function(a, b) return a.s < b.s end)
            local list = {}
            for _, e in ipairs(order) do list[#list + 1] = e.t end
            AREA_EGGS[area] = list
            n = n + #list
        end
    end
    return n
end
_G.SEHUB_AREAEGGS = areaEggsFromIndex
areaEggsFromIndex()

local function riftLabel(parent, ...)
    local node = parent
    for _, step in ipairs({ ... }) do
        if not node then return nil end
        local ok, nxt = pcall(function() return node:FindFirstChild(step) end)
        if not ok then return nil end
        node = nxt
    end
    if not node then return nil end
    local ok, t = pcall(function() return node.Text end)
    if ok and type(t) == "string" and #t > 0 then return t end
    return nil
end

-- The three pets the rift currently wants, read live. nil when the GUI is not there.
local function readRiftUI()
    local lp = localPlayer()
    local node = lp and lp:FindFirstChild("PlayerGui")
    for _, step in ipairs(RIFT_GUI) do
        if not node then return nil end
        local ok, nxt = pcall(function() return node:FindFirstChild(step) end)
        if not ok or not nxt then return nil end
        node = nxt
    end
    -- The panel rebuilds itself when the requirements reroll, and mid-rebuild it lies. An
    -- Input frame can briefly have no children at all; worse, it can keep its frames and
    -- have every label inside come back unreadable, while a sibling still shows the
    -- PREVIOUS rotation's pet on its Full label. Both were seen within a minute of each
    -- other, and both produced two requirements instead of three.
    --
    -- Checking that the Empty frame exists is not enough - that passed while every label
    -- under it was unreadable. The only test that holds is the count: the panel has
    -- exactly three input slots, so anything less than three names is a partial read. A
    -- partial read must never overwrite a good list, because `total` dropping to 2 could
    -- declare the rift ready while a third pet was still outstanding.
    local out = {}
    for i = 1, 3 do
        local ok, inp = pcall(function() return node:FindFirstChild("Input" .. i) end)
        if ok and inp then
            local nm = riftLabel(inp, "Empty", "Name")
            -- "Pet Name" is the untouched template text, not a pet
            if nm and nm ~= "Pet Name" then
                local area = riftLabel(inp, "FoundInWorld")
                if area then area = area:match("%[(.-)%]") end
                local amt  = riftLabel(inp, "Empty", "Amount")
                local have, need
                if amt then have, need = amt:match("^%s*(%d+)%s*/%s*(%d+)") end
                local tmpl = resolveEggTemplate(nm, area)
                -- Does that template actually exist? Four Titan Temple pets and a handful
                -- elsewhere have display names with no model behind them, and a target
                -- pointing at a template that does not exist can never match a world egg -
                -- so the farm silently ignored it. Recorded here so the scoring can fall
                -- back to "anything in that area" rather than nothing.
                local known = false
                do
                    local RS = game:GetService("ReplicatedStorage")
                    local okf, folder = pcall(function()
                        return RS and RS.Assets and RS.Assets.Models
                               and RS.Assets.Models:FindFirstChild("Eggs")
                    end)
                    if okf and folder and tmpl then
                        known = folder:FindFirstChild(tmpl) ~= nil
                    end
                end
                local tier = riftLabel(inp, "Empty", "Rarity")
                -- Free rarity data, straight off the panel. "Rarity" is the template's own
                -- placeholder text before it is filled in, so it is rejected by rank lookup.
                learnRarity(tmpl, tier)
                out[#out + 1] = {
                    name  = nm,
                    area  = area,
                    egg   = tmpl,
                    known = known,
                    rarity = tier,
                    have  = tonumber(have) or 0,
                    need  = tonumber(need) or 1,
                    alts  = { string.lower(nm) },
                }
            end
        end
    end
    if #out == 0 then return nil end
    return out, (#out == 3)
end
_G.SEHUB_RIFTUI = readRiftUI

-- A read worth acting on: complete, or better than what we already hold. Accepting a
-- partial list when we have nothing is deliberate - two of the three requirements beats
-- none while the panel finishes building itself - but it is flagged, and anything that
-- could end the farm early has to check that flag rather than trust the count.
local function readRiftUIStable()
    local live, complete = readRiftUI()
    if not live then return nil end
    _G.FARM.RiftComplete = complete
    if complete then return live end
    local prev = _G.FARM.RiftTargets
    if prev and #prev >= #live then return nil end   -- keep the better list we already have
    return live
end

-- Overwrite the configured targets with whatever the rift is actually asking for. Cheap
-- enough to call on a timer, so a mid-session rotation is handled without a reload.
-- Which rift egg is live. The panel writes it as "Riftborn Banner", so the suffix comes
-- off; the rotation list writes the same name with "(Now)" after it, which is not used
-- here because EggName is the simpler read of the two.
local function readRiftBanner()
    local lp = localPlayer()
    local t = riftLabel(lp and lp:FindFirstChild("PlayerGui"),
        "RiftTradeIn", "RiftTradeInMain", "CurrentEggInfoHolder", "EggName")
    if not t then return nil end
    t = t:gsub("%s*Banner%s*$", ""):gsub("%s*%(Now%)%s*$", "")
    if #t == 0 then return nil end
    return t
end

-- Work out the banner from the requirements when its own label will not read. The three
-- pets always come from within the banner's four areas, so the set of areas they are found
-- in has to be a subset of exactly one banner's list - and usually is: two pets from Cosmic
-- and one from Abyss Ocean fits Riftbeasts and nothing else.
--
-- This exists because the EggName label goes unreadable for a spell after every reroll,
-- exactly like the Input frames do. Without it, switching the mode on during that window
-- silently farmed the entire map instead of four areas.
-- Returns the areas to farm and a label naming what was inferred. When more than one
-- banner fits, it returns their UNION rather than giving up: two pets in Volcano and one
-- in Abyss Ocean fit both Riftborn and Riftbeasts, and their union is six areas - still
-- guaranteed to contain the live one, and far better than the eleven that "unknown" used
-- to fall back to. Narrowing eleven to six on a bad read is worth more than being right
-- only when the answer happens to be unique.
local function inferBannerAreas()
    local FMx = _G.FARM
    local areas = {}
    for _, t in ipairs(FMx.RiftTargets or {}) do
        if t.area then areas[t.area] = true end
    end
    if next(areas) == nil then return nil, nil end
    local fits = {}
    for _, r in ipairs(FMx.RiftEggAreas or {}) do
        local set = {}
        for _, a in ipairs(r.areas) do set[a] = true end
        local ok = true
        for a in pairs(areas) do
            if not set[a] then ok = false break end
        end
        if ok then fits[#fits + 1] = r end
    end
    if #fits == 0 then return nil, nil end
    local union, names = {}, {}
    for _, r in ipairs(fits) do
        names[#names + 1] = r.name
        for _, a in ipairs(r.areas) do union[a] = true end
    end
    return union, table.concat(names, " or ")
end

-- The set of areas the rift farm should cover: the union of whichever banners are ticked,
-- or - when none are - the areas of the banner that happens to be live. Falling back to
-- the live banner rather than to nothing means the toggle does something sensible on its
-- own, without making you pick first.
local function riftAreaSet()
    local FMx = _G.FARM
    local picked, any = {}, false
    for _, r in ipairs(FMx.RiftEggAreas or {}) do
        if FMx.RiftPick[r.name] then
            any = true
            for _, a in ipairs(r.areas) do picked[a] = true end
        end
    end
    if any then return picked, "selected" end

    local live = FMx.RiftBanner
    if live then
        for _, r in ipairs(FMx.RiftEggAreas or {}) do
            if r.name:lower() == live:lower() then
                for _, a in ipairs(r.areas) do picked[a] = true end
                return picked, "live banner (" .. r.name .. ")"
            end
        end
    end

    -- Label unreadable, which happens for a spell after every reroll. Work it out from
    -- where the three pets live instead.
    local guessed, names = inferBannerAreas()
    if guessed then
        FMx.RiftBannerGuess = names
        return guessed, "banner inferred (" .. names .. ")"
    end
    return picked, nil     -- nothing to go on; caller decides what to do
end

local function refreshRiftTargets()
    local live = readRiftUIStable()
    local lp = localPlayer()
    _G.FARM.RiftBanner = readRiftBanner() or _G.FARM.RiftBanner
    _G.FARM.RiftRotate = riftLabel(lp and lp:FindFirstChild("PlayerGui"),
        "RiftTradeIn", "RiftTradeInMain", "CurrentEggInfoHolder", "RotateTimer")
    if not live then return false end
    _G.FARM.RiftTargets = live
    -- When the panel was last actually READ. Everything downstream needs this, because the
    -- targets are kept when a read fails and there is otherwise no way to tell a current
    -- list from one left over from before the executor lost its DataModel bindings.
    _G.FARM.RiftReadAt = tick()
    return true
end

-- Push the chosen banners' areas into the farm's area filter. Called whenever the picks
-- change as well as when the mode is switched on, so re-ticking a banner mid-run takes
-- effect immediately instead of at the next toggle.
local function applyRiftAreas()
    local FMx = _G.FARM
    if not FMx.Rift then return end
    local set, source = riftAreaSet()
    local n = 0
    for _ in pairs(set) do n = n + 1 end
    if n == 0 then
        -- Nothing ticked and no readable banner. Farm everywhere rather than nowhere: an
        -- empty filter means the farm stands still, which looks identical to a broken
        -- script. Written out area by area now that there is no AllAreas shortcut.
        local all = {}
        for _, b in ipairs(AREA_BOUNDS) do all[b.name] = true end
        FMx.Areas = all
        FMx.RiftAreaNote = "no banner readable - farming all areas"
        return
    end
    FMx.Areas = set
    local list = {}
    for a in pairs(set) do list[#list + 1] = a end
    table.sort(list)
    FMx.RiftAreaNote = tostring(source or "areas") .. ": " .. table.concat(list, ", ")
end
_G.SEHUB_RIFTAREAS = applyRiftAreas
_G.SEHUB_RIFTREFRESH = refreshRiftTargets

-- Progress. Prefers the rift panel's own "0/1" counters, which are authoritative;
-- falls back to a loose backpack name match when the GUI cannot be read, so
-- "Whale Shark [X2]" still counts as a Whale Shark.
-- Do you already own one of this pet? Your backpack is 149 Tools with readable names, and
-- pets keep their display name there - the same name the rift panel asks for - so this is a
-- direct lookup rather than an inference.
--
-- Matched on "contains", because mutations prefix the name: a Golden Centapede, a Rainbow
-- Cosmic Gorilla and a Silver Bladehide are all still that pet as far as the rift cares.
-- Built ONCE and cached for a second, rather than walked per pet. The backpack is 150
-- Tools and this is asked three times a second - once per rift target - so the naive
-- version was 450 name reads a second, about 80ms of every second spent re-reading a list
-- that changes when you hatch something. The inventory does not change fast enough to care.
local OWNED_CACHE, OWNED_AT = nil, 0
local function ownedNames()
    if OWNED_CACHE and (tick() - OWNED_AT) < 1.0 then return OWNED_CACHE end
    local out = {}
    local lp = localPlayer()
    -- The Backpack hangs off the Player, so it is unreachable when that service is nil.
    -- The character still is, via the camera, so ownership degrades to "what is equipped"
    -- rather than failing outright.
    for _, where in ipairs({ lp and lp:FindFirstChild("Backpack"), myCharacter() }) do
        if where then
            local okk, kids = pcall(function() return where:GetChildren() end)
            if okk and kids then
                for _, c in ipairs(kids) do
                    local okcl, cl = pcall(function() return c.ClassName end)
                    if okcl and cl == "Tool" then
                        local okn, n = pcall(function() return c.Name end)
                        if okn and type(n) == "string" then
                            out[#out + 1] = string.lower(n)
                        end
                    end
                end
            end
        end
    end
    OWNED_CACHE, OWNED_AT = out, tick()
    return out
end

local function ownsPet(name)
    if not name then return false end
    local want = string.lower(name)
    for _, n in ipairs(ownedNames()) do
        if string.find(n, want, 1, true) then return true end
    end
    return false
end
_G.SEHUB_OWNS = ownsPet

local function riftProgress()
    local live = readRiftUIStable()
    if live then
        _G.FARM.RiftTargets = live
        _G.FARM.RiftFromUI = true
    elseif _G.FARM.RiftFromUI then
        -- The panel has read cleanly before and is momentarily rebuilding. Its last good
        -- answer beats falling back to backpack names, which cannot see the 0/1 counters.
        live = _G.FARM.RiftTargets
    end
    if live then
        local have, total, held = 0, 0, {}
        for _, want in ipairs(live) do
            total = total + 1
            -- OWNING one counts, not just having inserted it. The panel's 0/1 only moves
            -- when a pet is put into the rift, so a backpack full of Centapedes still read
            -- as "need Centapede" and the farm kept prioritising an egg you already had
            -- several of. Owning one is the thing that makes hunting it pointless.
            local got = (want.have >= want.need) or ownsPet(want.name)
            held[want.name] = got
            if got then have = have + 1 end
        end
        return have, total, held
    end

    local lp = localPlayer()
    local okb, bp = pcall(function() return lp and lp:FindFirstChild("Backpack") end)
    local held, names = {}, {}
    if okb and bp then
        local okc, kids = pcall(function() return bp:GetChildren() end)
        if okc and kids then
            for _, d in ipairs(kids) do
                local okn, nm = pcall(function() return d.Name end)
                if okn and nm then names[#names + 1] = string.lower(tostring(nm)) end
            end
        end
    end
    local have, total = 0, 0
    for _, want in ipairs(_G.FARM.RiftTargets or {}) do
        total = total + 1
        local got = false
        for _, alt in ipairs(want.alts or { string.lower(want.name) }) do
            for _, nm in ipairs(names) do
                if string.find(nm, alt, 1, true) then got = true break end
            end
            if got then break end
        end
        held[want.name] = got
        if got then have = have + 1 end
    end
    return have, total, held
end
