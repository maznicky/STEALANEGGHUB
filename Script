-- ==================== instant steal ====================
-- The reference script tried three routes and TWO of them are dead under Matcha:
-- fireproximityprompt does not exist, and prompt:InputHoldBegin is nil. The property
-- writes it falls back to error outright ("Unknown property: HoldDuration"). What
-- actually carries the feature is the memory write, so that is what this rebuilds -
-- but with the two things the original had no way to do:
--
--   1. VERIFY. memory_read works, so after writing we read back. If the value did not
--      take, the offsets have moved (a Roblox update reshuffles the struct) and we
--      stop immediately instead of spraying floats into whatever now lives there.
--   2. RESTORE. The originals are recorded per address before the first write, so
--      unloading or toggling off puts the game back rather than leaving it modified
--      with nothing tracking it.
_G.STEAL = _G.STEAL or {}
local ST = _G.STEAL
-- ON by default. The farm cannot work without it - the eggs need a zero hold time and
-- the widened reach to be grabbed on the move.
ST.On         = true
ST.Hold       = 0.0        -- HoldDuration to force
ST.Dist       = 15.0       -- MaxActivationDistance to force; 15 is the measured ceiling
ST.OFF_HOLD   = 0x120
ST.OFF_DIST   = 0x128
-- Candidate offset for RequiresLineOfSight, and it IS a candidate rather than a fact.
--
-- The layout around it is confirmed: +0x120 reads as HoldDuration, +0x124 holds 101 which
-- is KeyCode.E, and +0x128 is MaxActivationDistance - three anchors in a row. After those
-- sit three bytes that are 01 on every real prompt, which is what Enabled,
-- RequiresLineOfSight and ClickablePrompt all default to, and +0x135 is the one that reads
-- 00 on some non-egg prompts, so it is the one that varies per prompt.
--
-- Which of the three it actually is cannot be settled by reading, because all three are
-- true everywhere it matters. Trying to settle it by dumping every prompt in the workspace
-- failed for a different reason worth remembering: ClassName lies in this executor, and
-- that scan reported 97 egg-slot prompts where there are 8.
--
-- So this is behind its own toggle, defaults off, saves the original byte, and restores it.
-- If prompts stop appearing entirely when you switch it on, the byte was Enabled, not line
-- of sight - turn it off and say so, and the next candidate is +0x134.
ST.OFF_LOS    = 0x135
ST.NoLOS      = false
ST.orig       = ST.orig or {}   -- [address] = { hold = n, dist = n }
ST.origLOS    = ST.origLOS or {} -- [address] = original line-of-sight byte
-- [address] = when we last wrote it. The sweep repeats every 0.75s because prompts are
-- constantly recreated, but an address that was patched a moment ago and still answers is
-- the same object with the same values - rewriting it is six memory operations for nothing.
-- Measured at 65ms average per sweep before this, which is a hitch you can feel.
ST.doneAt     = ST.doneAt or {}
-- [address] = when we dropped its activation distance so it could not steal a grab.
-- Tracked separately so the sweep can tell "suppressed on purpose" from "never patched".
ST.suppressed = ST.suppressed or {}
-- How long a suppression outranks the sweep. Long enough to cover the press it was made
-- for (patch, read hold, tap, verify - a couple of hundred ms) and short enough that an
-- egg we suppressed is usable again almost immediately afterwards.
ST.SUPPRESS_TTL = 1.0
ST.REPATCH    = 3.0             -- seconds before an address is worth writing again
ST.sweepN     = 0
ST.offsetsOk  = true
ST.patched    = 0
ST.State      = "off"

-- Egg prompts live in TWO places, and for a long time this only knew about one.
--
--   55 sit under root-level SmartPromptPart, which is what this used to scan
--    8 sit under the egg slot model itself, at AreaEggSlotsClient.<guid>.Hitbox / .Part
--
-- The eight were never patched - they read back the untouched hold=-0.5 range=0 while
-- every other prompt on the map read 0 / 5. Walk up to one of those eggs and the instant
-- tap does nothing, so the grab falls through to holding E for its real duration: the
-- couple of seconds of standing in the egg before it finally lifts.
--
-- Still not a full descendant walk of workspace - that finds 175 prompts, mostly machines
-- and shops, and costs far more per sweep. Two known locations, both cheap.
--
-- `pos` is optional; with it, only prompts within `radius` are returned, each carrying the
-- distance from its OWNER part so callers can pick the nearest without measuring twice.
local function promptsNear(pos, radius)
    local out = {}
    local r = radius or math.huge
    local okc, kids = pcall(function() return workspace:GetChildren() end)
    if okc and kids then
        for _, c in ipairs(kids) do
            local okn, nm = pcall(function() return c.Name end)
            if okn and nm == "SmartPromptPart" then
                local okp, p = pcall(function() return c.Position end)
                local d = (okp and p and pos) and (p - pos).Magnitude or 0
                if not pos or (okp and p and d <= r) then
                    local okg, sub = pcall(function() return c:GetChildren() end)
                    if okg and sub then
                        for _, pr in ipairs(sub) do
                            -- EGG PROMPTS ONLY, BY NAME - and by name ALONE.
                            --
                            -- There used to be an `and ClassName == "ProximityPrompt"`
                            -- here, and it was quietly throwing eggs away. Counted live:
                            --
                            --   52 objects named CarryAreaEgg
                            --   44 of them report ClassName "ProximityPrompt"
                            --    8 of them report ClassName "Part"
                            --
                            -- Same name, same parent shape, same job - ClassName simply
                            -- reads wrong for some of them, which this file already knows
                            -- (it misreported the egg-slot prompts too). Those 8 were
                            -- never patched, so walking up to one of those eggs gave you
                            -- the full hold time while its neighbours took instantly.
                            -- That is the "only 3 of the 5 eggs near me are instant".
                            --
                            -- Dropping the check costs no safety: promptWritable() is the
                            -- real gate, and it reads the memory itself rather than
                            -- trusting a property. A non-prompt that sneaks in by name
                            -- fails there and is never written to.
                            local okn, nm2 = pcall(function() return pr.Name end)
                            if okn and (nm2 == "CarryAreaEgg" or ST.AnyPrompt) then
                                out[#out + 1] = { p = pr, d = d }
                            end
                        end
                    end
                end
            end
        end
    end
    local folder = workspace:FindFirstChild("AreaEggSlotsClient")
    if folder then
        local oks, slots = pcall(function() return folder:GetChildren() end)
        if oks and slots then
            for _, m in ipairs(slots) do
                local hb = m:FindFirstChild("Hitbox")
                local okp, p = pcall(function() return hb and hb.Position end)
                local d = (okp and p and pos) and (p - pos).Magnitude or 0
                if not pos or (okp and p and d <= r) then
                    local okd, desc = pcall(function() return m:GetDescendants() end)
                    if okd and desc then
                        for _, pr in ipairs(desc) do
                            -- By name here too, for the same reason as above.
                            local okn, nm2 = pcall(function() return pr.Name end)
                            if okn and (nm2 == "CarryAreaEgg" or ST.AnyPrompt) then
                                out[#out + 1] = { p = pr, d = d }
                            end
                        end
                    end
                end
            end
        end
    end
    return out
end

-- The background sweep only needs prompts you could plausibly reach before the next sweep.
-- Unbounded, it walked all 53 egg slots' descendants every 0.75s - measured at 41ms to find
-- zero prompts most of the time, since only a handful of slots own one. 400 studs is nearly
-- two seconds of running at full speed, so nothing can be reached before the next pass.
local function promptList()
    local out = {}
    local root = myRoot()
    local pos
    if root then
        local okp, p = pcall(function() return root.Position end)
        if okp then pos = p end
    end
    for _, e in ipairs(promptsNear(pos, pos and 400 or nil)) do out[#out + 1] = e.p end
    return out
end

-- The address is only safe to write while the prompt is still parented. Eggs are taken
-- and destroyed constantly, and writing a float into the memory of a freed prompt is a
-- good way to take the whole executor down - which is exactly the kind of crash that
-- appeared once grabs started patching three times each.
local function addrOf(p)
    local okpar, par = pcall(function() return p.Parent end)
    if not okpar or par == nil then return nil end
    local ok, a = pcall(function() return p.Address end)
    if ok and type(a) == "number" and a > 0x10000 then return a end
    return nil
end

-- THE CRASH GATE. Read before you write, and only write if what is there still looks like a
-- ProximityPrompt.
--
-- This is the fix for the crash that has come back about twenty-five times in different
-- disguises. Taking an egg destroys its prompt, and the patch sweep writes to prompt
-- addresses - so the write lands in memory the game freed a moment earlier, which is a
-- native crash that pcall cannot catch. Checking Parent first is not enough: the object can
-- be freed between the check and the write, and an address that was a prompt a second ago
-- can be anything now.
--
-- Measured on 54 live egg prompts: every one reads hold = 1.200. Patched ones read 0. The
-- reference script gates on the same idea, accepting 1.2 and 0.25. Freed and reused memory
-- reads as garbage - huge, negative, denormal - and fails this test, so the write never
-- happens. Real prompts whose struct we cannot parse (the slot-owned ones read -0.5) fail
-- it too, which is correct: if the layout does not look right, do not write into it.
local function promptWritable(a)
    if not a then return false end
    -- The KEY CODE is the real signature. All 54 live egg prompts read 101 at +0x124, which
    -- is Enum.KeyCode.E - the key you press to take an egg. Freed and reused memory reads 0
    -- or garbage there.
    --
    -- The hold time alone was not enough to gate on: an unrelated address happened to read
    -- 0.0, which is inside any sane range for a duration and would have been written to.
    -- Two fields agreeing is a much narrower coincidence than one.
    local okk, k = pcall(function() return memory_read("int", a + 0x124) end)
    if not okk or k ~= 101 then return false end
    local ok, h = pcall(function() return memory_read("float", a + ST.OFF_HOLD) end)
    if not ok or type(h) ~= "number" then return false end
    if h ~= h then return false end                 -- NaN
    return h >= 0 and h <= 5.0
end

local function patchPrompts()
    if not memory_write or not memory_read then
        ST.State = "memory_write unavailable"
        return
    end
    if not ST.offsetsOk then return end
    local n = 0
    ST.sweepN = (ST.sweepN or 0) + 1
    -- Verify on the first few sweeps and occasionally after. Its job is to catch the
    -- ProximityPrompt struct being reshuffled by a Roblox update, which is a permanent,
    -- once-ever event - not something worth two memory reads per prompt per 0.75s forever.
    local verify = (ST.sweepN <= 3) or (ST.sweepN % 20 == 0)
    local now = tick()
    for _, p in ipairs(promptList()) do
        local a = addrOf(p)
        -- Already written recently, and still answering, so it is the same object holding
        -- the same values. Skipping it is the difference between six memory operations and
        -- none, across every prompt in range, every 0.75 seconds.
        if a and (now - (ST.doneAt[a] or 0)) < ST.REPATCH then
            n = n + 1
            a = nil
        end
        -- Nothing is written to an address whose contents no longer look like a prompt.
        if a and not promptWritable(a) then
            ST.Rejected = (ST.Rejected or 0) + 1
            a = nil
        end
        -- LEAVE A SUPPRESSED PROMPT ALONE while its suppression is live. The sweep runs
        -- every 0.75s and suppressOthers deliberately forgets the address so it WILL be
        -- restored - but not before the press it was suppressed for. Without this the
        -- sweep handed the big neighbour its range back between the suppression and the
        -- keypress, which is a race the sweep usually won.
        if a and ST.suppressed[a] and (now - ST.suppressed[a]) < (ST.SUPPRESS_TTL or 1.0) then
            a = nil
        end
        if a then
            ST.doneAt[a] = now
            -- record the originals ONCE per address, before touching anything
            if not ST.orig[a] then
                local okh, h = pcall(function() return memory_read("float", a + ST.OFF_HOLD) end)
                local okd, d = pcall(function() return memory_read("float", a + ST.OFF_DIST) end)
                if okh and okd then ST.orig[a] = { hold = h, dist = d } end
            end
            pcall(function()
                memory_write("float", a + ST.OFF_HOLD, ST.Hold)
                memory_write("float", a + ST.OFF_DIST, ST.Dist)
            end)
            if ST.NoLOS then
                if ST.origLOS[a] == nil then
                    local okl, l = pcall(function() return memory_read("byte", a + ST.OFF_LOS) end)
                    if okl and type(l) == "number" then ST.origLOS[a] = l end
                end
                pcall(function() memory_write("byte", a + ST.OFF_LOS, 0) end)
            end
            local okv, h2, okv2, d2 = false, nil, false, nil
            if verify then
                okv, h2 = pcall(function() return memory_read("float", a + ST.OFF_HOLD) end)
                okv2, d2 = pcall(function() return memory_read("float", a + ST.OFF_DIST) end)
            end
            if okv and okv2 and h2 and d2 then
                if math.abs(h2 - ST.Hold) > 0.01 or math.abs(d2 - ST.Dist) > 0.01 then
                    ST.offsetsOk = false
                    ST.State = "OFFSETS MOVED - stopped, see console"
                    warn("[Steal An Egg] prompt offsets no longer hold their value.")
                    warn("[Steal An Egg] Roblox has probably reshuffled ProximityPrompt.")
                    warn(string.format("[Steal An Egg] wrote hold=%.2f dist=%.2f, read back %.2f / %.2f",
                        ST.Hold, ST.Dist, h2, d2))
                    warn("[Steal An Egg] Instant Steal disabled rather than writing blind.")
                    return
                end
            end
            n = n + 1
        end
    end
    -- Prune the seen-recently table. Prompts are recreated constantly with fresh addresses,
    -- so without this it grows for the life of the session.
    if ST.sweepN % 20 == 0 then
        for addr, at in pairs(ST.doneAt) do
            if (now - at) > 30 then ST.doneAt[addr] = nil end
        end
    end
    ST.patched = n
    ST.State = string.format("%d prompts patched (hold %.2fs, range %.0f)", n, ST.Hold, ST.Dist)
end

-- Patch the prompts around ONE spot, right now. The background sweep runs every couple
-- of seconds, which is fine for prompts that have been sitting there - but an egg that
-- just respawned (after a night reload, or after you died and it came back) can be
-- reached before the sweep has ever seen it, and an unpatched prompt still has its full
-- hold time and short reach. That is why some eggs simply would not be taken.
local function patchNear(pos, radius)
    if not memory_write or not pos then return 0 end
    if not ST.On or not ST.offsetsOk then return 0 end
    local n = 0
    for _, e in ipairs(promptsNear(pos, radius or 30)) do
        local a = addrOf(e.p)   -- nil once the prompt is gone
        -- Same gate as the sweep. This one runs at the exact moment an egg is being taken,
        -- which is precisely when its prompt is being destroyed, so it is the call site that
        -- was most likely to write into freed memory.
        if a and not promptWritable(a) then
            ST.Rejected = (ST.Rejected or 0) + 1
            a = nil
        end
        -- Same rule as the sweep: a live suppression outranks a re-patch.
        if a and ST.suppressed[a] and (tick() - ST.suppressed[a]) < (ST.SUPPRESS_TTL or 1.0) then
            a = nil
        end
        if a then
            if not ST.orig[a] then
                local okh, h = pcall(function() return memory_read("float", a + ST.OFF_HOLD) end)
                local okd, dd = pcall(function() return memory_read("float", a + ST.OFF_DIST) end)
                if okh and okd then ST.orig[a] = { hold = h, dist = dd } end
            end
            -- Write only. A "read first, write if different" version of this looked tidier
            -- and put roughly 144 memory_read calls per second onto prompt addresses that
            -- are freed constantly as eggs are taken - and the executor began crashing
            -- within a second of load. Reads happen at grab time only, against one prompt,
            -- checked for a parent.
            pcall(function()
                memory_write("float", a + ST.OFF_HOLD, ST.Hold)
                memory_write("float", a + ST.OFF_DIST, ST.Dist)
            end)
            if ST.NoLOS then
                if ST.origLOS[a] == nil then
                    local okl, l = pcall(function() return memory_read("byte", a + ST.OFF_LOS) end)
                    if okl and type(l) == "number" then ST.origLOS[a] = l end
                end
                pcall(function() memory_write("byte", a + ST.OFF_LOS, 0) end)
            end
            n = n + 1
        end
    end
    return n
end
_G.SEHUB_PATCHNEAR = patchNear

-- TAKE THE COMPETITION OUT OF RANGE. This is the answer to big eggs stealing the grab.
--
-- The game activates the CLOSEST ELIGIBLE prompt, and a 13.5 stud egg sitting over its
-- neighbours is closer to you than the small one you are standing on, however carefully
-- you aim. Standing inside the target (the 1.5 stud reach) and rotating the approach both
-- help and neither is decisive, because they are attempts to win a contest on position.
--
-- But eligibility is not physics, it is a float in the prompt's struct - the SAME float
-- this script already writes 15 into on every sweep, at ST.OFF_DIST. So rather than
-- out-positioning a big neighbour, make it ineligible: drop every OTHER prompt near the
-- target to an activation distance nothing can satisfy, press, and let the sweep put them
-- back. The target is the only prompt the game can still see.
--
-- 0.5 rather than 0, because 0 is ambiguous - in some Roblox versions it reads as "no
-- limit" rather than "no range", and a prompt that suddenly had infinite reach would be
-- the exact opposite of what this is for. 0.5 studs is unambiguous and unsatisfiable.
--
-- Safety is unchanged: same promptWritable gate, same addresses, same write, different
-- value. And the suppression is deliberately forgotten from ST.doneAt so the next sweep
-- restores it rather than skipping it as "done recently".
local function suppressOthers(pos, radius, keepPrompt)
    if not memory_write or not pos then return 0 end
    if not ST.On or not ST.offsetsOk then return 0 end
    local list = promptsNear(pos, radius or 25)
    -- the target's own prompt is the nearest one to the aim point
    local keep, keepD = keepPrompt, nil
    if not keep then
        for _, e in ipairs(list) do
            if not keepD or e.d < keepD then keepD, keep = e.d, e.p end
        end
    end
    local n = 0
    for _, e in ipairs(list) do
        if e.p ~= keep then
            local a = addrOf(e.p)
            if a and not promptWritable(a) then
                ST.Rejected = (ST.Rejected or 0) + 1
                a = nil
            end
            if a then
                if not ST.orig[a] then
                    local okh, h = pcall(function() return memory_read("float", a + ST.OFF_HOLD) end)
                    local okd, dd = pcall(function() return memory_read("float", a + ST.OFF_DIST) end)
                    if okh and okd then ST.orig[a] = { hold = h, dist = dd } end
                end
                pcall(function() memory_write("float", a + ST.OFF_DIST, 0.5) end)
                ST.doneAt[a] = nil          -- let the next sweep hand it back
                ST.suppressed[a] = tick()
                n = n + 1
            end
        end
    end
    ST.Suppressed = (ST.Suppressed or 0) + n
    return n
end
_G.SEHUB_SUPPRESS = suppressOthers

-- What hold time does the prompt at this spot ACTUALLY have right now? The patch does
-- not always take - a prompt created after the last sweep, or one the write missed -
-- and an unpatched prompt still wants its full hold, so a quick tap does nothing and
-- the egg looks immune. Reading the value back is the difference between guessing that
-- happened and knowing. Returns nil when it cannot be read at all.
-- The hold time of the prompt CLOSEST to this spot. Not the largest within a radius:
-- egg prompts sit only a few studs apart, so one unpatched neighbour made every slot
-- look unpatched. It reported 1.20 on a slot whose own prompt was patched to 0, which
-- would have used the slow fallback on nearly every grab.
local function holdTimeNear(pos, radius)
    if not memory_read or not pos then return nil end
    local bestD, bestPrompt
    for _, e in ipairs(promptsNear(pos, radius or 20)) do
        if not bestD or e.d < bestD then bestD, bestPrompt = e.d, e.p end
    end
    if not bestPrompt then return nil end
    local okpar, par = pcall(function() return bestPrompt.Parent end)
    if not okpar or par == nil then return nil end     -- gone since we found it
    local oka, a = pcall(function() return bestPrompt.Address end)
    if not oka or type(a) ~= "number" or a <= 0x10000 then return nil end
    local okh, h = pcall(function() return memory_read("float", a + ST.OFF_HOLD) end)
    if okh and type(h) == "number" then return h end
    return nil
end
_G.SEHUB_HOLDTIME = holdTimeNear

local function restorePrompts()
    if not memory_write then return end
    local n = 0
    for _, p in ipairs(promptList()) do
        local a = addrOf(p)
        if a and not promptWritable(a) then a = nil end
        local o = a and ST.orig[a]
        if a and o then
            pcall(function()
                memory_write("float", a + ST.OFF_HOLD, o.hold)
                memory_write("float", a + ST.OFF_DIST, o.dist)
            end)
            n = n + 1
        end
        if a and ST.origLOS[a] ~= nil then
            pcall(function() memory_write("byte", a + ST.OFF_LOS, ST.origLOS[a]) end)
        end
    end
    ST.State = string.format("restored %d prompts to original values", n)
    return n
end
-- exposed so the re-run guard of the NEXT load can undo this one's writes
_G.SEHUB_RESTORE = restorePrompts

-- "home", not "egg". The icon set this menu draws from does not have an egg, so the tab
-- rendered with a blank space where every other tab has a glyph.
local main = win:Tab("Main", "home")
local stealSec = main:Section("Instant Steal", "Full")
stealSec:Label("Removes the prompt hold time, letting you pick eggs up")
stealSec:Label("instantly. I wouldn't rely on this too much for auto-")
stealSec:Label("farming - it tends to stop working after a while.")
-- Handle kept so the boot block below can push the tick mark to match the real state.
-- Without that, pinning ST.On in code left the switch showing one thing while the script
-- did another - which is exactly what "the toggle said off but it was on" was.
local stealToggle
stealToggle = stealSec:Toggle("Instant Steal", true, function(v)
    ST.On = v
    if v then
        ST.offsetsOk = true
        ST.doneAt = {}        -- force a real write on the sweep after re-enabling
        patchPrompts()
    else
        restorePrompts()
        ST.doneAt = {}
    end
end, "ON by default. Removes the prompt hold time so eggs are taken the instant you press, and it is what lets the farm clear competing prompts out of range so a big egg cannot steal the grab. Applies continuously, since prompts are recreated as you move around.")
-- No Hold Time slider any more. It existed so instant steal could be softened if instant
-- turned out to be what got flagged, and it read 1.00s here - which is not a softer
-- instant steal, it is no instant steal at all. Nothing else in the menu can switch off
-- the feature the whole farm is built on, and a slider that silently does is a trap
-- whether it got there by a stray click or a restored value. ST.Hold stays 0; the Instant
-- Steal toggle above is the honest on/off.
-- 5, not 15, and this is a correction rather than a preference. Egg slots sit 6.7 studs
-- apart at the closest, so a 15 stud activation range makes four neighbouring eggs eligible
-- at once and leaves which one you get down to Roblox's tie-breaking. At 5 the maths is
-- decided instead of hoped for: standing 1.5 studs from the target puts its prompt about
-- 2.5 away (the prompt sits ~1 stud off its egg) and every neighbour at 5.2 or more, so
-- exactly one prompt is in range.
--
-- Bigger was assumed better because 15 was the measured ceiling - true, and irrelevant.
-- Reach is worth nothing if it cannot tell two eggs apart.
-- No Prompt Range slider either. It has exactly one correct value here: 5 keeps precisely
-- one egg in range at a time, because slots sit 6.7 studs apart and anything larger makes
-- the neighbours eligible and you take the wrong egg. It is pinned below.
-- Ignore Line of Sight has no toggle any more. It has been on all session, it is what
-- stops the camera direction deciding whether a grab works, and there is no situation
-- where you would want it off while Instant Steal is on - so it is simply part of what
-- Instant Steal does now, pinned in the boot block below.
ST.ui = stealSec:Label("off")

-- Building the menu fires every widget's callback, so the values the sliders hand back
-- are the last word regardless of what was assigned at the top of this file. That is how
-- Hold Time ended up at 1.00s and Prompt Range at 5 with nothing on screen admitting it.
-- Re-assert the settings the farm cannot work without, AFTER the UI has had its say, and
-- say so out loud rather than correcting it silently.
-- The menu does not merely fire its callbacks at build time - it REMEMBERS. Slider values
-- are persisted by label and replayed on load, so whatever a slider was last set to beats
-- whatever this file declares as its default, silently and forever. That is the single
-- mechanism behind every "the setting came back" problem in this script: Hold Time at 1.00s
-- killing instant steal, Escape Delay returning as 0.15, and Prompt Range loading as 15
-- after the default here was changed to 5.
--
-- So the two values that decide whether a grab works at all are pinned to a known-good
-- state on every load, loudly. The sliders still work normally once you are in-game; this
-- only controls where each session STARTS.
-- Dist has no slider any more, so this is the only thing setting it. On and NoLOS are
-- pinned for the same reason everything else here is: the menu remembers what a toggle was
-- last set to and replays it over the declared default, so without this Instant Steal came
-- back ON and Ignore Line of Sight came back OFF - both the opposite of what was asked for.
local STboot = { Hold = 0, Dist = 5, On = true, NoLOS = true }
for k, want in pairs(STboot) do
    if ST[k] ~= want then
        warn(string.format("[Steal An Egg] menu returned ST.%s=%s - starting at %s",
            k, tostring(ST[k]), tostring(want)))
        ST[k] = want
    end
end
-- AND PUSH IT BACK TO THE SWITCH. Pinning ST.On above only fixed the variable; the tick
-- mark kept whatever the menu had remembered, so the two could disagree - the toggle
-- reading off while instant steal was running, which is precisely what was reported.
-- Set() drives the visual, so from here the switch always tells the truth.
if stealToggle then pcall(function() stealToggle:Set(ST.On) end) end
if ST.On then pcall(patchPrompts) end


SESPAWN("prompt patch", function()
    while _G.SEHUB_GEN == GEN do
        local t0 = tick()
        if ST.On and ST.offsetsOk then patchPrompts() end
        PROFTICK("prompt patch", t0)
        -- 0.75s rather than 2s: eggs respawn constantly, and a prompt that appears just
        -- after a sweep was staying unpatched long enough to be reached and failed on.
        task.wait(0.75)
    end
end)

-- ==================== movement ====================
-- The Movement tab and its fly loop are gone. Flight was never usable here for the reason
-- discovered early on: in the egg areas, more than about a second off the ground gets you
-- snapped down and then killed, so a flight feature in a game about running between eggs on
-- the floor was a tab nobody could safely open.
--
-- The table stays because isRagdolled() checks _G.MOVE.Fly to avoid mistaking deliberate
-- upward motion for a fling. With nothing able to set it, that check is now always false -
-- harmless, and cheaper than hunting every reference.
_G.MOVE = _G.MOVE or {}
local MV = _G.MOVE
MV.Fly      = false
MV.State    = "off"

-- ==================== anti-boss ====================
-- Save a spot, return to it instantly. Ported from the reference script, which is
-- the one feature of its set that still works, and it works because it is a SHORT
-- hop - the long-range movement its other features needed is what got caught.
_G.ABOSS = _G.ABOSS or {}
local AB = _G.ABOSS
-- Set in the script rather than left for the user to record. This is the spot that
-- works: escapes land next to it and the run-in from there is what delivers an egg.
AB.Zone   = CFrame.new(537.9755, 70.5763, -371.0225)
-- ONE ATTEMPT, HELD LONG. This is the difference between an escape that costs you a life
-- every fourth use and one that costs you nothing. Measured, eight escapes each from ~650
-- studs, in the corridor, farm off:
--
--   5 attempts x 0.15s  ->  touched 2/8,  DIED 2/8
--   1 attempt  x 0.60s  ->  touched 3/8,  died 0/8
--
-- The kill risk rides on the NUMBER of rejected teleports, not on how long each one is
-- held - so retrying is the expensive thing, and holding is free. One long pin is both
-- safer and MORE likely to land than five short ones, which is the opposite of what the
-- retry loop assumed.
--
-- The kill itself is an anti-cheat instant kill, not a fall: health goes to -1000 while
-- the character is still standing in the corridor at normal height, belowSlab never
-- trips. It fires whether or not the touch actually landed - a missed attempt killed as
-- readily as a successful one - which is why cutting attempts matters more than anything
-- else here.
AB.Count  = 1          -- attempts per escape. More attempts = more deaths. Leave at 1.
-- 0.4, fixed. This was a slider and did not need to be: holding costs nothing (the kill
-- risk rides on how many separate teleports are fired, not how long each is held), so
-- there was never a reason to set it lower, and higher bought nothing measurable.
AB.Hold   = 0.40       -- seconds pinned at the zone, re-written every frame
AB.Delay  = 0.005      -- only used by teleportTo now; the touch writes every frame
AB.HoldFor = 6         -- seconds to keep re-planting you while a ragdoll is active
AB.Key    = "F1"
AB.State  = "no safe zone set"

-- THE TELEPORT IS CAPPED AT ~110 STUDS, and that single fact explains every "the
-- anti-boss is random" report. Measured here, standing still, interleaved so nothing
-- could drift between the two arms:
--
--    89,  92 (x5), 102, 108, 108, 111 studs -> HELD, 11 of 11
--   115, 115, 117 (x3), 125, 164, 239, 313, 417 -> NEVER APPLIED, 14 of 14
--
-- "Never applied" is literal: the write does not take even for one frame. It is not a
-- revert, not a race with ragdoll physics, and not a rate limit - 6 escapes fired 2s
-- apart at 92 studs all held, and a 45s rest changed nothing either way.
--
-- It is the SAME budget the run speed hits: ~290 studs/s of net displacement, over a
-- window of roughly 0.38s, which buys exactly one ~110 stud jump.
--
-- So an escape to a safe zone 500-3000 studs away - which is where you are during any
-- farming run - silently does nothing, every single time. It only ever worked when you
-- were already home, which is when you did not need it. AB.Count and AB.Delay never
-- helped because they only control how many times a rejected write is re-sent.
local ESC_MAXHOP = 100        -- 108 holds, 117 does not; 100 leaves margin

-- The playable corridor, so an escape never hops off the edge of it.
--
-- Measured from the egg slots, which are by definition standable ground:
--   X 591 .. 4805  (4214 studs)      Z -413 .. -311  (102 studs)
--
-- That shape is the whole reason hops have to be clamped, and it is worth stating plainly
-- because it caught out an earlier speed test too: the map is a long thin strip running
-- along X. There is essentially no room to move in Z.
--
-- Recomputed from live slots when there are enough of them, so a map change cannot leave
-- this stale; the measured numbers are the fallback for when the sweep has not run yet.
local PLAY_FALLBACK = { minx = 591, maxx = 4805, minz = -413, maxz = -311 }
local PLAY_CACHE, PLAY_AT = nil, 0
local function playBounds()
    if PLAY_CACHE and (tick() - PLAY_AT) < 30 then return PLAY_CACHE end
    local b, n = { minx = 1e9, maxx = -1e9, minz = 1e9, maxz = -1e9 }, 0
    local okS, slots = pcall(function() return _G.SEHUB_SLOTS and _G.SEHUB_SLOTS() or {} end)
    if okS and slots then
        for _, e in ipairs(slots) do
            local p = e.pos
            if p then
                n = n + 1
                if p.X < b.minx then b.minx = p.X end
                if p.X > b.maxx then b.maxx = p.X end
                if p.Z < b.minz then b.minz = p.Z end
                if p.Z > b.maxz then b.maxz = p.Z end
            end
        end
    end
    if n < 8 then b = PLAY_FALLBACK end
    -- Inset, so a hop lands ON the strip rather than on its lip.
    PLAY_CACHE = { minx = b.minx + 10, maxx = b.maxx - 10,
                   minz = b.minz + 10, maxz = b.maxz - 10 }
    PLAY_AT = tick()
    return PLAY_CACHE
end
_G.SEHUB_PLAYBOUNDS = function() return playBounds() end

-- ONE HOP PER STANDSTILL. Measured over 600 stud legs, from a dead stop:
--
--   run only    2.342 / 2.085 / 2.102 s   (avg 2.18)
--   1 hop + run 1.809 / 1.824 / 1.825 / 1.828 / 1.829 s   (avg 1.82)  <- 0.35s faster
--   2 hops      2.917 / 3.043 s                                       <- 0.8s SLOWER
--   3 hops      2.396 / 3.223 s                                       <- worse still
--
-- 0.35s is exactly 100 studs / 288 studs/s, so the first hop is genuinely free: standing
-- still banks displacement budget, and the hop spends what was already banked. The second
-- hop is not free, it is over budget, and the rubber-band that follows costs more than the
-- hop gained - the "2 hops landed" rows still finished LAST. Waiting longer before hopping
-- does not buy a second one either (3s of standstill was no better than 1.2s).
--
-- Hence the gate: every hop in the script goes through here, escape and headstart alike,
-- so a grab can never fire two. Without that, Auto Anti-Boss and the farm would each hop
-- on the same grab and the pair would be slower than neither.
-- WRITE IT MORE THAN ONCE, THEN CHECK IT TOOK. The first version of this fired a single
-- CFrame write, never looked, and counted every attempt as a success - so it reported 50
-- headstarts on 25 eggs while roughly a quarter of them were doing nothing at all, and the
-- catches that came from those were invisible in the numbers. Two separate causes, both
-- already documented elsewhere in this file and both ignored here:
--
--   a single write loses to ragdoll physics on the next step   (see teleportTo)
--   a hop into geometry is refused outright and moves you 0    (see the escape's retry)
--
-- So: plant it several times like every other teleport in this script, verify, and on a
-- refusal try again SHORTER along the same line. Shorter, not rotated - a blocked hop is
-- usually a hop into something, and backing off clears it while still making progress
-- toward home. Rotating is right for an escape, where survival beats direction; it is
-- wrong for a headstart, whose whole purpose is the progress.
--
-- Retrying is free: a hop that moved nothing spent none of the ~290 studs/s budget.
-- A HOP CAN LAND AND THEN BE TAKEN BACK. The first verification checked at 0.03s and
-- called that a success, but the escape measurements had already shown this exact shape:
--
--   from 161 studs -> at the zone at 0.05s and 0.15s, yanked back by 0.30s
--
-- So "it moved" is not the same as "it stuck", and a hop that is undone at 0.3s looks
-- identical to a good one at 0.15s while leaving you standing next to the egg you just
-- robbed. That is the failure that gets you caught, and the counter could not see it.
--
-- Hence a second look at 0.6s, and a budget check before hopping at all: the ~290 studs/s
-- allowance is a ROLLING one, so a hop taken moments after sprinting is spending studs
-- that are not there yet. HIST is the last second of positions, kept so the hop can ask
-- how much has already been used.
_G.SEHUB_HIST = _G.SEHUB_HIST or {}
local function histPush(p)
    local H = _G.SEHUB_HIST
    H[#H+1] = { t = tick(), x = p.X, z = p.Z }
    while #H > 40 and (tick() - H[1].t) > 1.2 do table.remove(H, 1) end
end
_G.SEHUB_HISTPUSH = histPush
-- How far we have moved over the last `secs`, and the span actually covered.
local function movedWithin(secs)
    local H = _G.SEHUB_HIST
    local newest = H[#H]
    if not newest then return 0, 0 end
    local now = tick()
    local oldest = H[1]
    for i = #H, 1, -1 do
        if (now - H[i].t) >= secs then oldest = H[i] break end
    end
    local span = newest.t - oldest.t
    if span <= 0.01 then return 0, 0 end
    return math.sqrt((newest.x-oldest.x)^2 + (newest.z-oldest.z)^2), span
end
_G.SEHUB_MOVEDIN = movedWithin

local lastHopAt = 0
local HOP_RETRY = { 0.70, 0.45, 0.25 }
local function hopToward(tx, tz, why)
    if (tick() - lastHopAt) < (AB.HopGap or 1.0) then return false end
    local root = myRoot()
    if not root then return false end
    local okp, me = pcall(function() return root.Position end)
    if not okp or not me then return false end
    local dx, dz = tx - me.X, tz - me.Z
    local m = math.sqrt(dx*dx + dz*dz)
    if m < 30 then return false end            -- practically there; nothing to win
    local B = playBounds()
    local F = _G.FARM or {}
    local full = math.min(ESC_MAXHOP, m)
    local function aim(dist)
        local nx, nz = me.X + (dx/m)*dist, me.Z + (dz/m)*dist
        if nx < B.minx then nx = B.minx elseif nx > B.maxx then nx = B.maxx end
        if nz < B.minz then nz = B.minz elseif nz > B.maxz then nz = B.maxz end
        return nx, nz
    end
    -- BUDGET CHECK. The allowance is rolling: over the last 0.6s the server will accept
    -- about 290 studs/s of net displacement, and whatever we already spent running is
    -- gone. Hopping the full 100 on top of a sprint is what gets the hop taken back a
    -- third of a second later. So hop only what is actually left, with a margin.
    local used, span = movedWithin(0.6)
    if span > 0.05 then
        local allowance = (290 * span) - used - 25      -- 25 studs of margin
        if allowance < full then full = allowance end
        if full < 25 then
            F.HopSkipped = (F.HopSkipped or 0) + 1
            F.LastHopSkip = string.format("%s: only %.0f studs of budget (used %.0f in %.2fs)",
                tostring(why), allowance, used, span)
            return false
        end
    end
    local nx, nz = aim(full)
    if math.sqrt((nx-me.X)^2 + (nz-me.Z)^2) < 20 then return false end

    lastHopAt = tick()
    F.HopTried = (F.HopTried or 0) + 1
    F.LastHeadstart = why
    F.HopUsedBefore = used
    local target = CFrame.new(nx, me.Y, nz)
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.CFrame = target
    end)

    task.spawn(function()
        -- Re-plant the full hop immediately, before judging it. This is the half the
        -- old code was missing: one write can simply be overridden, and calling that
        -- a blocked hop would send us shortening for no reason.
        for _ = 1, 2 do
            local r = myRoot()
            if r then
                pcall(function()
                    r.CFrame = target
                    r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end)
            end
            task.wait(AB.Delay or 0.005)
        end
        local landed, firstTry = false, false
        for attempt = 0, #HOP_RETRY do
            task.wait(0.03)
            local r = myRoot()
            if not r then return end
            local okq, p = pcall(function() return r.Position end)
            if not okq or not p then return end
            if math.sqrt((p.X-me.X)^2 + (p.Z-me.Z)^2) > 8 then
                landed, firstTry = true, (attempt == 0)
                target = CFrame.new(p.X, p.Y, p.Z)
                break
            end
            local f = HOP_RETRY[attempt + 1]
            if not f then break end
            local sx, sz = aim(full * f)
            target = CFrame.new(sx, me.Y, sz)
            pcall(function()
                r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                r.CFrame = target
            end)
        end
        -- Headstarts now counts hops that ACTUALLY MOVED YOU. HopTried counts attempts,
        -- HopFirst the ones that needed no retry: the gap between them is the failure
        -- rate that used to be unobservable.
        F.HopLanded  = (F.HopLanded  or 0) + (landed and 1 or 0)
        F.HopFirst   = (F.HopFirst   or 0) + (firstTry and 1 or 0)
        F.HopBlocked = (F.HopBlocked or 0) + (landed and 0 or 1)
        if landed then
            for _ = 1, math.max((AB.Count or 5) - 1, 1) do
                local r = myRoot()
                if r then
                    pcall(function() r.CFrame = target end)
                    pcall(function() r.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
                end
                task.wait(AB.Delay or 0.005)
            end
            -- THE SECOND LOOK. Far enough out to catch a server take-back, which lands
            -- around 0.3s. Counted separately, because a hop that is undone is worse
            -- than one that never fired: the farm believes it has a head start it does
            -- not have, and carries on as if it were 100 studs further away.
            task.wait(0.55)
            local r2 = myRoot()
            local okp2, p2 = pcall(function() return r2 and r2.Position end)
            if okp2 and p2 then
                local still = math.sqrt((p2.X-me.X)^2 + (p2.Z-me.Z)^2)
                if still > 8 then
                    F.HopHeld = (F.HopHeld or 0) + 1
                    F.Headstarts = (F.Headstarts or 0) + 1
                else
                    F.HopReverted = (F.HopReverted or 0) + 1
                    F.LastHopRevert = string.format("%s: hopped %.0f, back to %.0f after 0.6s (used %.0f before)",
                        tostring(why), full, still, F.HopUsedBefore or -1)
                end
            end
        end
    end)
    return true
end
_G.SEHUB_HOP = function(tx, tz, why) return hopToward(tx, tz, why) end

-- Where the threat is. Nearest live guard, or nil.
local function nearestGuardPos(me)
    local bx, bz, bd = nil, nil, 1e9
    for _, g in ipairs((_G.GUARDS or {}).list or {}) do
        local okm, mdl = pcall(function() return g.model end)
        if okm and mdl then
            local okp, par = pcall(function() return mdl.Parent end)
            if okp and par then
                local okr, r = pcall(function() return mdl:FindFirstChild("HumanoidRootPart") end)
                local okq, p = pcall(function() return r and r.Position end)
                if okq and p then
                    local d = math.sqrt((p.X - me.X)^2 + (p.Z - me.Z)^2)
                    if d < bd then bd, bx, bz = d, p.X, p.Z end
                end
            end
        end
    end
    return bx, bz, bd
end

-- One teleport, done the way that actually sticks: an immediate write, then repeats a
-- few milliseconds apart. A SINGLE write loses - the ragdoll physics simply overrides
-- it on the next step, which is why the forced escape appeared not to work at all
-- while the manual key (which came through here) worked every time.
local function teleportTo(cf, quiet)
    if not cf then return end
    local root = myRoot()
    if root then
        pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
        pcall(function() root.CFrame = cf end)
    end
    task.spawn(function()
        for _ = 1, math.max((AB.Count or 5) - 1, 1) do
            local r = myRoot()
            if r then
                pcall(function() r.CFrame = cf end)
                pcall(function() r.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
            end
            task.wait(AB.Delay)
        end
    end)
    AB.lastEscape = tick()
end
_G.SEHUB_TELEPORT = teleportTo

-- THE SAFE ZONE TOUCH. This is the exploit, and it does not need the teleport to stick.
--
-- The game drops the chase when it sees you at the safe zone - it treats having passed
-- there as having banked the egg. So all that has to happen is for the SERVER TO OBSERVE
-- ONE POSITION UPDATE at the zone. It then snaps you back (the distance is far past the
-- ~110 stud cap), you carry on running home from where you were, and the guard has lost
-- you. Going there and being thrown back is the whole trick, not a failure of it.
--
-- Which is why the earlier "0 of 14 escapes applied" measurement was answering the wrong
-- question. It checked where you ENDED UP 0.3 to 2 seconds later, and of course that is
-- back where you started - that is the anti-cheat doing exactly what this relies on. It
-- never checked whether the server saw the zone in between, which is the only thing that
-- matters.
--
-- So the failure mode is not distance. It is REPLICATION. Roblox sends the character's
-- position to the server roughly every 33-50ms, and the old escape wrote five times at
-- 0.01s apart - 50ms end to end. That can land entirely inside one replication gap, in
-- which case the server never sees the zone at all and the chase carries on. Same code,
-- same distance, works or does not purely on where the writes fall relative to the tick.
-- That is the randomness.
--
-- The fix is to HOLD the position across several ticks instead of flickering through it.
-- AB.Delay is now a replication tick rather than a fifth of one, so the default escape
-- spans ~5 ticks and the server cannot miss it.
local function gotoZone(quiet)
    if not AB.Zone then
        if not quiet then notify("Anti-Boss", "Set a safe zone first", 2) end
        AB.State = "no safe zone set"
        return
    end
    local root = myRoot()
    if not root then return end
    local okp, me = pcall(function() return root.Position end)
    if not okp or not me then return end
    local dHome = math.sqrt((AB.Zone.X - me.X)^2 + (AB.Zone.Z - me.Z)^2)

    -- The FIRST write happens right here, synchronously, before anything yields.
    -- Previously the whole thing went into task.spawn, so the escape did not begin
    -- until the scheduler came back round - and being flung and losing the egg takes
    -- less time than that.
    pcall(function()
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.CFrame = AB.Zone
    end)
    AB.Hops = (AB.Hops or 0) + 1

    task.spawn(function()
        -- PIN, DO NOT FLICKER. Measured, writing to the zone for 300ms at a time and
        -- sampling how long the character was actually there:
        --
        --   re-write every 0.040s ->   0ms,  200ms,   0ms
        --   re-write every 0.010s ->   0ms,  400ms,   0ms
        --   re-write every frame  -> 400ms,  380ms,   0ms
        --
        -- Between writes the anti-cheat drags you back, so a slow loop spends most of
        -- its time off the zone and the server samples you somewhere else. Writing every
        -- frame holds the position continuously, which is what a replication tick needs
        -- to land on. This is why the original 0.005s spacing worked more often than the
        -- 0.035s "one write per tick" that replaced it - the spacing was never the bug,
        -- the 50ms total duration was.
        --
        -- The zeroes in every column are the other half: sometimes the write is refused
        -- outright, whatever the spacing, and no amount of re-writing lands it. That is
        -- stochastic and roughly half the time. It cannot be prevented - but it CAN be
        -- detected, which is what the retry below is for. A touch that did not happen is
        -- now a retry instead of a silent failure.
        local reached, tries, bestFrames = false, 0, 0
        for attempt = 1, math.max(AB.Count or 5, 1) do
            tries = attempt
            local frames, t0 = 0, tick()
            while tick() - t0 < (AB.Hold or 0.35) do
                local r = myRoot()
                if r then
                    pcall(function()
                        r.CFrame = AB.Zone
                        r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    end)
                    local okq, p = pcall(function() return r.Position end)
                    if okq and p then
                        local d = math.sqrt((p.X-AB.Zone.X)^2 + (p.Z-AB.Zone.Z)^2)
                        if d < 25 then frames = frames + 1 end
                    end
                end
                task.wait()                      -- every frame, not every tick
            end
            if frames > bestFrames then bestFrames = frames end
            -- WHAT COUNTS AS ENOUGH DEPENDS ON RANGE, because the ceiling does. Measured
            -- across ten touches, holding for 0.35s each:
            --
            --   from   99 studs -> 7, 8, 9 frames   (inside the ~110 cap: pins freely)
            --   from  824 studs -> 2 frames
            --   from  923 studs -> 1 frame
            --   from 3762 studs -> 2 frames
            --
            -- Beyond the cap the server takes you back after a frame or two no matter how
            -- long the write loop runs, so 1-2 frames IS the ceiling out there and asking
            -- for 3 can never be satisfied - it just burns every retry. A frame is ~17ms
            -- and a replication tick 33-50ms, so two frames is a real chance of being
            -- seen and one is a coin flip; both are worth stopping for, and the retries
            -- are there for the attempts that land nothing at all.
            local need = (dHome <= ESC_MAXHOP) and 3 or 2
            if frames >= need then reached = true break end
            task.wait(0.12)                      -- let the refusal clear, then try again
        end
        AB.Touches = (AB.Touches or 0) + (reached and 1 or 0)
        AB.Missed  = (AB.Missed  or 0) + (reached and 0 or 1)
        AB.Tries   = (AB.Tries   or 0) + tries
        AB.LastTouch = string.format("%s after %d %s (%d frames at the zone, from %.0f studs)",
            reached and "TOUCHED" or "MISSED", tries,
            (tries == 1) and "try" or "tries", bestFrames, dHome)
        -- Nothing is written after this. The snap back to where you were IS the
        -- return leg, and fighting it would only keep you pinned at the zone.
    end)
    AB.lastEscape = tick()
    lastHopAt = tick()
    AB.LastHow = string.format("safe zone touch from %.0f studs", dHome)
    AB.State = AB.LastHow
    if not quiet then notify("Anti-Boss", "Touched the safe zone", 2) end
end

-- Exposed so the escape can be fired and measured without pressing the key.
_G.SEHUB_ESCAPE = function(quiet) return gotoZone(quiet) end

-- Shares the Main tab with Instant Steal now, rather than owning a tab for two controls.
