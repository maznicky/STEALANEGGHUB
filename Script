-- ---- egg identification ----
-- Every egg type has a template model in ReplicatedStorage.Assets.Models.Eggs, named
-- after its pet - 115 of them. World eggs are clones of those, so an egg can be
-- identified by shape. Nothing in the world says which is which: the slot is named with
-- a GUID, the models carry no labels, and ProximityPrompt.ObjectText reads nil. Shape is
-- the only channel there is.
--
-- Two earlier attempts at this were wrong, and both failed the same way - they threw
-- away the information that mattered:
--
--   1. Relative part VOLUMES. Matched the templates against each other well, but nothing
--      in the world, because world eggs are randomly scaled clones.
--   2. Aspect ratios of the three biggest parts. Scale-invariant, which fixed (1), but
--      the biggest part of every egg is the SHELL, and the shell is the same shape on
--      all of them - ax=1.721 az=0.980 turns up on eggs in seven different areas. So the
--      fingerprint was mostly measuring the one feature every egg shares, and whole
--      families scored 0.0000 against each other.
--
-- What actually identifies an egg is the DECORATION: how many extra parts are stuck to
-- the shell and their proportions. So the fingerprint is now every part, normalised by
-- the size of the largest one, and the part COUNT has to match exactly. Count alone is
-- most of the answer - in Cosmic, Centapede is 12 parts, Galaxy Gecko 5, La Vacca 7,
-- Cyclops Gorilla 9 - and the normalised sizes settle the rest.
--
-- This version was checked against ground truth rather than against itself. Every world
-- egg on the map matches some template with an error of exactly 0.0000 and a real margin
-- over the runner-up, the areas read as themed sets on their own (Volcano returns Lava
-- Iguana and Lava frog, Prehistoric returns Dodo, Pterodactyl and Ankylosaurus, Abyss
-- Ocean returns Orca, Swordfish and Parrotfish), and in Cosmic - the one area whose real
-- egg list is known - every name it produces is on that list.
--
-- Known limit: 29 of the 115 templates are empty shells in ReplicatedStorage with no
-- children at all (Unicorn, Void Dragon, Boss Egg and friends). Those can never be
-- matched, so eggs of those types come back nil rather than wrong.
-- KEPT IN _G SO IT SURVIVES A RELOAD. The templates live in ReplicatedStorage, and this
-- executor loses that service outright for long stretches - verified: game:GetChildren()
-- comes back without it, so no access path finds it, it is simply gone. While it is gone
-- nothing can be identified.
--
-- As a file-local this table was rebuilt from scratch on every reload, so reloading during
-- one of those windows threw away a perfectly good set of fingerprints and replaced it with
-- nothing: 76 templates one moment, 0 the next, with rarity features silently blind until
-- the service came back. _G outlives the reload, so the good copy is kept and only improved.
-- Bumped whenever the fingerprint RULE changes. The cache outlives a reload by design, so
-- without this a run carrying entries built under the old rule - including the Hitbox-only
-- one-part junk that matched everything at 0.000 - would keep them forever and the fix
-- would appear not to work. A mismatch throws the cache away and rebuilds.
local EGG_FP_VER = 2
_G.SEHUB_EGGFP = _G.SEHUB_EGGFP or { fp = nil, at = 0, done = false, stall = 0, ver = EGG_FP_VER }
local EGG_FP_C = _G.SEHUB_EGGFP
if EGG_FP_C.ver ~= EGG_FP_VER then
    EGG_FP_C.fp, EGG_FP_C.at, EGG_FP_C.done, EGG_FP_C.stall = nil, 0, false, 0
    EGG_FP_C.ver = EGG_FP_VER
end
local EGG_FP = EGG_FP_C.fp
local EGG_FP_AT, EGG_FP_DONE, EGG_FP_STALL = EGG_FP_C.at, EGG_FP_C.done, EGG_FP_C.stall

-- Every part, sorted biggest first, with X/Y/Z divided by the cube root of the biggest
-- part's volume. That normalisation makes it scale-invariant while keeping the relative
-- proportions BETWEEN parts, which is what the aspect-ratio version discarded.
-- GetDescendants, not GetChildren: the decorations are often nested a level down, and
-- reading only the top level is what made these models look like they had 2-5 parts.
local function eggFingerprint(m)
    if not m then return nil end
    -- PARENT CHECK FIRST, and it is not paranoia. This is handed models from the eggSlots
    -- cache, which can be up to a quarter second old, and eggs are destroyed constantly as
    -- other players take them. A destroyed instance answers some calls and crashes the
    -- executor on others - GetDescendants being one of the others - and a native crash is
    -- not something pcall can catch. Before the cache existed every model here came
    -- straight out of a fresh GetChildren and was live by construction.
    local okp, par = pcall(function() return m.Parent end)
    if not okp or par == nil then return nil end
    local parts = {}
    local okd, kids = pcall(function() return m:GetDescendants() end)
    if not okd or not kids then return nil end
    -- THE HITBOX IS EXCLUDED BY NAME, so a model whose names cannot be read excludes
    -- NOTHING - and the Hitbox is usually the one part still readable. The fingerprint then
    -- describes the BOUNDING BOX instead of the egg, which is a different shape entirely,
    -- and it is returned with full confidence because nothing about it looks like a failure.
    --
    -- Matcha signals a dead binding by returning the literal string "Unreadable_name" and an
    -- empty ClassName rather than by erroring, so pcall succeeds and the old guard passed
    -- straight through. Shark's template is in this state permanently - 11 descendants, 0
    -- readable, unchanged over 40 retries across four seconds - so it can never be
    -- fingerprinted at all, and every egg that "matched" it was something else.
    --
    -- Any unreadable child at all means the part list is a SUBSET of the real model, so the
    -- whole model is refused. A subset is not a weaker answer, it is a wrong one.
    --
    -- NOTE, because I got this wrong once and the fix was worse than the bug: a ONE-part
    -- fingerprint is NOT degenerate. The normaliser divides by the cube root of the largest
    -- part's VOLUME, not by the part itself, so a single part keeps its aspect ratio and
    -- stays perfectly identifiable - Crane, Chicken, Red Panda and DesertLark are all real
    -- one-part eggs. Rejecting them cost six identifications a sweep for no reason. What
    -- they cannot do is stand alone: Chicken and DesertLark have the same proportions, and
    -- a multi-part egg caught with only one part loaded would also land here. So one-part
    -- answers are kept but marked, and eggNameFor only accepts them when the area's own
    -- list agrees - see `solo` below.
    local unreadable = 0
    for _, c in ipairs(kids) do
        local okn, n = pcall(function() return c.Name end)
        if not okn or n == nil or n == "" or n == "Unreadable_name" then
            unreadable = unreadable + 1
        elseif n ~= "Hitbox" and n ~= "CustomBoundingBox" then
            local oks, s = pcall(function() return c.Size end)
            if oks and s and typeof(s) == "Vector3" and s.X > 0 and s.Y > 0 and s.Z > 0 then
                parts[#parts + 1] = s
            end
        end
    end
    if unreadable > 0 then return nil end
    if #parts == 0 then return nil end
    table.sort(parts, function(a, b) return a.X * a.Y * a.Z > b.X * b.Y * b.Z end)
    local big = parts[1]
    local k = (big.X * big.Y * big.Z) ^ (1 / 3)
    if k <= 0 then return nil end
    local out = {}
    for i, s in ipairs(parts) do out[i] = { s.X / k, s.Y / k, s.Z / k } end
    -- Marked, not rejected. A single part is a real shape but a weak witness, so the caller
    -- demands corroboration from the area list before trusting it.
    out.solo = (#parts == 1)
    return out
end

-- nil when the part counts differ. That is a feature: a 12-part Centapede must not be
-- allowed to half-match a 5-part Galaxy Gecko.
local function eggScore(a, b)
    if #a ~= #b then return nil end
    local sum = 0
    for i = 1, #a do
        sum = sum + math.abs(a[i][1] - b[i][1])
              + math.abs(a[i][2] - b[i][2])
              + math.abs(a[i][3] - b[i][3])
    end
    return sum / #a
end

local function buildEggFingerprints()
    -- ONLY CACHE A RESULT THAT HAS SOMETHING IN IT.
    --
    -- This used to read `if EGG_FP then return EGG_FP end`, and an empty table is truthy.
    -- So if the very first call landed while ReplicatedStorage was unreachable - which it
    -- intermittently is in this executor, the same DataModel decay that takes out Players
    -- and PlayerGui - it cached {} and every later call short-circuited on it. One
    -- transient failure at load permanently disabled egg identification for the whole
    -- session, and everything built on it went quietly inert: Rare Priority ranked every
    -- egg 0 and fell back to distance, the rift farm could not find its pets, and Always
    -- Target could never match a tier. Nothing errored, so it looked like the features
    -- were ignoring their settings rather than starving.
    --
    -- AND KEEP GOING UNTIL IT IS COMPLETE, not merely non-empty.
    --
    -- "Cache the first non-empty result" is still wrong, because the templates STREAM IN.
    -- Measured on a fresh join: the folder reported 115 children while only 20 of them had
    -- parts loaded well enough to fingerprint. Caching there locked identification to 17%
    -- of the egg types for the rest of the session - which does not look like a failure,
    -- it looks like Rare Priority working on some eggs and ignoring others.
    --
    -- So the cache is only final once the fingerprint count matches the folder's child
    -- count. Until then it rebuilds, at most once every few seconds so a partial folder
    -- cannot turn this into a per-call descendant walk.
    -- BOUNDED, because a rebuild is not cheap and "complete" is not reachable.
    --
    -- Measured: one rebuild walks 115 models and costs 162ms - a visible hitch. And the
    -- count can never match the folder, because 24 of the 115 templates have NO parts at
    -- all (they never finish streaming on this client), so a "retry until complete" rule
    -- would hitch every few seconds for the whole session. That is the freeze-mid-run
    -- behaviour, not a fix for it.
    --
    -- So it retries on a long interval and gives up once it stops improving: whatever has
    -- loaded by then is what identification gets. Measured progression on a fresh join,
    -- 20 -> 64, so the retry is worth having; chasing the last few is not.
    local nowT = tick()
    if EGG_FP and EGG_FP_DONE then return EGG_FP end
    if EGG_FP and (nowT - (EGG_FP_AT or 0)) < 10 then return EGG_FP end
    local okRS, RS = pcall(function() return game:GetService("ReplicatedStorage") end)
    if not okRS or not RS then return EGG_FP or {} end
    local ok, folder = pcall(function()
        return RS.Assets and RS.Assets.Models and RS.Assets.Models:FindFirstChild("Eggs")
    end)
    if not ok or not folder then return EGG_FP or {} end
    local okc, kids = pcall(function() return folder:GetChildren() end)
    if not okc or not kids then return EGG_FP or {} end
    EGG_FP_AT = nowT
    local built = {}
    for _, m in ipairs(kids) do
        local r = eggFingerprint(m)
        if r then built[#built + 1] = { name = tostring(m.Name), r = r } end
    end
    -- MERGE BY NAME, rather than keeping whichever single pass was biggest.
    --
    -- Bindings fail per-instance and independently: measured on one pass, Orca / Whale
    -- Shark / Finned Thresher all read as zero-part while Parrotfish and Swordfish read
    -- fine, and on the very next pass those three read 4 parts each. Taking the larger
    -- pass wholesale threw away every template the smaller pass had read successfully and
    -- the larger one happened to miss, so progress sawtoothed instead of accumulating.
    -- Merging makes the set monotonic - it only ever grows - which is also what lets the
    -- stall counter mean "nothing new is loading" instead of "this pass got unlucky".
    local before = EGG_FP and #EGG_FP or 0
    local merged, seen = {}, {}
    for _, e in ipairs(EGG_FP or {}) do
        if not seen[e.name] then seen[e.name] = true; merged[#merged + 1] = e end
    end
    for _, e in ipairs(built) do
        if not seen[e.name] then seen[e.name] = true; merged[#merged + 1] = e end
    end
    EGG_FP = merged
    if #EGG_FP > before then
        EGG_FP_STALL = 0            -- still improving, keep going
    else
        EGG_FP_STALL = (EGG_FP_STALL or 0) + 1
    end
    -- Done when everything loaded, or when two passes in a row found nothing new.
    EGG_FP_DONE = (#EGG_FP >= #kids) or (EGG_FP_STALL >= 2)
    -- Write the state back to the surviving copy, not just the locals.
    EGG_FP_C.fp, EGG_FP_C.at = EGG_FP, EGG_FP_AT
    EGG_FP_C.done, EGG_FP_C.stall = EGG_FP_DONE, EGG_FP_STALL
    _G.FARM.EggFP = string.format("%d of %d templates%s", #EGG_FP, #kids,
        EGG_FP_DONE and "" or " (still loading)")
    return EGG_FP
end

-- What each area can actually spawn, as internal template names. This is the only
-- outside knowledge in the file, and it is what turns the matcher from "a shape that
-- resembles X" into a real answer, because it is the one thing shape cannot supply: two
-- eggs built from identically proportioned parts are separated by where they are.
--
-- Sources: Cosmic came from the in-game list, Volcano and Abyss Ocean from the wiki.
-- Areas absent here still identify fine whenever the shape is unambiguous; they just
-- have no way to break a tie, so they return nil instead of guessing.
--
-- Some names differ between the display and the files, resolved by elimination against
-- the area list rather than by picking the nearest-looking template:
--   Cosmic Gecko Egg   -> Galaxy Gecko        Cosmic lists one gecko, Ash Gecko is Volcano's
--   Lava Gecko Egg     -> Ash Gecko           Volcano lists one gecko, Galaxy Gecko is Cosmic's
--   Cosmic Gorilla Egg -> Cyclops Gorilla     the other gorillas do not fit the part count
--   Cosmic Skeleton    -> Alien Skeleton Boss name structure only; UNCONFIRMED
--   Cosmic Dragon Egg  -> unknown             every candidate dragon template is empty
--
-- EMPTY: 29 of the 115 templates have no children in ReplicatedStorage and can never be
-- matched, so eggs of those types come back nil rather than wrong. On these three lists
-- that is Unicorn, Phoenix, Beluga Whale and Kraken.
--
-- Worth knowing about the pairs that matter for the current rotation: Orca and Whale
-- Shark are both 4-part Abyss Ocean eggs but sit 1.04 apart, so they are never confused.
-- Ash Gecko and Chimpanzee are 0.0001 apart - genuinely identical to this metric - and
-- only Volcano's list separates them.
-- Deliberately EMPTY. seedAreaEggs() fills all eleven areas from AREA_DISPLAY at load, and
-- harvestPetIndex() overwrites that with the game's own ordering once the Pet Index has
-- been opened. This used to hold a hand-typed fallback for three areas, from before the
-- eleven-area table existed, and seedAreaEggs replaced it wholesale so nobody noticed it
-- had gone stale. It no longer replaces - it merges, so that a transient read failure
-- cannot drop a template - and the stale entries promptly came back from the dead: Abyss
-- Ocean ended up with NINE eggs, the eighth being "Shark", a template that cannot be
-- fingerprinted at all and whose slot is really Finned Thresher.
local AREA_EGGS = {}

-- Best-scoring template, but only when the answer is CLEAR: a low error and a real
-- margin over the runner-up. Anything else returns nil - "unknown" is a useful answer
-- and a wrong name is not.
--
-- An earlier version resolved ambiguity by preferring whichever candidate happened to be
-- a rift target. That is confirmation bias in code - it reported a Frog egg in Cosmic as
-- a Centapede purely because Centapede was what we wanted, and produced a confident "4
-- Centapede eggs" that was not real. The tie-break below asks a different question: not
-- "which of these do we want" but "which of these can spawn here", against a list that
-- came from the game rather than from our hopes.
--
-- Being wrong here stays cheap by design: the rift farm only runs in the areas its pets
-- come from and takes every egg there eventually, so identification changes the ORDER it
-- visits slots and nothing else.
local EGG_MAXERR, EGG_MARGIN = 0.01, 0.002
local function eggNameFor(model, area)
    local list = buildEggFingerprints()
    local r = eggFingerprint(model)
    if not r or #list == 0 then return nil end
    local fits = {}
    for _, t in ipairs(list) do
        local s = eggScore(r, t.r)
        if s and s <= EGG_MAXERR then fits[#fits + 1] = { name = t.name, s = s } end
    end
    if #fits == 0 then return nil end
    table.sort(fits, function(a, b) return a.s < b.s end)
    local allow = area and AREA_EGGS[area]

    if #fits == 1 or (fits[2].s - fits[1].s) >= EGG_MARGIN then
        -- A confident answer the area list has never heard of is NOT overruled here, and
        -- that has now paid for itself. Abyss Ocean kept producing a confident "Finned
        -- Thresher", a template its list did not contain; overruling it would have quietly
        -- relabelled the egg and destroyed the evidence. Trusting it and RECORDING the
        -- disagreement is what exposed the real fault - the list was wrong, not the match.
        -- The game's own Pet Index has that slot as "Shark", a template which exists but
        -- is permanently unreadable, so the egg really is a Finned Thresher and the alias
        -- now says so. Keep this branch honest: report the disagreement, do not hide it.
        if allow then
            local ok = false
            for _, want in ipairs(allow) do
                if fits[1].name == want then ok = true break end
            end
            if not ok then
                -- A SOLO fingerprint is the one case where the area list outranks the
                -- shape, because one part is also what a half-loaded multi-part egg looks
                -- like. Unidentified is cheap; a wrong name propagates into Rare Priority
                -- and Always Target and sends the farm to the wrong egg.
                if r.solo then return nil end
                _G.FARM.EggOdd = _G.FARM.EggOdd or {}
                _G.FARM.EggOdd[area .. ": " .. fits[1].name] = true
            end
        elseif r.solo then
            return nil    -- no list to corroborate against, so a one-part answer is a guess
        end
        return fits[1].name
    end

    -- Shape shared by more than one template; only location separates them.
    if allow then
        for _, want in ipairs(allow) do
            for _, c in ipairs(fits) do
                if c.name == want then return c.name end
            end
        end
    end
    return nil    -- ambiguous and nothing local to break the tie
end
-- Exposed for diagnosis. The matcher has now twice disagreed with a probe reimplementing
-- the same maths, and guessing at the difference costs more than exposing it does.
_G.SEHUB_NAMEFOR = function(model, area) return eggNameFor(model, area) end
_G.SEHUB_FPCOUNT = function() return #buildEggFingerprints() end

