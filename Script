diagSec:Button("Check Rift Progress", function()
    local live = refreshRiftTargets()
    local have, total, held = _G.SEHUB_RIFT()
    print(string.format("---- rift pets: %d of %d  (%s) ----", have, total,
        live and "read from the rift panel" or "GUI unreadable, using configured list"))
    if FM.RiftRotate then print("   " .. tostring(FM.RiftRotate)) end
    print("   banner: " .. tostring(FM.RiftBanner or FM.RiftBannerGuess or "unreadable"))
    print("   areas:  " .. tostring(FM.RiftAreaNote or "not set"))
    for _, t in ipairs(FM.RiftTargets or {}) do
        print(string.format("   [%s] %-14s %-10s from %-12s egg: %s",
            held[t.name] and "x" or " ", t.name, tostring(t.rarity or "?"),
            tostring(t.area), tostring(t.egg)))
    end
    print(string.format("   egg types identified on the map: %d", FM.EggIdent or 0))
    local seen = {}
    for _, nm in pairs(FM.eggName or {}) do seen[nm] = (seen[nm] or 0) + 1 end
    for _, t in ipairs(FM.RiftTargets or {}) do
        print(string.format("   %-14s eggs currently spawned: %d",
            tostring(t.egg), seen[t.egg] or 0))
    end
    -- Eggs identified confidently in an area whose list does not mention them. Either the
    -- list is incomplete or the match is wrong, and both are worth knowing about.
    local odd = {}
    for k in pairs(FM.EggOdd or {}) do odd[#odd + 1] = k end
    if #odd > 0 then
        table.sort(odd)
        print("   not on the area's known egg list: " .. table.concat(odd, ", "))
    end
    if have < total then print("   still farming") else print("   ALL THREE - rift is ready") end
end, "Lists the three pets, which you already hold, and how many of their eggs are on the map right now.")

diagSec:Button("Show Egg Rarities", function()
    local tbl, rank = _G.SEHUB_RARITY()
    local rows = {}
    for name, tier in pairs(tbl) do
        rows[#rows + 1] = { n = name, t = tier, r = rank[string.lower(tier)] or 0 }
    end
    table.sort(rows, function(a, b)
        if a.r ~= b.r then return a.r > b.r end
        return a.n < b.n
    end)
    print(string.format("---- known egg rarities: %d (%d learned from the rift panel) ----",
        #rows, FM.RarityLearned or 0))
    for _, r in ipairs(rows) do
        print(string.format("   %-2d %-10s %s", r.r, r.t, r.n))
    end
    local seen = {}
    for _, nm in pairs(FM.eggName or {}) do seen[nm] = (seen[nm] or 0) + 1 end
    local live = {}
    for nm, c in pairs(seen) do
        live[#live + 1] = { n = nm, c = c, t = tbl[nm], r = rank[string.lower(tbl[nm] or "")] or 0 }
    end
    table.sort(live, function(a, b) if a.r ~= b.r then return a.r > b.r end return a.n < b.n end)
    print("   ---- on the map now ----")
    if #live == 0 then print("   (nothing identified - Rare Priority or the rift farm must be on)") end
    for _, l in ipairs(live) do
        print(string.format("   %-10s x%d  %s", l.t or "unknown", l.c, l.n))
    end
end, "Every egg type whose rarity is known, rarest first, plus what is currently spawned. The table fills itself in as the rift panel names new pets.")

