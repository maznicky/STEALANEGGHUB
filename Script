-- The Movement tab and its fly loop are gone. Flight was never usable here for the reason
-- discovered early on: in the egg areas, more than about a second off the ground gets you
-- snapped down and then killed, so a flight feature in a game about running between eggs on
-- the floor was a tab nobody could safely open.
--
-- The table stays because isRagdolled() checks _G.MOVE.Fly to avoid mistaking deliberate
-- upward motion for a fling. With nothing able to set it, that check is now always false -
-- harmless, and cheaper than hunting every reference.
_G.MOVE = _G.MOVE or {}
local MV = _G.MOVE
MV.Fly      = false
MV.State    = "off"

-- ==================== anti-boss ====================
-- Save a spot, return to it instantly. Ported from the reference script, which is
-- the one feature of its set that still works, and it works because it is a SHORT
-- hop - the long-range movement its other features needed is what got caught.
_G.ABOSS = _G.ABOSS or {}
local AB = _G.ABOSS
-- Set in the script rather than left for the user to record. This is the spot that
-- works: escapes land next to it and the run-in from there is what delivers an egg.
AB.Zone   = CFrame.new(537.9755, 70.5763, -371.0225)
AB.Count  = 5          -- repeats, to beat a single rejected write
AB.HoldFor = 6         -- seconds to keep re-planting you while a ragdoll is active
AB.Delay  = 0.005
AB.Key    = "F1"
AB.State  = "no safe zone set"

-- One teleport, done the way that actually sticks: an immediate write, then repeats a
-- few milliseconds apart. A SINGLE write loses - the ragdoll physics simply overrides
-- it on the next step, which is why the forced escape appeared not to work at all
-- while the manual key (which came through here) worked every time.
local function teleportTo(cf, quiet)
    if not cf then return end
    local root = myRoot()
    if root then
        pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
        pcall(function() root.CFrame = cf end)
    end
    task.spawn(function()
        for _ = 1, math.max((AB.Count or 5) - 1, 1) do
            local r = myRoot()
            if r then
                pcall(function() r.CFrame = cf end)
                pcall(function() r.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
            end
            task.wait(AB.Delay)
        end
    end)
    AB.lastEscape = tick()
end
_G.SEHUB_TELEPORT = teleportTo

local function gotoZone(quiet)
    if not AB.Zone then
        if not quiet then notify("Anti-Boss", "Set a safe zone first", 2) end
        AB.State = "no safe zone set"
        return
    end
    -- The FIRST write happens right here, synchronously, before anything yields.
    -- Previously the whole thing went into task.spawn, so the escape did not begin
    -- until the scheduler came back round - and being flung and losing the egg takes
    -- less time than that. Everything after this is just insurance.
    local root = myRoot()
    if root then
        pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
        pcall(function() root.CFrame = AB.Zone end)
    end
    task.spawn(function()
        for _ = 1, math.max((AB.Count or 5) - 1, 1) do
            local r = myRoot()
            if r then
                pcall(function() r.CFrame = AB.Zone end)
                pcall(function() r.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
            end
            task.wait(AB.Delay)
        end
    end)
    AB.lastEscape = tick()
    AB.State = "escaped to safe zone"
    if not quiet then notify("Anti-Boss", "Teleported to safe zone", 2) end
end

-- Shares the Main tab with Instant Steal now, rather than owning a tab for two controls.
local bossSec = main:Section("Anti-Boss", "Full")
bossSec:Label("Quickly teleports you to the safe zone and back so the")
bossSec:Label("boss stops chasing you.")
bossSec:Button("Set Safe Zone", function()
    local root = myRoot()
    if not root then
        notify("Anti-Boss", "Character not found", 2)
        return
    end
    local ok, cf = pcall(function() return root.CFrame end)
    if ok and cf then
        AB.Zone = cf
        local p = cf.Position
        AB.State = string.format("saved at %d, %d, %d", p.X, p.Y, p.Z)
        notify("Anti-Boss", "Safe zone saved", 2)
    else
        notify("Anti-Boss", "Could not read your position", 2)
    end
end, "Saves where you are standing right now. A safe zone is already set in the script - the spot the farm uses for escapes and deliveries - so this only overrides it. Keep it close: short hops have always held, while one 350 stud jump was dragged back after a second.")
-- The teleport-repeat slider lives in the Auto Farm section, next to Anti-Boss Delay,
-- because that is where the anti-boss is actually tuned. One control, not two: a second
-- slider writing the same value is how Hold Time ended up at 1.00s with nothing on screen
-- admitting it.
AB.ui = bossSec:Label("no safe zone set")
AB.keyUi = bossSec:Keybind("Escape Key", "F1", function(k) AB.Key = k end,
    "Fires on press, not hold.")

-- InputBegan is the ONLY event that connects under Matcha - :Connect on Instances
-- does not work at all - so the hotkey is driven from it, with a polled fallback
-- because keyboards drop keys while other keys are held.
do
    local ok, UIS = pcall(function() return game:GetService("UserInputService") end)
    if ok and UIS then
        pcall(function()
            local conn = UIS.InputBegan:Connect(function(input)
                if _G.SEHUB_GEN ~= GEN then return end
                pcall(function()
                    if keyMatches(input, tostring(AB.Key or "F1")) then gotoZone() end
                end)
            end)
            _G.SEHUB_CONN = conn
        end)
    end
end
SESPAWN("escape key", function()
    local wasDown = false
    while _G.SEHUB_GEN == GEN do
        local down = keyDown(tostring(AB.Key or "F1"))
        if down and not wasDown and AB.Zone then gotoZone() end
        wasDown = down
        task.wait(0.05)
    end
end)

-- ==================== auto farm ====================
-- A GROUND RUNNER, and that is not a stylistic choice - it is the only thing the egg
-- areas allow. Measured, in the area itself:
--
--   airborne              snapped back to the floor every ~1.5s, then KILLED at 7.3s
--   6 studs under         physics ejects you back to the surface within a second
--   25 studs under        dead in 0.1 seconds
--
-- At spawn none of that happens - 12s at 60 studs up, and 18 studs underground, both
-- fine - so the check is scoped to the egg areas. Underground travel was the plan and
-- it is simply not available: the only two states are "inside the slab", where you get
-- pushed out, and "below it", where you die instantly. There is no gap to live in.
--
-- What IS free is horizontal speed while touching the ground. So: run, do not fly, and
-- keep a small downward bias so a bump never counts as air time.
_G.FARM = _G.FARM or {}
local FM = _G.FARM
FM.On        = false
FM.Speed     = 220        -- ground speed; 320 is the measured ceiling, this leaves room
FM.Stick     = 18         -- downward bias, studs/s, to guarantee floor contact
-- Close enough to be standing INSIDE the egg, and that is not a preference - it is what
-- makes the game hand you the right prompt.
--
-- Measured: egg slots sit 6.7 studs apart at the closest, median 7.2, and the prompt sits
-- on the egg (0.97 studs off it, median). Roblox activates the CLOSEST eligible prompt, so
-- at the old 5 stud reach a neighbour could be 6.7 - 5 = 1.7 studs away - nearer than the
-- egg being aimed at - and you would take the wrong one. That is the whole bug.
--
--   stand 5.0 away -> nearest neighbour >= 1.7   (loses, frequently)
--   stand 1.5 away -> nearest neighbour >= 5.2   (wins by 3.5 studs)
