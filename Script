    print("   banner: " .. tostring(FM.RiftBanner or FM.RiftBannerGuess or "unreadable"))
    print("   areas:  " .. tostring(FM.RiftAreaNote or "not set"))
    for _, t in ipairs(FM.RiftTargets or {}) do
        print(string.format("   [%s] %-14s %-10s from %-12s egg: %-22s %s",
            held[t.name] and "x" or " ", t.name, tostring(t.rarity or "?"),
            tostring(t.area), tostring(t.egg),
            _G.SEHUB_OWNS(t.name) and "OWNED - not prioritised" or "still wanted"))
    end
    print(string.format("   egg types identified on the map: %d", FM.EggIdent or 0))
    local seen = {}
    for _, nm in pairs(FM.eggName or {}) do seen[nm] = (seen[nm] or 0) + 1 end
