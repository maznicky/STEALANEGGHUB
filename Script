-- ==================== Steal An Egg Hub ====================
-- Built on the AR2 Hub core: re-run guard, loop supervisor, drawing registry,
-- validated library loader. Those exist because of specific failures, and the
-- comments explaining why are kept rather than rewritten - see each block.
--
-- What this executor can and cannot do, MEASURED in this game, not assumed:
--
--   CFrame writes        WORK, but a SINGLE write loses - ragdoll physics
--                        overrides it on the next step, so write it 3x a few
--                        ms apart (see teleportTo).
--                        SCOPED: the long hops in the note this replaces were
--                        measured at spawn, which is outside the check. Re-run
--                        inside an egg area, 60 studs holds exactly (0.00
--                        error), 150 and 300 revert having gained nothing, and
--                        600 reverts AND kills. Snap the final approach; never
--                        try to snap the journey.
--                        CFrame.new(Vector3) DOES NOT EXIST here - it takes 0,
--                        3, 6 or 12 numbers. The 6-arg form is (pos, lookAt),
--                        verified against LookVector.
--   Velocity writes      WORK, and there IS a ceiling - the earlier "none
--                        found" only ever tested 205. In an egg area:
--                        220 -> 207 actual, 260 -> 250, 300 -> 288, and then
--                        320 -> 42 (rubber-banded) and 430 -> dead.
--   THE ONE NUMBER       The server allows ~290 studs/s of NET DISPLACEMENT in
--                        the egg areas and enforces it identically against
--                        velocity, chained CFrame snaps, and single hops.
--                        Bursting is strictly worse than steady: 900 studs/s
--                        for 0.25s in every 1s averaged 37 studs/s, against
--                        282 for a flat 300. There is no trick under it.
--   Flight               WORKS. Climbed 135 studs in 3s, descended, landed at
--                        the starting height on full health. Zero vertical
--                        velocity still drifts down ~12 studs/s, so holding an
--                        altitude needs a small positive Y every tick.
--   WalkSpeed            NOT writable. "Unknown property: WalkSpeed".
--   Humanoid:Move        Missing.
--   HoldDuration etc     NOT writable as properties. Reads return nil, writes
--                        error. The memory route is the only one that works.
--   InputHoldBegin/End   Missing on ProximityPrompt.
--   fireproximityprompt  Missing.
--   workspace:Raycast    Returns nil always. No ground-height queries, so a
--                        landing has to be detected by altitude going still.
--   Hooking              ENTIRELY ABSENT - no hookfunction, hookmetamethod,
--                        getnamecallmethod, getrawmetatable, getconnections,
--                        and debug carries none of the useful members. Nothing
--                        that works by intercepting traffic can be built here.
--
-- Everything starts DISABLED.

-- ---------------- re-run guard ----------------
-- Loading this script a second time (which a loadstring URL makes easy) would
-- otherwise stack a second copy of every task.spawn loop and a second UI window
-- on top of the first. Bumping the generation makes every loop from the previous
-- load exit on its next tick.
_G.SEHUB_GEN = (_G.SEHUB_GEN or 0) + 1
local GEN = _G.SEHUB_GEN
if GEN > 1 then
    print(string.format("[Steal An Egg] reload #%d - retiring previous instance", GEN))
    -- Hand back anything the previous generation was holding open. Prompt
    -- patches are memory writes, so a reload that forgets them leaves the game
    -- permanently modified with nothing tracking it.
    if _G.SEHUB_RESTORE then pcall(_G.SEHUB_RESTORE) end
    if _G.SEHUB_WIN then
        for _, m in ipairs({ "Destroy", "Unload", "Close", "Remove" }) do
            pcall(function() _G.SEHUB_WIN[m](_G.SEHUB_WIN) end)
        end
        _G.SEHUB_WIN = nil
    end
    if setrobloxinput then pcall(function() setrobloxinput(true) end) end
    task.wait(0.2)
end

-- ---------------- loop supervisor ----------------
-- Every feature runs in its own task.spawn loop, and an error inside one kills it
-- outright - no message, no restart, the feature simply stops while the rest of the
-- menu carries on looking fine. That is what "the script crashed" turned out to mean
-- more than once in AR2: one stale instance read, one dead loop.
-- Bisect switch. Set _G.SEHUB_SKIP = { ["night watch"] = true, ... } BEFORE loading and
-- those loops never start. Added because the executor began crashing within a second of
-- load and no amount of reading the code found it - with ten background loops, arguing
-- about which one is at fault is slower than switching them off one at a time.
_G.SEHUB_SKIP = _G.SEHUB_SKIP or {}
_G.SEHUB_LOOPS = {}
-- ---------------- tick profiler ----------------
-- Added because the freezes have now survived two rounds of fixing the thing I ASSUMED was
-- slow. Both times the number that convinced me came from a probe I wrote to imitate the
-- real function, not the function itself, and both times the imitation was wrong - once by
-- doing a descendant walk the real code never does.
--
-- This times the real loops in place, while you play, and keeps the worst tick plus what
-- the farm was doing at that moment. Cost is two tick() calls per iteration.
_G.SEHUB_SLOW = _G.SEHUB_SLOW or {}

-- Waiting is not working, and conflating the two is how the first reading lied. farmStep
-- sleeps inside itself - 0.2s when the farm is off, 0.03s between phases - so timing the
-- call end to end reported a 0.2 second nap as a 200ms stall. PWAIT accumulates time spent
-- asleep so PROFTICK can subtract it and report CPU only.
local PWAIT_ACC = 0
local function PWAIT(t)
    local a = tick()
    local r = task.wait(t)
    PWAIT_ACC = PWAIT_ACC + (tick() - a)
    return r
end
local function PROFRESET() PWAIT_ACC = 0 end
-- Shadowing `task` with this inside farmStep routes its dozen-odd task.wait calls through
-- PWAIT with a single line, instead of rewriting every call site and getting one wrong.
local PROF_TASK = { wait = PWAIT, spawn = task.spawn, delay = task.delay, defer = task.defer }

-- `sub` only for the loop that actually routes its waits through PWAIT. The accumulator is
-- shared, and subtracting it from a loop that never touched it charged the farm's sleep
-- against whoever measured next - which is why every loop suddenly showed a second-long
-- maximum at the same time.
local function PROFTICK(name, t0, sub)
    local ms = (tick() - t0) * 1000
    if sub then ms = ms - PWAIT_ACC * 1000 end
    if ms < 0 then ms = 0 end
    local e = _G.SEHUB_SLOW[name]
    if not e then
        e = { n = 0, total = 0, max = 0, over50 = 0, over150 = 0, maxState = "?" }
        _G.SEHUB_SLOW[name] = e
    end
    e.n, e.total = e.n + 1, e.total + ms
    if ms > e.max then
        e.max = ms
        e.maxState = tostring((_G.FARM or {}).State)
    end
    if ms > 50 then e.over50 = e.over50 + 1 end
    if ms > 150 then e.over150 = e.over150 + 1 end
end

local function SESPAWN(name, fn)
    if _G.SEHUB_SKIP[name] then
        print("[Steal An Egg] skipping loop: " .. name)
        return
    end
    -- The restart budget DECAYS. It used to be a plain counter that never reset: five
    -- errors spread over an entire session - even hours apart, even from five unrelated
    -- one-off hiccups - retired the loop permanently, and a retired farm loop looks
    -- exactly like "the auto-farm randomly stopped". Five failures in quick succession is
    -- a broken loop worth giving up on; five failures across two hours is a loop that has
    -- been working fine. Only the first deserves to be stopped.
    --
    -- So a loop that survives a full minute is considered recovered and gets its budget
    -- back. The error itself is kept in _G.SEHUB_LOOPERR either way, because the thing
    -- that made this hard to diagnose was that a dead loop left nothing behind to read.
    local restarts = 0
    _G.SEHUB_LOOPERR = _G.SEHUB_LOOPERR or {}
    task.spawn(function()
        while _G.SEHUB_GEN == GEN do
            local startedAt = tick()
            local ok, err = pcall(fn)
            if ok then return end
            if _G.SEHUB_GEN ~= GEN then return end
            local ranFor = tick() - startedAt
            if ranFor > 60 then restarts = 0 end
            restarts = restarts + 1
            _G.SEHUB_LOOPS[name] = (_G.SEHUB_LOOPS[name] or 0) + 1
            _G.SEHUB_LOOPERR[name] = string.format("%s  (after %.0fs, restart %d)",
                tostring(err), ranFor, restarts)
            if restarts > 5 then
                warn(string.format("[Steal An Egg] '%s' died %d times in a row, leaving it stopped: %s",
                    name, restarts, tostring(err)))
                return
            end
            warn(string.format("[Steal An Egg] '%s' errored after %.0fs (restart %d): %s",
                name, ranFor, restarts, tostring(err)))
            task.wait(0.5)
        end
    end)
end

-- ---------------- Drawing registry ----------------
-- ONLY OUR OWN DRAWINGS. This used to wrap Drawing.new globally and free everything it had
-- ever seen on reload, which was catastrophic for a reason that took three crashes to spot:
-- Instance.new does not exist in this executor, so the UI LIBRARY draws its entire menu out
-- of Drawing objects too. They all landed in this registry.
--
-- The reload sequence then freed them twice. Destroying the window (above) frees the
-- library's drawings through its own path, which never touches our dead-flag, and then this
-- block removed the same 238 objects a second time. Double-freeing a native object is not
-- catchable by pcall - it takes the executor out, which is exactly the "crashed when the
-- new script loaded" symptom.
--
-- Fixing the flag was not enough because a wrapper installed by an EARLIER generation
-- survives in the environment and keeps registering the library's drawings no matter what
-- this load does. So ownership is tracked explicitly instead: newDrawing() marks what is
-- ours, and cleanup will not touch anything else, whatever ends up in the list.
_G.SEHUB_DRAWINGS = _G.SEHUB_DRAWINGS or {}
_G.SEHUB_DRAWOURS = _G.SEHUB_DRAWOURS or {}
_G.SEHUB_DRAWDEAD = _G.SEHUB_DRAWDEAD or {}
local function dropDrawing(d)
    if not d or _G.SEHUB_DRAWDEAD[d] then return end
    if not _G.SEHUB_DRAWOURS[d] then return end   -- not ours, not our business
    _G.SEHUB_DRAWDEAD[d] = true
    pcall(function() d.Visible = false end)
    pcall(function() d:Remove() end)
end
_G.SEHUB_DROPDRAW = dropDrawing

-- Create and claim. Everything this script draws goes through here.
local function newDrawing(kind)
    if not Drawing then return nil end
    local ok, obj = pcall(function() return Drawing.new(kind) end)
    if not ok or not obj then return nil end
    _G.SEHUB_DRAWOURS[obj] = true
    table.insert(_G.SEHUB_DRAWINGS, obj)
    return obj
end

if GEN > 1 then
    local n = 0
    for _, d in ipairs(_G.SEHUB_DRAWINGS) do
        if _G.SEHUB_DRAWOURS[d] and not _G.SEHUB_DRAWDEAD[d] then
            dropDrawing(d)
            n = n + 1
        end
    end
    print(string.format("[Steal An Egg] cleared %d of our own drawings (the menu's are its own)", n))
end
_G.SEHUB_DRAWINGS = {}
_G.SEHUB_DRAWOURS = {}
_G.SEHUB_DRAWDEAD = {}

-- INS-ui captures game:GetService("Players") ONCE, at library load, and reads the
-- mouse only through LocalPlayer:GetMouse(). If the handle is nil at that instant the
-- menu renders but can never be clicked, for the life of that instance. Matcha's
-- service lookup does go nil, so wait for it rather than loading into a dead menu.
do
    local waited, limit = 0, 10
    local function handleOk()
        local ok, lp = pcall(function() return game:GetService("Players").LocalPlayer end)
        return ok and lp ~= nil
    end
    while not handleOk() and waited < limit do
        task.wait(0.5)
        waited = waited + 0.5
    end
    if not handleOk() then
        warn("[Steal An Egg] Players handle is stale after " .. limit .. "s - the menu will")
        warn("[Steal An Egg] render but not accept clicks. Reinject Matcha, then reload.")
    elseif waited > 0 then
        print(string.format("[Steal An Egg] waited %.1fs for the Players handle", waited))
    end
end

-- ---------------- UI library ----------------
-- Fetched fresh on every load, and every reload is another request. Seventeen reloads
-- in one AR2 session earned a "429: Too Many Requests" from GitHub, which loadstring
-- then tried to parse as Luau, leaving no menu at all - after the re-run guard had
-- already retired the working instance. The library also has two shapes in the wild:
-- the older build returns its table, the newer returns nil and publishes a global
-- named INSUI. So: fetch, RUN, and keep only a source that yields a table with
-- CreateWindow. The cache is written after that test, never before, so a broken
-- upstream cannot poison a working local copy.
local LIB_CACHE = "insui_cache.lua"
local LIB_URLS = {
    "https://raw.githubusercontent.com/neaxusxgod-png/INS-ui/main/uilib.min.lua",
    "https://cdn.jsdelivr.net/gh/neaxusxgod-png/INS-ui@main/uilib.min.lua",
}
local Lib
do
    local function usableSrc(s)
        return type(s) == "string" and #s > 5000 and not string.find(s, "^%s*%d%d%d:")
    end
    local function usableLib(t) return type(t) == "table" and type(t.CreateWindow) == "function" end
    local function try(src)
        if not usableSrc(src) then return nil end
        local chunk = loadstring(src)
        if not chunk then return nil end
        local okr, ret = pcall(chunk)
        if okr and usableLib(ret) then return ret end
        for _, name in ipairs({ "INSUI", "INSui", "insui" }) do
            local g = _G[name] or rawget(getfenv(), name)
            if usableLib(g) then return g end
        end
        return nil
    end
    local okc, cached = pcall(function() return readfile(LIB_CACHE) end)
    if okc then Lib = try(cached) end
    if not Lib then
        for _, u in ipairs(LIB_URLS) do
            local okh, body = pcall(function() return game:HttpGet(u) end)
            if okh then
                local got = try(body)
                if got then
                    Lib = got
                    pcall(function() writefile(LIB_CACHE, body) end)
                    break
                end
            end
        end
    end
    if not Lib then
        warn("[Steal An Egg] no working UI library from cache or any mirror - menu cannot load")
        return
    end
end

-- ---------------- helpers ----------------
local function svcPlayers()
    local ok, p = pcall(function() return game:GetService("Players") end)
    return ok and p or nil
end
local function localPlayer()
    local P = svcPlayers()
    if not P then return nil end
    local ok, lp = pcall(function() return P.LocalPlayer end)
    return ok and lp or nil
end
-- Your character, by whichever route still answers.
--
-- game:GetService("Players") goes nil in this executor - it has happened twice now, and it
-- takes LocalPlayer, Character and everything downstream with it. The whole farm then sits
-- on "waiting for character" forever while the game runs perfectly well around it.
--
-- The camera is the way back in: CameraSubject is your Humanoid, and its Parent is your
-- character. It needs no services at all, only the workspace global, which has never gone
-- nil. Verified against a dead Players service - the fallback returned a live
-- HumanoidRootPart while every normal route returned nothing.
local function myCharacter()
    local lp = localPlayer()
    if lp then
        local ok, ch = pcall(function() return lp.Character end)
        if ok and ch then return ch end
    end
    local okc, cam = pcall(function() return workspace.CurrentCamera end)
    if okc and cam then
        local oks, subj = pcall(function() return cam.CameraSubject end)
        if oks and subj then
            local okp, par = pcall(function() return subj.Parent end)
            if okp and par then return par end
        end
    end
    return nil
end
_G.SEHUB_CHAR = myCharacter

-- Guarded because the character is nil through every respawn, and an unguarded read
-- here is exactly what silently killed AR2's dash loop.
local function myRoot()
    local ch = myCharacter()
    if not ch then return nil end
    local okr, r = pcall(function()
        return ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso")
    end)
    return okr and r or nil
end
-- The egg you are carrying, as an actual object rather than an inference.
--
-- This file spent a long time asserting the opposite - "an egg is NOT a Tool in the
-- character, false through 541 ragdolls" - and built grab timing, delivery timeouts and
-- slot-vanished checks around that. It is wrong. A held egg is a Tool parented to the
-- character, with a readable name: "Riftbeasts Egg", "Volcano Egg". The original test was
-- run once, mid-run, and the conclusion outlived whatever made it fail.
--
-- Filtered on the name containing "egg" so that equipping a pet - and every pet you own is
-- also a Tool - is not mistaken for carrying one.
local function heldEggTool()
    local ch = myCharacter()      -- survives the Players service going nil
    if not ch then return nil end
    local okk, kids = pcall(function() return ch:GetChildren() end)
    if not okk or not kids then return nil end
    for _, c in ipairs(kids) do
        local okcl, cl = pcall(function() return c.ClassName end)
        if okcl and cl == "Tool" then
            local okn, n = pcall(function() return c.Name end)
            if okn and type(n) == "string" and string.find(string.lower(n), "egg", 1, true) then
                return c, n
            end
        end
    end
    return nil
end
_G.SEHUB_HELDEGG = heldEggTool

-- Put the held egg away. Humanoid:UnequipTools() is not bound in this executor, so the
-- only route left is re-parenting the Tool into the Backpack, which is what unequipping
-- does anyway. Wrapped because a Parent write is not guaranteed to be permitted here, and
-- the caller must work whether or not it lands.
local function stowHeldEgg()
    local tool = heldEggTool()
    if not tool then return true end          -- nothing to put away
    -- LIVENESS FIRST. Delivering consumes the egg, so the server destroys this Tool at the
    -- same moment we would be re-parenting it, and writing Parent on a freed instance is a
    -- native crash that pcall cannot catch - the same failure mode as the double-freed
    -- drawings. Reading Parent is safe; writing to a dead one is not.
    local okp, par = pcall(function() return tool.Parent end)
    if not okp or par == nil then return true end
    local lp = localPlayer()
    local bp = lp and lp:FindFirstChild("Backpack")
    if not bp then return false end
    pcall(function() tool.Parent = bp end)
    return heldEggTool() == nil
end
_G.SEHUB_STOW = stowHeldEgg

-- ---------------- player traps ----------------
-- Other players drop traps, they live in workspace.__DEBRIS as PlayerTrap objects, and
-- until now this script ran straight through them. Taken from the reference script, which
-- steers around them - and it is a decent candidate for some of the deaths that looked like
-- anti-cheat, since running a fixed line between eggs walks into anything sitting on it.
--
-- Cached for a second: traps are placed occasionally, not continuously, and this is asked
-- on every movement tick.
local TRAP_CACHE, TRAP_AT = {}, 0
local function trapPositions()
    if (tick() - TRAP_AT) < 1.0 then return TRAP_CACHE end
    local out = {}
    local deb = workspace:FindFirstChild("__DEBRIS")
    if deb then
        local okd, kids = pcall(function() return deb:GetDescendants() end)
        if okd and kids then
            for _, d in ipairs(kids) do
                local okn, n = pcall(function() return d.Name end)
                if okn and type(n) == "string" and string.find(n, "PlayerTrap", 1, true) then
                    local okp, p = pcall(function() return d.Position end)
                    if okp and p then
                        out[#out + 1] = p
                    else
                        -- a Model rather than a Part: take the first child with a position
                        local okc, sub = pcall(function() return d:GetChildren() end)
                        if okc and sub then
                            for _, c in ipairs(sub) do
                                local ok2, p2 = pcall(function() return c.Position end)
                                if ok2 and p2 then out[#out + 1] = p2 break end
                            end
                        end
                    end
                end
            end
        end
    end
    TRAP_CACHE, TRAP_AT = out, tick()
    return out
end
_G.SEHUB_TRAPS = trapPositions

-- A sideways push away from any trap you are about to run through, in X and Z only.
-- Returned as an offset added to wherever the farm is heading, so avoidance bends the path
-- rather than replacing the destination - stack two traps and it threads between them.
local function trapAvoid(pos, radius)
    local r = radius or 30
    local ox, oz, near = 0, 0, 0
    for _, t in ipairs(trapPositions()) do
        local dx, dz = pos.X - t.X, pos.Z - t.Z
        local d2 = dx * dx + dz * dz
        if d2 > 0.01 and d2 < (r * r) then
            local d = math.sqrt(d2)
            local push = (r - d) * 2.0
            ox = ox + (dx / d) * push
            oz = oz + (dz / d) * push
            near = near + 1
        end
    end
    return ox, oz, near
end

-- ---------------- notifications ----------------
-- Drawn ourselves, bottom-right, rather than handed to Lib.Notify - the library puts its
-- toasts where it likes, and the ask was for them to sit where the game's own "eggs have
-- respawned" popups do, so your eye is already looking there.
--
-- Drawing is used instead of a ScreenGui because this executor cannot create Instances at
-- all (Instance.new is nil), so there is no GUI to build. Every Drawing goes through the
-- registry wrapper above, which is what stops a reload leaking them.
-- Sized from the text rather than fixed. TextBounds turns out to be READABLE here, which
-- means the card can measure its own contents, wrap a long line properly and grow to fit -
-- instead of the old fixed 340x46 box that clipped anything longer than a few words and
-- squashed everything into two cramped lines.
local TOAST = {
    list = {}, pad = 12, gap = 9, margin = 20, lineGap = 4,
    minW = 240, maxW = 420, titleSize = 15, bodySize = 13, bar = 3,
}
-- Accent per kind. OutlineColor cannot be written in this executor, so the colour has to
-- come from the bar and the title rather than from a text outline.
local TOAST_KIND = {
    info = { 96, 165, 250 },
    good = { 74, 222, 128 },
    warn = { 250, 204, 21 },
    bad  = { 248, 113, 113 },
}

-- Viewport size, by whatever means answers. Camera.ViewportSize is the direct read and may
-- come back nil like so much else here, so the fallback measures the largest GuiObject in
-- PlayerGui - AbsoluteSize reads fine on GUI CHILDREN even though it returns nil on the
-- ScreenGui itself, which is a distinction that cost an afternoon to find. 1920x1080 only
-- if both fail, which just means the toasts sit off-corner rather than not appearing.
local function viewportSize()
    local ok, cam = pcall(function() return workspace.CurrentCamera end)
    if ok and cam then
        local okv, v = pcall(function() return cam.ViewportSize end)
        if okv and v and v.X and v.X > 100 then return v end
    end
    local okp, pg = pcall(function()
        return game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
    end)
    if okp and pg then
        local best
        local okd, desc = pcall(function() return pg:GetDescendants() end)
        if okd and desc then
            for _, d in ipairs(desc) do
                local oks, s = pcall(function() return d.AbsoluteSize end)
                if oks and s and s.X and s.X > 100 then
                    if not best or (s.X * s.Y) > (best.X * best.Y) then best = s end
                end
            end
        end
        if best then return best end
    end
    return Vector2.new(1920, 1080)
end

-- Color3 is used nowhere else in this script, so it is not assumed to exist. Every colour
-- is applied through this, and a missing constructor costs you a white toast rather than no
-- toast - the same reasoning as the rest of the file: unsupported reads here return nil
-- instead of erroring, so anything unverified gets wrapped rather than trusted.
local function rgb(r, g, b)
    local ok, c = pcall(function() return Color3.fromRGB(r, g, b) end)
    if ok and c then return c end
    local ok2, c2 = pcall(function() return Color3.new(r / 255, g / 255, b / 255) end)
    if ok2 and c2 then return c2 end
    return nil
end
local function setp(obj, key, value)
    if value == nil then return end
    pcall(function() obj[key] = value end)
end

-- Width of a string, asked of the renderer. One hidden Text drawing is reused as a ruler:
-- set the text, read TextBounds. Guessing from character count was the alternative and it
-- is wrong by 30% on anything with capitals or punctuation.
local function measure(txt, size)
    if not TOAST.ruler then
        TOAST.ruler = newDrawing("Text")
        if TOAST.ruler then setp(TOAST.ruler, "Visible", false) end
    end
    local r = TOAST.ruler
    if not r then return #tostring(txt) * size * 0.55 end
    setp(r, "Font", 2); setp(r, "Size", size); setp(r, "Text", tostring(txt))
    local ok, b = pcall(function() return r.TextBounds end)
    if ok and b and b.X and b.X > 0 then return b.X end
    return #tostring(txt) * size * 0.55
end

-- Greedy word wrap to a pixel width. Long status lines - the rift area list, the "need X, Y,
-- Z" line - used to run off the edge of the card and simply vanish.
local function wrapText(txt, size, maxW)
    local lines, cur = {}, ""
    for word in string.gmatch(tostring(txt), "%S+") do
        local try = (cur == "") and word or (cur .. " " .. word)
        if cur ~= "" and measure(try, size) > maxW then
            lines[#lines + 1] = cur
            cur = word
        else
            cur = try
        end
    end
    if cur ~= "" then lines[#lines + 1] = cur end
    if #lines == 0 then lines[1] = "" end
    return lines
end

local function toastPush(title, msg, dur, kind)
    if not Drawing then return false end
    local accent = TOAST_KIND[kind or "info"] or TOAST_KIND.info

    -- Measure first, then build to fit.
    local innerMax = TOAST.maxW - TOAST.pad * 2 - TOAST.bar
    local titleW = measure(title, TOAST.titleSize)
    local body = wrapText(msg, TOAST.bodySize, innerMax)
    local widest = titleW
    for _, l in ipairs(body) do
        local w = measure(l, TOAST.bodySize)
        if w > widest then widest = w end
    end
    local cardW = math.max(TOAST.minW, math.min(TOAST.maxW, widest + TOAST.pad * 2 + TOAST.bar + 6))
    local lineH = TOAST.bodySize + TOAST.lineGap
    local cardH = TOAST.pad * 2 + TOAST.titleSize + 5 + (#body * lineH) - TOAST.lineGap

    local t = {
        born = tick(), until_ = tick() + (dur or 3),
        w = cardW, h = cardH, body = body, parts = {},
    }

    -- Title and body are the message; everything else is decoration and is created
    -- separately, so a missing Square type costs you the styling and not the words.
    local h1 = newDrawing("Text")
    if not h1 then return false end
    setp(h1, "Font", 2); setp(h1, "Size", TOAST.titleSize)
    setp(h1, "Color", rgb(accent[1], accent[2], accent[3]))
    setp(h1, "Outline", true); setp(h1, "Text", tostring(title)); setp(h1, "Visible", true)
    setp(h1, "ZIndex", 12)
    t.parts.h1 = h1

    t.lines = {}
    for i, l in ipairs(body) do
        local tl = newDrawing("Text")
        if tl then
            setp(tl, "Font", 2); setp(tl, "Size", TOAST.bodySize)
            setp(tl, "Color", rgb(226, 232, 240))
            setp(tl, "Outline", true); setp(tl, "Text", l); setp(tl, "Visible", true)
            setp(tl, "ZIndex", 12)
            t.lines[i] = tl
        end
    end

    local shadow = newDrawing("Square")
    if shadow then
        setp(shadow, "Filled", true); setp(shadow, "Color", rgb(0, 0, 0))
        setp(shadow, "Size", Vector2.new(cardW + 4, cardH + 4)); setp(shadow, "ZIndex", 9)
        setp(shadow, "Visible", true)
        t.parts.shadow = shadow
    end
    local bg = newDrawing("Square")
    if bg then
        setp(bg, "Filled", true); setp(bg, "Color", rgb(17, 21, 30))
        setp(bg, "Size", Vector2.new(cardW, cardH)); setp(bg, "ZIndex", 10)
        setp(bg, "Visible", true)
        t.parts.bg = bg
    end
    local bar = newDrawing("Square")
    if bar then
        setp(bar, "Filled", true); setp(bar, "Color", rgb(accent[1], accent[2], accent[3]))
        setp(bar, "Size", Vector2.new(TOAST.bar, cardH)); setp(bar, "ZIndex", 11)
        setp(bar, "Visible", true)
        t.parts.bar = bar
    end

    table.insert(TOAST.list, 1, t)      -- newest nearest the bottom
    while #TOAST.list > 5 do
        local old = table.remove(TOAST.list)
        for _, p in pairs(old.parts) do dropDrawing(p) end
        for _, p in ipairs(old.lines or {}) do dropDrawing(p) end
    end
    return true
end

local function toastLayout()
    local okv, vp = pcall(viewportSize)
    if not okv or not vp then return end
    local now = tick()
    for i = #TOAST.list, 1, -1 do
        local t = TOAST.list[i]
        if now > t.until_ then
            for _, p in pairs(t.parts) do dropDrawing(p) end
            for _, p in ipairs(t.lines or {}) do dropDrawing(p) end
            table.remove(TOAST.list, i)
        end
    end

    local yCursor = vp.Y - TOAST.margin
    for _, t in ipairs(TOAST.list) do
        -- Slides in from the right over 0.18s and fades out over the last 0.35s. Drawing has
        -- no animation of its own, but this loop already runs at 10Hz, so it is free.
        local inA  = math.min(1, (now - t.born) / 0.18)
        local outA = math.min(1, math.max(0, (t.until_ - now) / 0.35))
        local a = math.min(inA, outA)
        local slide = (1 - inA) * 40

        local x = vp.X - t.w - TOAST.margin + slide
        local y = yCursor - t.h
        yCursor = y - TOAST.gap

        -- Positioned one at a time. Grouped in a single pcall, a missing background would
        -- abort the whole block and leave the TEXT sitting at 0,0 - the decoration failing
        -- must not take the message with it.
        if t.parts.shadow then
            setp(t.parts.shadow, "Position", Vector2.new(x - 2, y - 2))
            setp(t.parts.shadow, "Transparency", 0.35 * a)
        end
        if t.parts.bg then
            setp(t.parts.bg, "Position", Vector2.new(x, y))
            setp(t.parts.bg, "Transparency", 0.93 * a)
        end
        if t.parts.bar then
            setp(t.parts.bar, "Position", Vector2.new(x, y))
            setp(t.parts.bar, "Transparency", a)
        end
        local tx = x + TOAST.bar + TOAST.pad
        setp(t.parts.h1, "Position", Vector2.new(tx, y + TOAST.pad - 2))
        setp(t.parts.h1, "Transparency", a)
        local ly = y + TOAST.pad + TOAST.titleSize + 3
        for i, tl in ipairs(t.lines or {}) do
            setp(tl, "Position", Vector2.new(tx, ly + (i - 1) * (TOAST.bodySize + TOAST.lineGap)))
            setp(tl, "Transparency", a)
        end
    end
end

-- Deduplicated. Several of these fire from loops that run every second or every tick, so
-- the same line stacks up four or five deep and buries anything new. An identical message
-- inside eight seconds is the same event being reported again, not a new one worth reading.
local NOTIFY_LAST = {}
local function notify(title, msg, dur, kind)
    local key = tostring(title) .. "\0" .. tostring(msg)
    local now = tick()
    if NOTIFY_LAST[key] and (now - NOTIFY_LAST[key]) < 8 then return end
    NOTIFY_LAST[key] = now
    -- Keep the table from growing across a long session.
    if not NOTIFY_LAST.__n then NOTIFY_LAST.__n = 0 end
    NOTIFY_LAST.__n = NOTIFY_LAST.__n + 1
    if NOTIFY_LAST.__n > 60 then
        for k, t in pairs(NOTIFY_LAST) do
            if type(t) == "number" and k ~= "__n" and (now - t) > 30 then NOTIFY_LAST[k] = nil end
        end
        NOTIFY_LAST.__n = 0
    end

    -- Ours first; Lib.Notify only if Drawing is unavailable, so a notification is never
    -- silently lost just because the toast could not be built.
    -- Kind is inferred when the caller does not say, so existing calls get sensible colour
    -- without every site being rewritten.
    if not kind then
        local m = string.lower(tostring(msg))
        if string.find(m, "unreadable") or string.find(m, "stale") or string.find(m, "no safe zone")
           or string.find(m, "cannot") or string.find(m, "failed") then kind = "warn"
        elseif string.find(m, "complete") or string.find(m, "collected") or string.find(m, "owned")
           or string.find(m, "saved") or string.find(m, "restored") then kind = "good"
        end
    end
    if not toastPush(title, msg, dur or 3, kind) then
        if Lib and Lib.Notify then pcall(function() Lib.Notify(title, msg, dur or 2) end) end
    end
end
-- A closure, not a direct reference. Assigning `notify` straight into _G here produced nil
-- while the very next line assigning toastLayout worked, which I could not explain and did
-- not want to spend the session on - a wrapper resolves the upvalue when it is called and
-- behaves identically for every caller.
_G.SEHUB_NOTIFY = function(a, b, c, d) return notify(a, b, c, d) end
_G.SEHUB_TOASTLAYOUT = toastLayout
_G.SEHUB_TOASTINFO = function()
    local out = {}
