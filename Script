local win = Lib:CreateWindow({ title = "Steal An Egg Hub", size = Vector2.new(680, 600) })
_G.SEHUB_WIN = win

-- ==================== instant steal ====================
-- The reference script tried three routes and TWO of them are dead under Matcha:
-- fireproximityprompt does not exist, and prompt:InputHoldBegin is nil. The property
-- writes it falls back to error outright ("Unknown property: HoldDuration"). What
-- actually carries the feature is the memory write, so that is what this rebuilds -
-- but with the two things the original had no way to do:
--
--   1. VERIFY. memory_read works, so after writing we read back. If the value did not
--      take, the offsets have moved (a Roblox update reshuffles the struct) and we
--      stop immediately instead of spraying floats into whatever now lives there.
--   2. RESTORE. The originals are recorded per address before the first write, so
--      unloading or toggling off puts the game back rather than leaving it modified
--      with nothing tracking it.
_G.STEAL = _G.STEAL or {}
local ST = _G.STEAL
-- ON by default. The farm cannot work without it - the eggs need a zero hold time and
-- the widened reach to be grabbed on the move.
ST.On         = true
ST.Hold       = 0.0        -- HoldDuration to force
ST.Dist       = 15.0       -- MaxActivationDistance to force; 15 is the measured ceiling
ST.OFF_HOLD   = 0x120
ST.OFF_DIST   = 0x128
ST.orig       = ST.orig or {}   -- [address] = { hold = n, dist = n }
ST.offsetsOk  = true
ST.patched    = 0
ST.State      = "off"

local function promptList()
    -- Root-level SmartPromptPart only, which is where the steal prompts live (30 of
    -- them). A full descendant walk finds 175 prompts, most of them machines and
    -- shops, and costs far more per sweep for no benefit.
    local out = {}
    local okc, kids = pcall(function() return workspace:GetChildren() end)
    if not okc or not kids then return out end
    for _, c in ipairs(kids) do
        local okn, nm = pcall(function() return c.Name end)
        if okn and nm == "SmartPromptPart" then
            local okg, sub = pcall(function() return c:GetChildren() end)
            if okg and sub then
                for _, p in ipairs(sub) do
                    local okcl, cl = pcall(function() return p.ClassName end)
                    if okcl and cl == "ProximityPrompt" then out[#out + 1] = p end
                end
            end
        end
    end
    return out
end

-- The address is only safe to write while the prompt is still parented. Eggs are taken
-- and destroyed constantly, and writing a float into the memory of a freed prompt is a
-- good way to take the whole executor down - which is exactly the kind of crash that
-- appeared once grabs started patching three times each.
local function addrOf(p)
    local okpar, par = pcall(function() return p.Parent end)
    if not okpar or par == nil then return nil end
    local ok, a = pcall(function() return p.Address end)
    if ok and type(a) == "number" and a > 0x10000 then return a end
    return nil
end

local function patchPrompts()
    if not memory_write or not memory_read then
        ST.State = "memory_write unavailable"
        return
    end
    if not ST.offsetsOk then return end
    local n = 0
    for _, p in ipairs(promptList()) do
        local a = addrOf(p)
        if a then
            -- record the originals ONCE per address, before touching anything
            if not ST.orig[a] then
                local okh, h = pcall(function() return memory_read("float", a + ST.OFF_HOLD) end)
                local okd, d = pcall(function() return memory_read("float", a + ST.OFF_DIST) end)
                if okh and okd then ST.orig[a] = { hold = h, dist = d } end
            end
            pcall(function()
                memory_write("float", a + ST.OFF_HOLD, ST.Hold)
                memory_write("float", a + ST.OFF_DIST, ST.Dist)
            end)
            -- verify: if the struct moved, this is where we find out
            local okv, h2 = pcall(function() return memory_read("float", a + ST.OFF_HOLD) end)
            local okv2, d2 = pcall(function() return memory_read("float", a + ST.OFF_DIST) end)
            if okv and okv2 and h2 and d2 then
                if math.abs(h2 - ST.Hold) > 0.01 or math.abs(d2 - ST.Dist) > 0.01 then
                    ST.offsetsOk = false
                    ST.State = "OFFSETS MOVED - stopped, see console"
                    warn("[Steal An Egg] prompt offsets no longer hold their value.")
                    warn("[Steal An Egg] Roblox has probably reshuffled ProximityPrompt.")
                    warn(string.format("[Steal An Egg] wrote hold=%.2f dist=%.2f, read back %.2f / %.2f",
                        ST.Hold, ST.Dist, h2, d2))
                    warn("[Steal An Egg] Instant Steal disabled rather than writing blind.")
                    return
                end
            end
            n = n + 1
        end
    end
    ST.patched = n
    ST.State = string.format("%d prompts patched (hold %.2fs, range %.0f)", n, ST.Hold, ST.Dist)
end

-- Patch the prompts around ONE spot, right now. The background sweep runs every couple
-- of seconds, which is fine for prompts that have been sitting there - but an egg that
-- just respawned (after a night reload, or after you died and it came back) can be
-- reached before the sweep has ever seen it, and an unpatched prompt still has its full
-- hold time and short reach. That is why some eggs simply would not be taken.
local function patchNear(pos, radius)
    if not memory_write or not pos then return 0 end
    if not ST.On or not ST.offsetsOk then return 0 end
    local n = 0
    local okc, kids = pcall(function() return workspace:GetChildren() end)
    if not okc or not kids then return 0 end
    for _, c in ipairs(kids) do
        local okn, nm = pcall(function() return c.Name end)
        if okn and nm == "SmartPromptPart" then
            local okp, p = pcall(function() return c.Position end)
            if okp and p and (p - pos).Magnitude <= (radius or 30) then
                local okg, sub = pcall(function() return c:GetChildren() end)
                if okg and sub then
                    for _, pr in ipairs(sub) do
                        local okcl, cl = pcall(function() return pr.ClassName end)
                        if okcl and cl == "ProximityPrompt" then
                            local a = addrOf(pr)   -- nil once the prompt is gone
                            if a then
                                if not ST.orig[a] then
                                    local okh, h = pcall(function() return memory_read("float", a + ST.OFF_HOLD) end)
                                    local okd, dd = pcall(function() return memory_read("float", a + ST.OFF_DIST) end)
                                    if okh and okd then ST.orig[a] = { hold = h, dist = dd } end
                                end
                                -- Write only. A "read first, write if different" version
                                -- of this looked tidier and put roughly 144 memory_read
                                -- calls per second onto prompt addresses that are freed
                                -- constantly as eggs are taken - and the executor began
                                -- crashing within a second of load. Reads happen at grab
                                -- time only, against one prompt, checked for a parent.
                                pcall(function()
                                    memory_write("float", a + ST.OFF_HOLD, ST.Hold)
                                    memory_write("float", a + ST.OFF_DIST, ST.Dist)
                                end)
                                n = n + 1
                            end
                        end
                    end
                end
            end
        end
    end
    return n
end
_G.SEHUB_PATCHNEAR = patchNear

-- What hold time does the prompt at this spot ACTUALLY have right now? The patch does
-- not always take - a prompt created after the last sweep, or one the write missed -
-- and an unpatched prompt still wants its full hold, so a quick tap does nothing and
-- the egg looks immune. Reading the value back is the difference between guessing that
-- happened and knowing. Returns nil when it cannot be read at all.
-- The hold time of the prompt CLOSEST to this spot. Not the largest within a radius:
-- egg prompts sit only a few studs apart, so one unpatched neighbour made every slot
-- look unpatched. It reported 1.20 on a slot whose own prompt was patched to 0, which
-- would have used the slow fallback on nearly every grab.
local function holdTimeNear(pos, radius)
    if not memory_read or not pos then return nil end
    local bestD, bestPrompt
    local okc, kids = pcall(function() return workspace:GetChildren() end)
    if not okc or not kids then return nil end
    for _, c in ipairs(kids) do
        local okn, nm = pcall(function() return c.Name end)
        if okn and nm == "SmartPromptPart" then
            local okp, p = pcall(function() return c.Position end)
            if okp and p then
                local d = (p - pos).Magnitude
                if d <= (radius or 20) and (not bestD or d < bestD) then
                    local okg, sub = pcall(function() return c:GetChildren() end)
                    if okg and sub then
                        for _, pr in ipairs(sub) do
                            local okcl, cl = pcall(function() return pr.ClassName end)
                            if okcl and cl == "ProximityPrompt" then
                                bestD, bestPrompt = d, pr
                                break
                            end
                        end
                    end
                end
            end
        end
    end
    if not bestPrompt then return nil end
    local okpar, par = pcall(function() return bestPrompt.Parent end)
    if not okpar or par == nil then return nil end     -- gone since we found it
    local oka, a = pcall(function() return bestPrompt.Address end)
    if not oka or type(a) ~= "number" or a <= 0x10000 then return nil end
    local okh, h = pcall(function() return memory_read("float", a + ST.OFF_HOLD) end)
    if okh and type(h) == "number" then return h end
    return nil
end
_G.SEHUB_HOLDTIME = holdTimeNear

local function restorePrompts()
    if not memory_write then return end
    local n = 0
    for _, p in ipairs(promptList()) do
        local a = addrOf(p)
        local o = a and ST.orig[a]
        if a and o then
            pcall(function()
                memory_write("float", a + ST.OFF_HOLD, o.hold)
                memory_write("float", a + ST.OFF_DIST, o.dist)
            end)
            n = n + 1
        end
    end
    ST.State = string.format("restored %d prompts to original values", n)
    return n
end
-- exposed so the re-run guard of the NEXT load can undo this one's writes
_G.SEHUB_RESTORE = restorePrompts

