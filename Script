-- Writes a label ONLY when its text actually changed.
--
-- This loop was pushing six SetText calls every 0.25s - twenty-four writes a second into
-- the menu, forever, almost all of them setting a label to the string it already held. That
-- is worth removing on its own, but the reason it is worth removing NOW is that the menu is
-- built out of Drawing objects (no Instance.new in this executor), and a library that
-- rebuilds its elements while you scroll leaves our cached label handles pointing at freed
-- drawings. Writing to one is a native crash, which pcall cannot catch - which is what
-- "scrolled down and it crashed" looks like.
--
-- Idle, this now writes nothing at all, so there is almost no window left to hit.
local lastLabel = {}
local function setLabel(key, obj, text)
    if not obj then return end
    if lastLabel[key] == text then return end
    lastLabel[key] = text
    pcall(function() obj:SetText(text) end)
end

SESPAWN("ui refresh", function()
    while _G.SEHUB_GEN == GEN do
        local __t0 = tick()
        setLabel("steal", ST.ui, tostring(ST.State))
        setLabel("farm", FM.ui, tostring(FM.State))
        setLabel("rift", FM.riftUi, tostring(FM.RiftState))
        setLabel("boss", AB.ui, tostring(AB.State))
        -- health is rounded to one decimal so it stops churning the string every tick
        -- Identification coverage is on here because it is the thing that silently limits
        -- Rare Priority: an egg with no name has no rarity and cannot be ranked, so a map
        -- that is only half identified looks like the priority is being ignored.
        setLabel("diag", diagLbl, string.format(
            "health %.1f | prompts %d | identified %d/%d | eggs %d | traps %d",
            _G.SEHUB_HEALTH or -1, ST.patched or 0,
            FM.EggIdent or 0, FM.slotCount or 0, FM.Taken or 0, FM.TrapDodges or 0))
        PROFTICK("ui refresh", __t0)
        task.wait(0.3)
    end
end)

