-- MIGRATE THE CACHED PET INDEX THROUGH THE ALIASES ABOVE.
--
-- sehub_petindex.lua is written once, from a real harvest, and then trusted for the rest of
-- time - so a rename discovered AFTER that harvest never reaches it, and the stale template
-- name outlives every other fix. That is exactly what happened with Shark: the cache on
-- disk records Abyss Ocean slot 3 as "Shark", harvested before the rename was known, and
-- areaEggsFromIndex faithfully rebuilt the allow list from it - putting a template that can
-- never be fingerprinted back into the area on every single load.
--
-- The stored values are template names, and a stored name that is ITSELF an alias key is by
-- definition a name the game displays but no longer models. Only those move; everything
-- else is left alone, because the alias keys are display names and a template that shares
-- one is the very case being corrected.
do
    local moved = 0
    for _, slots in pairs(INDEX_SLOT) do
        for tmpl, slot in pairs(slots) do
            local better = RIFT_EGG_ALIAS[string.lower(tmpl)]
            if better and better ~= tmpl then
                slots[tmpl] = nil
                slots[better] = slot
                moved = moved + 1
            end
        end
    end
    if moved > 0 then
        pcall(saveIndexSlots)
        _G.FARM.IndexMigrated = moved
    end
end

