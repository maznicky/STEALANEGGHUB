-- Areas are found by CLUSTERING the prompts, not by asking the game where they are.
-- The obvious route - the named parts under __OBJECTS.Areas - turned out to be map
-- geometry (Ground, WallStartCollision, SeparationLine), and classifying against it put
-- 43 of 54 prompts in "Other" and printed the same answer everywhere on the map. The
-- slot names carry an area only for Forest; the other 46 are GUIDs.
--
-- What the slots themselves show is unmistakable once plotted: eleven groups of five,
-- strung along a line at Z ~ -350 with X climbing from 597 to 4798, which is the usual
-- progression layout. They are clustered by gaps in X, then named from fixed map bounds
-- rather than list order - see AREA_BOUNDS above for why that distinction matters.
-- Egg slots come from AreaEggSlotsClient, NOT from the SmartPromptParts. The prompts
-- were the obvious source and they are wrong twice over: near spawn they include plot
-- prompts, machines and gear givers (Forest read as 12 eggs instead of 5), and distant
-- areas do not have theirs loaded at all (Titan Temple read as 1). The slot folder
-- holds exactly 55 - eleven areas of five - and every one has a readable Hitbox.
--
-- The areas sit in a line along X, so they are separated by sorting on X and cutting
-- wherever the gap exceeds AREA_GAP. That is deterministic, unlike the proximity
-- clustering it replaces: at a 180 stud link Forest and Lake merged (their centres are
-- only 146 apart), and tightening the link exposed a bug in the merge pass that
-- collapsed everything into one group. One dimension, one rule, no merge step.
local AREA_GAP = 100
-- Named by WHERE they are, not by their position in the list.
--
-- Naming by list order looked fine and was quietly wrong: the areas are clustered from
-- whatever slots exist at load, and if the far ones have not streamed in yet you get ten
-- clusters instead of eleven. Every name from that point shifts down one, so the real
-- Titan Temple at x=4798 was labelled "Cherry Blossom" - which is why its faster-escape
-- override never applied and that area kept catching you.
--
-- These X bounds are fixed map geometry, so the label is right however many clusters
-- happen to be loaded.
local AREA_BOUNDS = {
    { name = "Forest",         minX =  553, maxX =  647 },
    { name = "Lake",           minX =  653, maxX =  794 },
    { name = "Desert",         minX =  796, maxX = 1005 },
    { name = "Jungle",         minX = 1008, maxX = 1240 },
    { name = "Snow",           minX = 1244, maxX = 1564 },
    { name = "Volcano",        minX = 1568, maxX = 1950 },
    { name = "Abyss Ocean",    minX = 1953, maxX = 2379 },
    { name = "Prehistoric",    minX = 2383, maxX = 2884 },
    { name = "Cosmic",         minX = 2888, maxX = 3524 },
    { name = "Cherry Blossom", minX = 3528, maxX = 4264 },
    { name = "Titan Temple",   minX = 4268, maxX = 5123 },
}
local function nameForX(x)
    for _, b in ipairs(AREA_BOUNDS) do
        if x >= b.minX and x <= b.maxX then return b.name end
    end
    -- outside every band: fall back to the nearest one rather than losing the slot
    local best, bd
    for _, b in ipairs(AREA_BOUNDS) do
        local mid = (b.minX + b.maxX) / 2
        local d = math.abs(x - mid)
        if not bd or d < bd then bd, best = d, b.name end
    end
    return best or "Other"
end

-- Returns records, not bare positions: the PART matters as much as where it is, because
-- an egg part is destroyed when someone picks it up. Holding the instance lets a grab be
-- confirmed by checking whether it still has a Parent - which is the success signal that
-- a whole evening of hunting for a "am I carrying an egg" flag never found. The question
-- was never what is in your hands, it was whether the target disappeared.
-- Deliberately minimal: ONE child lookup per slot, no extra fallbacks, no rare check,
-- no instance kept. This is called every tick by the farm loop, and a richer version
-- of it (four lookups per slot, plus caching to afford them) went in alongside the
-- reference-script work and the executor started crashing. Reverted wholesale rather
-- than picked at - it was stable in exactly this form.
local function eggSlots()
    local out = {}
    local folder = workspace:FindFirstChild("AreaEggSlotsClient")
    if not folder then return out end
    local okc, kids = pcall(function() return folder:GetChildren() end)
    if not okc or not kids then return out end
    for _, m in ipairs(kids) do
        local hb = m:FindFirstChild("Hitbox")
        local okp, p = pcall(function() return hb and hb.Position end)
        if okp and p then out[#out + 1] = p end
    end
    return out
end

local function buildAreas()
    local pts = eggSlots()
    if #pts == 0 then return {} end
    table.sort(pts, function(a, b) return a.X < b.X end)
    local groups, cur = {}, { pts[1] }
    for i = 2, #pts do
        if (pts[i].X - pts[i - 1].X) > AREA_GAP then
            groups[#groups + 1] = cur
            cur = {}
        end
        cur[#cur + 1] = pts[i]
    end
    groups[#groups + 1] = cur
    local out = {}
    for _, g in ipairs(groups) do
        local sum = Vector3.new(0, 0, 0)
        for _, p in ipairs(g) do sum = sum + p end
        local centre = sum / #g
        out[#out + 1] = { centre = centre, n = #g, name = nameForX(centre.X) }
    end
    return out
end

_G.FARM = _G.FARM or {}
_G.FARM.areaList = buildAreas()

-- The single source of truth for "home": whatever the safe zone currently is. The
-- delivery point and the post-death rally point are both this, because in play they
-- are the same place, and keeping a separate copy is what caused the escape to send
-- you somewhere the manual key never would.
local function homePos()
    local z = _G.ABOSS and _G.ABOSS.Zone
    local ok, p = pcall(function() return z and z.Position end)
    return (ok and p) or nil
end

-- Matched on X alone. The areas are separated along X by at least 146 studs and share
-- almost the same Z, so a full 3D distance only adds a way to get it wrong - which it
-- did, assigning slots to a neighbouring area and making an area filter look broken.
-- Straight from the map bounds, so a slot's area never depends on which clusters
-- happened to be loaded when the list was built.
local function areaOf(pos)
    return nameForX(pos.X)
end

-- Caught == ragdolled, and the game says so outright: the player carries a
-- RagdollEndTime attribute, a unix timestamp of when it wears off. That beats the
-- velocity heuristic this replaces, which had to infer a fling from motion and could
-- not tell one from our own movement.
-- Also NOT an attribute read, for the same reason. RagdollEndTime is the honest signal
-- and it was being polled fifty times a second, which is a third of the rate that
-- crashed the executor in a bare test - almost certainly part of today's instability.
--
-- Instead: being flung is motion nobody asked for. The script only ever writes downward
-- stick or horizontal run velocity, never upward, so a sharp upward throw is something
-- the game did to you.
local function isRagdolled()
    local root = myRoot()
    if not root then return false end
    local ok, v = pcall(function() return root.AssemblyLinearVelocity end)
    if not ok or not v then return false end
    if _G.MOVE and _G.MOVE.Fly then return false end   -- flying is upward on purpose
    return v.Y > (_G.FARM.FlingLift or 45)
end

-- (An AreaId attribute exists on the player and would name your current area, but every
-- GetAttribute call is off limits here - see the note on the guard watch below.)

-- ---- boss chase detection ----
-- Each area has exactly one guard at __OBJECTS.Areas.GuardAreas.<Area>.Guard, so they
-- can be indexed directly instead of walking the workspace (a full descendant scan for
-- Humanoids took 1.5 seconds, hopeless for a per-tick check).
--
-- The point of this: firing the escape the moment an egg is grabbed is TOO EARLY. It
-- spends the teleport before the boss has even started moving, and by the time it
-- reaches you the escape is long since finished - which is why the manual key, pressed
-- at the right moment, worked while the automatic one did not. So the escape now waits
-- for the actual chase.
--
-- A guard standing at its post near the eggs is normal and must not trigger anything.
-- What distinguishes a chase is CLOSING: the distance dropping fast over a short
-- window. Proximity alone would fire constantly, since the eggs are on the guard's
-- doorstep by design.
_G.GUARDS = _G.GUARDS or { list = {}, at = 0 }
local GU = _G.GUARDS

-- Stores the GUARD MODEL, not its root part.
--
-- The first version cached the HumanoidRootPart and reached back up through
-- root.Parent to get the model, then read four attributes off it at 10Hz. Guards are
-- destroyed and rebuilt when they wake, so that cached root goes stale - and reading
-- attributes off a dead instance forty times a second crashed the executor within
-- seconds, every time. Bisecting the loops one at a time is what found it; no amount
-- of reading the code did.
local function refreshGuards()
    local obj = workspace:FindFirstChild("__OBJECTS")
    local areas = obj and obj:FindFirstChild("Areas")
    local ga = areas and areas:FindFirstChild("GuardAreas")
    if not ga then return end
    local okc, kids = pcall(function() return ga:GetChildren() end)
    if not okc or not kids then return end
    local out = {}
    for _, areaModel in ipairs(kids) do
        local g = areaModel:FindFirstChild("Guard")
        if g then
            out[#out + 1] = { model = g, area = tostring(areaModel.Name) }
        end
    end
    if #out > 0 then GU.list = out end
end

-- Nothing touches a guard without this first. A destroyed instance still answers
-- some calls and crashes on others, so the parent check is the gate.
local function guardAlive(g)
    if not g or not g.model then return false end
    local ok, par = pcall(function() return g.model.Parent end)
    return ok and par ~= nil
end

-- The guards announce themselves. Each carries GuardState / Sleeping / TargetPlayer /
-- WakeTargetPlayer attributes: asleep they read GuardState="Sleeping", Sleeping=true and
-- an empty target. So "is a boss awake and after ME" is a direct question, not something
-- to infer from closing distance - which was hopeless anyway, because a stationary guard
-- and a charging one close the gap identically when you are the one running.
-- MOVEMENT, not attributes.
--
-- The guards publish exactly what we want - GuardState, TargetPlayer, Sleeping - and it
-- cannot be used. GetAttribute crashes this executor at any real polling rate: a bare
-- loop doing nothing but GetAttribute on these eleven models, with the script not even
-- loaded, took Matcha down in under six seconds. That single test explained every
-- crash today and disproved three theories I had already "fixed".
--
-- So: watch what the guards DO. Position reads are the one thing measured safe all day.
-- A sleeping guard stands still; a chasing one moves. Crucially this measures the
-- GUARD'S OWN SPEED, not the distance between you - the earlier version used closing
-- distance and misfired constantly, because running at a stationary guard closes the
-- gap exactly as fast as one charging at you. A guard that is not moving can never
-- trigger this now, however close you get.
-- WAKING, detected the way the game shows it: a guard that wakes gains a child called
-- "GuardWakeHighlight" - the glow you see on it. That is an instance, so FindFirstChild
-- reaches it, and FindFirstChild is safe at any rate.
--
-- This restores the original behaviour after the attribute route had to be abandoned.
-- The guards do publish GuardState="Waking" directly, but GetAttribute is not dependable
-- in this executor: 55 calls in a row worked earlier in the day and a SINGLE call killed
-- the exec later in the same session. Anything built on it works until it suddenly does
-- not, which is worse than not having it.
--
-- The highlight is BRIEF - observed appearing and gone again inside half a second - so
-- it is polled at 10Hz and the sighting is latched by the caller. Waiting for the escape
-- delay while re-testing the condition would never fire, because by then the glow has
-- already gone.
local function wakingGuardNear(me)
    for _, g in ipairs(GU.list or {}) do
        if guardAlive(g) then
            local okr, r = pcall(function() return g.model:FindFirstChild("HumanoidRootPart") end)
            local okp, p = pcall(function() return r and r.Position end)
            if okp and p and (p - me).Magnitude < (FM.BossRange or 140) then
                local okh, hl = pcall(function()
                    return g.model:FindFirstChild("GuardWakeHighlight")
                end)
                if okh and hl then return true, g.area, (p - me).Magnitude end
            end
        end
    end
    return false
end


-- Are we holding an egg? Harder than it sounds, and the first three answers were wrong.
-- An egg is NOT a Tool in the character (that check sat false through 541 ragdolls), it
-- is not an attribute on the player or character, nothing egg-named is parented to you,
-- and no part sits within 8 studs of your hand.
--
-- The DropHeldEgg ScreenGui looked promising and is not usable either: its button
-- reports the same AbsoluteSize (281x87) whether or not an egg is held, because the
-- game hides it with Visible=false, which reads nil here.
--
-- What actually works, found by snapshotting the whole client while holding an egg and
-- again after delivering it and diffing: the carried egg is a TOP-LEVEL WORKSPACE MODEL
-- with a GUID name, welded to you. Deliver it and the model disappears from workspace.
-- An earlier scan missed it only because that check tested IsA("BasePart") and skipped
-- Models outright.
--
-- Verified in both directions: one such model sits on you while carrying, and zero are
-- within 200 studs while empty-handed.
-- NOT SOLVABLE on this client. Everything below was tested against a live held egg and
-- none of it distinguishes carrying from empty-handed:
--
--   Tool in the character ....... never appears (false through 541 ragdolls)
--   Player/Character attributes . nothing egg-related among the 11 published
--   Parts near your hand ........ nothing within 8 studs
--   Any workspace child ......... nothing within 25 studs but map geometry
--   Camera / LocalPlayer ........ AudioListener and the standard folders only
--   DropHeldEgg ScreenGui ....... exists, but Enabled/Visible read nil and its button
--                                 reports 281x87 whether held or not, because the game
--                                 hides it with Visible rather than disabling the GUI
--   GUID workspace models ....... churn constantly from other players' eggs; the one
--                                 that vanished across a delivery was coincidence
--
-- A full snapshot of workspace, every ScreenGui and the character, diffed across a
-- delivery, showed only unrelated changes. So the farm tracks the egg by its own
-- actions instead. Left here so nobody spends another evening on it.
local function carryingEgg() return false end

-- Targets are the egg slots, for the reasons above. The prompt attached to each is
-- what actually gets pressed, but there is no way to ask a prompt what it belongs to -
-- ActionText, ObjectText and Enabled all read nil - so position is the only link, and
-- standing on the slot puts you on its prompt.
local function farmTargets()
    local out = {}
    for _, p in ipairs(eggSlots()) do
        out[#out + 1] = { pos = p, area = areaOf(p) }
    end
    return out
end

-- A rare egg's slot gains a "RareAreaEggHighlight" child - the glow you see on it.
--
-- Read from a CACHE, refreshed once a second by the night watch, never per tick. The
-- first attempt at this did the child lookup inside the target loop, which meant an
-- extra 55 lookups every tick at 30Hz on top of everything else. Rare eggs sit there
-- for a while; a second of staleness costs nothing and keeps the hot path cheap.
--
-- Reading WHICH rarity is impossible: the label above each egg is a TextLabel and this
-- executor returns the literal string "failed to fetch text" for it, so Divine, Eternal
-- and Secret cannot be told apart. Rare or not is all there is.
local function looksRare(t)
    if not t or not t.pos then return false end
    local key = string.format("%d_%d_%d", t.pos.X, t.pos.Y, t.pos.Z)
    return (_G.FARM.rareSet or {})[key] == true
end

-- ---- egg identification ----
-- Every egg type has a template model in ReplicatedStorage.Assets.Models.Eggs, named
-- after its pet - 115 of them. World eggs are clones of those, so an egg can be
-- identified by shape.
--
-- The fingerprint is the set of child part VOLUMES expressed as ratios of the largest
-- part, which makes it scale-invariant. That matters: raw volumes match the templates
-- almost perfectly (98 of 115 unique) but almost nothing in the world, because world
-- eggs are scaled - the same trap that made item naming impossible in the AR2 script.
-- With ratios, Whale Shark and Galaxy Gecko resolve uniquely, and Centapede narrows to
-- three of which only it appears in Cosmic.
local EGG_FP = nil
-- Ratio vector, largest part first. Sorted by size rather than compared exactly,
-- because the same egg reads a different number of parts at different slots - some
-- children's Size comes back unreadable - so an exact fingerprint match is far too
-- brittle. Comparison is scored with a tolerance instead.
-- The shape of the three biggest parts, as aspect ratios (X/Y and Z/Y). Scale-invariant
-- per part, and far more discriminating than relative volumes: volume ratios could not
-- separate Galaxy Gecko from Camel, while aspect ratios put a clear margin between them.
local function eggFingerprint(m)
    local parts = {}
    local okc, kids = pcall(function() return m:GetChildren() end)
    if not okc or not kids then return nil end
    for _, c in ipairs(kids) do
        local okn, n = pcall(function() return c.Name end)
        local okcl, cl = pcall(function() return c.ClassName end)
        if okn and okcl and n ~= "Hitbox" and cl ~= "ProximityPrompt" then
            local oks, s = pcall(function() return c.Size end)
            if oks and s and s.Y > 0 then
                parts[#parts + 1] = { v = s.X * s.Y * s.Z, ax = s.X / s.Y, az = s.Z / s.Y }
            end
        end
    end
    if #parts < 2 then return nil end
    table.sort(parts, function(a, b) return a.v > b.v end)
    local out = {}
    for i = 1, math.min(3, #parts) do
        out[#out + 1] = parts[i].ax
        out[#out + 1] = parts[i].az
    end
    return out
end

local function eggScore(a, b)
    local n = math.min(#a, #b)
    if n < 4 then return 9 end
    local sum = 0
    for i = 1, n do sum = sum + math.abs(a[i] - b[i]) end
    return sum / n
end

local function buildEggFingerprints()
    if EGG_FP then return EGG_FP end
    EGG_FP = {}
    local RS = game:GetService("ReplicatedStorage")
    local ok, folder = pcall(function()
        return RS.Assets and RS.Assets.Models and RS.Assets.Models:FindFirstChild("Eggs")
    end)
    if not ok or not folder then return EGG_FP end
    local okc, kids = pcall(function() return folder:GetChildren() end)
    if not okc or not kids then return EGG_FP end
    for _, m in ipairs(kids) do
        local r = eggFingerprint(m)
        if r then EGG_FP[#EGG_FP + 1] = { name = tostring(m.Name), r = r } end
    end
    return EGG_FP
end

-- Best-scoring template, but only when the answer is CLEAR: a low error and a decent
-- margin over the runner-up. Anything else returns nil - "unknown" is a useful answer
-- and a wrong name is not.
--
-- The previous version resolved ambiguity by preferring whichever candidate happened to
-- be one of the rift targets for that area. That is confirmation bias in code: a Frog
-- egg sitting in Cosmic was reported as a Centapede purely because Centapede was what
-- we wanted, and it produced a confident "4 Centapede eggs on the map" that was not
-- real. Nothing here is allowed to know what we are hoping for.
-- Deliberately loose enough to be useful and strict enough to stay honest. About two
-- thirds of the map's eggs get a confident name; the rest return nil.
--
-- Being wrong here is cheap by design: the rift farm only ever runs in the areas its
-- pets come from, and it takes every egg there eventually, so identification changes
-- the ORDER it visits them and nothing else. That is the only reason a partial, fuzzy
-- matcher is acceptable at all.
local EGG_MAXERR, EGG_MARGIN = 0.02, 0.005
local function eggNameFor(model, area)
    local list = buildEggFingerprints()
    local r = eggFingerprint(model)
    if not r or #list == 0 then return nil end
    -- everything that fits, not just the winner: whole families score identically
    local fits = {}
    local best
    for _, t in ipairs(list) do
        local s = eggScore(r, t.r)
        if s <= EGG_MAXERR then fits[#fits + 1] = { name = t.name, s = s } end
        if not best or s < best then best = s end
    end
    if #fits == 0 then return nil end
    table.sort(fits, function(a, b) return a.s < b.s end)
    -- a clear winner
    if #fits == 1 or (fits[2].s - fits[1].s) >= EGG_MARGIN then return fits[1].name end

    -- Otherwise the shape is shared by a whole family and only location separates them.
    -- Centapede, Dream Axolotl, Frog and Lava frog all score 0.0000 against each other -
    -- they are built from similarly proportioned parts - and the same family turns up in
    -- Lake, Volcano and Cosmic. Which one it is depends on where it is.
    --
    -- This is NOT the biased tie-break that was removed. That one preferred whichever
    -- candidate we happened to want, and invented four Centapede eggs. This asks a
    -- different question: which of these can spawn HERE. It is an inference rather than
    -- a fact, but a corroborated one - it names exactly three Centapede eggs in Cosmic,
    -- which is what was actually on screen.
    if area then
        for _, t in ipairs(_G.FARM.RiftTargets or {}) do
            if t.area == area then
                for _, c in ipairs(fits) do
                    if c.name == t.egg then return c.name end
                end
            end
        end
    end
    return nil    -- ambiguous and nothing local to break the tie
end

-- Which rift pets are in the backpack right now. Loose match on lowercase contains, so
-- "Whale Shark [X2]" still counts as a Whale Shark.
local function riftProgress()
    local lp = localPlayer()
    local okb, bp = pcall(function() return lp and lp:FindFirstChild("Backpack") end)
    local held, names = {}, {}
    if okb and bp then
        local okc, kids = pcall(function() return bp:GetChildren() end)
        if okc and kids then
            for _, d in ipairs(kids) do
                local okn, nm = pcall(function() return d.Name end)
                if okn and nm then names[#names + 1] = string.lower(tostring(nm)) end
            end
        end
    end
    local have, total = 0, 0
    for _, want in ipairs(_G.FARM.RiftTargets or {}) do
        total = total + 1
        local got = false
        for _, alt in ipairs(want.alts or { string.lower(want.name) }) do
            for _, nm in ipairs(names) do
                if string.find(nm, alt, 1, true) then got = true break end
            end
            if got then break end
        end
        held[want.name] = got
        if got then have = have + 1 end
    end
    return have, total, held
end
_G.SEHUB_RIFT = riftProgress

local function pressE(dur)
    if not keypress then return end
    pcall(function()
        keypress(0x45)
        task.wait(dur or 0.08)
        keyrelease(0x45)
    end)
end

