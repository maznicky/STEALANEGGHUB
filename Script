-- Headstart Hop is gone. It was worth a measured 0.27s a leg, and it competed with the
-- safe zone touch for the one moment that actually decides whether you get caught - so it
-- was buying a fraction of a second at the cost of the thing that keeps the egg.

-- ALWAYS TARGET. A standing order rather than an ordering: "wherever a Divine is, go and
-- get it." Two things make it different from Rare Priority, and both matter:
--
--   1. It IGNORES THE AREA FILTER. A rarity listed here is fetched from areas you have
--      not ticked - that is the whole point, and it is why it is a separate control
--      instead of another rung on the rarity ladder.
--   2. It outranks everything else, including the rift's wanted list. You asked for #1
--      priority and that is what this is; if a Divine and a rift pet are both on the map,
--      the Divine goes first.
--
-- Tiers are listed rarest-last to match the game's own order, which is the order they are
-- named in everywhere else in this file.
local RARITY_CHOICES = { "Common", "Uncommon", "Rare", "Epic", "Legendary",
                         "Mythic", "Cosmic", "Secret", "Eternal", "Divine" }
local alwaysDrop = farmSec:Dropdown("Always Target", {}, RARITY_CHOICES, true, function(sel)
    local set, n = {}, 0
    for _, nm in ipairs(sel or {}) do set[string.lower(nm)] = true n = n + 1 end
    FM.Always, FM.AlwaysN = set, n
end, "Rarities to fetch no matter what. An egg of a listed rarity is taken from ANY area, including ones you have not ticked below, and jumps ahead of everything else - Rare Priority, Size Priority and the rift's wanted pets. Leave empty to farm only the areas you pick. Needs the egg identified, which happens automatically while this has anything in it.")
pcall(function() alwaysDrop:Set({}) end)
FM.Always, FM.AlwaysN = {}, 0
FM.alwaysDrop = alwaysDrop

-- ONE DROPDOWN, not eleven toggles and a section of its own. Sits directly under Always
-- Target because the two are read together: Always Target is "fetch these wherever they
-- are", Areas is "and otherwise, farm here".
--
-- "All" is back, at the top of the list. It was removed once because the farm used to
-- treat an EMPTY selection as "everywhere", which is how unticking Snow turned into
-- farming the entire map. Picking All from a list is not that - it is an explicit choice,
-- and an empty list still means nothing is farmed.
local ALL_AREAS = "All"
local areaNames = { ALL_AREAS }
for _, b in ipairs(AREA_BOUNDS) do areaNames[#areaNames + 1] = b.name end
-- ARGUMENT ORDER IS (name, DEFAULT, CHOICES, multi, callback, tooltip) - default comes
-- BEFORE choices, which is the opposite way round to most menu libraries and is easy to
-- get wrong. With them swapped the dropdown stored choices={} and default={11 areas}, so
-- clicking it showed an empty list: the areas had been handed to it as a pre-selection
-- rather than as the things you can pick.
local areaDrop = farmSec:Dropdown("Areas", {}, areaNames, true, function(sel)
    -- Rebuilt rather than mutated: the callback hands back the WHOLE selection, so
    -- diffing it against the old table would only be a way to get them out of step.
    local set, all = {}, false
    for _, nm in ipairs(sel or {}) do
        if nm == ALL_AREAS then all = true else set[nm] = true end
    end
    -- All wins outright rather than merging: ticking All and Snow together means all, and
    -- expanding it into the eleven names here keeps every downstream check a plain
    -- FM.Areas[area] lookup instead of "area is ticked OR the all flag is set", which is
    -- the kind of second condition that gets forgotten at one call site out of four.
    if all then
        set = {}
        for _, b in ipairs(AREA_BOUNDS) do set[b.name] = true end
    end
    FM.Areas, FM.AllAreas = set, all
end, "Which areas to farm, in the game's own west-to-east map order. Pick All for the whole map, or tick as many individual areas as you like. Nothing selected means nothing is farmed - it does not quietly mean everything. Always Target above ignores this list entirely.")
-- Start with nothing selected, and say so explicitly rather than trusting the default -
-- the menu remembers what a control was last set to and replays it over whatever this
-- file declares, which is the same mechanism that brought Auto Farm back on at load.
pcall(function() areaDrop:Set({}) end)
FM.Areas, FM.AllAreas = {}, false
FM.areaDrop = areaDrop
-- Everything above this line is "what to do"; everything below is "how fast". The
-- divider is the whole reason the section reads as two short lists instead of one long one.
farmSec:Divider()
farmSec:Slider("Run Speed", 300, 10, 40, 300, " studs/s", function(v) FM.Speed = v end,
    "300 is the ceiling, measured: it gives 288 studs/s actual. 320 does NOT - the server rubber-bands it down to 42, slower than walking, and 430 kills you outright. The slider stops at 300 for that reason.")
farmSec:Slider("Big Egg Carry Speed", 280, 10, 40, 300, " studs/s", function(v) FM.BigCarrySpeed = v end,
    "Speed used while carrying an egg wider than 6 studs. A big egg is welded into your physics assembly and the server refuses the positions a fast run produces - a 13.5 wide egg managed 32 studs/s at a commanded 300, and ended in a death, against 220 for a small one. Lower this if big eggs still rubber-band.")
farmSec:Slider("Anti-Boss Delay", 0.15, 0.05, 0, 2, " s", function(v) FM.WakeDelay = v end,
    "How long after picking up an egg before Auto Anti-Boss fires. 0 leaves the instant the egg is in your hands. Titan Temple's guard wakes faster than the rest and uses a shorter delay automatically - this will never make it slower.")
farmSec:Slider("Boss Reset Wait", 0, 0.5, 0, 10, " s", function(v) FM.PostDeliver = v end,
    "Pause at the safe zone after handing an egg over, before setting off again. Lets a guard that chased you walk back to its post. Mainly for farming without Auto Anti-Boss.")
FM.ui = farmSec:Label("off")

-- Same treatment the steal settings get, and for the same reason: building the menu fires
-- every slider callback, so whatever they hand back is the last word regardless of what was
-- assigned at the top of this file - which is how Hold Time ended up at 1.00s and Escape
-- Delay silently came back as 0.15 across a reload. These are the values each load STARTS
-- at; move the sliders in-session whenever you want.
--
-- Anti-Boss Delay is deliberately NOT pinned here any more. It has a real default now
-- (0.15) that you chose, so forcing it would fight the slider rather than protect it.
for k, want in pairs({ GrabHold = 1.3 }) do
    if FM[k] ~= want then
        warn(string.format("[Steal An Egg] menu returned %s=%s - starting at %s",
            k, tostring(FM[k]), tostring(want)))
        FM[k] = want
    end
end

local riftSec = farm:Section("Auto Rift-Farm", "Full")
riftSec:Label("Hunts for all the possible pets within the selected Rift")
riftSec:Label("Egg(s). You can prioritize the 3 pets that are currently")
riftSec:Label("wanted in the rift, or prioritize the rarest pets that can")
riftSec:Label("possibly be within those rifts. You can add both priorities")
riftSec:Label("making you target the rarest out of the 3 pets first.")
riftSec:Label("Shares the same settings as the default Auto Farm.")
-- Handle kept for the same reason as Auto Farm's: this one starts the farm too, so a
-- remembered tick mark would set the character running at load.
local riftToggle
riftToggle = riftSec:Toggle("Auto Rift-Farm", false, function(v)
    FM.Rift = v
    if v then
        -- Ask the game what it wants before deciding where to go, rather than trusting
        -- the values this file shipped with.
        refreshRiftTargets()
        -- Remember what to put back. Turning this on changes the area filter and may
        -- start the farm; without recording that, switching it off left the farm
        -- running on two areas and looked like it could not be disabled at all.
        FM.riftPrevAreas = FM.Areas
        FM.riftStartedFarm = false

        -- Areas come from the banner picks now, not from where the current three pets
        -- happen to live. The pets get rerolled constantly; the banner's four areas do
        -- not, so farming those banks eggs for whatever it asks for next.
        applyRiftAreas()
        -- Start the farm too. Setting the filter and the target list without turning
        -- the farm on just looks broken - nothing moves and nothing says why.
        -- Instant Steal is left alone: it has its own toggle and its own tab.
        if not FM.On then
            FM.On = true
            FM.riftStartedFarm = true
        end
        FM.RiftState = tostring(FM.RiftAreaNote or "farming")
        notify("Rift Farm", tostring(FM.RiftAreaNote or "farming"), 4)
        -- And say what is actually out there, which is the whole reason to look at the
        -- screen when you switch this on.
        task.spawn(function()
