-- The escape gets its OWN loop, on the tightest interval in the script, because it
-- cannot afford to wait for anything else. When it lived inside the farm loop it was
-- blocked by the very stage that needs it most: while waiting to deliver an egg, that
-- loop polls at 0.25s intervals for up to 25 seconds, so being grabbed mid-carry went
-- unanswered for as long as a quarter of a second - long enough to lose the egg. It
-- also only ran while the farm was on, leaving manual play unprotected.
-- Counters, because this loop failed silently once and no amount of reading the code
-- explained it. If escapes are not happening, these say which half is at fault: ticks
-- climbing with ragSeen flat means the detection never fired; both climbing with
-- escapes flat means the guard conditions blocked it.
_G.SEHUB_WATCH = { ticks = 0, ragSeen = 0, escapes = 0, blocked = 0, lastRag = "never" }
-- Chase watch. This is the escape trigger that matters; the ragdoll watch below is now
-- only a backstop for when this one is too slow.
SESPAWN("boss chase watch", function()
    local hist = {}
    while _G.SEHUB_GEN == GEN do
        -- Refreshed often, because a stale guard handle is what crashed this loop.
        if (tick() - (GU.at or 0)) > 1.0 then GU.at = tick(); refreshGuards() end
        -- NOT `local ok, p = root and pcall(...)`. An `and` expression truncates a
        -- multiple return to one value, so the position silently came back nil forever
        -- and the whole chase check did nothing. Same trap as the cam-and-pcall bug in
        -- the AR2 script.
        local root = myRoot()
        local pos
        if root then
            local okp, p = pcall(function() return root.Position end)
            if okp then pos = p end
        end
        if pos then
            -- THE GRAB IS THE TRIGGER. Measured from five manual escapes during real
            -- play: 0.3, 0.2, 0.3, 0.3, 0.3 seconds after taking an egg, every time,
            -- with no guard waking anywhere near - the only wakes in that window were
            -- 957 and 2272 studs away. Reacting to a boss was never what worked; the
            -- egg leaving the nest is the cue.
            --
            -- This was the original design, dropped after it "fired too early". It did
            -- not: it teleported to FM.Home plus a 35 stud offset, an invented spot that
            -- happened to be lethal. A position bug diagnosed as a timing one.
            -- The per-area override may only make the escape FASTER. It used to replace
            -- your setting outright, so Titan Temple's 0.05 would have overridden a 0 you
            -- had deliberately chosen - an override that slows down the thing you asked to
            -- speed up is just a bug wearing a table.
            local myDelay = FM.WakeDelay or 0.15
            local areaOverride = FM.grabArea and FM.AreaDelay[FM.grabArea]
            if areaOverride and areaOverride < myDelay then myDelay = areaOverride end
            if FM.hasEgg and FM.grabbedAt and not FM.grabEscaped
               and (tick() - FM.grabbedAt) >= myDelay then
                FM.grabEscaped = true
                if FM.AutoBoss and AB.Zone then
                    local W = _G.SEHUB_WATCH
                    W.chaseEscapes = (W.chaseEscapes or 0) + 1
                    gotoZone(true)
                    FM.LastEscape = string.format("%s, %.2fs after grab",
                        tostring(FM.grabArea or "?"), tick() - FM.grabbedAt)
                    FM.LastEscapeAt = tick()
                    FM.State = "took an egg - escaped home"
                end
            end

            local waking, area, d = wakingGuardNear(pos)
            -- LATCH the sighting. The highlight lives well under a second, so a design
            -- that re-tests the condition while counting down the delay would reset the
            -- timer the moment the glow vanished and never fire at all.
            -- Not within 2s of an escape we just made. The guard wakes at the exact
            -- moment you steal - measured at 0.00s after the grab, 9 to 18 studs away -
            -- so without this the grab trigger and the wake trigger both fire, half a
            -- second apart, and the second teleport interrupts the run home.
            local justEscaped = (tick() - (AB.lastEscape or 0)) < 2.0
            if waking and not FM.wakeAt and not justEscaped then
                FM.wakeAt = tick()
                FM.wakeArea = tostring(area)
                FM.BossDist = d or -1
                FM.BossHunting = FM.wakeArea
            end
            if FM.wakeAt then
                local waited = tick() - FM.wakeAt
                if waited >= (FM.WakeDelay or 0.8) then
                    if FM.AutoBoss and AB.Zone then
                        local W = _G.SEHUB_WATCH
                        W.chaseEscapes = (W.chaseEscapes or 0) + 1
                        gotoZone(true)
                        FM.State = string.format("%s guard woke %.1fs ago (%.0f studs) - escaped",
                            tostring(FM.wakeArea), waited, FM.BossDist or -1)
                        -- Kept separately, because FM.State is shared by every subsystem
                        -- and the next night reload or grab overwrites it within seconds
                        -- - which made a working escape look like it never happened.
                        FM.LastEscape = string.format("%s guard, %.0f studs, %.1fs delay",
                            tostring(FM.wakeArea), FM.BossDist or -1, waited)
                        FM.LastEscapeAt = tick()
                    end
                    FM.wakeAt, FM.wakeArea = nil, nil
                    FM.BossHunting = nil
                    task.wait(1.0)   -- let the escape settle before arming again
                end
            end
        end
        -- 10Hz. The wake highlight was observed appearing and disappearing inside half a
        -- second, so a slower poll would miss it outright. These are FindFirstChild
        -- calls, which are safe at this rate - unlike the attribute reads they replaced.
        task.wait(0.1)
    end
end)

SESPAWN("anti-boss watch", function()
    local wasDown = false
    while _G.SEHUB_GEN == GEN do
        local W = _G.SEHUB_WATCH
        W.ticks = W.ticks + 1
        local down = isRagdolled()
        if down then
            W.ragSeen = W.ragSeen + 1
            W.lastRag = string.format("%.1fs ago", 0)
            W.lastRagAt = tick()
        end
        if FM.AutoBoss and AB.Zone then
            -- fire on the EDGE, so one grab is one escape rather than a burst of them
            -- NO COOLDOWN on a genuine ragdoll. There used to be a 0.75s guard here and
            -- it suppressed every rescue that mattered: grabbing an egg teleports you
            -- and stamps lastEscape, a guard catches you a fraction of a second later,
            -- and the guard clause then threw away the escape. Measured over three
            -- ragdolls: 3 edges detected, 3 blocked, 0 escapes, 3 deaths. The edge test
            -- alone is enough to stop it firing repeatedly.
            -- Fires on ANY ragdoll, carrying or not. Gating it on knowing you hold an
            -- egg is impossible here, and gating on the farm's own flag left manual play
            -- unprotected - 0 escapes across 759 observed ragdolls between the two
            -- attempts. A ragdoll only happens when something has genuinely caught you,
            -- and a needless walk back is cheaper than the void.
            if down and not wasDown then
                W.escapes = W.escapes + 1
                -- EXACTLY what pressing the key does, nothing else. The manual escape
                -- has worked perfectly throughout, so this calls the same function
                -- rather than a second implementation of it.
                --
                -- Two separate mistakes got us here. First a 0.75s cooldown sat in front
                -- of this call and suppressed every rescue, because grabbing an egg
                -- stamps lastEscape and the guard catches you a moment later. Then, in
                -- removing the cooldown, this call was ALSO swapped for a hand-rolled
                -- hold loop - so the obvious combination, working function with no gate,
                -- was never actually run. Two changes at once, neither one tested alone.
                gotoZone(true)
                FM.State = "caught - escaped"
            end
            wasDown = down
        else
            W.blocked = W.blocked + (down and 1 or 0)
        end
        task.wait(0.02)
    end
end)

-- Death watch. Health hitting zero is easy to miss - the character is destroyed and
-- replaced, so a loop holding a reference just sees it go stale. Watching the Character
-- instance change catches both, and it is the same trap that cost half an hour in AR2
-- when cached references outlived a respawn.
SESPAWN("death watch", function()
    local lastChar, wasDead = nil, false
    while _G.SEHUB_GEN == GEN do
        local lp = localPlayer()
        local okc, ch = pcall(function() return lp and lp.Character end)
        if okc and ch then
            if lastChar ~= nil and ch ~= lastChar then
                FM.needRally = true      -- respawned into the base
                FM.Deaths = (FM.Deaths or 0) + 1
                FM.hasEgg = false        -- whatever you were carrying is gone
                FM.depositAt = nil
            end
            lastChar = ch
            local hum = ch:FindFirstChild("Humanoid")
            local okh, h = pcall(function() return hum and hum.Health end)
            local dead = (okh and type(h) == "number" and h <= 0)
            if dead and not wasDead then
                FM.needRally = true
                FM.Deaths = (FM.Deaths or 0) + 1
            end
            wasDead = dead
        end
        task.wait(0.2)
    end
end)

-- Night reload watch. Lighting is no help - ClockTime, TimeOfDay and Brightness all
-- read nil under this executor - so the cycle is detected from its actual effect: the
-- egg slots being torn down and rebuilt. When the set changes wholesale, the visited
-- cooldowns are cleared so the farm immediately re-sweeps the fresh eggs instead of
-- sitting out the cooldown on slots that are no longer the same eggs.
SESPAWN("night watch", function()
    while _G.SEHUB_GEN == GEN do
        local folder = workspace:FindFirstChild("AreaEggSlotsClient")
        if folder then
            local okc, kids = pcall(function() return folder:GetChildren() end)
            if okc and kids then
                -- signature: count plus a cheap sum of name lengths, enough to notice a
                -- wholesale swap without stringing 55 names together every second
                -- COUNT, not a name signature. The first version summed slot name
                -- lengths, and slot names alternate between 32-character GUIDs and
                -- 44-character "FirstAreaEgg_..._Forest:Slot_005" strings - so two
                -- slots changing hands moved the signature by ~24 and tripped the
                -- threshold. Dying and watching one egg respawn read as nightfall.
                --
                -- Measured through an actual night: the slot folder empties to about 5
                -- and then refills to 55 over four seconds, seven per half-second. A
                -- single egg returning changes the count by one. Nothing in between.
                -- Rare eggs, scanned here rather than in the target loop. One pass a
                -- second over the slots, cached by position key for looksRare().
                local rare, rareN = {}, 0
                for _, m in ipairs(kids) do
                    local okh, hl = pcall(function()
                        return m:FindFirstChild("RareAreaEggHighlight")
                    end)
                    if okh and hl then
                        local hb = m:FindFirstChild("Hitbox")
                        local okp, p = pcall(function() return hb and hb.Position end)
                        if okp and p then
                            rare[string.format("%d_%d_%d", p.X, p.Y, p.Z)] = true
                            rareN = rareN + 1
                        end
                    end
                end
                FM.rareSet, FM.RareCount = rare, rareN

                -- Identify egg types, once a second, while anything needs it: the rift
                -- farm to find its pets, and Rare Priority to know a Yeti from a Penguin.
                -- Skipped otherwise: it reads every child's Size across 55 slots, which
                -- is fine at 1Hz but has no business running when nothing uses it.
                if FM.Rift or FM.RarePri then sweepEggNames() end

                -- rift progress, checked here too rather than in another loop
                if FM.Rift then
                    local have, total, held = riftProgress()
                    FM.RiftHave = held
                    -- Only a COMPLETE read may stop the farm. A partial one satisfies
                    -- "have >= total" as soon as the two pets it could see are done, which
                    -- would park you at the safe zone with a third still outstanding.
                    if have >= total and total >= 3 and FM.RiftComplete then
                        FM.RiftState = string.format("ALL %d PETS - rift ready", total)
                        if FM.On then
                            FM.On = false
                            FM.riftStartedFarm = false   -- it is already stopped
                            notify("Rift Farm", "All three pets collected - farm stopped", 5)
                            print("[Steal An Egg] rift pets complete:")
                            for _, t in ipairs(FM.RiftTargets or {}) do
                                print("   " .. t.name .. " (" .. t.area .. ")")
                            end
                        end
                    else
                        -- Say what is actually on the map, not just what is missing from
                        -- the backpack. These eggs rotate: a target can be at zero for a
                        -- while, and without this the farm looks stuck when it is really
                        -- just waiting for the right egg to spawn.
                        local spawned = {}
                        for _, nm in pairs(FM.eggName or {}) do
                            spawned[nm] = (spawned[nm] or 0) + 1
                        end
                        local missing, onMap = {}, 0
                        for _, t in ipairs(FM.RiftTargets or {}) do
                            if not held[t.name] then
                                local c = spawned[t.egg] or 0
                                onMap = onMap + c
                                missing[#missing + 1] = string.format("%s(%d)", t.name, c)
                            end
                        end
                        FM.RiftState = string.format("%d/%d - need %s%s",
                            have, total, table.concat(missing, ", "),
                            (onMap == 0) and " - none spawned, waiting" or "")
                    end
                end

                local n = #kids
                if FM.slotCount and (n - FM.slotCount) >= 10 then
                    FM.visited = {}
                    FM.Reloads = (FM.Reloads or 0) + 1
                    FM.State = "eggs reloaded (night) - sweeping again"
                    notify("Auto Farm", "Night reload - fresh eggs", 3)
                    -- Report what the respawn actually brought, once it has finished
                    -- arriving. The folder refills over about four seconds, so asking
                    -- immediately would count a third of the map and call the rest missing.
                    if FM.Rift then
                        task.spawn(function()
                            task.wait(5)
                            if _G.SEHUB_GEN ~= GEN or not FM.Rift then return end
                            sweepEggNames()
                            notifyRiftSpawns("Eggs respawned")
                        end)
                    end
                end
                FM.slotCount = n
            end
        end
        task.wait(1.0)
    end
end)

-- One tick of the farm, as a function so each phase can bail out with `return`.
-- Luau has no goto, and nesting the phases as if/else instead produced a pyramid deep
-- enough that the grab logic sat sixteen levels in.
local function farmStep()
    if not FM.On then task.wait(0.2) return end
    local root = myRoot()
    if not root then
        FM.State = "waiting for character"
        task.wait(0.5)
        return
    end
    local okp, me = pcall(function() return root.Position end)
    if not okp or not me then task.wait(0.2) return end
    do
        do
            do
                do
                    -- (the caught check runs in its own loop - see "anti-boss watch")
                    local now = tick()

                    -- PHASE 1: after a death, go to the rally point BEFORE anything
                    -- else. Dying returns you to your base, and running at an egg from
                    -- there means crossing whatever geometry sits between - which is
                    -- how you end up wedged against a wall. The rally point is a spot
                    -- you have confirmed has a clear run to the areas, so every
                    -- respawn starts from the same known-good place.
                    local homeP = homePos()
                    if FM.needRally and homeP then
                        local d = (Vector3.new(homeP.X, me.Y, homeP.Z) - me).Magnitude
                        if d > (FM.RallyReach or 14) then
                            local flat = Vector3.new(homeP.X - me.X, 0, homeP.Z - me.Z)
                            local m = flat.Magnitude
                            if m > 0.01 then
                                local sp = FM.Speed
                                if d < (FM.Brake or 60) then
                                    sp = math.max(25, FM.Speed * (d / (FM.Brake or 60)))
                                end
                                local v = (flat / m) * sp
                                pcall(function()
                                    root.AssemblyLinearVelocity =
                                        Vector3.new(v.X, -(FM.Stick or 18), v.Z)
                                end)
                            end
                            FM.State = string.format("died - returning to rally point, %.0f studs", d)
                            task.wait(0.03)
                            return
                        else
                            FM.needRally = false
                            FM.State = "at rally point - resuming"
                        end
                    end

                    -- PHASE 2: holding an egg means the job is to deliver it, not to
                    -- take another. RUN back to the safe zone rather than teleporting -
                    -- the teleport is the emergency escape, this is the delivery.
                    -- Did that grab actually land? Answered while running, not while
                    -- standing still. The slot model is destroyed server-side within a
                    -- round trip, so anything still there after 0.8s was never taken.
                    if FM.pendingSlot ~= nil then
                        if slotGone(FM.pendingSlot) then
                            FM.Confirmed = (FM.Confirmed or 0) + 1
                            if FM.grabRetry and FM.pendingKey then
                                FM.grabRetry[FM.pendingKey] = nil
                            end
                            FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                        elseif (tick() - (FM.pendingAt or 0)) > 0.8 then
                            local key = FM.pendingKey
                            FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                            FM.grabRetry = FM.grabRetry or {}
                            local tries = (FM.grabRetry[key or ""] or 0) + 1
                            FM.grabRetry[key or ""] = tries
                            if tries < 2 then
                                -- Turn around and take it properly. Clearing the cooldown
                                -- matters: leave it set and the retry picks a DIFFERENT
                                -- egg, which is what had you cycling between two areas.
                                FM.hasEgg = false
                                if key then FM.visited[key] = nil end
                                FM.State = "grab did not register - going back for it"
                                task.wait(0.05)
                                return
                            end
                            -- Twice now. Keep the egg flag and deliver anyway rather than
                            -- bouncing forever: a wasted trip home is a bad outcome, a farm
                            -- that never delivers is a broken one.
                            FM.Misses = (FM.Misses or 0) + 1
                        end
                    end

                    if FM.hasEgg and homeP then
                        local zp = homeP
                        local d = (Vector3.new(zp.X, me.Y, zp.Z) - me).Magnitude
                        if d > (FM.ZoneReach or 12) then
                            local flat = Vector3.new(zp.X - me.X, 0, zp.Z - me.Z)
                            local m = flat.Magnitude
                            if m > 0.01 then
                                -- Full run speed. The separate, slower carry speed was
                                -- a guess that carrying slows you server-side; in
                                -- practice it just made the trip home crawl.
                                local sp = FM.Speed
                                if d < (FM.Brake or 60) then
                                    sp = math.max(40, sp * (d / (FM.Brake or 60)))
                                end
                                local v = (flat / m) * sp
                                pcall(function()
                                    root.AssemblyLinearVelocity =
                                        Vector3.new(v.X, -(FM.Stick or 18), v.Z)
                                end)
                            end
                            FM.State = string.format("carrying an egg - running home, %.0f studs (%d/s)",
                                d, FM.Speed)
                        else
                            pcall(function()
                                root.AssemblyLinearVelocity = Vector3.new(0, -(FM.Stick or 18), 0)
                            end)
                            -- Standing on the spot should hand it over. If it does not,
                            -- give up rather than parking here permanently - a grab
                            -- that never actually landed would otherwise end the run.
                            FM.depositAt = FM.depositAt or tick()
                            local held = tick() - FM.depositAt
                            -- Standing on the delivery point for a couple of seconds is
                            -- taken as delivered. There is no readable signal for the
                            -- egg leaving your hands, so this is a timer, not a fact.
                            if held > (FM.DeliverSettle or 2.5) then
                                FM.hasEgg = false
                                FM.depositAt = nil
                                -- Never carry a slot reference past the run it belongs to.
                                FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                                -- Wait before setting off again. Sprinting straight back
                                -- out means arriving at the next egg while the guard that
                                -- chased you is still out of position and still hostile,
                                -- and it throws you the moment you have something in your
                                -- hands. Standing still for a couple of seconds lets it
                                -- walk back to its post first.
                                local pause = FM.PostDeliver or 2.0
                                if pause > 0 then
                                    FM.State = string.format("delivered - letting the boss reset (%.1fs)", pause)
                                    local t0d = tick()
                                    while (tick() - t0d) < pause and FM.On do
                                        pcall(function()
                                            root.AssemblyLinearVelocity =
                                                Vector3.new(0, -(FM.Stick or 18), 0)
                                        end)
                                        task.wait(0.05)
                                    end
                                end
                                FM.State = "delivered - back to farming"
                                task.wait(0.05)
                                return
                            end
                            if held > (FM.DepositWait or 20) then
                                FM.hasEgg = false
                                FM.depositAt = nil
                                FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                                FM.visited = {}
                                FM.State = "delivery did not register - back to farming"
                                task.wait(0.3)
                                return
                            end
                            FM.State = string.format("at the delivery point - handing over (%.0fs)", held)
                            task.wait(0.2)
                        end
                        task.wait(0.03)
                        return
                    end

                    -- nothing in hand: the delivery clock resets for next time
                    FM.depositAt = nil

                    -- PHASE 3: nothing in hand, so go take one.
                    --
                    -- Rift farming takes EVERY egg in the selected banners' areas, and
                    -- only orders them by what the rift is asking for right now. An
                    -- earlier version filtered instead of ordered - it skipped anything
                    -- that was not one of the three current pets - which sounds more
                    -- efficient and is not: the three get rerolled constantly, so a
                    -- Chillin Chilli skipped this hour is a Chillin Chilli you have to go
                    -- back for next hour. Banking the whole pool is the efficient play;
                    -- priority just decides what to grab first.
                    local best, bestScore
                    local anyAllowed = 0        -- targets in range of the filter at all
                    for _, t in ipairs(farmTargets()) do
                        -- Explicit: All Areas, or this area was ticked. No inferring
                        -- intent from an empty table - that is what turned "I unticked
                        -- Snow" into "farm the entire map".
                        local allowed = (FM.Areas[t.area] == true)
                        local key = string.format("%d_%d_%d", t.pos.X, t.pos.Y, t.pos.Z)
                        local cool = (now - (FM.visited[key] or 0)) > FM.Cooldown
                        if allowed then anyAllowed = anyAllowed + 1 end

                        if allowed and cool then
                            local d = (t.pos - me).Magnitude
                            local en = FM.eggName[key]
                            -- Priority is a LADDER, and distance only ever breaks ties
                            -- within a rung. 20000 per rank is wider than the map is long
                            -- (about 4600 studs corner to corner), so a Secret on the far
                            -- side always outranks a Legendary next door - which is what
                            -- "rarest first" has to mean to be worth anything.
                            --
                            -- The two priorities STACK rather than compete, which is what
                            -- makes "the rarest of the current eggs" fall out for free: a
                            -- wanted egg is lifted clear of everything else by the 10M, and
                            -- the rarity rung then decides the order among the wanted ones.
                            local pri = 0
                            local wanted = false
                            if FM.Rift and FM.RiftPrio and en then
                                for _, want in ipairs(FM.RiftTargets or {}) do
                                    if want.egg == en and not (FM.RiftHave or {})[want.name] then
                                        wanted = true
                                        pri = pri + 10000000    -- above every rarity
                                        break
                                    end
                                end
                            end
                            -- One Rare Priority for everything, shared with the rift section.
                            -- It briefly had its own copy, which was two switches for one
                            -- idea and made "which of these is ordering my eggs" a question
                            -- you had to think about.
                            if FM.RarePri then
                                local rank = rarityRank(en)
                                if rank > 0 then
                                    pri = pri + rank * 20000
                                elseif looksRare(t) then
                                    -- Unidentified, but wearing the rare glow. Worth more
                                    -- than a known common and less than a known Legendary,
                                    -- so it slots in at the middle rung rather than
                                    -- pretending to a precision we do not have.
                                    pri = pri + 5 * 20000
                                end
                            end
                            local score = d - pri
                            if not bestScore or score < bestScore then
                                best, bestScore = t, score
                                best.key = key
                            end
                        end
                    end
                    if not best and anyAllowed == 0 then
                        -- The map is genuinely out of eggs in the areas we farm - not a
                        -- cooldown, not a filter mistake. Wait it out at the safe zone
                        -- rather than wherever the last steal left us: standing in an area
                        -- is only safe while empty-handed, and the respawn drops fresh
                        -- eggs everywhere at once, so home is the shortest average trip to
                        -- the next one.
                        local home = homePos()
                        local dh = home and (home - me).Magnitude or 0
                        if home and dh > 20 then
                            local flat = Vector3.new(home.X - me.X, 0, home.Z - me.Z)
                            local m = flat.Magnitude
                            if m > 0.01 then
                                local sp = FM.Speed
                                if dh < (FM.Brake or 60) then
                                    sp = FM.Speed * (dh / (FM.Brake or 60))
                                    if sp < 25 then sp = 25 end
                                end
                                local v = (flat / m) * sp
                                pcall(function()
                                    root.AssemblyLinearVelocity =
                                        Vector3.new(v.X, -(FM.Stick or 18), v.Z)
                                end)
                            end
                            FM.State = string.format("no eggs left - heading to the safe zone (%.0f studs)", dh)
                            task.wait(0.03)
                        else
                            pcall(function()
                                root.AssemblyLinearVelocity = Vector3.new(0, -(FM.Stick or 18), 0)
                            end)
                            FM.State = "waiting at the safe zone for eggs to respawn"
                            task.wait(0.5)
                        end
                        return
                    end
                    if not best then
                        FM.State = "nothing to farm (all on cooldown or no area on)"
                        task.wait(0.5)
                    else
                        local d = (best.pos - me).Magnitude
                        if d > FM.Reach then
                            -- Run there, glued to the floor, but SLOW DOWN on approach.
                            -- Driving at full speed until the moment you are in range
                            -- means arriving with all that momentum still on you: you
                            -- sail straight past and end up out of reach with the
                            -- prompt behind you. Speed is tapered from BRAKE_DIST so
                            -- the last stretch is walked, not sprinted.
                            local flat = Vector3.new(best.pos.X - me.X, 0, best.pos.Z - me.Z)
                            local m = flat.Magnitude
                            if m > 0.01 then
                                local sp = FM.Speed
                                local brakeAt = FM.Brake or 60
                                if d < brakeAt then
                                    sp = FM.Speed * (d / brakeAt)
                                    if sp < 25 then sp = 25 end   -- still enough to close
                                end
                                local v = (flat / m) * sp
                                pcall(function()
                                    root.AssemblyLinearVelocity =
                                        Vector3.new(v.X, -(FM.Stick or 18), v.Z)
                                end)
                            end
                            FM.State = string.format("running to %s, %.0f studs%s", best.area, d,
                                (d < (FM.Brake or 60)) and " (braking)" or "")
                        else
                            -- Full stop FIRST. A press while still sliding is a press
                            -- from wherever the slide takes you, which is how eggs were
                            -- being missed at point blank range.
                            for _ = 1, 3 do
                                pcall(function()
                                    root.AssemblyLinearVelocity =
                                        Vector3.new(0, -(FM.Stick or 18), 0)
                                end)
                                task.wait(0.03)
                            end
                            -- INSTANT PICK UP, the one piece kept from the reference
                            -- script. Patch this prompt, then READ THE HOLD TIME BACK:
                            -- a patched prompt takes an instant tap, an unpatched one
                            -- still wants its real hold, which is why some eggs looked
                            -- immune. Measured rather than assumed.
                            -- Instant Steal is a CHOICE, not an assumption. With it off,
                            -- nothing is patched and the egg is taken the way the game
                            -- intends - hold E for however long this prompt actually wants.
                            -- The farm used to switch the patch on behind your back and
                            -- then take the instant path regardless, so turning it off in
                            -- the menu changed nothing except that the taps stopped working.
                            if ST.On then _G.SEHUB_PATCHNEAR(best.pos, 30) end
                            local hd = _G.SEHUB_HOLDTIME(best.pos, 20)
                            -- Watch the actual egg, so the moment it is gone we stop
                            -- pressing and leave. Everything below used to run to
                            -- completion whether or not the egg had already been taken -
                            -- three presses at 0.11s each, or a flat 1.3s hold - which is
                            -- the standing-around you were seeing after the pickup.
                            local slot = slotAt(best.pos)
                            -- hd >= 0, not just hd < 0.05. A NEGATIVE hold time is not a
                            -- fast prompt, it is a nonsense reading - unpatched egg prompts
                            -- read back -0.5 - and `-0.5 < 0.05` is true, so the old test
                            -- classified every one of them as "already patched, tap it".
                            -- Three taps at a prompt that actually wants a real hold takes
                            -- nothing, and with no success check the farm set hasEgg anyway
                            -- and ran all the way home empty. That is the bug that made
                            -- instant steal look like it broke on its own.
                            if ST.On and hd ~= nil and hd >= 0 and hd < 0.05 then
                                -- press a few times: one press can land in the same frame
                                -- the prompt is still registering you as in range
                                for _ = 1, 3 do
                                    pcall(function()
                                        root.AssemblyLinearVelocity =
                                            Vector3.new(0, -(FM.Stick or 18), 0)
                                    end)
                                    pressE(0.05)
                                    if slotGone(slot) then break end
                                    task.wait(0.04)
                                end
                            else
                                -- Three cases, and the middle one is the one that was
                                -- getting this wrong:
                                --   hd known and sane -> hold it out, plus a margin
                                --   hd unknown or negative -> we have NO idea what this
                                --      prompt wants, so use the 2s you established works
                                --      by hand rather than a slider value that happened to
                                --      read 0.5 and was far too short to take anything
                                --   otherwise -> the configured fallback
                                local hold
                                if hd and hd > 0 then
                                    hold = hd + 0.3
                                else
                                    hold = 2.0
                                end
                                local cfg = FM.GrabHold or 1.3
                                if cfg > hold then hold = cfg end
                                -- Only a FALLBACK when the patch was meant to work. With
                                -- Instant Steal off this is simply how the egg is taken, and
                                -- counting it as a failure would make the diagnostics lie.
                                if ST.On then FM.Fallbacks = (FM.Fallbacks or 0) + 1 end
                                FM.State = string.format("holding E for %.1fs in %s", hold, best.area)
                                if keypress then pcall(function() keypress(0x45) end) end
                                local t0h = tick()
                                while (tick() - t0h) < hold do
                                    pcall(function()
                                        root.AssemblyLinearVelocity =
                                            Vector3.new(0, -(FM.Stick or 18), 0)
                                    end)
                                    -- Out the instant the egg is taken. A prompt that
                                    -- wants 2s of hold still releases the egg the moment
                                    -- it completes, so sitting out the rest of the timer
                                    -- is pure loss.
                                    if slotGone(slot) then break end
                                    task.wait(0.03)
                                end
                                if keyrelease then pcall(function() keyrelease(0x45) end) end
                            end
                            FM.visited[best.key] = now
                            FM.Taken = FM.Taken + 1

                            -- VERIFY. "Am I carrying an egg" is unanswerable on this client
                            -- - not a Tool, not an attribute, nothing near your hand - but
                            -- that was always the wrong question. The answerable one is
                            -- whether the EGG IS STILL THERE: taking it destroys the model,
                            -- so a slot that still exists means the grab failed.
                            --
                            -- Without this the farm assumed every press worked, so one
                            -- missed grab cost a full round trip home with nothing in hand,
                            -- and the counters happily reported it as an egg taken.
                            --
                            -- Only trusted when we actually have a handle on the slot. If
                            -- slotAt could not match one - the hitbox moved, the model was
                            -- renamed - `slot` is nil and we fall back to assuming success,
                            -- because refusing to ever set hasEgg would wedge the farm in a
                            -- loop pressing E at the same egg forever. Unknown is not the
                            -- same as failed.
                            --
                            -- Verification does NOT happen here. The model is destroyed by
                            -- the server, so it is still sitting there for a round trip
                            -- after a perfectly good grab - but waiting for it means
                            -- standing on the spot you just robbed, which is the delay that
                            -- gets you ragdolled. Two failed attempts at this:
                            --   check immediately -> called 8 of 11 good grabs a miss
                            --   wait 0.7s for it  -> correct, but reintroduced the delay
                            -- So: leave NOW, assume it worked, and confirm during the run
                            -- home. The check costs nothing there, and a grab that turns
                            -- out to have failed is caught within a second - having already
                            -- spent that second running in the right direction.
                            FM.pendingSlot = slot
                            FM.pendingKey  = best.key
                            FM.pendingAt   = tick()
                            FM.hasEgg = true
                            FM.grabbedAt = tick()
                            FM.grabEscaped = false    -- arm the post-grab escape
                            FM.grabArea = best.area   -- some areas need a faster escape
                            FM.State = string.format("took an egg in %s (%d) - running home",
                                best.area, FM.Taken)
                            -- Straight into the run, no settle. The delivery phase picks
                            -- it up on the very next tick, and the escape happens later
                            -- when a boss actually closes - running first means a failed
                            -- teleport still leaves you moving in the right direction
                            -- rather than standing on the spot you just robbed.
                            return
                            -- NO teleport here. Escaping on the grab spends the escape
                            -- before the boss has started moving, and by the time it
                            -- catches up the teleport is long finished - that is why
                            -- the manual key worked and this did not. Run home instead;
                            -- the chase watch fires the escape when a guard actually
                            -- starts closing on you.
                            task.wait(FM.AfterSteal or 0.4)
                        end
                    end
                end
            end
        end
    end
end

