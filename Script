-- Matcha delivers KeyCode as a raw number about as often as an Enum, and never
-- delivers gameProcessed, so every key test has to accept both forms. The letter is
-- converted to its virtual-key code because that is what iskeypressed wants.
-- The KeyCode a name maps to, asked of the engine rather than guessed from its letter.
-- string.byte was the old approach and it is wrong: Enum.KeyCode.F.Value is 102, the byte
-- of LOWERCASE f, while the code compared against byte("F") = 70. It also cannot express
-- F1 at all, which is 282.
local function keyCodeValue(name)
    if not name then return nil end
    local ok, v = pcall(function() return Enum.KeyCode[name].Value end)
    if ok and type(v) == "number" then return v end
    return nil
end

-- Matcha delivers KeyCode as a raw number about as often as an Enum, and its Enum names
-- come back as "KeyCode.F1" rather than "F1", so every comparison here has to accept all
-- three shapes. Both of the old branches were broken - the numeric one by the byte
-- mismatch above, the name one by the "KeyCode." prefix - which meant a keybind of F1
-- would simply never have fired.
local function keyMatches(input, letter)
    if not input or not letter then return false end
    local ok, kc = pcall(function() return input.KeyCode end)
    if not ok or kc == nil then return false end
    local want = keyCodeValue(letter)

    if type(kc) == "number" then
        if want and kc == want then return true end
        if #letter == 1 then
            return kc == string.byte(string.lower(letter))
                or kc == string.byte(string.upper(letter))
        end
        return false
    end

    local okv, v = pcall(function() return kc.Value end)
    if okv and want and v == want then return true end
    local okn, n = pcall(function() return kc.Name end)
    if okn and type(n) == "string" then
        local N, L = string.upper(n), string.upper(letter)
        if N == L then return true end
        if string.match(N, "%.([%w_]+)$") == L then return true end   -- "KEYCODE.F1"
    end
    return false
end
-- iskeypressed wants a WINDOWS virtual-key code, which is not the same thing as a byte.
-- For A-Z and 0-9 the uppercase byte happens to equal the VK code, which is why the old
-- one-liner worked - but only for those. F1 is VK 0x70, nowhere near byte("F") = 70
-- decimal, so a function-key bind polled the letter F instead.
local VK = {
    F1 = 0x70, F2 = 0x71, F3 = 0x72, F4 = 0x73, F5 = 0x74, F6 = 0x75,
    F7 = 0x76, F8 = 0x77, F9 = 0x78, F10 = 0x79, F11 = 0x7A, F12 = 0x7B,
    SPACE = 0x20, LSHIFT = 0xA0, RSHIFT = 0xA1, LCONTROL = 0xA2, RCONTROL = 0xA3,
    TAB = 0x09, LALT = 0xA4, RALT = 0xA5, BACKSPACE = 0x08, ENTER = 0x0D,
}
local function keyDown(letter)
    if not iskeypressed or not letter then return false end
    local up = string.upper(tostring(letter))
    local code = VK[up] or (#up == 1 and string.byte(up) or nil)
    if not code then return false end
    local ok, d = pcall(function() return iskeypressed(code) end)
    return (ok and d) and true or false
end

-- ---------------- scheduler health ----------------
-- A watchdog that measures its own lateness. Sweeps scale their budgets by it, so a
-- struggling client scans less rather than falling further behind. Falls fast, recovers
-- slowly, on the basis that being wrong about "recovered" is what causes the freezes.
_G.SEHUB_HEALTH = 1.0
SESPAWN("health", function()
    local last = tick()
    while _G.SEHUB_GEN == GEN do
        task.wait(0.05)
        local now = tick()
        local dt = now - last
        last = now
        -- The freeze detector. This loop asks for 0.05s and does no work, so however late
        -- it comes back is how long the CLIENT was stalled - by anything, us or not. If the
        -- farm's worst tick and this both spike together the stall is global and not ours;
        -- if the farm spikes alone, it is.
        local lateMs = (dt - 0.05) * 1000
        local L = _G.SEHUB_SLOW["scheduler stall"]
        if not L then
            L = { n = 0, total = 0, max = 0, over50 = 0, over150 = 0, maxState = "-" }
            _G.SEHUB_SLOW["scheduler stall"] = L
        end
        L.n, L.total = L.n + 1, L.total + lateMs
        if lateMs > L.max then
            L.max = lateMs
            L.maxState = tostring((_G.FARM or {}).State)
        end
        if lateMs > 50 then L.over50 = L.over50 + 1 end
        if lateMs > 150 then L.over150 = L.over150 + 1 end

        local score = 0.05 / math.max(dt, 0.0001)
        if score > 1 then score = 1 end
        local blend = (score < _G.SEHUB_HEALTH) and 0.6 or 0.1
        _G.SEHUB_HEALTH = _G.SEHUB_HEALTH * (1 - blend) + score * blend
        if _G.SEHUB_HEALTH < 0.05 then _G.SEHUB_HEALTH = 0.05 end
    end
end)

