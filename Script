-- Save a spot, return to it instantly. Ported from the reference script, which is
-- the one feature of its set that still works, and it works because it is a SHORT
-- hop - the long-range movement its other features needed is what got caught.
_G.ABOSS = _G.ABOSS or {}
local AB = _G.ABOSS
-- Set in the script rather than left for the user to record. This is the spot that
-- works: escapes land next to it and the run-in from there is what delivers an egg.
AB.Zone   = CFrame.new(537.9755, 70.5763, -371.0225)
AB.Count  = 5          -- repeats, to beat a single rejected write
AB.HoldFor = 6         -- seconds to keep re-planting you while a ragdoll is active
AB.Delay  = 0.005
AB.Key    = "f"
AB.State  = "no safe zone set"

-- One teleport, done the way that actually sticks: an immediate write, then repeats a
-- few milliseconds apart. A SINGLE write loses - the ragdoll physics simply overrides
-- it on the next step, which is why the forced escape appeared not to work at all
-- while the manual key (which came through here) worked every time.
local function teleportTo(cf, quiet)
    if not cf then return end
    local root = myRoot()
    if root then
        pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
        pcall(function() root.CFrame = cf end)
    end
    task.spawn(function()
        for _ = 1, math.max((AB.Count or 5) - 1, 1) do
            local r = myRoot()
            if r then
                pcall(function() r.CFrame = cf end)
                pcall(function() r.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
            end
            task.wait(AB.Delay)
        end
    end)
    AB.lastEscape = tick()
end
_G.SEHUB_TELEPORT = teleportTo

local function gotoZone(quiet)
    if not AB.Zone then
        if not quiet then notify("Anti-Boss", "Set a safe zone first", 2) end
        AB.State = "no safe zone set"
        return
    end
    -- The FIRST write happens right here, synchronously, before anything yields.
    -- Previously the whole thing went into task.spawn, so the escape did not begin
    -- until the scheduler came back round - and being flung and losing the egg takes
    -- less time than that. Everything after this is just insurance.
    local root = myRoot()
    if root then
        pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
        pcall(function() root.CFrame = AB.Zone end)
    end
    task.spawn(function()
        for _ = 1, math.max((AB.Count or 5) - 1, 1) do
            local r = myRoot()
            if r then
                pcall(function() r.CFrame = AB.Zone end)
                pcall(function() r.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
            end
            task.wait(AB.Delay)
        end
    end)
    AB.lastEscape = tick()
    AB.State = "escaped to safe zone"
    if not quiet then notify("Anti-Boss", "Teleported to safe zone", 2) end
end

