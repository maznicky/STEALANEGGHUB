    local oka, a = pcall(function() return hl.Address end)
    if not oka or type(a) ~= "number" or a <= 0x10000 then return nil end
    local okr, r = pcall(function() return memory_read("float", a + HL_COLOR_OFF) end)
    local okg, g = pcall(function() return memory_read("float", a + HL_COLOR_OFF + 4) end)
    local okb, b = pcall(function() return memory_read("float", a + HL_COLOR_OFF + 8) end)
    if not (okr and okg and okb) then return nil end
    local function unit(v) return type(v) == "number" and v == v and v >= -0.001 and v <= 1.001 end
