local TRAP_CACHE, TRAP_AT = {}, 0
local function trapPositions()
    if (tick() - TRAP_AT) < 0.2 then return TRAP_CACHE end
    local out = {}
    local deb = workspace:FindFirstChild("__DEBRIS")
    if deb then
        local okd, kids = pcall(function() return deb:GetDescendants() end)
        if okd and kids then
            for _, d in ipairs(kids) do
                local okn, n = pcall(function() return d.Name end)
                if okn and type(n) == "string" and string.find(n, "PlayerTrap", 1, true) then
                    local okp, p = pcall(function() return d.Position end)
                    if okp and p then
                        out[#out + 1] = p
                    else
                        local okc, sub = pcall(function() return d:GetChildren() end)
                        if okc and sub then
                            for _, c in ipairs(sub) do
                                local ok2, p2 = pcall(function() return c.Position end)
                                if ok2 and p2 then out[#out + 1] = p2 break end
                            end
                        end
                    end
                end
            end
        end
    end
    local rift = workspace:FindFirstChild("BossArenaTeleport")
    local hb = rift and rift:FindFirstChild("Hitbox")
    if hb then
        local okc, cf = pcall(function() return hb.CFrame end)
        local oks, sz = pcall(function() return hb.Size end)
        if okc and cf and oks and sz then
            local c = cf.Position
            if c.X > 0 and math.abs(c.Y - 72) < 60 then
                local axis = (sz.X >= sz.Z) and cf.RightVector or cf.LookVector
                local half = math.max(sz.X, sz.Z) * 0.5 - 1
                local base = Vector3.new(c.X, c.Y - 5, c.Z)
                out[#out + 1] = base
                out[#out + 1] = base + Vector3.new(axis.X, 0, axis.Z) * half
                out[#out + 1] = base - Vector3.new(axis.X, 0, axis.Z) * half
            end
        end
    end
    local FMx = _G.FARM
    if not (FMx and FMx.ddPhase) then
        out[#out + 1] = Vector3.new(551.9, 70.6, -433.5)
    end
    TRAP_CACHE, TRAP_AT = out, tick()
    return out
end
_G.SEHUB_TRAPS = trapPositions

-- A carried or dropped egg is a workspace Model whose name contains "Egg" and which has a
-- Hitbox, e.g. "FirstAreaEgg_84080151_5965395_Forest:Slot_005". Carried, it tracks you a
-- stud or two away; dropped, it sits still. Nest eggs live inside AreaEggSlotsClient, not
-- as workspace children, so they do not show up here.
-- (This replaces an older guess that egg models had 32-character GUID names. They never
-- have, so every scan built on that matched nothing at all.)
-- Both finders live in one do-block on purpose: Luau allows only 200 locals at the top
-- level of a chunk and this file is already at the ceiling. Declaring eggPos and
-- DROP_HOLDERS out here costs two of them and the script will not compile.
local eggModelsNear, droppedEggsNear
do

local function eggPos(c)
    local okq, q = pcall(function()
        local hb = c:FindFirstChild("Hitbox")
        return hb and hb.Position
    end)
    if okq and q then return q end
    local okp, p2 = pcall(function() return c:GetPivot().Position end)
    return okp and p2 or nil
end

-- A CARRIED egg is a direct workspace child named like
-- "FirstAreaEgg_84080151_5965395_Forest:Slot_005" and it follows you a stud or two away.
-- This is the "am I still holding one" test.
function eggModelsNear(pos, range)
    local out = {}
    if not pos then return out end
    local okk, kids = pcall(function() return workspace:GetChildren() end)
    for _, c in ipairs((okk and kids) or {}) do
        local okc, cl = pcall(function() return c.ClassName end)
        if okc and cl == "Model" then
            local okn, nm = pcall(function() return c.Name end)
            if okn and type(nm) == "string"
               and string.find(string.lower(nm), "egg", 1, true) then
                local q = eggPos(c)
                if q then
                    local d = math.sqrt((q.X - pos.X) ^ 2 + (q.Z - pos.Z) ^ 2)
                    if d <= (range or math.huge) then
                        out[#out + 1] = { m = c, pos = q, d = d, name = nm }
                    end
                end
            end
        end
    end
    table.sort(out, function(a, b) return a.d < b.d end)
    return out
end

-- A DROPPED egg is a different thing entirely. It lives inside one of these containers
-- under a name like "84080151_3927d6ed2e40400ab1a9be0fdf260b23" - <eggTypeId>_<32 hex> -
-- with no "egg" in it anywhere, which is why searching workspace by name never found one
-- (BossHitFound stayed nil every single session while the egg sat right next to us).
-- These holders only ever contain eggs, so take any Model in them.
local DROP_HOLDERS = { "PlacedEggRenders", "ClientRenderedAssets", "Eggs", "__DEBRIS" }

function droppedEggsNear(pos, range)
    local out = {}
    if not pos then return out end
    for _, holder in ipairs(DROP_HOLDERS) do
        local okh, h = pcall(function() return workspace:FindFirstChild(holder) end)
        if okh and h then
            local okk, kids = pcall(function() return h:GetChildren() end)
            for _, c in ipairs((okk and kids) or {}) do
                local okc, cl = pcall(function() return c.ClassName end)
                if okc and cl == "Model" then
                    local q = eggPos(c)
                    if q then
                        local d = math.sqrt((q.X - pos.X) ^ 2 + (q.Z - pos.Z) ^ 2)
                        if d <= (range or math.huge) then
                            out[#out + 1] = { m = c, pos = q, d = d, name = tostring(c.Name) }
                        end
                    end
                end
            end
        end
    end
    -- and anything sitting straight in workspace with "egg" in the name
    for _, e in ipairs(eggModelsNear(pos, range)) do out[#out + 1] = e end
    table.sort(out, function(a, b) return a.d < b.d end)
    return out
end

end
_G.SEHUB_DROPPEDEGGS = droppedEggsNear
_G.SEHUB_EGGMODELS = eggModelsNear

local steerAround, drive
do
    local CLEAR = 8
    local LOOK_S = 1.2

    local function onLine(traps, y, ax, az, bx, bz, clear)
        local dx, dz = bx - ax, bz - az
        local len2 = dx * dx + dz * dz
        for _, t in ipairs(traps) do
            if math.abs(t.Y - y) < 12 then
                local s = 0
                if len2 > 0.01 then
                    s = ((t.X - ax) * dx + (t.Z - az) * dz) / len2
                    if s < 0 then s = 0 elseif s > 1 then s = 1 end
                end
                local cx, cz = ax + dx * s - t.X, az + dz * s - t.Z
                if (cx * cx + cz * cz) < clear * clear then return true end
            end
        end
        return false
    end

    local PL_CACHE, PL_AT = {}, 0
    local function playerSpots()
        if (tick() - PL_AT) < 0.2 then return PL_CACHE end
        local out = {}
        local okp, P = pcall(function() return game:GetService("Players") end)
        if okp and P then
            local okm, myName = pcall(function() return P.LocalPlayer.Name end)
            local okl, list = pcall(function() return P:GetPlayers() end)
            if okl and list then
                for _, pl in ipairs(list) do
                    local okn, nm = pcall(function() return pl.Name end)
                    if okn and not (okm and nm == myName) then
                        local okr, pos = pcall(function()
                            local c = pl.Character
                            local r = c and c:FindFirstChild("HumanoidRootPart")
                            return r and r.Position
                        end)
                        if okr and pos then out[#out + 1] = pos end
                    end
                end
            end
        end
        PL_CACHE, PL_AT = out, tick()
        return out
    end

    local GD_CACHE, GD_AT = {}, 0
    local GD_LAST, GD_MOVED = {}, {}
    local function guardSpots()
        local nowT = tick()
        if (nowT - GD_AT) < 0.2 then return GD_CACHE end
        local out = {}
        local okg, ga = pcall(function()
            local obj = workspace:FindFirstChild("__OBJECTS")
            local areas = obj and obj:FindFirstChild("Areas")
            return areas and areas:FindFirstChild("GuardAreas")
        end)
        if okg and ga then
            local okc, kids = pcall(function() return ga:GetChildren() end)
            if okc and kids then
                for _, am in ipairs(kids) do
                    local nm = tostring(am.Name)
                    local okr, pos = pcall(function()
                        local g = am:FindFirstChild("Guard")
                        local r = g and g:FindFirstChild("HumanoidRootPart")
                        return r and r.Position
                    end)
                    if okr and typeof(pos) == "Vector3" then
                        -- GuardWakeHighlight is created at runtime and Matcha's index never
                        -- shows it, so tell a woken guard by the one thing that does read
                        -- live: it is moving. A guard at rest is perfectly still. Stays
                        -- "active" for 3s after it stops so we keep clear of one that pauses
                        -- partway back.
                        local prev = GD_LAST[nm]
                        if prev then
                            local d = math.sqrt((pos.X - prev.X) ^ 2 + (pos.Z - prev.Z) ^ 2)
                            if d > 0.5 then GD_MOVED[nm] = nowT end
                        end
                        GD_LAST[nm] = pos
                        if (nowT - (GD_MOVED[nm] or 0)) < 3 then out[#out + 1] = pos end
                    end
                end
            end
        end
        GD_CACHE, GD_AT = out, nowT
        return out
    end

    function steerAround(me, tx, tz, speed)
        local dx, dz = tx - me.X, tz - me.Z
        local dist = math.sqrt(dx * dx + dz * dz)
        if dist < 0.01 then return 0, 0 end
        local ux, uz = dx / dist, dz / dist
        local traps = trapPositions()
        local FMg = _G.FARM
        if FMg and FMg.AvoidPlayers then
            local merged = {}
            for _, t in ipairs(traps) do merged[#merged + 1] = t end
            for _, p in ipairs(playerSpots()) do
                if ((p.X - tx) ^ 2 + (p.Z - tz) ^ 2) > 144 then merged[#merged + 1] = p end
            end
            traps = merged
        end
        -- Skip this while a Ragdoll Teleport is running: that one has to hit us.
        if FMg and FMg.AvoidBosses and (FMg.rtBusyUntil or 0) < tick() then
            local merged = {}
            for _, t in ipairs(traps) do merged[#merged + 1] = t end
            for _, g in ipairs(guardSpots()) do
                -- never dodge a guard parked on the egg we are going for
                if ((g.X - tx) ^ 2 + (g.Z - tz) ^ 2) > 144 then merged[#merged + 1] = g end
            end
            traps = merged
        end
        if #traps == 0 then return ux, uz end
        for _, t in ipairs(traps) do
            local ox, oz = me.X - t.X, me.Z - t.Z
            local o2 = ox * ox + oz * oz
            if math.abs(t.Y - me.Y) < 12 and o2 > 0.01 and o2 < (CLEAR * 0.5) ^ 2 then
                local o = math.sqrt(o2)
                return ox / o, oz / o
            end
        end
        local look = math.min(dist, math.max(40, (speed or 300) * LOOK_S))
        if not onLine(traps, me.Y, me.X, me.Z, me.X + ux * look, me.Z + uz * look, CLEAR) then
            return ux, uz
        end
        local near, nearAlong
        for _, t in ipairs(traps) do
            if math.abs(t.Y - me.Y) < 12 then
                local rx, rz = t.X - me.X, t.Z - me.Z
                local along = rx * ux + rz * uz
                local side = rz * ux - rx * uz
                if along > -CLEAR and along < look and math.abs(side) < CLEAR
                   and (not nearAlong or along < nearAlong) then
                    near, nearAlong = t, along
                end
            end
        end
        if not near then return ux, uz end
        local nx, nz = -uz, ux
        local side = (near.X - me.X) * nx + (near.Z - me.Z) * nz
        local first = (side > 0) and -1 or 1
        for k = 1, 6 do
            for _, sgn in ipairs({ first, -first }) do
                local off = CLEAR * (0.6 + 0.6 * k)
                local wx, wz = near.X + nx * sgn * off, near.Z + nz * sgn * off
                if not onLine(traps, me.Y, me.X, me.Z, wx, wz, CLEAR * 0.9) then
                    local ex, ez = wx - me.X, wz - me.Z
                    local e = math.sqrt(ex * ex + ez * ez)
                    if e > 0.01 then return ex / e, ez / e end
                end
            end
        end
        return ux, uz
    end

    function drive(root, vx, vz, vy)
        pcall(function()
            root.AssemblyLinearVelocity = Vector3.new(vx, vy, vz)
        end)
    end
end
_G.SEHUB_STEER, _G.SEHUB_DRIVE = steerAround, drive

