local function addrOf(p)
    local okpar, par = pcall(function() return p.Parent end)
    if not okpar or par == nil then return nil end
    local ok, a = pcall(function() return p.Address end)
    if ok and type(a) == "number" and a > 0x10000 then return a end
    return nil
end

local function promptWritable(a)
    if not a then return false end
    local okk, k = pcall(function() return memory_read("int", a + 0x124) end)
    if not okk or k ~= 101 then return false end
    local ok, h = pcall(function() return memory_read("float", a + ST.OFF_HOLD) end)
    if not ok or type(h) ~= "number" then return false end
    if h ~= h then return false end
    return h >= 0 and h <= 5.0
end

local function patchPrompts()
    if not memory_write or not memory_read then
        ST.State = "Not supported"
        return
    end
    if not ST.offsetsOk then return end
    local n = 0
    ST.sweepN = (ST.sweepN or 0) + 1
    local verify = (ST.sweepN <= 3) or (ST.sweepN % 20 == 0)
    local now = tick()
    for _, p in ipairs(promptList()) do
        local a = addrOf(p)
        if a and (now - (ST.doneAt[a] or 0)) < ST.REPATCH then
            n = n + 1
            a = nil
        end
        if a and not promptWritable(a) then
            ST.Rejected = (ST.Rejected or 0) + 1
            a = nil
        end
        if a and ST.suppressed[a] and (now - ST.suppressed[a]) < (ST.SUPPRESS_TTL or 1.0) then
            a = nil
        end
        if a and (ST.keepSlow[a] or 0) > now then
            a = nil
        end
        if a then
            ST.doneAt[a] = now
            if not ST.orig[a] then
                local okh, h = pcall(function() return memory_read("float", a + ST.OFF_HOLD) end)
                local okd, d = pcall(function() return memory_read("float", a + ST.OFF_DIST) end)
                if okh and okd then ST.orig[a] = { hold = h, dist = d } end
            end
            pcall(function()
                memory_write("float", a + ST.OFF_HOLD, ST.Hold)
                memory_write("float", a + ST.OFF_DIST, ST.Dist)
            end)
            if ST.NoLOS then
                if ST.origLOS[a] == nil then
                    local okl, l = pcall(function() return memory_read("byte", a + ST.OFF_LOS) end)
                    if okl and type(l) == "number" then ST.origLOS[a] = l end
                end
                pcall(function() memory_write("byte", a + ST.OFF_LOS, 0) end)
            end
            local okv, h2, okv2, d2 = false, nil, false, nil
            if verify then
                okv, h2 = pcall(function() return memory_read("float", a + ST.OFF_HOLD) end)
                okv2, d2 = pcall(function() return memory_read("float", a + ST.OFF_DIST) end)
            end
            if okv and okv2 and h2 and d2 then
                if math.abs(h2 - ST.Hold) > 0.01 or math.abs(d2 - ST.Dist) > 0.01 then
                    ST.offsetsOk = false
                    ST.State = "Stopped - game updated"
                    warn("[Steal An Egg] prompt offsets no longer hold their value.")
                    warn("[Steal An Egg] Roblox has probably reshuffled ProximityPrompt.")
                    warn(string.format("[Steal An Egg] wrote hold=%.2f dist=%.2f, read back %.2f / %.2f",
                        ST.Hold, ST.Dist, h2, d2))
                    warn("[Steal An Egg] Instant Steal disabled rather than writing blind.")
                    return
                end
            end
            n = n + 1
        end
    end
    if ST.sweepN % 20 == 0 then
        for addr, at in pairs(ST.doneAt) do
            if (now - at) > 30 then ST.doneAt[addr] = nil end
        end
    end
    ST.patched = n
    ST.State = string.format("On - %d prompts", n)
end

local function nearFrom(shared, pos, radius)
    if not shared then return promptsNear(pos, radius) end
    local out = {}
    for _, e in ipairs(shared) do
        if e.d <= radius then out[#out + 1] = e end
    end
    return out
end

local function patchNear(pos, radius, shared)
    if not memory_write or not pos then return 0 end
    if not ST.On or not ST.offsetsOk then return 0 end
    local n = 0
    for _, e in ipairs(nearFrom(shared, pos, radius or 30)) do
        local a = addrOf(e.p)
        if a and not promptWritable(a) then
            ST.Rejected = (ST.Rejected or 0) + 1
            a = nil
        end
        if a and ST.suppressed[a] and (tick() - ST.suppressed[a]) < (ST.SUPPRESS_TTL or 1.0) then
            a = nil
        end
        if a and (ST.keepSlow[a] or 0) > tick() then
            a = nil
        end
        if a then
            if not ST.orig[a] then
                local okh, h = pcall(function() return memory_read("float", a + ST.OFF_HOLD) end)
                local okd, dd = pcall(function() return memory_read("float", a + ST.OFF_DIST) end)
                if okh and okd then ST.orig[a] = { hold = h, dist = dd } end
            end
            pcall(function()
                memory_write("float", a + ST.OFF_HOLD, ST.Hold)
                memory_write("float", a + ST.OFF_DIST, ST.Dist)
            end)
            if ST.NoLOS then
                if ST.origLOS[a] == nil then
                    local okl, l = pcall(function() return memory_read("byte", a + ST.OFF_LOS) end)
                    if okl and type(l) == "number" then ST.origLOS[a] = l end
                end
                pcall(function() memory_write("byte", a + ST.OFF_LOS, 0) end)
            end
            n = n + 1
        end
    end
    return n
end
