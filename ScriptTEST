local function eggPromptSpots(p, r)
    local out = {}
    local okc, kids = pcall(function() return workspace:GetChildren() end)
    if not okc or not kids then return out end
    for _, c in ipairs(kids) do
        local okn, nm = pcall(function() return c.Name end)
        if okn and nm == "SmartPromptPart" then
            local okp2, cp = pcall(function() return c.Position end)
            if okp2 and cp and (not p or math.sqrt((cp.X - p.X) ^ 2 + (cp.Z - p.Z) ^ 2) < r)
               and c:FindFirstChild("CarryAreaEgg") then
                out[#out + 1] = cp
            end
        end
    end
    return out
end

local function notePress()
    if FM.ePress and (tick() - FM.ePress.at) < 0.3 then return end
    local r = myRoot()
    local okp, p = pcall(function() return r and r.Position end)
    if not okp or not p then return end
    local near = {}
    for _, sl in ipairs(eggSlots(0.05)) do
        if math.sqrt((sl.pos.X - p.X) ^ 2 + (sl.pos.Z - p.Z) ^ 2) < 10 then near[#near + 1] = sl.pos end
    end
    local prompts = eggPromptSpots(p, 10)
    if (#near > 0 or #prompts > 0) and (FM.rtBusyUntil or 0) < tick() then
        FM.ePress = { at = tick(), near = near, prompts = prompts }
    end
end
