local CFG_FILE = "stealhub_config.txt"
local CFG_KEYS = {
    "SpeedSet", "Priority", "RagdollTp", "DeathDrop", "AutoBoss", "AvoidPlayers",
    "AvoidBosses", "TreadmillFarm", "AntiAfk", "GrabEscapeDelay", "Rift",
    "CarryCap", "FarmKey",
}

local function cfgSerialize(v)
    local t = type(v)
    if t == "number" or t == "boolean" then return tostring(v) end
    if t == "string" then return string.format("%q", v) end
    if t == "table" then
        local out = { "{" }
        for k, vv in pairs(v) do
            local kt, vt = type(k), type(vv)
            if vt == "number" or vt == "boolean" or vt == "string" or vt == "table" then
                if kt == "string" then
                    out[#out + 1] = string.format("[%q]=", k) .. cfgSerialize(vv) .. ","
                elseif kt == "number" then
                    out[#out + 1] = cfgSerialize(vv) .. ","
                end
            end
        end
        out[#out + 1] = "}"
        return table.concat(out)
    end
    return "nil"
end

local function cfgGather()
    local c = {}
    for _, k in ipairs(CFG_KEYS) do c[k] = FM[k] end
    c.Areas, c.AllAreas, c.Always = FM.Areas, FM.AllAreas, FM.Always
    c.StealOn, c.StealDist = ST.On, ST.Dist
    c.EscapeKey = AB.Key
    c.AutoLoad = FM.AutoLoadCfg and true or false
    return c
end

local function cfgApply(c)
    for _, k in ipairs(CFG_KEYS) do
        if c[k] ~= nil then FM[k] = c[k] end
    end
    if type(c.Areas) == "table" then FM.Areas = c.Areas end
    if c.AllAreas ~= nil then FM.AllAreas = c.AllAreas end
    if type(c.Always) == "table" then
        FM.Always = c.Always
        local n = 0
        for _ in pairs(c.Always) do n = n + 1 end
        FM.AlwaysN = n
    end
    if c.StealOn ~= nil then ST.On = c.StealOn end
    if c.StealDist ~= nil then ST.Dist = c.StealDist end
    if c.EscapeKey then AB.Key = c.EscapeKey end
    if c.AutoLoad ~= nil then
        FM.AutoLoadCfg = c.AutoLoad
        -- the toggle is built after this function, so only Set it once it exists
        pcall(function() if FM.autoTog then FM.autoTog:Set(c.AutoLoad and true or false) end end)
    end
    FM.Speed = math.min(FM.SpeedSet or 500, 900)
    -- Push what we can back into the menu. Anything without a stored handle still takes
    -- effect, because the farm reads these values directly - the control just will not
    -- redraw until the next load.
    pcall(function()
        if FM.priDrop and type(c.Priority) == "string" then FM.priDrop:Set({ c.Priority }) end
    end)
    pcall(function()
        if FM.areaDrop and type(c.Areas) == "table" then
            local sel = {}
            for a, on in pairs(c.Areas) do if on then sel[#sel + 1] = a end end
            if c.AllAreas then sel = { "All" } end
            FM.areaDrop:Set(sel)
        end
    end)
    pcall(function() if FM.fdTog then FM.fdTog:Set(FM.DeathDrop and true or false) end end)
    pcall(function() if FM.bossTog then FM.bossTog:Set(FM.AutoBoss and true or false) end end)
end

local function cfgRead()
    if not readfile then return nil, "this executor cannot read files" end
    local okr, body = pcall(function() return readfile(CFG_FILE) end)
    if not okr or type(body) ~= "string" or body == "" then
        return nil, "no saved config yet"
    end
    -- Matcha's loadstring throws a chunk's return value away: loadstring("return 42")()
    -- hands back nil. Assigning to a global does work, so pass the table out that way.
    local f = loadstring("_G.SEHUB_CFGTMP = " .. body)
    if not f then return nil, "the config file is corrupt" end
    _G.SEHUB_CFGTMP = nil
    local okc = pcall(f)
    local c = _G.SEHUB_CFGTMP
    _G.SEHUB_CFGTMP = nil
    if not okc or type(c) ~= "table" then return nil, "the config file is corrupt" end
    return c
end

local function cfgSave()
    if not writefile then return false, "this executor cannot write files" end
    local body = cfgSerialize(cfgGather())
    local ok = pcall(function() writefile(CFG_FILE, body) end)
    return ok, ok and (tostring(#body) .. " bytes") or "write failed"
end

local function cfgLoad()
    local c, err = cfgRead()
    if not c then return false, err end
    cfgApply(c)
    return true, "loaded"
end
_G.SEHUB_CFGSAVE, _G.SEHUB_CFGLOAD = cfgSave, cfgLoad

