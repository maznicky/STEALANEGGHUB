local PLAY_FALLBACK = { minx = 591, maxx = 4805, minz = -413, maxz = -311 }
local PLAY_CACHE, PLAY_AT = nil, 0
local function playBounds()
    if PLAY_CACHE and (tick() - PLAY_AT) < 30 then return PLAY_CACHE end
    local b, n = { minx = 1e9, maxx = -1e9, minz = 1e9, maxz = -1e9 }, 0
    local okS, slots = pcall(function() return _G.SEHUB_SLOTS and _G.SEHUB_SLOTS() or {} end)
    if okS and slots then
        for _, e in ipairs(slots) do
            local p = e.pos
            if p then
                n = n + 1
                if p.X < b.minx then b.minx = p.X end
                if p.X > b.maxx then b.maxx = p.X end
                if p.Z < b.minz then b.minz = p.Z end
                if p.Z > b.maxz then b.maxz = p.Z end
            end
        end
    end
    if n < 8 then b = PLAY_FALLBACK end
    PLAY_CACHE = { minx = b.minx + 10, maxx = b.maxx - 10,
                   minz = b.minz + 10, maxz = b.maxz - 10 }
    PLAY_AT = tick()
    return PLAY_CACHE
end
