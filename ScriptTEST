    if r < 0.35 and g < 0.35 and b < 0.35 then return "secret" end
    if r > 0.7 and b > 0.6 and g < 0.5 then return "eternal" end
    if r > 0.7 and g > 0.6 and b < 0.4 then return "divine" end
