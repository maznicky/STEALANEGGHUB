local function suppressOthers(pos, radius, keepPrompt, shared)
    if not memory_write or not pos then return 0 end
    if not ST.On or not ST.offsetsOk then return 0 end
    local list = nearFrom(shared, pos, radius or 25)
    local keep, keepD = keepPrompt, nil
    if not keep then
        for _, e in ipairs(list) do
            if not keepD or e.d < keepD then keepD, keep = e.d, e.p end
        end
    end
    local n = 0
    for _, e in ipairs(list) do
        if e.p ~= keep then
            local a = addrOf(e.p)
            if a and not promptWritable(a) then
                ST.Rejected = (ST.Rejected or 0) + 1
                a = nil
            end
            if a then
                if not ST.orig[a] then
                    local okh, h = pcall(function() return memory_read("float", a + ST.OFF_HOLD) end)
                    local okd, dd = pcall(function() return memory_read("float", a + ST.OFF_DIST) end)
                    if okh and okd then ST.orig[a] = { hold = h, dist = dd } end
                end
                pcall(function() memory_write("float", a + ST.OFF_DIST, 0.5) end)
                ST.doneAt[a] = nil
                ST.suppressed[a] = tick()
                n = n + 1
            end
        end
    end
    -- Make sure the prompt we are KEEPING is live. This function only ever touched the
    -- others, so if the target had itself been suppressed a moment earlier (as a neighbour of
    -- a previous target) it stayed at 0.5 studs - and patchNear and the sweep both skip
    -- anything suppressed in the last second, so nothing put it back and E did nothing.
    -- Give it a generous range while we grab. Every neighbour within the radius is at 0.5
    -- by now, so the extra reach cannot land on the wrong egg - and it covers standing on top
    -- of a small egg after a teleport, which puts you further than 5 studs from its prompt.
    if keep then
        local ka = addrOf(keep)
        if ka and promptWritable(ka) then
            if not ST.orig[ka] then
                local okh, h = pcall(function() return memory_read("float", ka + ST.OFF_HOLD) end)
                local okd, dd = pcall(function() return memory_read("float", ka + ST.OFF_DIST) end)
                if okh and okd then ST.orig[ka] = { hold = h, dist = dd } end
            end
            pcall(function()
                memory_write("float", ka + ST.OFF_HOLD, ST.Hold)
                memory_write("float", ka + ST.OFF_DIST, ST.KeepDist or 12)
            end)
            if ST.NoLOS then
                if ST.origLOS[ka] == nil then
                    local okl, l = pcall(function() return memory_read("byte", ka + ST.OFF_LOS) end)
                    if okl and type(l) == "number" then ST.origLOS[ka] = l end
                end
                pcall(function() memory_write("byte", ka + ST.OFF_LOS, 0) end)
            end
            ST.suppressed[ka] = nil
            ST.KeptLive = (ST.KeptLive or 0) + 1
        end
    end
    ST.Suppressed = (ST.Suppressed or 0) + n
    return n
end
_G.SEHUB_SUPPRESS = suppressOthers

local function holdTimeNear(pos, radius, shared)
    if not memory_read or not pos then return nil end
    local bestD, bestPrompt
