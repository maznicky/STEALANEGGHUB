local function gotoZone(quiet)
    if not AB.Zone then
        if not quiet then notify("Anti-Boss", "Set a safe zone first", 2) end
        AB.State = "No safe zone set"
        return
    end
    local root = myRoot()
    if not root then return end
    local okp, me = pcall(function() return root.Position end)
    if not okp or not me then return end
    -- A boss that chased you can be stood on the escape spot, and landing on top of it is
    -- how you get ragdolled at the safe zone. Slide along the line away from it - same X, so
    -- you end up exactly as far inside as before.
    do
        local land = AB.Zone
        local obj = workspace:FindFirstChild("__OBJECTS")
        local areas = obj and obj:FindFirstChild("Areas")
        local ga = areas and areas:FindFirstChild("GuardAreas")
        local okc, kids = pcall(function() return ga and ga:GetChildren() end)
        local bz, bd
        for _, am in ipairs((okc and kids) or {}) do
            local okr, p = pcall(function()
                local g = am:FindFirstChild("Guard")
                local gr = g and g:FindFirstChild("HumanoidRootPart")
                return gr and gr.Position
            end)
            if okr and typeof(p) == "Vector3" then
                local d = math.sqrt((p.X - AB.Zone.X) ^ 2 + (p.Z - AB.Zone.Z) ^ 2)
                if d < (AB.DodgeNear or 50) and (not bd or d < bd) then bz, bd = p.Z, d end
            end
        end
        if bz then
            local away = (AB.Zone.Z >= bz) and 1 or -1
            land = CFrame.new(AB.Zone.X, AB.Zone.Y,
                AB.Zone.Z + away * (AB.DodgeShift or 28))
            AB.Dodged = (AB.Dodged or 0) + 1
            AB.DodgedFrom = bd
        end
        AB.landCF = land
    end
    local zcf = AB.landCF or AB.Zone
    local dHome = math.sqrt((zcf.X - me.X)^2 + (zcf.Z - me.Z)^2)
    AB.hopFrom, AB.hopTo = me, zcf.Position

    pcall(function()
        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        root.CFrame = zcf
    end)
    AB.Hops = (AB.Hops or 0) + 1
    AB.pinning, AB.pinAt = true, tick()
    local nTel = math.max(AB.Teleports or 1, 1)
    local hold = math.max(AB.Hold or 0.03, 0.03)
    local gap = AB.RetryGap or 0
    AB.pinUntil = tick() + nTel * (hold + gap + 0.05) + 1

    task.spawn(function()
        local frames0, writes0 = AB.pinFrames or 0, AB.pinWrites or 0
        local hooked = #(_G.SEHUB_PINCONN or {}) > 0
        local done = 0
        for i = 1, nTel do
            local tEnd = tick() + hold
            AB.pinLive = tEnd
            repeat
                if not hooked then
                    local r = myRoot()
                    if r then
                        pcall(function()
                            r.CFrame = AB.landCF or AB.Zone
                            r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        end)
                    end
                end
                task.wait(0.03)
            until tick() >= tEnd
            done = i
            if i < nTel and gap > 0 then
                AB.pinLive = 0
                task.wait(math.max(gap, 0.03))
            end
        end
        AB.pinLive = 0
        local frames = (AB.pinFrames or 0) - frames0
        local writes = (AB.pinWrites or 0) - writes0
        local reached = frames >= ((dHome <= ESC_MAXHOP) and 3 or 2)
        AB.ExtraDone = math.max(0, done - 1)
        AB.pinning = false
        AB.Touches = (AB.Touches or 0) + (reached and 1 or 0)
        AB.Missed  = (AB.Missed  or 0) + (reached and 0 or 1)
        AB.Tries   = (AB.Tries   or 0) + done
        AB.LastTouch = string.format("%s: %d teleports, %d writes, %d frames at the zone (from %.0f studs)",
            reached and "TOUCHED" or "MISSED", done, writes, frames, dHome)
    end)
    AB.lastEscape = tick()
    lastHopAt = tick()
    AB.LastHow = "Escaped"
    AB.State = AB.LastHow
    if not quiet then notify("Anti-Boss", "Escaped", 2, "good") end
end

