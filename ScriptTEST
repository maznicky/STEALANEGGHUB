local MOTION_WAKE_AREAS = { ["Light Dark"] = true }
local MOTION_STATE = {}
local MOTION_SLOW = 30
local function motionWakeNear(me)
    local now = tick()
    for area in pairs(MOTION_WAKE_AREAS) do
        local st = MOTION_STATE[area] or {}
        MOTION_STATE[area] = st
        local gp = guardRootPos(area)
        if not gp then
            st.pos = nil
        else
            if st.pos and st.t and now > st.t then
                local dt = now - st.t
                local vx, vz = (gp.X - st.pos.X) / dt, (gp.Z - st.pos.Z) / dt
                local sp = math.sqrt(vx * vx + vz * vz)
                if sp > 400 then
                    st.slowStart, st.lastSlow = nil, nil
                elseif sp < MOTION_SLOW then
                    if not st.lastSlow or (now - st.lastSlow) > 0.75 then st.slowStart = now end
                    st.lastSlow = now
                    st.fired = false
                elseif not st.fired and st.slowStart and st.lastSlow
                       and (st.lastSlow - st.slowStart) >= 1.0 and (now - st.lastSlow) <= 1.0 then
                    local dist = (gp - me).Magnitude
                    local range = (FM.BossRangeByArea and FM.BossRangeByArea[area]) or FM.BossRange or 300
                    local tx, tz = me.X - gp.X, me.Z - gp.Z
                    local tl = math.sqrt(tx * tx + tz * tz)
                    local toward = tl > 0.01 and (vx * tx + vz * tz) / tl or 0
                    if sp >= (FM.ChargeSpeed or 60) and toward >= 0.6 * sp and dist < range then
                        st.fired = true
                        st.pos, st.t = gp, now
                        return true, area, dist, gp, toward
                    end
                end
            end
            st.pos, st.t = gp, now
        end
    end
    return false
end

