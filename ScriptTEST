local function keyMatches(input, letter)
    if not input or not letter then return false end
    local ok, kc = pcall(function() return input.KeyCode end)
    if not ok or kc == nil then return false end
    local want = keyCodeValue(letter)

    if type(kc) == "number" then
        if want and kc == want then return true end
        if #letter == 1 then
            return kc == string.byte(string.lower(letter))
                or kc == string.byte(string.upper(letter))
        end
        return false
    end

    local okv, v = pcall(function() return kc.Value end)
    if okv and want and v == want then return true end
    local okn, n = pcall(function() return kc.Name end)
    if okn and type(n) == "string" then
        local N, L = string.upper(n), string.upper(letter)
        if N == L then return true end
        if string.match(N, "%.([%w_]+)$") == L then return true end
    end
    return false
end
