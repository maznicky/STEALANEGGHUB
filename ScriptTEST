_G.SEHUB_FRIENDDROP = function()
    if FM.fdBusy then return false end
    -- Never dive empty-handed, whoever asks. Dying at the wall with nothing in your hands
    -- costs you a life and gains nothing at all.
    do
        local r = myRoot()
        local okp, p = pcall(function() return r and r.Position end)
        if not okp or not p or #eggModelsNear(p, FM.CarryNear or 15) == 0 then
            FM.FriendDropNoEgg = (FM.FriendDropNoEgg or 0) + 1
            FM.State = "Friend drop - no egg in hand, not diving"
            return false
        end
    end
    FM.fdBusy = true
    local ds = FM.DeathSpot or Vector3.new(551.523, 70.574, -441.038)
    local t0, died = tick(), false
    while (tick() - t0) < 8 do
        local ch = myCharacter()
        local root = myRoot()
        local hum = ch and ch:FindFirstChild("Humanoid")
        local hp = -1
        pcall(function() hp = hum and hum.Health or -1 end)
        if hp <= 0 then died = true break end
        if not root then break end
        FM.State = "Friend drop - dropping the egg at the wall"
        local zPush = ((tick() - t0) > 2.5) and 4 or 0
        pcall(function()
            root.CFrame = CFrame.new(ds.X, ds.Y, ds.Z - zPush)
            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
        end)
        -- let the wall do it; the health float is only a last resort so you are never
        -- left stuck in the wall holding the egg
        if memory_write and hum and (tick() - t0) > (FM.FriendDropKillAfter or 3) then
            local oka, ad = pcall(function() return hum.Address end)
            if oka and ad then
                pcall(function() memory_write("float", ad + 0x190, -10) end)
                FM.FriendDropKills = (FM.FriendDropKills or 0) + 1
            end
        end
        task.wait(0.05)
    end
    if died then FM.FriendDropsMade = (FM.FriendDropsMade or 0) + 1 end
    FM.fdDoneAt = tick()
    FM.fdBusy = false
    return died
end

