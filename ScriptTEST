                            spawned[nm] = (spawned[nm] or 0) + 1
                        end
                        local missing, onMap = {}, 0
                        for _, t in ipairs(FM.RiftTargets or {}) do
                            if not held[t.name] then
                                local c = spawned[t.egg] or 0
                                onMap = onMap + c
                                missing[#missing + 1] = string.format("%s(%d)", t.name, c)
                            end
                        end
                        FM.RiftState = string.format("%d/%d - need %s%s",
                            have, total, table.concat(missing, ", "),
                            (onMap == 0) and " (none spawned)" or "")
                    end
                    end
                end

                local n = #kids
                if FM.slotCount and (n - FM.slotCount) >= 10 then
                    FM.visited = {}
                    eggSlotsInvalidate()
                    FM.eggName, FM.eggTried = {}, {}
                    FM.Reloads = (FM.Reloads or 0) + 1
                    FM.State = "Eggs respawned"
                    notify("Auto Farm", "Eggs respawned", 3)
                    if FM.Rift then
                        task.spawn(function()
                            task.wait(5)
                            if _G.SEHUB_GEN ~= GEN or not FM.Rift then return end
                            while (FM.rtQuietUntil or 0) > tick() and _G.SEHUB_GEN == GEN do task.wait(0.5) end
                            sweepEggNames()
                            notifyRiftSpawns("Eggs respawned")
                        end)
                    end
                end
                FM.slotCount = n
            end
        end
        PROFTICK("night watch", __t0)
        task.wait(1.0)
    end
end)

local TREAD_POS, TREAD_AT, TREAD_SPAWN = nil, 0, nil
local function myTreadmill()
    if TREAD_POS and (tick() - TREAD_AT) < 10 then return TREAD_POS end
    TREAD_POS = nil
    local lp = localPlayer()
    local okn, myName = pcall(function() return lp and lp.Name end)
    local okdn, myDisp = pcall(function() return lp and lp.DisplayName end)
    local plots = workspace:FindFirstChild("Plots")
    if not (okn and myName and plots) then return nil end
    local okc, list = pcall(function() return plots:GetChildren() end)

    local function take(pl)
        local tb = pl:FindFirstChild("TreadmillBottom")
        local spn = pl:FindFirstChild("SpawnPoint")
        local okp, p = pcall(function() return tb and tb.Position end)
        local oks, s = pcall(function() return spn and spn.Position end)
        if okp and p then
            TREAD_POS, TREAD_AT = p, tick()
            TREAD_SPAWN = (oks and s) or nil
            return p
        end
        return nil
    end

    -- A plot sign shows the DISPLAY name, which is not the username for most people. Only
    -- matching lp.Name is why Auto Treadmill "does not work" for them - their sign never
    -- matches and no treadmill is ever found. Accept either, case-insensitively.
    local want = { string.lower(tostring(myName)) }
    if okdn and myDisp then want[#want + 1] = string.lower(tostring(myDisp)) end
    for _, pl in ipairs(okc and list or {}) do
        local sign = pl:FindFirstChild("PlotSign")
        local okd, desc = pcall(function() return sign and sign:GetDescendants() or {} end)
        for _, d in ipairs(okd and desc or {}) do
            local okt, t = pcall(function() return d.Text end)
            if okt and type(t) == "string" then
                local lt = string.lower(t)
                for _, w in ipairs(want) do
                    if lt == w then
                        local got = take(pl)
                        if got then return got end
                    end
                end
            end
        end
    end

    -- Last resort: no sign matched at all (blank text, a stale read, a renamed sign). You
    -- always spawn on your own plot, so the plot whose SpawnPoint sits nearest home is it.
    local home = homePos()
    if home then
        local bestPl, bestD
        for _, pl in ipairs(okc and list or {}) do
            local spn = pl:FindFirstChild("SpawnPoint")
            local oks, s = pcall(function() return spn and spn.Position end)
            if oks and s then
                local dd = math.sqrt((s.X - home.X) ^ 2 + (s.Z - home.Z) ^ 2)
                if not bestD or dd < bestD then bestPl, bestD = pl, dd end
            end
        end
        if bestPl and bestD and bestD < 200 then
            FM.TreadmillByHome = (FM.TreadmillByHome or 0) + 1
            local got = take(bestPl)
            if got then return got end
        end
    end
    return nil
end
_G.SEHUB_TREADMILL = myTreadmill

local ragdollTeleport
do
    local function ragdollJoints()
        local ch = myCharacter()
        local okt, t = pcall(function() return ch and ch:FindFirstChild("UpperTorso") end)
        if not okt or not t then return false end
        local okk, kids = pcall(function() return t:GetChildren() end)
        if not okk or not kids then return false end
        for _, k in ipairs(kids) do
            local okc, cl = pcall(function() return k.ClassName end)
            if okc and cl == "BallSocketConstraint" then return true end
        end
        return false
    end

    local function guardAwake(areaName)
        local ok, awake = pcall(function()
            local o = workspace:FindFirstChild("__OBJECTS")
            local a = o and o:FindFirstChild("Areas")
            local ga = a and a:FindFirstChild("GuardAreas")
            local am = ga and ga:FindFirstChild(areaName)
            local g = am and am:FindFirstChild("Guard")
            return g ~= nil and g:FindFirstChild("GuardWakeHighlight") ~= nil
        end)
        return ok and awake == true
    end

    local function guardModelAwake(am)
        local ok, awake = pcall(function()
            local g = am and am:FindFirstChild("Guard")
            return g ~= nil and g:FindFirstChild("GuardWakeHighlight") ~= nil
        end)
        return ok and awake == true
    end

    local function nearestGuard(from, skipArea)
        local obj = workspace:FindFirstChild("__OBJECTS")
        local areas = obj and obj:FindFirstChild("Areas")
        local ga = areas and areas:FindFirstChild("GuardAreas")
        if not ga then return nil end
        local okc, kids = pcall(function() return ga:GetChildren() end)
        if not okc or not kids then return nil end
        local bestA, bestP, bestD
        for _, am in ipairs(kids) do
            local nm = tostring(am.Name)
            if nm ~= "Light Dark" and nm ~= skipArea then
                local okr, p = pcall(function()
                    local g = am:FindFirstChild("Guard")
                    local gr = g and g:FindFirstChild("HumanoidRootPart")
                    return gr and gr.Position
                end)
                if okr and typeof(p) == "Vector3" then
                    local d = math.sqrt((p.X - from.X) ^ 2 + (p.Z - from.Z) ^ 2)
                    if not bestD or d < bestD then bestA, bestP, bestD = am, p, d end
                end
            end
        end
        return bestA, bestP, bestD
    end

    local function rootAlive(root)
        if myRoot() ~= root then return false end
        local ch = myCharacter()
        local okh, hp = pcall(function()
            local hum = ch and ch:FindFirstChild("Humanoid")
            return hum and hum.Health
        end)
        return okh and type(hp) == "number" and hp > 0
    end

    FM.RagdollTpMin = 40
    FM.RagdollTpOffset = 0
    -- no wait needed: with the body stripped there is no assembly left to bounce
    FM.RagdollTpDelay = 0
    FM.RagdollTpGiveUp = 15
    FM.RagdollTpHold = 0
    FM.RagdollTpSettle = 0
    -- 0 = go straight back and try again instead of falling back to running
    FM.RagdollTpCool = 0
    -- the one real reason to pause: a woken guard has to settle before it can hit us
    FM.RagdollTpAwakeCool = 1
    FM.RagdollTpGap = 0.01
    FM.RagdollTpBurst = 3
    FM.RagdollTpHeight = 0
    FM.RagdollTpHooks = true
    FM.RespawnWait = FM.RespawnWait or 2.5

    local function ghostRestore()
        local saved = FM.GhostSaved
        FM.GhostSaved, FM.GhostSeen = nil, nil
        if not saved then return 0 end
        local back, since = 0, 0
        for i = #saved, 1, -1 do
            local e = saved[i]
            if e.o and e.p then
                local oko, cur = pcall(function() return e.o.Parent end)
                if oko and cur ~= nil then
                    if pcall(function() e.o.Parent = e.p end) then back = back + 1 end
                end
            end
            -- Reparenting all 281 objects inside one frame is what takes the client down:
            -- it crashed mid-teleport, after a delivery, and again leaving the treadmill.
            -- Spread them over frames instead. The whole thing still finishes in about a
            -- fifth of a second, which is fast enough even for the respawn path.
            since = since + 1
            if since >= (FM.GhostChunk or 40) then
                since = 0
                pcall(function() task.wait() end)
            end
        end
        FM.GhostBack = back
        return back
    end

    local function ghostStrip(ch)
        local okc, cam = pcall(function() return workspace.CurrentCamera end)
        if not okc or not cam then return 0 end
        local okk, kids = pcall(function() return ch:GetDescendants() end)
        if not okk or not kids then return 0 end
        local saved = FM.GhostSaved or {}
        local seen = FM.GhostSeen or {}
        local moved = 0
        for _, d in ipairs(kids) do
            local okn, nm = pcall(function() return d.Name end)
            -- their filter is IsA("Motor6D"), but Matcha's IsA returns true for every
            -- class, so the name test is the only part that narrows it. Do that directly.
            if okn and nm ~= "RootJoint" and nm ~= "Root" then
                local okp, par = pcall(function() return d.Parent end)
                if okp and par and par ~= cam then
                    if not seen[d] then
                        seen[d] = true
                        saved[#saved + 1] = { o = d, p = par }
                    end
                    if pcall(function() d.Parent = cam end) then moved = moved + 1 end
                end
            end
        end
        FM.GhostSaved, FM.GhostSeen, FM.GhostMoved = saved, seen, moved
        return moved
    end

    FM.ghostStep = function(root, off)
        local ch = myCharacter()
        -- Belt and braces for the same trap: if the character read comes back as the Camera,
        -- as nil, or as anything that is not a Model, do nothing at all this step. A bad read
        -- must not strip, must not restore, and must not move the GhostChar goalposts.
        local okcl, cl = pcall(function() return ch and ch.ClassName end)
        local okcam, camNow = pcall(function() return workspace.CurrentCamera end)
        if not ch or (okcam and ch == camNow) or not okcl or cl ~= "Model" then
            FM.GhostBadChar = (FM.GhostBadChar or 0) + 1
            return
        end
        if ch ~= FM.GhostChar then
            -- Hand the old body back before letting go of it, or 281 parts are left in
            -- the Camera after every death and pile up there for the rest of the session.
            if FM.GhostSaved then pcall(ghostRestore) end
            FM.GhostChar, FM.GhostSaved, FM.GhostSeen = ch, nil, nil
            FM.GhostReadyAt = nil
            _G.SEHUB_GROOT = nil
        end
        if root then _G.SEHUB_GROOT = root end
        -- Matcha answers FindFirstChild from a stale index, so the script still sees an
        -- intact character - root, Humanoid, health, LowerTorso - while every part really
        -- sits in the Camera. Nothing needs to stand down for this. And every restore is
        -- a 281-object reparent in one frame, which is what crashed the client mid-
        -- teleport and again after a delivery. So: strip once, and only ever hand the
        -- body back when the farm stops or you turn the toggle off.
        -- Leaving a treadmill while stripped has crashed the client three times now,
        -- including with the restore already spread over frames, so frame budget was not
        -- the cause. Stand down for the treadmill entirely: the body goes back while you
        -- are stood still on your own plot, which is the calmest moment there is, and you
        -- do not need the speed to train.
        -- Belt and braces for the treadmill: go by where you actually are, not just the
        -- flags. However you got onto it - the farm walking you there, or you turning the
        -- farm on mid-workout - stepping off stripped crashes the client.
        local onTreadNow = FM.onTreadmill or FM.treadVisit
        if not onTreadNow then
            local tp = myTreadmill()
            local rr = myRoot()
            local okrp, rp = pcall(function() return rr and rr.Position end)
            if tp and okrp and rp then
                onTreadNow = math.sqrt((rp.X - tp.X) ^ 2 + (rp.Z - tp.Z) ^ 2)
                    < (FM.TreadmillNear or 14)
            end
        end
        local want = FM.Ghost and not off
            and not onTreadNow
            -- Friend Drop needs the WALL to kill you. That specific death is what drops
            -- the egg by your plot; an ordinary health-zero death just returns it to its
            -- nest, which is what "egg gets returned" was. A stripped character takes no
            -- wall damage, so stay out of ghost for the whole Friend Drop cycle - from
            -- before the egg is picked up through to the dive.
            and not FM.DeathDrop and not FM.ddPhase
        if not want then
            if FM.GhostSaved then
                ghostRestore()
                FM.GhostOffs = (FM.GhostOffs or 0) + 1
            end
            FM.Stick = FM.StickSet or 18
            FM.Speed = math.min(FM.SpeedSet or 300, 300)
            return
        end
        FM.Stick = 0
        FM.Speed = math.min(FM.SpeedSet or 300, 900)
        local now = tick()
        -- Never hold a dead or half-loaded character stripped: dying in ghost leaves you
        -- permanently dead. Hand the body back the instant health hits 0, and stay out of
        -- ghost until the replacement character has respawned and settled.
        local alive = false
        local okh, hpNow = pcall(function()
            local h = ch and ch:FindFirstChild("Humanoid")
            return h and h.Health
        end)
        if okh and type(hpNow) == "number" and hpNow > 0 then alive = true end
        if not alive then
            if FM.GhostSaved then
                ghostRestore()
                FM.GhostDeaths = (FM.GhostDeaths or 0) + 1
            end
            FM.GhostReadyAt = nil
            return
        end
        -- alive again, but give the new character a moment before taking it apart
        FM.GhostReadyAt = FM.GhostReadyAt or (now + (FM.GhostRespawnWait or 1.5))
        if now < FM.GhostReadyAt then
            FM.GhostWaiting = true
            return
        end
        FM.GhostWaiting = false
        -- The strip never decays: all 281 objects were still in the Camera at t+17s with
        -- nothing re-applying them. So this runs once per character, no timer.
        if ch and not FM.GhostSaved then
            ghostStrip(ch)
            FM.GhostStrips = (FM.GhostStrips or 0) + 1
        end
    end

    ragdollTeleport = function(root, me, best)
        local now = tick()
        -- Straight after a respawn the character is still loading. Firing teleports at an egg
        -- from your base during that window is what kills you on the way back in.
        if FM.respawnAt and (now - FM.respawnAt) < (FM.RespawnSettle or 3) then
            FM.RagdollTpWhy = "still loading back in"
            return false
        end
        if (FM.rtCoolUntil or 0) > now or not best or not best.pos then return false end
        local gArea, gpos = nearestGuard(me, tostring(best.area))
        if not gpos then
            FM.RagdollTpWhy = "no guard with a body right now"
            return false
        end
        local gName = tostring(gArea and gArea.Name or "guard")
        local forestPrompts = promptsNear(gpos, 30)
        local launchPrompt, launchPos, bd
        for _, e in ipairs(forestPrompts) do
            local okq, pp = pcall(function() return e.p.Parent.Position end)
            if okq and pp and (not bd or e.d < bd) then
                launchPrompt, launchPos, bd = e.p, pp, e.d
            end
        end
        if not launchPrompt then
            FM.RagdollTpWhy = "no egg next to the " .. gName .. " guard"
            return false
        end
        local tpos = best.pos
        if math.sqrt((tpos.X - launchPos.X) ^ 2 + (tpos.Z - launchPos.Z) ^ 2) < (FM.RagdollTpMin or 600) then
            FM.RagdollTpWhy = "target too close to the launch egg"
            return false
        end
        local dMeTarget = math.sqrt((tpos.X - me.X) ^ 2 + (tpos.Z - me.Z) ^ 2)
        local dMeLaunch = math.sqrt((launchPos.X - me.X) ^ 2 + (launchPos.Z - me.Z) ^ 2)
        -- The launch egg only has to be no further away than the target, not 150 studs
        -- nearer than it. A short detour is nothing next to the thousands of studs the
        -- teleport saves, and the old margin was quietly cancelling runs that would have
        -- worked. Set FM.RagdollTpOnWay back to 150 for the old behaviour.
        if dMeLaunch + (FM.RagdollTpOnWay or 0) > dMeTarget then
            FM.RagdollTpWhy = "launch egg is not on the way"
            return false
        end
        -- Ghost has to be ON before we commit. Un-stripped, the guard hit flings you instead
        -- of leaving the pin to hold, which is the "teleport ragdolled" failure. Ghost
        -- re-engages a moment after any stand-down, so just come back next step - failures
        -- retry immediately now, so waiting costs nothing.
        if FM.Ghost and not FM.DeathDrop and not FM.GhostSaved then
            FM.RagdollTpWhy = "waiting for ghost mode to take hold"
            FM.RagdollTpWaits = (FM.RagdollTpWaits or 0) + 1
            FM.rtGhostWaitAt = FM.rtGhostWaitAt or now
            if (now - FM.rtGhostWaitAt) < (FM.RagdollTpGhostWait or 2) then
                -- Stand still instead of handing the step back to the farm. Letting it set
                -- off for the target is why you ran the wrong way for a second or two and
                -- then got yanked back to the launch egg the moment ghost engaged.
                pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, 0, 0) end)
                FM.State = "Waiting for ghost mode before the teleport"
                task.wait(0.03)
                return true
            end
            -- waited long enough - ghost is not coming, so just run it normally
            return false
        end
        FM.rtGhostWaitAt = nil
        FM.RagdollTpWhy = nil

        local dl = math.sqrt((launchPos.X - me.X) ^ 2 + (launchPos.Z - me.Z) ^ 2)
        if dl > 2 then
            -- a single jump holds up to about 150 studs before the position check pulls
            -- it back (measured: +120 held, +200 reverted inside 0.12s), so take the
            -- whole last stretch in one hop instead of running it
            if dl <= 120 then
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    root.CFrame = CFrame.new(launchPos.X, me.Y, launchPos.Z)
                end)
            else
                local sp = FM.Speed
                local brakeAt = math.max(FM.Brake or 30, 60)
                if dl < brakeAt then sp = math.max(20, FM.Speed * (dl / brakeAt)) end
                local ux, uz = steerAround(me, launchPos.X, launchPos.Z, sp)
                drive(root, ux * sp, uz * sp, -(FM.Stick or 18))
            end
            FM.rtQuietUntil = now + 1.5
            FM.State = "Ragdoll teleport - going to the " .. gName .. " egg"
            task.wait(0.03)
            return true
        end
        if guardModelAwake(gArea) then
            FM.rtCoolUntil = now + (FM.RagdollTpAwakeCool or 1)
            return false
        end

        FM.rtBusyUntil = now + 12
        FM.rtQuietUntil = now + 12
        local slowed = {}
        if memory_read and memory_write then
            for _, e in ipairs(forestPrompts) do
                local a = addrOf(e.p)
                if a and promptWritable(a) then
                    ST.keepSlow[a] = now + 12
                    slowed[#slowed + 1] = a
                    local want = math.max(0, math.min(5, FM.RagdollTpHold or 1.2))
                    local wantDist = ST.orig[a] and ST.orig[a].dist
                    if not wantDist or wantDist < 10 then wantDist = 10 end
                    ST.suppressed[a] = nil
                    pcall(function()
                        memory_write("float", a + ST.OFF_HOLD, want)
                        memory_write("float", a + ST.OFF_DIST, wantDist)
                    end)
                end
            end
        end
        local function finish(cool, state)
            for _, a in ipairs(slowed) do ST.keepSlow[a] = nil end
            FM.rtBusyUntil = tick() + 0.3
            FM.rtQuietUntil = tick() + 0.5
            AB.rtLive = 0
            if cool then FM.rtCoolUntil = tick() + cool end
            if state then FM.State = state end
        end

        FM.State = "Ragdoll teleport - grabbing the " .. gName .. " egg"
        local off = FM.RagdollTpOffset or 2.5
        local hx, hz = launchPos.X - tpos.X, launchPos.Z - tpos.Z
        local hm = math.sqrt(hx * hx + hz * hz)
        local lx, lz = tpos.X, tpos.Z
        if hm > 0.01 then lx, lz = tpos.X + hx / hm * off, tpos.Z + hz / hm * off end
        local baseY, tbd = tpos.Y, nil
        for _, e in ipairs(promptsNear(tpos, 8)) do
            local okq, pp = pcall(function() return e.p.Parent.Position end)
            if okq and pp and (not tbd or e.d < tbd) then baseY, tbd = pp.Y, e.d end
        end
        local ty = baseY + (me.Y - launchPos.Y)
        if math.abs(ty - me.Y) > 30 then ty = me.Y end
        local settleAt = tick()
        while (tick() - settleAt) < (FM.RagdollTpSettle or 0.35) and FM.On and rootAlive(root) do
            pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, -(FM.Stick or 18), 0) end)
            task.wait(0.05)
        end
        local function grabLanded()
            -- The ragdoll is the surest sign of all: the guard only wakes because the grab
            -- landed, and UpperTorso's constraints are one of the few runtime additions
            -- Matcha reports live. GuardWakeHighlight never turns up in its stale index, so
            -- that check below can never fire, and the prompt-vanishing test lags behind the
            -- actual grab - between them that is the noGrab failure.
            if ragdollJoints() then return true end
            if guardModelAwake(gArea) then return true end
            return #promptsNear(launchPos, 6) == 0
        end
        local woke = false
        if (FM.RagdollTpHold or 1.2) < 0.05 then
            local tapEnd = tick() + (FM.RagdollTpTapFor or 3.5)
            while tick() < tapEnd and FM.On and rootAlive(root) and not woke do
                pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, -(FM.Stick or 18), 0) end)
                if keypress then pcall(function() keypress(0x45) end) end
                task.wait(0.06)
                if keyrelease then pcall(function() keyrelease(0x45) end) end
                task.wait(0.1)
                if grabLanded() then woke = true end
                FM.RagdollTpTaps = (FM.RagdollTpTaps or 0) + 1
            end
        else
        for _ = 1, 2 do
            if not (FM.On and rootAlive(root)) then break end
            if keypress then pcall(function() keypress(0x45) end) end
            local t0 = tick()
            while (tick() - t0) < 2.2 and FM.On and rootAlive(root) do
                pcall(function() root.AssemblyLinearVelocity = Vector3.new(0, -(FM.Stick or 18), 0) end)
                if grabLanded() then
                    woke = true
                    break
                end
                task.wait(0.05)
            end
            if keyrelease then pcall(function() keyrelease(0x45) end) end
            if woke then break end
            task.wait(0.2)
            if grabLanded() then
                woke = true
                break
            end
            FM.RagdollTpRepress = (FM.RagdollTpRepress or 0) + 1
        end
        end
        if not woke then
            FM.RagdollTpNoGrab = (FM.RagdollTpNoGrab or 0) + 1
            FM.RagdollTpStreak = (FM.RagdollTpStreak or 0) + 1
            finish(FM.RagdollTpCool or 0, string.format(
                "Ragdoll teleport - %s grab missed, retrying (%d)", gName, FM.RagdollTpStreak))
            return true
        end

        FM.State = "Ragdoll teleport - going to the boss for the hit"
        local t1 = tick()
        while (tick() - t1) < 3 and FM.On and rootAlive(root) and not ragdollJoints() do
            -- go to the boss rather than stand still waiting for it to walk over. It is
            -- only a short hop from the launch egg, well inside what the position check
            -- tolerates, and it stops once we are on top of it.
            local okg, gp = pcall(function()
                local g = gArea and gArea:FindFirstChild("Guard")
                local gr = g and g:FindFirstChild("HumanoidRootPart")
                return gr and gr.Position
            end)
            local okm, mp = pcall(function() return root.Position end)
            if okg and typeof(gp) == "Vector3" and okm and mp then
                local d = math.sqrt((gp.X - mp.X) ^ 2 + (gp.Z - mp.Z) ^ 2)
                if d > 4 and d < 120 then
                    pcall(function()
                        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        root.CFrame = CFrame.new(gp.X, gp.Y, gp.Z)
                    end)
                    FM.RagdollTpBossHops = (FM.RagdollTpBossHops or 0) + 1
                end
            end
            task.wait(0.03)
        end
        if not ragdollJoints() then
            if rootAlive(root) then
                FM.hasEgg, FM.eggIsTool, FM.depositAt = true, false, nil
                FM.grabbedAt, FM.lastPressAt = tick(), tick()
                FM.carryPos = launchPos
                FM.carryKey = string.format("%d_%d", launchPos.X, launchPos.Z)
                FM.carrySlotGone, FM.grabReloads, FM.carryW = true, FM.Reloads, 1
                FM.grabArea = gName
            end
            FM.RagdollTpNoHit = (FM.RagdollTpNoHit or 0) + 1
            FM.RagdollTpStreak = (FM.RagdollTpStreak or 0) + 1
            -- we are holding the launch egg now, so the retry comes round naturally on the
            -- next run once this one is delivered - no reason to sit on a cooldown
            finish(FM.RagdollTpCool or 0, "Ragdoll teleport - no hit, taking the egg home")
            return true
        end

        FM.State = "Ragdoll teleport - teleporting"
        local writes, holds, cut, misses = 0, 0, false, 0
        -- Friend Drop needs the old 1.5s wait right here. At 0 the pin lands while the ragdoll
        -- is still bouncing and the whole dive goes wrong from there. The ordinary farm is fine
        -- at 0 because it is not about to throw itself at a wall straight afterwards.
        local rtWait = FM.RagdollTpDelay or 0
        if FM.DeathDrop then rtWait = FM.FriendDropTpDelay or 1.5 end
        local t2 = tick()
        while (tick() - t2) < rtWait and ragdollJoints() and rootAlive(root) do
            task.wait(0.03)
        end
        local pinY = ty + (FM.RagdollTpHeight or 0)
        if FM.RagdollTpHooks then
            AB.rtCF = CFrame.new(lx, pinY, lz)
            AB.rtLive = tick() + 6
        end
        -- the pin window is measured from before the wait, so give it that time back
        while FM.On and (tick() - t2) < (5 + rtWait)
              and ragdollJoints() and rootAlive(root) do
            for _ = 1, math.max(1, math.floor(FM.RagdollTpBurst or 1)) do
                pcall(function()
                    root.CFrame = CFrame.new(lx, pinY, lz)
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end)
            end
            task.wait(FM.RagdollTpGap or 0.03)
            writes = writes + 1
            local okq, q = pcall(function() return root.Position end)
            if okq and q and math.sqrt((q.X - lx) ^ 2 + (q.Z - lz) ^ 2) < 10 then
                holds = holds + 1
                misses = 0
            else
                misses = misses + 1
            end
            if misses >= (FM.RagdollTpGiveUp or 3) or (writes >= 10 and holds < writes * 0.5) then
                cut = true
                break
            end
        end
        -- Let go the instant the pin loop is done. rtLive was armed for a flat 6 seconds
        -- regardless of how quickly the landing happened, and while it is live the frame hook
        -- rewrites your CFrame every frame at the pin height with the velocity zeroed - so you
        -- hang in the air afterwards, unable to grab, until the 6s runs out. That is the
        -- floating. Clearing it here lets the landing settle below actually pull you down.
        AB.rtLive = 0
        while (tick() - t2) < 6 and ragdollJoints() and rootAlive(root) do task.wait(0.05) end
        task.wait(0.1)
        local okq, q = pcall(function() return root.Position end)
        local landed = (not cut) and writes > 0 and rootAlive(root) and okq and q
            and math.sqrt((q.X - lx) ^ 2 + (q.Z - lz) ^ 2) < 15
        FM.LastRagdollTp = string.format("%d writes, %d held, %s", writes, holds, landed and "landed" or "failed")
        if landed then
            FM.RagdollTps = (FM.RagdollTps or 0) + 1
            if ST.On then pcall(function() patchNear(tpos, 30) end) end
            -- Ghost sets Stick to 0, because downward force at speed is what the ground
            -- check kills you for. That made this settle push nothing at all, which is why
            -- you were left hanging in the air drifting slowly down. Use a landing push of
            -- its own, and hold it until you actually stop falling.
            local settle2, lastY = tick(), nil
            while (tick() - settle2) < (FM.LandSettle or 1.5) and rootAlive(root) do
                pcall(function()
                    root.AssemblyLinearVelocity = Vector3.new(0, -(FM.LandStick or 40), 0)
                end)
                task.wait(0.05)
                local oky, py = pcall(function() return root.Position.Y end)
                if oky and py then
                    if lastY and math.abs(py - lastY) < 0.05 then break end
                    lastY = py
                end
            end
            FM.RagdollTpStreak = 0
            finish(nil, "Ragdoll teleport - landed")
        else
            FM.RagdollTpFails = (FM.RagdollTpFails or 0) + 1
            FM.RagdollTpStreak = (FM.RagdollTpStreak or 0) + 1
            finish(FM.RagdollTpCool or 0, string.format(
                "Ragdoll teleport - pin lost, retrying (%d)", FM.RagdollTpStreak))
        end
        return true
    end
end

local function farmStep()
    local task = PROF_TASK
    if not FM.On then
        if FM.ddPhase then FM.ddPhase, FM.ddSpawnAt, FM.ddLastChar = nil, nil, nil end
        if FM.bhPhase then FM.bhPhase, FM.bhSeen, FM.bhMiss = nil, nil, nil end
        if FM.ghostStep then FM.ghostStep(nil, true) end
        task.wait(0.2)
        return
    end
    local root = myRoot()
    if not root then
        FM.State = "Waiting for character"
        if FM.ghostStep then FM.ghostStep(nil, true) end
        task.wait(0.5)
        return
    end
    if FM.ghostStep then FM.ghostStep(root) end
    -- Respawning can drop you in half sunk into the floor, where you slide about while the
    -- farm believes it is running normally. Check once per character and lift clear.
    do
        local uch = myCharacter()
        if uch ~= FM.unstickChar then
            FM.unstickChar, FM.unstickAt, FM.unstickDone = uch, tick(), false
        end
        if not FM.unstickDone and FM.unstickAt and (tick() - FM.unstickAt) > 1.5 then
            FM.unstickDone = true
            local okup, up = pcall(function() return root.Position end)
            local ground = TREAD_SPAWN or homePos()
            if okup and up and ground and up.Y < (ground.Y - 1) then
                pcall(function()
                    root.CFrame = CFrame.new(up.X, ground.Y + 3, up.Z)
                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end)
                FM.RespawnUnstick = (FM.RespawnUnstick or 0) + 1
            end
        end
    end
    local okp, me = pcall(function() return root.Position end)
    if not okp or not me then task.wait(0.2) return end
    if AB.pinning and tick() < (AB.pinUntil or 0) then
        task.wait(0.03)
        return
    end
    do
        do
            do
                do
                    local now = tick()

                    local homeP = homePos()
                    if FM.needRally and homeP and not FM.ddPhase and not FM.bhPhase then
                        FM.rallySpot = FM.rallySpot or pickHomeSpot() or homeP
                        local rp = FM.rallySpot
                        local d = (Vector3.new(rp.X, me.Y, rp.Z) - me).Magnitude
                        if d > (FM.SpotReach or 4) then
                            local flat = Vector3.new(rp.X - me.X, 0, rp.Z - me.Z)
                            local m = flat.Magnitude
                            if m > 0.01 then
                                local sp = FM.Speed
                                if d < (FM.Brake or 60) then
                                    sp = math.max(25, FM.Speed * (d / (FM.Brake or 60)))
                                end
                                local ux, uz = steerAround(me, rp.X, rp.Z, sp)
                                drive(root, ux * sp, uz * sp, -(FM.Stick or 18))
                            end
                            FM.State = "Respawned - heading back"
                            task.wait(0.03)
                            return
                        else
                            FM.needRally = false
                            FM.rallySpot = nil
                            FM.State = "Resuming"
                            if FM.retryKey and FM.retryPos and not FM.retryUntil then
                                local far = (Vector3.new(FM.retryPos.X, me.Y, FM.retryPos.Z) - me).Magnitude
                                FM.retryUntil = now + (FM.RetryWindow or 15) + far / math.max(50, FM.Speed or 290)
                            end
                        end
                    end

                    do
                        local sf = workspace:FindFirstChild("AreaEggSlotsClient")
                        local okn, kids = pcall(function() return sf and sf:GetChildren() end)
                        local nSlots = (okn and kids) and #kids or 0
                        if nSlots == 0 then
                            FM.nightSince = FM.nightSince or now
                            -- remember when night STARTED, not just that it is night
                            FM.nightStart = FM.nightStart or now
                        elseif FM.nightSince then
                            FM.nightSince, FM.dayAt = nil, now
                        end
                        -- Night plus the opening slice of day - everything before the barrier
                        -- lifts - runs about 15 seconds end to end. The old wait counted 5s
                        -- from the moment eggs appeared, which is the wrong anchor and let the
                        -- farm out early: the first teleport to the launch egg and the boss
                        -- then failed against a barrier that was still up, costing a whole
                        -- retry. Time it from the start of night instead.
                        if FM.nightStart then
                            local left = (FM.nightStart + (FM.NightHold or 15)) - now
                            if left > 0 then
                                pcall(function()
                                    root.AssemblyLinearVelocity =
                                        Vector3.new(0, -(FM.LandStick or 40), 0)
                                end)
                                FM.State = string.format(
                                    "Waiting for the barrier (%.1fs)", left)
                                task.wait(0.1)
                                return
                            end
                            FM.nightStart = nil
                            FM.BarrierWaits = (FM.BarrierWaits or 0) + 1
                        end
                    end
                    local RW = _G.SEHUB_WATCH or {}
                    -- Stop guessing. A carried egg is a workspace model that follows you a
                    -- stud or two away, so just look: if we believe we are carrying and there
                    -- is no egg anywhere near us for about a second, it is genuinely gone.
                    -- This replaces the ragdoll/fling heuristics, which were wrong in both
                    -- directions - first inventing losses from our own teleports, then missing
                    -- real ones once that was tightened up.
                    local eggGone = false
                    if FM.hasEgg and FM.grabbedAt and (now - FM.grabbedAt) > 1.2
                       and (FM.carryChkAt or 0) < now then
                        FM.carryChkAt = now + (FM.CarryCheckEvery or 0.3)
                        -- Look with the WIDE finder (workspace plus the render containers) and
                        -- at a generous radius. The narrow one kept missing the egg that was in
                        -- our hands the whole time: Taken 1, EggsLost 2 - more losses than eggs
                        -- ever picked up. Each false miss started a recovery, which froze us,
                        -- tapped E, picked the same egg back up, and went round again.
                        if #droppedEggsNear(me, FM.CarryNear or 25) > 0 then
                            FM.carryMiss = 0
                        else
                            FM.carryMiss = (FM.carryMiss or 0) + 1
                            -- Patience is only needed when nothing corroborates the miss. If a
                            -- boss just hit us, believe it straight away - waiting out the full
                            -- 2.4s is why the recovery started so late you had already run half
                            -- way home.
                            local need = FM.CarryMissNeed or 8
                            if FM.lastHitAt
                               and (now - FM.lastHitAt) < (FM.BossHitMemory or 6) then
                                need = FM.CarryMissHit or 2
                            end
                            if FM.carryMiss >= need then
                                eggGone, FM.carryMiss = true, 0
                            end
                        end
                    end
                    if not FM.hasEgg then FM.carryMiss = 0 end
                    -- A miss on its own proves nothing. The scan genuinely cannot see an egg
                    -- that IS in our hands - CarryFalseLost climbed while hasEgg was true and
                    -- the wide finder reported nothing within 60 studs. So unless a boss hit us
                    -- just now, we are still carrying: believing otherwise is what sent the farm
                    -- off for a second egg with the first still in hand, over and over.
                    local hitRecent = FM.lastHitAt
                        and (now - FM.lastHitAt) < (FM.BossHitMemory or 6)
                    if eggGone and not hitRecent then
                        FM.CarryFalseLost = (FM.CarryFalseLost or 0) + 1
                        eggGone = false
                    end
                    if eggGone and FM.carryKey and not FM.recovering then
                        local lostKey = FM.carryKey
                        FM.retryTries = FM.retryTries or {}
                        local rt = FM.retryTries[lostKey]
                        if not rt or (now - rt.at) > 60 then rt = { n = 0, at = now } end
                        rt.n, rt.at = rt.n + 1, now
                        FM.retryTries[lostKey] = rt
                        FM.recovering, FM.recoverStart = (FM.RetryMax or 0) > 0, now
                        local lostPos = FM.carryPos
                        local hit = (((RW.flingAt or 0) >= (RW.lastRagAt or 0)) and RW.flingFrom or RW.ragPos) or me
                        local nearNest = lostPos
                            and math.sqrt((hit.X - lostPos.X) ^ 2 + (hit.Z - lostPos.Z) ^ 2) <= (FM.RetryRange or 300)
                        FM.retryKey = (nearNest and rt.n <= (FM.RetryMax or 3)) and lostKey or nil
                        FM.retryPos = FM.retryKey and lostPos or nil
                        FM.retryUntil = nil
                        FM.retryBackSeen = false
                        FM.hasEgg, FM.depositAt, FM.eggIsTool, FM.grabbedAt = false, nil, false, nil
                        FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                        FM.carryKey = nil
                        FM.EggsLost = (FM.EggsLost or 0) + 1
                        -- We know where we were standing when it went missing, so start the
                        -- recovery there rather than waiting for a boss hit to trigger it.
                        -- We only get here with a real hit behind us. Recovery is off by
                        -- default now, so normally we just let the egg go and move on.
                        if FM.EggRecovery and not FM.bhPhase then
                            -- go back to where the hit landed: the egg fell there, and we have
                            -- run on since while the carry check made its mind up
                            local hp0 = FM.lastHitPos or me
                            FM.bhPhase, FM.bhAt = "stopped", now
                            FM.bhX, FM.bhY, FM.bhZ = hp0.X, hp0.Y, hp0.Z
                            FM.bhSeen, FM.bhPinX, FM.bhPinZ = nil, nil, nil
                            FM.bhTried, FM.bhEggX, FM.bhEggZ = nil, nil, nil
                            FM.EggGoneRecoveries = (FM.EggGoneRecoveries or 0) + 1
                            FM.State = "Egg gone - going back for it"
                        end
                    end
                    if FM.recovering then
                        local sinceRag = now - math.max(RW.lastRagAt or 0, RW.flingAt or 0, FM.recoverStart or 0)
                        local bnd = playBounds()
                        local settled = ((not homeP) or math.abs(me.Y - homeP.Y) < 25)
                            and me.Z >= bnd.minz - 50 and me.Z <= bnd.maxz + 50
                        if sinceRag >= (FM.RecoverWait or 2.5) and settled then
                            FM.recovering = false
                            if FM.retryKey then
                                FM.retryUntil = now + (FM.RetryWindow or 15)
                                FM.visited[FM.retryKey] = nil
                            end
                        elseif now - FM.recoverStart > 12 then
                            FM.recovering, FM.retryKey, FM.retryUntil = false, nil, nil
                        else
                            FM.State = "Ragdolled - recovering"
                            task.wait(0.1)
                            return
                        end
                    end
                    if FM.retryKey and FM.retryUntil then
                        if now > FM.retryUntil then
                            FM.retryKey, FM.retryUntil = nil, nil
                        else
                            local back = false
                            local rp = FM.retryPos
                            for _, sl in ipairs(eggSlots()) do
                                local k = string.format("%d_%d", sl.pos.X, sl.pos.Z)
                                if k == FM.retryKey
                                   or (rp and math.sqrt((sl.pos.X - rp.X) ^ 2 + (sl.pos.Z - rp.Z) ^ 2) <= 10
                                       and isNewSlot(sl, FM.carryNear)) then
                                    back = true
                                    FM.retryKey = k
                                    break
                                end
                            end
                            if back and not FM.retryBackSeen then
                                FM.retryBackSeen = true
                                FM.RetryReturns = (FM.RetryReturns or 0) + 1
                            end
                            if not back and not FM.hasEgg and rp then
                                local dx, dz = rp.X - me.X, rp.Z - me.Z
                                local dn = math.sqrt(dx * dx + dz * dz)
                                local holdAt = FM.RetryHoldDist or 45
                                if dn > holdAt + 5 then
                                    local sp = FM.Speed
                                    if (dn - holdAt) < (FM.Brake or 60) then
                                        sp = math.max(25, FM.Speed * ((dn - holdAt) / (FM.Brake or 60)))
                                    end
                                    local ux, uz = steerAround(me, rp.X, rp.Z, sp)
                                    drive(root, ux * sp, uz * sp, -(FM.Stick or 18))
                                else
                                    drive(root, 0, 0, -(FM.Stick or 18))
                                end
                                FM.State = string.format("Waiting for the egg to return (%.0fs)", FM.retryUntil - now)
                                task.wait(0.05)
                                return
                            end
                        end
                    end

                    local __s1 = tick()
                    if FM.hasEgg and not FM.carrySlotGone and FM.carryPos and FM.grabReloads == FM.Reloads then
                        local cp = FM.carryPos
                        if math.sqrt((me.X - cp.X) ^ 2 + (me.Z - cp.Z) ^ 2) < 300 then
                            local present = false
                            for _, sl in ipairs(eggSlots()) do
                                if math.sqrt((sl.pos.X - cp.X) ^ 2 + (sl.pos.Z - cp.Z) ^ 2) <= 5 then
                                    present = true
                                    break
                                end
                            end
                            if not present then FM.carrySlotGone = true end
                        end
                    end

                    if FM.hasEgg and FM.carrySlotGone and FM.carryPos and FM.grabbedAt
                       and (now - FM.grabbedAt) > 1.5 and FM.grabReloads == FM.Reloads then
                        local cp = FM.carryPos
                        for _, sl in ipairs(eggSlots()) do
                            if math.sqrt((sl.pos.X - cp.X) ^ 2 + (sl.pos.Z - cp.Z) ^ 2) <= 10
                               and isNewSlot(sl, FM.carryNear) then
                                local k = string.format("%d_%d", sl.pos.X, sl.pos.Z)
                                local tk = FM.carryKey or k
                                FM.retryTries = FM.retryTries or {}
                                local rt = FM.retryTries[tk]
                                if not rt or (now - rt.at) > 60 then rt = { n = 0, at = now } end
                                rt.n, rt.at = rt.n + 1, now
                                FM.retryTries[tk] = rt
                                if rt.n <= (FM.RetryMax or 3) then
                                    FM.retryKey, FM.retryPos, FM.retryBackSeen = k, cp, true
                                    FM.retryUntil = now + (FM.RetryWindow or 15)
                                    FM.visited[k] = nil
                                end
                                FM.hasEgg, FM.depositAt, FM.eggIsTool, FM.grabbedAt = false, nil, false, nil
                                FM.carryKey, FM.carrySlotGone = nil, false
                                FM.EggsLost = (FM.EggsLost or 0) + 1
                                FM.EggBack = (FM.EggBack or 0) + 1
                                break
                            end
                        end
                    end

                    PROFTICK("farm: egg checks", __s1)
                    local __s2 = tick()
                    local LM = FM.lastMiss
                    if LM and (now - LM.at) < 3 and LM.key then
                        local RWl = _G.SEHUB_WATCH or {}
                        local lateAt = math.max(FM.wakeAt or 0, RWl.flingHardAt or 0, RWl.lastRagAt or 0)
                        if lateAt > LM.pressAt and (FM.grabbedAt or 0) <= LM.pressAt and not FM.pendingKey then
                            FM.lastMiss = nil
                            local key, cp = LM.key, LM.pos
                            FM.retryTries = FM.retryTries or {}
                            local rt = FM.retryTries[key]
                            if not rt or (now - rt.at) > 60 then rt = { n = 0, at = now } end
                            rt.n, rt.at = rt.n + 1, now
                            FM.retryTries[key] = rt
                            if cp and rt.n <= (FM.RetryMax or 3) then
                                local far = math.sqrt((cp.X - me.X) ^ 2 + (cp.Z - me.Z) ^ 2)
                                FM.retryKey, FM.retryPos, FM.retryBackSeen = key, cp, false
                                FM.retryUntil = now + (FM.RetryWindow or 15) + far / math.max(50, FM.Speed or 290)
                                FM.visited[key] = nil
                            end
                            if FM.grabRetry then FM.grabRetry[key] = nil end
                            FM.fails[key], FM.banned[key] = nil, nil
                            FM.hasEgg, FM.depositAt, FM.eggIsTool, FM.grabbedAt = false, nil, false, nil
                            FM.carryKey, FM.carrySlotGone = nil, false
                            FM.EggsLost = (FM.EggsLost or 0) + 1
                            FM.State = "Egg knocked back - retrying"
                        end
                    elseif LM then
                        FM.lastMiss = nil
                    end

                    if FM.pendingSlot ~= nil and not FM.pendingHadEgg and heldEggTool() then
                        FM.eggIsTool = true
                        FM.Confirmed = (FM.Confirmed or 0) + 1
                        if FM.grabRetry and FM.pendingKey then
                            FM.grabRetry[FM.pendingKey] = nil
                            FM.fails[FM.pendingKey] = nil
                        end
                        if FM.pendingKey and not slotGone(FM.pendingSlot) then
                            FM.visited[FM.pendingKey] = tick()
                            FM.WrongEgg = (FM.WrongEgg or 0) + 1
                        end
                        FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                    elseif FM.pendingSlot ~= nil then
                        local took = nil
                        if FM.pendingNear and #FM.pendingNear > 0 and not slotGone(FM.pendingSlot) then
                            local slotsNow = eggSlots()
                            for _, nb in ipairs(FM.pendingNear) do
                                local still = false
                                for _, sl in ipairs(slotsNow) do
                                    if math.abs(sl.pos.X - nb.pos.X) < 1 and math.abs(sl.pos.Z - nb.pos.Z) < 1 then
                                        still = true
                                        break
                                    end
                                end
                                if not still then
                                    took = nb
                                    break
                                end
                            end
                        end
                        if not took and FM.pendingPromptNear and #FM.pendingPromptNear > 0
                           and not slotGone(FM.pendingSlot) then
                            local nowPrompts = eggPromptSpots(nil)
                            if #nowPrompts > 10 then
                                for _, pp in ipairs(FM.pendingPromptNear) do
                                    local still = false
                                    for _, cp in ipairs(nowPrompts) do
                                        if math.abs(cp.X - pp.X) < 1 and math.abs(cp.Z - pp.Z) < 1 then
                                            still = true
                                            break
                                        end
                                    end
                                    if not still then
                                        took = { pos = pp, w = (FM.BigWidth or 6) + 1 }
                                        break
                                    end
                                end
                            end
                        end
                        if slotGone(FM.pendingSlot) then
                            FM.Confirmed = (FM.Confirmed or 0) + 1
                            FM.carrySlotGone = true
                            if FM.grabRetry and FM.pendingKey then
                                FM.grabRetry[FM.pendingKey] = nil
                                FM.fails[FM.pendingKey] = nil
                            end
                            FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                        elseif took then
                            FM.Confirmed = (FM.Confirmed or 0) + 1
                            FM.WrongEgg = (FM.WrongEgg or 0) + 1
                            if FM.pendingKey then
                                if FM.grabRetry then FM.grabRetry[FM.pendingKey] = nil end
                                FM.fails[FM.pendingKey] = nil
                            end
                            local nearNow = { { pos = FM.carryPos } }
                            for _, nb in ipairs(FM.pendingNear or {}) do
                                if nb ~= took then nearNow[#nearNow + 1] = nb end
                            end
                            FM.carryNear = nearNow
                            FM.carryKey = string.format("%d_%d", took.pos.X, took.pos.Z)
                            FM.carryPos, FM.carrySlotGone = took.pos, true
                            FM.carryW = took.w or FM.carryW
                            FM.pendingSlot, FM.pendingKey, FM.pendingAt, FM.pendingNear = nil, nil, nil, nil
                        elseif (tick() - (FM.pendingAt or 0)) > 1.5 and not grabStillThere() then
                            FM.Confirmed = (FM.Confirmed or 0) + 1
                            FM.carrySlotGone = true
                            FM.ConfirmedByScan = (FM.ConfirmedByScan or 0) + 1
                            if FM.grabRetry and FM.pendingKey then
                                FM.grabRetry[FM.pendingKey] = nil
                                FM.fails[FM.pendingKey] = nil
                            end
                            FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                        elseif (tick() - (FM.pendingAt or 0)) > 1.5 then
                            local key = FM.pendingKey
                            local pressAt = FM.pendingAt or 0
                            FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                            -- The slot we aimed at is still sitting there - but that does not
                            -- mean we came away empty. A big egg between us and it takes the
                            -- prompt, so we walk off holding that one instead. Going home with
                            -- something beats retrying for the one we wanted, so if an egg is
                            -- actually with us, keep it and deliver it.
                            if #eggModelsNear(me, FM.CarryNear or 15) > 0 then
                                FM.hasEgg, FM.eggIsTool = true, false
                                FM.grabbedAt = FM.grabbedAt or tick()
                                FM.carrySlotGone = true
                                FM.WrongEggKept = (FM.WrongEggKept or 0) + 1
                                if key then FM.visited[key] = now end
                                FM.State = "Got a different egg - taking it anyway"
                                task.wait(0.05)
                                return
                            end
                            local RWm = _G.SEHUB_WATCH or {}
                            local reactedAt = math.max(FM.wakeAt or 0, RWm.flingHardAt or 0, RWm.lastRagAt or 0)
                            if key and reactedAt > pressAt then
                                FM.retryTries = FM.retryTries or {}
                                local rt = FM.retryTries[key]
                                if not rt or (now - rt.at) > 60 then rt = { n = 0, at = now } end
                                rt.n, rt.at = rt.n + 1, now
                                FM.retryTries[key] = rt
                                local cp = FM.carryPos
                                if cp and rt.n <= (FM.RetryMax or 3) then
                                    local far = math.sqrt((cp.X - me.X) ^ 2 + (cp.Z - me.Z) ^ 2)
                                    FM.retryKey, FM.retryPos, FM.retryBackSeen = key, cp, false
                                    FM.retryUntil = now + (FM.RetryWindow or 15) + far / math.max(50, FM.Speed or 290)
                                    FM.visited[key] = nil
                                end
                                if FM.grabRetry then FM.grabRetry[key] = nil end
                                FM.fails[key], FM.banned[key] = nil, nil
                                FM.hasEgg, FM.depositAt, FM.eggIsTool, FM.grabbedAt = false, nil, false, nil
                                FM.carryKey, FM.carrySlotGone = nil, false
                                FM.EggsLost = (FM.EggsLost or 0) + 1
                                FM.State = "Egg knocked back - retrying"
                                task.wait(0.05)
                                return
                            end
                            FM.lastMiss = { key = key, pressAt = pressAt, at = tick(), pos = FM.carryPos }
                            FM.grabRetry = FM.grabRetry or {}
                            local tries = (FM.grabRetry[key or ""] or 0) + 1
                            FM.grabRetry[key or ""] = tries
                            if tries < 2 then
                                FM.hasEgg = false
                                if key then FM.visited[key] = nil end
                                FM.State = "Grab missed - retrying"
                                task.wait(0.05)
                                return
                            end
                            FM.Misses = (FM.Misses or 0) + 1
                            if key then
                                FM.fails[key] = (FM.fails[key] or 0) + 1
                                if FM.fails[key] >= 2 then
                                    FM.banned[key] = tick() + 120
                                    FM.Banned = (FM.Banned or 0) + 1
                                    FM.State = "Egg blocked - skipping"
                                end
                            end
                        end
                    end

                    PROFTICK("farm: grab confirm", __s2)
                    local __s3 = tick()
                    local homeNow = homePos()
                    local farFromHome = true
                    if homeNow then
                        farFromHome = (Vector3.new(homeNow.X, me.Y, homeNow.Z) - me).Magnitude
                                      > ((FM.ZoneReach or 12) + 8)
                    end
                    local heldNow = heldEggTool()
                    if heldNow and heldNow == FM.deliveredTool then heldNow = nil end
                    if heldNow and not FM.hasEgg and farFromHome
                       and FM.lastPressAt and (tick() - FM.lastPressAt) < 3 then
                        FM.hasEgg = true
                        FM.eggIsTool = true
                        FM.grabbedAt = FM.grabbedAt or tick()
                        FM.depositAt = nil
                    end

                    if FM.hasEgg and FM.eggIsTool and FM.pendingSlot == nil and FM.grabbedAt
                       and (tick() - FM.grabbedAt) > 1.5 and not heldEggTool() then
                        FM.hasEgg = false
                        FM.depositAt = nil
                        FM.Dropped = (FM.Dropped or 0) + 1
                        FM.State = "Egg lost - back to farming"
                        task.wait(0.05)
                        return
                    end

                    if not FM.hasEgg then FM.homeSpot = nil end
                    -- A boss hit ragdolls you. Come to a dead stop exactly where it happened instead of
                    -- sliding on, and tap E so the egg goes straight back into your hands. We cannot search
                    -- for a dropped egg - Matcha's workspace listing is a stale index and Raycast is a stub -
                    -- but we do not need to: stand still on the spot and the prompt comes to us.
                    -- Always on, no toggle.
                    do
                        local hit = false
                        local okt, ut = pcall(function()
                            local c = myCharacter()
                            return c and c:FindFirstChild("UpperTorso")
                        end)
                        if okt and ut then
                            local okk, kids = pcall(function() return ut:GetChildren() end)
                            if okk and kids then
                                for _, k in ipairs(kids) do
                                    local okc, cl = pcall(function() return k.ClassName end)
                                    if okc and cl == "BallSocketConstraint" then hit = true break end
                                end
                            end
                        end
                        -- during a Ragdoll Teleport the ragdoll is ours on purpose, so leave it
                        -- alone. Keep working the spot for a few seconds after the ragdoll ends
                        -- too, or there is no time left to reach an egg that fell a bit away.
                        -- Not at the safe zone. A boss can ragdoll you there during the quick
                        -- Anti-Boss teleport, and there is no dropped egg to sweep for - pinning
                        -- you on the spot would only stop you delivering.
                        local safeP = AB.Zone or homeP
                        local nearSafe = safeP
                            and math.sqrt((me.X - safeP.X) ^ 2 + (me.Z - safeP.Z) ^ 2)
                                < (FM.BossHitSkipNear or 60)
                        -- The moment a boss hits you: stop dead. Speed to zero right where it
                        -- happened, egg or no egg - being dragged onward while it comes loose
                        -- is what leaves you too far away to get it back. Only if it did come
                        -- loose do we then hop around the spot to reach it, and we are back to
                        -- farming the instant the ragdoll ends with the egg still in hand.
                        local freezeFor = FM.BossHitFreeze or 0.8
                        -- NEVER stop while the egg is still in your hands. Freezing on any hit
                        -- meant getting pinned in place on the way home and battered, and worse:
                        -- straight after a successful pickup you are holding an egg AND still
                        -- ragdolled, so it re-froze you and you lost it again. If you still have
                        -- it, run. Only the recovery - started by the carry check once the egg
                        -- is genuinely gone - gets to stop you.
                        if hit and FM.hasEgg then
                            -- remember where the hit landed, because the egg drops HERE even
                            -- though we will not notice it is missing for another second
                            FM.lastHitPos = Vector3.new(me.X, me.Y, me.Z)
                            FM.lastHitAt = now
                            FM.BossHits = (FM.BossHits or 0) + 1
                        end
                        local active = FM.bhPhase and not FM.hasEgg
                            -- long enough to sit out the ragdoll AND still have time to grab
                            and (now - (FM.bhAt or now)) < (FM.BossHitHold or 7)
                        if active and not nearSafe and (FM.rtBusyUntil or 0) < now
                           and not (AB.pinning and tick() < (AB.pinUntil or 0)) then
                            -- A hard fling throws you hundreds of studs, and the position
                            -- check reverts any teleport over about 150 - so we cannot simply
                            -- pin back to the spot, we have to RUN there. Hold the grab clock
                            -- at zero until we arrive, or the whole window expires in transit
                            -- and the farm wanders off to a nearer egg instead.
                            local backD = math.sqrt(
                                (me.X - (FM.bhX or me.X)) ^ 2 + (me.Z - (FM.bhZ or me.Z)) ^ 2)
                            if backD > (FM.BossHitRunBack or 120) then
                                FM.bhAt = now
                                local spB = FM.Speed
                                if backD < (FM.Brake or 60) then
                                    spB = math.max(40, spB * (backD / (FM.Brake or 60)))
                                end
                                local uxB, uzB = steerAround(me, FM.bhX, FM.bhZ, spB)
                                drive(root, uxB * spB, uzB * spB, -(FM.Stick or 18))
                                FM.State = string.format(
                                    "Egg knocked away - running back (%.0f studs)", backD)
                                FM.BossHitRunBacks = (FM.BossHitRunBacks or 0) + 1
                                task.wait(0.03)
                                return
                            end
                            -- No "have I got it back yet" test here any more. Standing ON a
                            -- dropped egg looks exactly like holding one, so that check was
                            -- calling success before we had even pressed E. One attempt at a
                            -- fixed time is simpler and does not need to tell them apart.
                            -- Freeze first so the ragdoll cannot slide you off the spot, then
                            -- hop around it in widening rings - but only when the egg actually
                            -- came loose. We cannot see where it landed, so sweep rather than
                            -- guess.
                            local held = now - (FM.bhAt or now)
                            local hx, hz = FM.bhX, FM.bhZ
                            -- Residual fling speed from the ragdoll drags the pin straight back
                            -- - the very thing that made the original teleport need a 1.5s wait.
                            -- Do not try to move anywhere until it has died down: judge that by
                            -- both the leftover velocity and whether the last pin actually held.
                            local okv, vel = pcall(function() return root.AssemblyLinearVelocity end)
                            local vmag = 0
                            if okv and vel then
                                vmag = math.sqrt(vel.X ^ 2 + vel.Y ^ 2 + vel.Z ^ 2)
                            end
                            local drift = 0
                            local okp2, pnow = pcall(function() return root.Position end)
                            if okp2 and pnow and FM.bhPinX then
                                drift = math.sqrt((pnow.X - FM.bhPinX) ^ 2
                                    + (pnow.Z - FM.bhPinZ) ^ 2)
                            end
                            local settled = vmag < (FM.BossHitSettleSpeed or 25) and drift < 6
                            if not settled then
                                FM.BossHitSettling = (FM.BossHitSettling or 0) + 1
                            end
                            if not FM.hasEgg and held > freezeFor and settled then
                                -- Look for the egg itself and go straight to it. The old Death
                                -- Drop recovery found dropped eggs with exactly this scan and
                                -- banked 10 of them, so the listing does see them - blind rings
                                -- were only ever meant as the fallback.
                                local tx, tz, bestD
                                FM.bhSeen = FM.bhSeen or {}
                                for _, e in ipairs(droppedEggsNear(
                                        Vector3.new(FM.bhX, FM.bhY, FM.bhZ),
                                        FM.BossHitFind or 60)) do
                                    -- anything drifting is in someone else's hands, or still
                                    -- in ours; only something lying still is a dropped egg
                                    local prev = FM.bhSeen[e.name]
                                    local still = prev and math.sqrt(
                                        (e.pos.X - prev.X) ^ 2 + (e.pos.Z - prev.Z) ^ 2) < 2
                                    FM.bhSeen[e.name] = e.pos
                                    if still and (not bestD or e.d < bestD) then
                                        tx, tz, bestD = e.pos.X, e.pos.Z, e.d
                                    end
                                end
                                if tx then
                                    FM.bhEggX, FM.bhEggZ = tx, tz
                                    FM.BossHitFound = (FM.BossHitFound or 0) + 1
                                end
                                if FM.bhEggX then
                                    -- Locked on: go to the egg and stay there. No ring-hopping
                                    -- fallback any more - a recording showed it circling for
                                    -- the full 7s, which is both the teleporting-in-circles and
                                    -- the standing-still-being-battered. If we cannot see the
                                    -- egg we simply hold the spot where it was lost, which is
                                    -- where it is.
                                    hx, hz = FM.bhEggX, FM.bhEggZ
                                    FM.BossHitHops = (FM.BossHitHops or 0) + 1
                                end
                            end
                            local hSpot = Vector3.new(hx, FM.bhY, hz)
                            -- Only teleport if we are not already there. Rewriting the position
                            -- every step while stood on the egg is the constant teleporting.
                            local okpp, pp = pcall(function() return root.Position end)
                            local offSpot = (not okpp) or (not pp)
                                or math.sqrt((pp.X - hx) ^ 2 + (pp.Z - hz) ^ 2)
                                    > (FM.BossHitOnSpot or 2)
                            if offSpot then
                                -- One write per step loses to the ragdoll. Burst several, the
                                -- way the ragdoll teleport pin does, so it outlasts the bounce.
                                for _ = 1, (FM.BossHitBurst or 4) do
                                    pcall(function()
                                        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                        root.CFrame = CFrame.new(hx, FM.bhY, hz)
                                    end)
                                    task.wait(FM.BossHitGap or 0.01)
                                end
                                FM.bhPinX, FM.bhPinZ = hx, hz
                            else
                                -- On the spot. Hold X and Z but let yourself DROP. Zeroing the
                                -- velocity every step left you hovering at whatever height you
                                -- were hit at, and a prompt does not render while you are in
                                -- the air - so every single tap missed. Ghost sets Stick to 0,
                                -- so the push has to come from LandStick.
                                local okY, curY = pcall(function() return root.Position.Y end)
                                local useY = (okY and curY) or FM.bhY
                                pcall(function()
                                    root.CFrame = CFrame.new(hx, useY, hz)
                                    root.AssemblyLinearVelocity =
                                        Vector3.new(0, -(FM.LandStick or 40), 0)
                                end)
                            end
                            if ST.On then pcall(function() patchNear(hSpot, 25) end) end
                            -- stretch the prompts too, so we do not have to land right on top of it
                            if memory_read and memory_write then
                                for _, pe in ipairs(promptsNear(hSpot, 25)) do
                                    local pa = addrOf(pe.p)
                                    if pa and promptWritable(pa) then
                                        pcall(function()
                                            memory_write("float", pa + ST.OFF_HOLD, 0)
                                            memory_write("float", pa + ST.OFF_DIST, 30)
                                            memory_write("byte", pa + ST.OFF_LOS, 0)
                                        end)
                                    end
                                end
                            end
                            -- Wait out the ragdoll, then ONE grab, then leave either way.
                            if not FM.bhTried and held > (FM.BossHitGrabAfter or 3) then
                                FM.bhTried = true
                                FM.State = "Boss hit - picking the egg back up"
                                if ST.On then pcall(function() patchNear(hSpot, 25) end) end
                                if memory_read and memory_write then
                                    for _, pe in ipairs(promptsNear(hSpot, 25)) do
                                        local pa = addrOf(pe.p)
                                        if pa and promptWritable(pa) then
                                            pcall(function()
                                                memory_write("float", pa + ST.OFF_HOLD, 0)
                                                memory_write("float", pa + ST.OFF_DIST, 30)
                                                memory_write("byte", pa + ST.OFF_LOS, 0)
                                            end)
                                        end
                                    end
                                end
                                -- Instant Steal puts the hold at 0, so holding the key down
                                -- achieves nothing - the problem is timing. A single press
                                -- often lands BEFORE the prompt exists and is simply thrown
                                -- away, which is why the launch-egg grab taps about six times
                                -- a second rather than pressing once. Do the same here.
                                if keypress then
                                    local tapEnd = tick() + (FM.BossHitTapFor or 2)
                                    while tick() < tapEnd do
                                        pcall(function() keypress(0x45) end)
                                        task.wait(0.06)
                                        if keyrelease then pcall(function() keyrelease(0x45) end) end
                                        task.wait(0.1)
                                        FM.BossHitTaps = (FM.BossHitTaps or 0) + 1
                                    end
                                end
                                task.wait(0.15)
                                -- Assume it worked and head home. If it did not, the carry check
                                -- notices within a second and the farm moves on by itself, which
                                -- beats standing here guessing.
                                FM.hasEgg, FM.eggIsTool = true, false
                                FM.grabbedAt, FM.lastPressAt = tick(), tick()
                                FM.carryPos = Vector3.new(FM.bhX, FM.bhY, FM.bhZ)
                                FM.carryKey = FM.carryKey
                                    or string.format("%d_%d", FM.bhX, FM.bhZ)
                                FM.carrySlotGone = true
                                FM.carryW = FM.carryW or 1
                                FM.BossHitRecovered = (FM.BossHitRecovered or 0) + 1
                                FM.bhPhase, FM.bhTapAt, FM.bhBack = nil, nil, nil
                                FM.bhTried, FM.bhSeen = nil, nil
                                FM.bhEggX, FM.bhEggZ = nil, nil
                                FM.bhPinX, FM.bhPinZ = nil, nil
                                FM.State = "Got the egg - heading home"
                                task.wait(0.02)
                                return
                            end
                            FM.State = string.format("Boss hit - holding for the egg (%.1fs)", held)
                            task.wait(0.02)
                            return
                        end
                        if FM.bhPhase then
                            FM.bhPhase, FM.bhTapAt, FM.bhSeen = nil, nil, nil
                            FM.bhPinX, FM.bhPinZ, FM.bhBack = nil, nil, nil
                            FM.bhEggX, FM.bhEggZ = nil, nil
                            FM.BossHitsEnded = (FM.BossHitsEnded or 0) + 1
                        end
                    end
                    do
                        local ds = FM.DeathSpot or Vector3.new(551.523, 70.574, -441.038)
                        -- No distance requirement any more. Demanding the egg be 1200+ studs
                        -- from home meant Friend Drop silently did nothing for whole areas -
                        -- Cosmic and Prehistoric included - which just leaves you doing normal
                        -- farming with the toggle on and no sign of why. Carrying an egg is the
                        -- only condition; the egg-in-hand check on the dive does the rest.
                        -- Set FM.DeathDropMin above 0 to bring a minimum back.
                        local farEnough = FM.hasEgg and true or false
                        if (FM.DeathDropMin or 0) > 0 and homeP and FM.carryPos then
                            farEnough = farEnough and math.sqrt(
                                (FM.carryPos.X - homeP.X) ^ 2
                                + (FM.carryPos.Z - homeP.Z) ^ 2) > FM.DeathDropMin
                        end
                        local curChar = myCharacter()
                        if FM.DeathDrop and FM.hasEgg and not FM.ddPhase then
                            for _, ch3 in ipairs(workspace:GetChildren()) do
                                if ch3.ClassName == "Model" and #tostring(ch3.Name) == 32 then
                                    local okc, qc = pcall(function()
                                        local hb = ch3:FindFirstChild("Hitbox")
                                        return hb and hb.Position
                                    end)
                                    if okc and qc and (qc - me).Magnitude < 8 then
                                        FM.ddEggName = tostring(ch3.Name)
                                        break
                                    end
                                end
                            end
                        end
                        if FM.DeathDrop and not FM.ddPhase and FM.ddLastChar
                           and curChar and curChar ~= FM.ddLastChar then
                            FM.ddPhase, FM.ddDeadAt, FM.ddChar, FM.ddSpawnAt = "dead", now, FM.ddLastChar, nil
                            FM.hasEgg, FM.eggIsTool, FM.depositAt = false, false, nil
                            FM.DeathDropAny = (FM.DeathDropAny or 0) + 1
                        end
                        FM.ddLastChar = curChar
                        if FM.DeathDrop and not FM.ddPhase and farEnough
                           and (now - (FM.fdDoneAt or 0)) > (FM.FriendDropCool or 2)
                           -- and only on an egg we actually picked up recently, never on
                           -- leftover state from a previous run
                           and FM.grabbedAt
                           and (now - FM.grabbedAt) < (FM.FriendDropFresh or 60)
                           -- not while still loading back in from the last death
                           and (not FM.respawnAt
                                or (now - FM.respawnAt) > (FM.RespawnSettle or 3))
                           -- and only once the grab is CONFIRMED: the slot we took the egg
                           -- from has actually vanished (carrySlotGone) and nothing is still
                           -- pending. That is the same proof the farm has always used to count
                           -- a grab, read from AreaEggSlotsClient, which refreshes live.
                           -- The model scan that was here could not reliably see an egg in
                           -- your hands, so the dive never fired and you just ran home. And
                           -- hasEgg on its own is not enough either: after a second missed grab
                           -- the farm bans the egg but leaves hasEgg true, which is how you
                           -- ended up diving at the wall with nothing.
                           and FM.carrySlotGone and FM.pendingSlot == nil then
                            FM.ddPhase, FM.ddAt = "dying", now
                            FM.ddDived, FM.ddPushed = nil, nil
                            FM.ddChar = myCharacter()
                        end
                        if FM.ddPhase then
                            FM.rtBusyUntil = now + 4
                            FM.rtQuietUntil = now + 4
                            local hum = myCharacter() and myCharacter():FindFirstChildOfClass("Humanoid")
                            local hp = -1
                            pcall(function() hp = hum and hum.Health or -1 end)
                            if FM.ddPhase == "dying" then
                                -- Pin from the very first step. The old version stood still
                                -- doing nothing for the whole 1.5s settle, which is exactly
                                -- when the boss flung you - the teleport only started after.
                                -- So: hold a few studs short of the wall while the egg settles
                                -- in your hands, then go in, then push deeper if the wall has
                                -- not done its job.
                                local since = now - (FM.ddAt or now)
                                local settleT = FM.FriendDropDelay or 1.5
                                if since < settleT then
                                    -- Held clear of the wall while the egg settles, pinned hard
                                    -- so a boss cannot fling you out of position.
                                    FM.State = string.format(
                                        "Friend drop - holding at the wall (%.1fs)", settleT - since)
                                    for _ = 1, (FM.FriendDropBurst or 3) do
                                        pcall(function()
                                            root.CFrame = CFrame.new(ds.X, ds.Y,
                                                ds.Z + (FM.FriendDropStandOff or 5))
                                            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                        end)
                                        task.wait(FM.FriendDropGap or 0.01)
                                    end
                                else
                                    -- The wall does kill, it is just slow, and sitting at one
                                    -- depth waiting for it is what let the boss reach you first.
                                    -- So sink further in the longer it takes, while staying
                                    -- pinned - the pin is what stops the fling.
                                    local deep = math.min(
                                        (since - settleT) * (FM.FriendDropSink or 8),
                                        FM.FriendDropMaxSink or 24)
                                    FM.State = string.format(
                                        "Friend drop - into the wall (%.0f studs deep)", deep)
                                    for _ = 1, (FM.FriendDropBurst or 3) do
                                        pcall(function()
                                            root.CFrame = CFrame.new(ds.X, ds.Y, ds.Z - deep)
                                            root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                        end)
                                        task.wait(FM.FriendDropGap or 0.01)
                                    end
                                end
                                -- Let the wall do the killing: that death is what makes the
                                -- egg drop by your plot, where a health-zero death just
                                -- returns it to its nest. Only fall back to the health float
                                -- if the wall has not managed it after 3s, so we are not
                                -- left stuck in the wall forever holding the egg.
                                if hp > 0 and memory_write and hum
                                   and (now - (FM.ddAt or now)) > (FM.FriendDropKillAfter or 3) then
                                    local okad, ad = pcall(function() return hum.Address end)
                                    if okad and ad then
                                        pcall(function()
                                            memory_write("float", ad + 0x190, -10)
                                        end)
                                        FM.FriendDropKills = (FM.FriendDropKills or 0) + 1
                                    end
                                end
                                if hp <= 0 then
                                    FM.ddPhase, FM.ddDeadAt = "dead", now
                                    FM.hasEgg, FM.eggIsTool, FM.depositAt = false, false, nil
                                    FM.carrySlotGone, FM.pendingSlot = false, nil
                                    FM.DeathDrops = (FM.DeathDrops or 0) + 1
                                elseif (now - (FM.ddAt or now)) > 5 then
                                    FM.ddPhase = nil
                                    FM.DeathDropFails = (FM.DeathDropFails or 0) + 1
                                    FM.State = "Death drop failed - taking it home"
                                end
                                task.wait(0.05)
                                return
                            elseif FM.ddPhase == "dead" then
                                local ch = myCharacter()
                                if ch and ch ~= FM.ddChar and hp > 0 then
                                    -- the egg stays where it fell for a friend to take, so
                                    -- there is nothing to wait for and nothing to recover
                                    FM.ddPhase, FM.ddSpawnAt = nil, nil
                                    FM.fdDoneAt = now
                                    FM.FriendDropsMade = (FM.FriendDropsMade or 0) + 1
                                    FM.State = "Friend drop - left for a friend, back to farming"
                                else
                                    FM.State = "Death drop - waiting to respawn"
                                    if (now - (FM.ddDeadAt or now)) > 20 then
                                        FM.ddPhase, FM.ddSpawnAt = nil, nil
                                    end
                                end
                                task.wait(0.1)
                                return
                            elseif FM.ddPhase == "recover" then
                                local egg, eggPos, eggD, eggMine
                                for _, ch2 in ipairs(workspace:GetChildren()) do
                                    if ch2.ClassName == "Model" and #tostring(ch2.Name) == 32 then
                                        local okq, q = pcall(function()
                                            local hb = ch2:FindFirstChild("Hitbox")
                                            return hb and hb.Position
                                        end)
                                        if okq and q and q.Z < -380 and q.Z > -470 then
                                            local d = math.sqrt((q.X - me.X) ^ 2 + (q.Z - me.Z) ^ 2)
                                            local fromHome = homeP
                                                and math.sqrt((q.X - homeP.X) ^ 2 + (q.Z - homeP.Z) ^ 2)
                                                or d
                                            local nm2 = tostring(ch2.Name)
                                            FM.ddSeen = FM.ddSeen or {}
                                            local prev = FM.ddSeen[nm2]
                                            local still = prev
                                                and math.sqrt((q.X - prev.X) ^ 2 + (q.Z - prev.Z) ^ 2) < 2
                                            FM.ddSeen[nm2] = q
                                            local mine = FM.ddEggName and nm2 == FM.ddEggName and still
                                            if not still then
                                                q = nil
                                            end
                                            if q and mine then
                                                egg, eggPos, eggD = ch2, q, d
                                                eggMine = true
                                            elseif q and not eggMine and fromHome <= (FM.DeathDropRange or 400)
                                               and (not eggD or d < eggD) then
                                                egg, eggPos, eggD = ch2, q, d
                                            end
                                        end
                                    end
                                end
                                if egg and not eggMine and FM.ddEggName
                                   and (now - (FM.ddRecoverAt or now)) < 4 then
                                    FM.State = "Death drop - waiting for my egg to land"
                                    task.wait(0.1)
                                    return
                                end
                                if not egg or (now - (FM.ddRecoverAt or now)) > (12 + (eggD or 0) / 120) then
                                    FM.ddPhase = nil
                                    if not egg then FM.DeathDropLost = (FM.DeathDropLost or 0) + 1 end
                                    task.wait(0.05)
                                    return
                                end
                                local side = (me.Z >= eggPos.Z) and 1 or -1
                                local standX = eggPos.X
                                local standZ = eggPos.Z + side * (FM.DeathDropStand or 6)
                                local standD = math.sqrt((standX - me.X) ^ 2 + (standZ - me.Z) ^ 2)
                                local closeEnough = eggD <= (FM.DeathDropGrabAt or 20)
                                if not closeEnough then
                                    local since = now - (FM.ddProgressAt or 0)
                                    if not FM.ddBestD or eggD < (FM.ddBestD - 2) then
                                        FM.ddBestD, FM.ddProgressAt = eggD, now
                                    end
                                    local settling = (now - (FM.ddRecoverAt or now)) < 1
                                    if not settling and FM.ddProgressAt and since > 1.5 then
                                        if eggD <= (FM.DeathDropReach or 25) then
                                            closeEnough = true
                                            FM.DeathDropStuckGrabs = (FM.DeathDropStuckGrabs or 0) + 1
                                        else
                                            FM.ddPhase, FM.ddBestD, FM.ddProgressAt = nil, nil, nil
                                            FM.DeathDropBlocked = (FM.DeathDropBlocked or 0) + 1
                                            FM.State = "Death drop - blocked, back to farming"
                                            task.wait(0.05)
                                            return
                                        end
                                    end
                                end
                                if not closeEnough and standD > 2.5 then
                                    local tx, tz, gating = standX, standZ, false
                                    local gate = FM.DeathDropGate or Vector3.new(558, 70.6, -420)
                                    if me.X < (gate.X - 2) and eggPos.X > (gate.X - 2) then
                                        tx, tz, gating = gate.X, gate.Z, true
                                    end
                                    local dd = math.sqrt((tx - me.X) ^ 2 + (tz - me.Z) ^ 2)
                                    local sp = FM.Speed
                                    if dd < (FM.Brake or 60) then
                                        sp = math.max(40, sp * (dd / (FM.Brake or 60)))
                                    end
                                    local ux, uz = steerAround(me, tx, tz, sp)
                                    drive(root, ux * sp, uz * sp, -(FM.Stick or 18))
                                    FM.State = gating
                                        and string.format("Death drop - going round the wall (%.0f studs)", dd)
                                        or string.format("Death drop - running to the egg (%.0f studs)", standD)
                                    task.wait(0.03)
                                    return
                                end
                                FM.ddBestD, FM.ddProgressAt = nil, nil
                                pcall(function()
                                    root.AssemblyLinearVelocity = Vector3.new(0, -(FM.Stick or 18), 0)
                                end)
                                FM.State = "Death drop - grabbing the dropped egg"
                                if ST.On then pcall(function() patchNear(eggPos, 20) end) end
                                if memory_read and memory_write then
                                    for _, pe in ipairs(promptsNear(eggPos, 20)) do
                                        local pa = addrOf(pe.p)
                                        if pa and promptWritable(pa) then
                                            pcall(function()
                                                memory_write("float", pa + ST.OFF_HOLD, 0)
                                                memory_write("float", pa + ST.OFF_DIST, FM.DeathDropReach or 25)
                                                memory_write("byte", pa + ST.OFF_LOS, 0)
                                            end)
                                        end
                                    end
                                end
                                if keypress then
                                    pcall(function() keypress(0x45) end)
                                    local tG = tick()
                                    while (tick() - tG) < 1.6 do
                                        local okp, par = pcall(function() return egg.Parent end)
                                        if not okp or par == nil then break end
                                        task.wait(0.05)
                                    end
                                    if keyrelease then pcall(function() keyrelease(0x45) end) end
                                end
                                local okp, par = pcall(function() return egg.Parent end)
                                if (not okp or par == nil) or heldEggTool() then
                                    FM.hasEgg, FM.eggIsTool = true, false
                                    FM.grabbedAt, FM.lastPressAt = tick(), tick()
                                    FM.carryPos = eggPos
                                    FM.carryKey = string.format("%d_%d", eggPos.X, eggPos.Z)
                                    FM.carrySlotGone, FM.grabReloads, FM.carryW = true, FM.Reloads, 1
                                    FM.DeathDropSaves = (FM.DeathDropSaves or 0) + 1
                                    FM.ddPhase = nil
                                    FM.State = "Death drop - got it, heading home"
                                end
                                task.wait(0.05)
                                return
                            end
                        end
                    end
                    if FM.hasEgg and FM.FriendDrop then
                        local dp = FM.FriendDropPos or Vector3.new(572, 70.6, -364)
                        local dd = (Vector3.new(dp.X, me.Y, dp.Z) - me).Magnitude
                        if dd > (FM.SpotReach or 4) then
                            local sp = math.min(FM.Speed, FM.CarryCap or 400)
                            if (FM.carryW or 1) > (FM.BigWidth or 6) then
                                sp = math.min(sp, FM.BigCarrySpeed or 260)
                            end
                            if dd < (FM.Brake or 60) then
                                sp = math.max(40, sp * (dd / (FM.Brake or 60)))
                            end
                            local ux, uz = steerAround(me, dp.X, dp.Z, sp)
                            drive(root, ux * sp, uz * sp, -(FM.Stick or 18))
                            FM.State = string.format("Taking egg to the friend drop (%.0f studs)", dd)
                            task.wait(0.03)
                            return
                        end
                        pcall(function()
                            root.AssemblyLinearVelocity = Vector3.new(0, -(FM.Stick or 18), 0)
                        end)
                        FM.State = "Dropping the egg for friends"
                        if keypress then
                            pcall(function() keypress(0x51) end)
                            task.wait(0.06)
                            if keyrelease then pcall(function() keyrelease(0x51) end) end
                        end
                        FM.dropTries = (FM.dropTries or 0) + 1
                        task.wait(0.35)
                        if FM.dropTries >= 3 then
                            FM.FriendDrops = (FM.FriendDrops or 0) + 1
                            FM.dropTries = nil
                            FM.hasEgg, FM.eggIsTool, FM.depositAt = false, false, nil
                            FM.carryKey, FM.carrySlotGone = nil, false
                            FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                            FM.State = "Dropped for friends"
                            task.wait(0.05)
                        end
                        return
                    end
                    if FM.hasEgg and homeP then
                        FM.homeSpot = FM.homeSpot or pickHomeSpot() or homeP
                        local zp = FM.homeSpot
                        local d = (Vector3.new(zp.X, me.Y, zp.Z) - me).Magnitude
                        if d > (FM.SpotReach or 4) and not (FM.depositAt and d <= (FM.ZoneReach or 12)) then
                            FM.depositAt = nil
                            FM.depositToolSeen = nil
                            local flat = Vector3.new(zp.X - me.X, 0, zp.Z - me.Z)
                            local m = flat.Magnitude
                            if m > 0.01 then
                                local sp = math.min(FM.Speed, FM.CarryCap or 400)
                                if (FM.carryW or 1) > (FM.BigWidth or 6) then
                                    sp = math.min(sp, FM.BigCarrySpeed or 260)
                                    FM.BigCarries = FM.BigCarries or 0
                                end
                                if d < (FM.Brake or 60) then
                                    sp = math.max(40, sp * (d / (FM.Brake or 60)))
                                end
                                local ux, uz = steerAround(me, zp.X, zp.Z, sp)
                                drive(root, ux * sp, uz * sp, -(FM.Stick or 18))
                            end
                            FM.State = string.format("Taking egg home (%.0f studs)", d)
                            PROFTICK("farm: carry move", __s3)
                        else
                            pcall(function()
                                root.AssemblyLinearVelocity = Vector3.new(0, -(FM.Stick or 18), 0)
                            end)
                            FM.depositAt = FM.depositAt or tick()
                            local held = tick() - FM.depositAt
                            local toolNow = heldEggTool()
                            if toolNow then FM.depositToolSeen = true end
                            if (FM.eggIsTool or FM.depositToolSeen) and not toolNow then
                                FM.depositToolSeen = nil
                                FM.hasEgg = false
                                FM.depositAt = nil
                                FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                                local pause = FM.PostDeliver or 0
                                if pause > 0 then
                                    FM.State = string.format("Delivered - waiting %.1fs", pause)
                                    local t0d = tick()
                                    while (tick() - t0d) < pause and FM.On do
                                        pcall(function()
                                            root.AssemblyLinearVelocity =
                                                Vector3.new(0, -(FM.Stick or 18), 0)
                                        end)
                                        task.wait(0.05)
                                    end
                                end
                                FM.State = "Delivered"
                                task.wait(0.05)
                                return
                            end
                            if held > ((FM.depositToolSeen and 2.5) or (FM.DeliverSettle or 2.5)) then
                                FM.depositToolSeen = nil
                                FM.hasEgg = false
                                FM.depositAt = nil
                                FM.deliveredTool = heldEggTool()
                                FM.stowPending = true
                                FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                                local pause = FM.PostDeliver or 2.0
                                if pause > 0 then
                                    FM.State = string.format("Delivered - waiting %.1fs", pause)
                                    local t0d = tick()
                                    while (tick() - t0d) < pause and FM.On do
                                        pcall(function()
                                            root.AssemblyLinearVelocity =
                                                Vector3.new(0, -(FM.Stick or 18), 0)
                                        end)
                                        task.wait(0.05)
                                    end
                                end
                                FM.State = "Delivered"
                                task.wait(0.05)
                                return
                            end
                            if held > (FM.DepositWait or 20) then
                                FM.depositToolSeen = nil
                                FM.hasEgg = false
                                FM.depositAt = nil
                                FM.pendingSlot, FM.pendingKey, FM.pendingAt = nil, nil, nil
                                FM.visited = {}
                                FM.State = "Delivery didn't register"
                                task.wait(0.3)
                                return
                            end
                            FM.State = "Delivering..."
                            task.wait(0.1)
                        end
                        task.wait(0.03)
                        return
                    end

                    FM.depositAt = nil

                    local heldEgg = (not FM.NoStow) and heldEggTool() or nil
                    if not heldEgg then FM.stowGaveUp, FM.stowTries = nil, nil end
                    if heldEgg and not FM.stowGaveUp then
                        if keypress then
                            pcall(function() keypress(0x31) end)
                            task.wait(0.05)
                            if keyrelease then pcall(function() keyrelease(0x31) end) end
                        end
                        task.wait(0.15)
                        if heldEggTool() then
                            FM.stowTries = (FM.stowTries or 0) + 1
                            if FM.stowTries >= 3 then
                                FM.StowFail = (FM.StowFail or 0) + 1
                                FM.stowGaveUp = true
                            end
                        else
                            FM.Stowed = (FM.Stowed or 0) + 1
                            FM.stowTries = nil
                        end
                    end
                    FM.stowPending = nil

                    if FM.fromTreadmill and not FM.hasEgg then
                        local h = homePos()
                        local dh = h and (Vector3.new(h.X, me.Y, h.Z) - me).Magnitude or 0
                        if h and dh > (FM.ZoneReach or 12) then
                            local sp = FM.Speed
                            if dh < (FM.Brake or 60) then
                                sp = math.max(25, FM.Speed * (dh / (FM.Brake or 60)))
                            end
                            local ux, uz = steerAround(me, h.X, h.Z, sp)
                            drive(root, ux * sp, uz * sp, -(FM.Stick or 18))
                            FM.State = "Leaving the treadmill - heading to the safe zone"
                            task.wait(0.03)
                            return
                        end
                        FM.fromTreadmill = nil
                    end
                    local best, bestScore
                    local anyAllowed = 0
                    local cands, sawRandom = {}, false
                    local tlist = farmTargets()
                    local areaBonus = {}
                    if FM.RarePri then
                        local home = homePos()
                        if home then
                            local dist, names = {}, {}
                            for _, t in ipairs(tlist) do
                                local a = tostring(t.area)
                                if dist[a] == nil then
                                    dist[a] = math.sqrt((t.pos.X - home.X) ^ 2 + (t.pos.Z - home.Z) ^ 2)
                                    names[#names + 1] = a
                                end
                            end
                            table.sort(names, function(p, q) return dist[p] > dist[q] end)
                            for i, a in ipairs(names) do areaBonus[a] = (#names - i) * 800 end
                        end
                    end
                    for _, t in ipairs(tlist) do
                        local allowed = (FM.Areas[t.area] == true)
                        local key = string.format("%d_%d", t.pos.X, t.pos.Z)
                        local always = false
                        if (FM.AlwaysN or 0) > 0 then
                            local ht = (FM.rareTier or {})[key]
                            local en2 = FM.eggName[key]
                            local tier = en2 and alwaysTier(en2, t.area) or nil
                            if ht then
                                always = FM.Always[ht] == true
                            elseif tier == "secret" or tier == "eternal" or tier == "divine" then
                                always = FM.Always[tier] == true
                            elseif looksRare(t) then
                                local row = RARE_BY_AREA[t.area]
                                if row then
                                    local anyWanted, allWanted = false, true
                                    for tierName in pairs(row) do
                                        if FM.Always[tierName] then anyWanted = true else allWanted = false end
                                    end
                                    always = anyWanted and allWanted
                                else
                                    always = (FM.AlwaysN or 0) >= 3
                                end
                            end
                            if always then allowed = true end
                        end
                        local cool = (now - (FM.visited[key] or 0)) > FM.Cooldown
                        if (FM.banned[key] or 0) > now then allowed = false end
                        if FM.retryKey == key and FM.retryUntil and now < FM.retryUntil then
                            allowed, cool = true, true
                        end
                        if allowed then anyAllowed = anyAllowed + 1 end

                        if allowed and cool then
                            local d = (Vector3.new(t.pos.X, me.Y, t.pos.Z) - me).Magnitude
                            local en = (FM.rareName or {})[key] or FM.eggName[key]
                            local pri = 0
                            local wanted = false
                            if always then pri = pri + 20000000 end
                            if FM.retryKey == key and FM.retryUntil and now < FM.retryUntil then
                                pri = pri + 25000000
                            end
                            local riftFresh = (tick() - (FM.RiftPanelAt or FM.RiftReadAt or 0)) < 30
                            if FM.Rift and FM.RiftPrio and riftFresh then
                                for _, want in ipairs(FM.RiftTargets or {}) do
                                    if not (FM.RiftHave or {})[want.name] then
                                        if en and want.egg == en then
                                            wanted = true
                                        elseif want.known == false and want.area == t.area then
                                            wanted = true
                                        end
                                        if wanted then
                                            pri = pri + 10000000
                                            break
                                        end
                                    end
                                end
                            end
                            if FM.RarePri then
                                local W = FM.RareWeight or 400
                                local rank = rarityRank(en, t.area)
                                local ct = (FM.rareTier or {})[key]
                                local cr = ct and RARITY_RANK[ct] or 0
                                if cr > rank then rank = cr end
                                if rank > 0 then
                                    pri = pri + rank * W
                                elseif looksRare(t) then
                                    pri = pri + 5 * W
                                end
                            end
                            if FM.SizePri then
                                local sizeRank = math.floor(t.w or 0)
                                if sizeRank > 0 then
                                    pri = pri + sizeRank * (FM.SizeWeight or 5000)
                                end
                            end
                            if (FM.eggBlocked or {})[key] then pri = pri - 4000 end
                            if not FM.RarePri and not FM.SizePri and not FM.DistPri then
                                cands[#cands + 1] = { key = key, area = t.area }
                                if key == FM.randomKey then
                                    sawRandom = true
                                    pri = pri + 5000000
                                end
                            end
                            if FM.RarePri then
                                pri = pri + (areaBonus[tostring(t.area)] or 0)
                            end
                            if key == FM.lockKey then pri = pri + (FM.LockWeight or 5000) end
                            -- Lower score wins and d is your distance to the egg, so a
                            -- plain d already means nearest-first. Flip it for Furthest.
                            local score = (FM.DistPri == "far") and (-d - pri) or (d - pri)
                            if not bestScore or score < bestScore then
                                best, bestScore = t, score
                                best.key = key
                                best.name = en
                                best.rank = FM.RarePri and rarityRank(en, t.area) or 0
                                best.w    = t.w
                                best.always = always
                            end
                        end
                    end
                    if not FM.RarePri and not FM.SizePri and not FM.DistPri
                       and not sawRandom then
                        if #cands > 0 then
                            local byArea, areas = {}, {}
                            for _, cd in ipairs(cands) do
                                local a = tostring(cd.area)
                                if not byArea[a] then byArea[a] = {} areas[#areas + 1] = a end
                                local g = byArea[a]
                                g[#g + 1] = cd.key
                            end
                            local pickArea = areas[math.random(1, #areas)]
                            local pool = byArea[pickArea]
                            FM.randomKey  = pool[math.random(1, #pool)]
                            FM.randomArea = pickArea
                            FM.Rerolls = (FM.Rerolls or 0) + 1
                        else
                            FM.randomKey, FM.randomArea = nil, nil
                        end
                    end
                    FM.lockKey = best and best.key or nil
                    if not best and anyAllowed == 0 then
                        FM.idleSince = FM.idleSince or now
                        -- An Anti-Boss escape drops you at the safe zone and the egg list
                        -- reads empty for a moment while things resettle. At the 0.3s gate I
                        -- had set, that blip was enough to decide every egg was gone and send
                        -- you off to train. Wait longer, and never decide it right after an
                        -- escape.
                        local sinceEsc = now - (AB.lastEscape or 0)
                        local tread = FM.TreadmillFarm
                            and (now - FM.idleSince) >= (FM.TreadmillIdle or 2)
                            and sinceEsc > (FM.TreadmillAfterEscape or 5)
                            and myTreadmill() or nil
                        if tread then
                            FM.idleSpot = nil
                            FM.treadVisit = true
                            local dt = (Vector3.new(tread.X, me.Y, tread.Z) - me).Magnitude
                            local goal = tread
                            if TREAD_SPAWN and not FM.treadViaSpawn and dt > 40 then
                                if (Vector3.new(TREAD_SPAWN.X, me.Y, TREAD_SPAWN.Z) - me).Magnitude > 6 then
                                    goal = TREAD_SPAWN
                                else
                                    FM.treadViaSpawn = true
                                end
                            end
                            if dt > 4 then
                                -- One hop straight onto it. A jump holds up to about 150
                                -- studs, and crawling the last 30 at 35 studs/s was most of
                                -- the wait.
                                if dt <= 120 then
                                    pcall(function()
                                        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                        root.CFrame = CFrame.new(tread.X, me.Y, tread.Z)
                                    end)
                                    FM.TreadmillHops = (FM.TreadmillHops or 0) + 1
                                else
                                    local flat = Vector3.new(goal.X - me.X, 0, goal.Z - me.Z)
                                    local m = flat.Magnitude
                                    if m > 0.01 then
                                        local sp = FM.Speed
                                        if goal == tread and dt < (FM.Brake or 60) then
                                            sp = math.max(20, FM.Speed * (dt / (FM.Brake or 60)))
                                        end
                                        local ux, uz = steerAround(me, goal.X, goal.Z, sp)
                                        drive(root, ux * sp, uz * sp, -(FM.Stick or 18))
                                    end
                                end
                                FM.State = "Going to the treadmill"
                                task.wait(0.03)
                            else
                                if not FM.onTreadmill then
                                    pcall(function()
                                        root.AssemblyLinearVelocity = Vector3.new(0, -(FM.Stick or 18), 0)
                                    end)
                                end
                                FM.onTreadmill = true
                                FM.State = "Training on the treadmill"
                                -- short nap so a fresh egg is picked up quickly
                                task.wait(0.15)
                            end
                            return
                        end
                        local home = homePos()
                        if home then
                            FM.idleSpot = FM.idleSpot or pickHomeSpot() or home
                            home = FM.idleSpot
                        end
                        local dh = home and (Vector3.new(home.X, me.Y, home.Z) - me).Magnitude or 0
                        if home and dh > (FM.SpotReach or 4) then
                            local flat = Vector3.new(home.X - me.X, 0, home.Z - me.Z)
                            local m = flat.Magnitude
                            if m > 0.01 then
                                local sp = FM.Speed
                                if dh < (FM.Brake or 60) then
                                    sp = FM.Speed * (dh / (FM.Brake or 60))
                                    if sp < 25 then sp = 25 end
                                end
                                local ux, uz = steerAround(me, home.X, home.Z, sp)
                                drive(root, ux * sp, uz * sp, -(FM.Stick or 18))
                            end
                            FM.State = "No eggs left - going home"
                            task.wait(0.03)
                        else
                            pcall(function()
                                root.AssemblyLinearVelocity = Vector3.new(0, -(FM.Stick or 18), 0)
                            end)
                            FM.State = "Waiting for eggs to respawn"
                            task.wait(0.5)
                        end
                        return
                    end
                    FM.idleSince = nil
                    FM.treadViaSpawn = nil
                    if FM.treadVisit then
                        local tread = myTreadmill()
                        if tread and (Vector3.new(tread.X, me.Y, tread.Z) - me).Magnitude < 14 then
                            FM.fromTreadmill = true
                            local tx = best and best.pos.X or (tread.X + 20)
                            local tz = best and best.pos.Z or tread.Z
                            local dx, dz = tx - tread.X, tz - tread.Z
                            local dm = math.sqrt(dx * dx + dz * dz)
                            if dm < 0.01 then dx, dz, dm = 1, 0, 1 end
                            dx, dz = dx / dm, dz / dm
                            FM.State = "Leaving the treadmill"
                            local freed = false
                            local okS, pS = pcall(function() return root.Position end)
                            local lastP = (okS and pS) or nil
                            local startD = lastP and math.sqrt(
                                (lastP.X - tread.X) ^ 2 + (lastP.Z - tread.Z) ^ 2) or 0
                            for _ = 1, (FM.TreadmillJumps or 6) do
                                if keypress then pcall(function() keypress(0x20) end) end
                                task.wait(0.08)
                                if keyrelease then pcall(function() keyrelease(0x20) end) end
                                -- Hopping off gives you a small teleport away from the treadmill.
                                -- Watch for THAT, instead of shoving yourself sideways and
                                -- waiting to drift clear. Catching it means one jump rather than
                                -- ten, and none of the repositioning in between - which is the
                                -- jumping about you were seeing.
                                local tW = tick()
                                while (tick() - tW) < (FM.TreadmillWatch or 0.8) do
                                    task.wait(0.05)
                                    local okp1, p1 = pcall(function() return root.Position end)
                                    if okp1 and p1 then
                                        local step = lastP and math.sqrt(
                                            (p1.X - lastP.X) ^ 2 + (p1.Z - lastP.Z) ^ 2) or 0
                                        local away = math.sqrt(
                                            (p1.X - tread.X) ^ 2 + (p1.Z - tread.Z) ^ 2)
                                        lastP = p1
                                        if step > (FM.TreadmillHopJump or 3)
                                           or away > startD + 6 then
                                            freed = true
                                            break
                                        end
                                    end
                                end
                                if freed then break end
                                FM.TreadmillJumpTries = (FM.TreadmillJumpTries or 0) + 1
                            end
                            -- Coming off a treadmill half sunk into the ground is common. Lift
                            -- clear before anything starts driving, or you slide along hugging
                            -- a wall while the script believes it is running normally.
                            local okp2, p2 = pcall(function() return root.Position end)
                            if okp2 and p2 and p2.Y < (tread.Y + 1) then
                                pcall(function()
                                    root.CFrame = CFrame.new(p2.X, tread.Y + 4, p2.Z)
                                    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                end)
                                FM.TreadmillUnstick = (FM.TreadmillUnstick or 0) + 1
                            end
                            if not freed then
                                FM.State = "Stuck on the treadmill - click into Roblox"
                                task.wait(0.3)
                                return
                            end
                        end
                        FM.treadVisit, FM.onTreadmill = nil, nil
                        return
                    end
                    FM.idleSpot = nil
                    if best and FM.RagdollTp and not FM.hasEgg and FM.pendingSlot == nil
                       and ragdollTeleport(root, me, best) then
                        return
                    end
                    if not best then
                        FM.State = "Nothing to farm"
                        task.wait(0.5)
                    else
                        local aim = best.pos
                        local tries = (FM.grabRetry or {})[best.key or ""] or 0
                        if tries > 0 then
                            local ang = tries * 2.39
                            aim = best.pos + Vector3.new(math.cos(ang) * 1.2, 0, math.sin(ang) * 1.2)
                        end
                        local d = (Vector3.new(aim.X, me.Y, aim.Z) - me).Magnitude
                        if d > FM.Reach then
                            local ax, az = aim.X, aim.Z
                            if FM.SnapOn and d <= (FM.Snap or 12) then
                                local sx, sz = aim.X - me.X, aim.Z - me.Z
                                local sm = math.sqrt(sx*sx + sz*sz)
                                if sm > 0.01 then
                                    local back = math.min(0.9, sm)
                                    local tx = aim.X - (sx/sm) * back
                                    local tz = aim.Z - (sz/sm) * back
                                    pcall(function()
                                        root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                                        root.CFrame = CFrame.new(tx, me.Y, tz,
                                                                 aim.X, me.Y, aim.Z)
                                    end)
                                    FM.Snaps = (FM.Snaps or 0) + 1
                                    FM.State = string.format("Grabbing in %s", best.area)
                                end
                                task.wait(0.03)
                                return
                            end
                            local flat = Vector3.new(ax - me.X, 0, az - me.Z)
                            local m = flat.Magnitude
                            if m > 0.01 then
                                local sp = FM.Speed
                                local brakeAt = FM.Brake or 30
                                if d < brakeAt then
                                    sp = FM.Speed * (d / brakeAt)
                                    if sp < 14 then sp = 14 end
                                end
                                local ux, uz = flat.X / m, flat.Z / m
                                if d > 12 then ux, uz = steerAround(me, ax, az, sp) end
                                drive(root, ux * sp, uz * sp, -(FM.Stick or 18))
                            end
                            local what = ""
                            if best.name then what = " for " .. best.name end
                            FM.State = string.format("Going to %s%s", best.area, what)
                        else
                            -- Get both feet down before pressing anything. Ghost sets Stick to
                            -- 0, so this used to apply no downward force whatsoever and you
                            -- could still be in the air from the snap - where the prompt does
                            -- not show and the grab quietly fails. Breaks out as soon as your
                            -- height stops changing, so it costs nothing when already landed.
                            do
                                local tG, lastY = tick(), nil
                                while (tick() - tG) < (FM.GroundWait or 0.5) do
                                    pcall(function()
                                        root.AssemblyLinearVelocity =
                                            Vector3.new(0, -(FM.LandStick or 40), 0)
                                    end)
                                    task.wait(0.05)
                                    local okY, py = pcall(function() return root.Position.Y end)
                                    if okY and py then
                                        if lastY and math.abs(py - lastY) < 0.05 then break end
                                        lastY = py
                                    end
                                end
                            end
                            local nearPrompts = promptsNear(best.pos, 30)
                            if ST.On then _G.SEHUB_PATCHNEAR(best.pos, 30, nearPrompts) end
                            local hd = _G.SEHUB_HOLDTIME(best.pos, 20, nearPrompts)
                            local slot = best.model or slotAt(best.pos)
                            if ST.On and hd ~= nil and hd >= 0 and hd < 0.05 then
                                if ST.On and FM.Suppress then
                                    FM.SuppressedNow = _G.SEHUB_SUPPRESS(best.pos, 14, nil, nearPrompts)
                                end
                                pressE(0.04)
                            else
                                local hold
                                if hd and hd > 0 then
                                    hold = hd + 0.3
                                else
                                    hold = 2.0
                                end
                                local cfg = FM.GrabHold or 1.3
                                if cfg > hold then hold = cfg end
                                if ST.On then FM.Fallbacks = (FM.Fallbacks or 0) + 1 end
                                FM.State = string.format("Grabbing in %s", best.area)
                                if ST.On and FM.Suppress then
                                    FM.SuppressedNow = _G.SEHUB_SUPPRESS(best.pos, 14)
                                end
                                if keypress then pcall(function() keypress(0x45) end) end
                                local t0h = tick()
                                while (tick() - t0h) < hold do
                                    pcall(function()
                                        root.AssemblyLinearVelocity =
                                            Vector3.new(0, -(FM.Stick or 18), 0)
                                    end)
                                    if slotGone(slot) then break end
                                    task.wait(0.03)
                                end
                                if keyrelease then pcall(function() keyrelease(0x45) end) end
                            end
                            FM.visited[best.key] = now
                            FM.Taken = FM.Taken + 1

                            FM.pendingSlot = slot
                            FM.pendingSlotName = nil
                            pcall(function() FM.pendingSlotName = slot and slot.Name or nil end)
                            FM.pendingKey  = best.key
                            FM.pendingNear = {}
                            for _, sl in ipairs(eggSlots()) do
                                local ndx, ndz = sl.pos.X - best.pos.X, sl.pos.Z - best.pos.Z
                                local nd2 = ndx * ndx + ndz * ndz
                                if nd2 > 1 and nd2 < 400 then
                                    FM.pendingNear[#FM.pendingNear + 1] = { pos = sl.pos, w = sl.w }
                                end
                            end
                            FM.pendingPromptNear = {}
                            local slotList = eggSlots()
                            for _, sp in ipairs(eggPromptSpots(best.pos, 20)) do
                                local dT = math.sqrt((sp.X - best.pos.X) ^ 2 + (sp.Z - best.pos.Z) ^ 2)
                                local bySlot = false
                                for _, sl in ipairs(slotList) do
                                    if math.sqrt((sl.pos.X - sp.X) ^ 2 + (sl.pos.Z - sp.Z) ^ 2) < 4 then
                                        bySlot = true
                                        break
                                    end
                                end
                                if dT > 4 and not bySlot then
                                    FM.pendingPromptNear[#FM.pendingPromptNear + 1] = sp
                                end
                            end
                            FM.carryNear = FM.pendingNear
                            FM.carryKey    = best.key
                            FM.carryPos    = best.pos
                            FM.carrySlotGone = false
                            FM.grabReloads = FM.Reloads
                            FM.retryPos    = nil
                            FM.retryKey, FM.retryUntil = nil, nil
                            FM.pendingAt   = tick()
                            FM.lastPressAt = tick()
                            FM.pendingHadEgg = (heldEggTool() ~= nil)
                            FM.eggIsTool = false
                            FM.hasEgg = true
                            FM.grabbedAt = tick()
                            FM.grabArea = best.area
                            FM.carryW = best.w or 1
                            FM.State = "Got an egg - heading home"
                            task.wait(FM.AfterGrab or 0.1)
                            return
                        end
                    end
                end
            end
        end
    end
end

