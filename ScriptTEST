_G.SEHUB_GEN = (_G.SEHUB_GEN or 0) + 1
local GEN = _G.SEHUB_GEN
if GEN > 1 then
    print(string.format("[Steal An Egg] reload #%d - retiring previous instance", GEN))
    if _G.FARM then _G.FARM.On = false end
    if _G.ABOSS then _G.ABOSS.pinLive, _G.ABOSS.pinning = 0, false end
    task.wait(0.3)
    if _G.SEHUB_RESTORE then pcall(_G.SEHUB_RESTORE) end
    if _G.SEHUB_WIN then
        for _, m in ipairs({ "Destroy", "Unload", "Close", "Remove" }) do
            pcall(function() _G.SEHUB_WIN[m](_G.SEHUB_WIN) end)
        end
        _G.SEHUB_WIN = nil
    end
    if setrobloxinput then pcall(function() setrobloxinput(true) end) end
    task.wait(0.2)
end

-- Refuse to load into a broken DataModel. Matcha can end up in a state where every
-- game:GetService() returns nil while the game itself runs fine (game:GetChildren() == 0,
-- game reads as "DataModel (Ugc)"). Loading into that gives you a build that cannot find
-- you and cannot hook frames, so teleports and pins silently stop holding with no error to
-- point at - and at least one outright hang. The binding also just flaps for a second or
-- two at times, so retry for 3s before giving up.
do
    local P, RS
    for _ = 1, 60 do
        local okP, p = pcall(function() return game:GetService("Players") end)
        local okR, r = pcall(function() return game:GetService("RunService") end)
        if okP and p and okR and r then P, RS = p, r break end
        task.wait(0.05)
    end
    if not P or not RS then
        warn("[Steal An Egg] Roblox services are not reachable right now "
            .. "(game:GetService returns nil), so nothing was loaded. Restart Matcha; if it "
            .. "still fails, close Roblox completely and relaunch it.")
        -- give the generation back so the next attempt is a clean first load, not a reload
        _G.SEHUB_GEN = GEN - 1
        return
    end
end

_G.SEHUB_SKIP = _G.SEHUB_SKIP or {}
_G.SEHUB_LOOPS = {}
_G.SEHUB_SLOW = _G.SEHUB_SLOW or {}

local PWAIT_ACC = 0
local function PWAIT(t)
    local a = tick()
    local r = task.wait(t)
    PWAIT_ACC = PWAIT_ACC + (tick() - a)
    return r
end
local function PROFRESET() PWAIT_ACC = 0 end
local PROF_TASK = { wait = PWAIT, spawn = task.spawn, delay = task.delay, defer = task.defer }

local function PROFTICK(name, t0, sub)
    local ms = (tick() - t0) * 1000
    if sub then ms = ms - PWAIT_ACC * 1000 end
    if ms < 0 then ms = 0 end
    local e = _G.SEHUB_SLOW[name]
    if not e then
        e = { n = 0, total = 0, max = 0, over50 = 0, over150 = 0, maxState = "?" }
        _G.SEHUB_SLOW[name] = e
    end
    e.n, e.total = e.n + 1, e.total + ms
    if ms > e.max then
        e.max = ms
        e.maxState = tostring((_G.FARM or {}).State)
    end
    if ms > 50 then e.over50 = e.over50 + 1 end
    if ms > 150 then e.over150 = e.over150 + 1 end
end

local function SESPAWN(name, fn)
    if _G.SEHUB_SKIP[name] then
        print("[Steal An Egg] skipping loop: " .. name)
        return
    end
    local restarts = 0
    _G.SEHUB_LOOPERR = _G.SEHUB_LOOPERR or {}
    task.spawn(function()
        while _G.SEHUB_GEN == GEN do
            local startedAt = tick()
            local ok, err = pcall(fn)
            if ok then return end
            if _G.SEHUB_GEN ~= GEN then return end
            local ranFor = tick() - startedAt
            if ranFor > 60 then restarts = 0 end
            restarts = restarts + 1
            _G.SEHUB_LOOPS[name] = (_G.SEHUB_LOOPS[name] or 0) + 1
            _G.SEHUB_LOOPERR[name] = string.format("%s  (after %.0fs, restart %d)",
                tostring(err), ranFor, restarts)
            if restarts > 5 then
                warn(string.format("[Steal An Egg] '%s' died %d times in a row, leaving it stopped: %s",
                    name, restarts, tostring(err)))
                return
            end
            warn(string.format("[Steal An Egg] '%s' errored after %.0fs (restart %d): %s",
                name, ranFor, restarts, tostring(err)))
            task.wait(0.5)
        end
    end)
end

