local LIB_CACHE = "insui_cache.lua"
local LIB_URLS = {
    "https://raw.githubusercontent.com/neaxusxgod-png/INS-ui/main/uilib.min.lua",
    "https://cdn.jsdelivr.net/gh/neaxusxgod-png/INS-ui@main/uilib.min.lua",
}
local Lib
do
    local function usableSrc(s)
        return type(s) == "string" and #s > 5000 and not string.find(s, "^%s*%d%d%d:")
    end
    local function usableLib(t) return type(t) == "table" and type(t.CreateWindow) == "function" end
    local function try(src)
        if not usableSrc(src) then return nil end
        local chunk = loadstring(src)
        if not chunk then return nil end
        local okr, ret = pcall(chunk)
        if okr and usableLib(ret) then return ret end
        for _, name in ipairs({ "INSUI", "INSui", "insui" }) do
            local g = _G[name] or rawget(getfenv(), name)
            if usableLib(g) then return g end
        end
        return nil
    end
    local okc, cached = pcall(function() return readfile(LIB_CACHE) end)
    if okc then Lib = try(cached) end
    if not Lib then
        for _, u in ipairs(LIB_URLS) do
            local okh, body = pcall(function() return game:HttpGet(u) end)
            if okh then
                local got = try(body)
                if got then
                    Lib = got
                    pcall(function() writefile(LIB_CACHE, body) end)
                    break
                end
            end
        end
    end
    if not Lib then
        warn("[Steal An Egg] no working UI library from cache or any mirror - menu cannot load")
        return
    end
end

local function svcPlayers()
    local ok, p = pcall(function() return game:GetService("Players") end)
    return ok and p or nil
end
local function localPlayer()
    local P = svcPlayers()
    if not P then return nil end
    local ok, lp = pcall(function() return P.LocalPlayer end)
    return ok and lp or nil
end
local function myCharacter()
    local lp = localPlayer()
    if lp then
        local ok, ch = pcall(function() return lp.Character end)
        if ok and ch then return ch end
    end
    -- Matcha's Players binding goes stale and returns nil, and while the body is stripped
    -- CameraSubject is the Humanoid sitting IN the Camera - so the fallback below used to
    -- hand back the Camera itself as "your character". Stripping that orphans your root and
    -- leaves you unable to move. Prefer the character we stripped, and never accept the
    -- Camera or anything that is not a Model.
    local FMg = _G.FARM
    if FMg and FMg.GhostSaved and FMg.GhostChar then return FMg.GhostChar end
    local okc, cam = pcall(function() return workspace.CurrentCamera end)
    if okc and cam then
        local oks, subj = pcall(function() return cam.CameraSubject end)
        if oks and subj then
            local okp, par = pcall(function() return subj.Parent end)
            if okp and par and par ~= cam then
                local okcl, cl = pcall(function() return par.ClassName end)
                if okcl and cl == "Model" then return par end
            end
        end
    end
    return nil
end
_G.SEHUB_CHAR = myCharacter

local function myRoot()
    local gr = _G.SEHUB_GROOT
    if gr and _G.FARM and _G.FARM.GhostSaved then
        local okg, par = pcall(function() return gr.Parent end)
        if okg and par then return gr end
        _G.SEHUB_GROOT = nil
    end
    local ch = myCharacter()
    if not ch then return nil end
    local okr, r = pcall(function()
        return ch:FindFirstChild("HumanoidRootPart") or ch:FindFirstChild("Torso")
    end)
    return okr and r or nil
end
local function heldEggTool()
    local ch = myCharacter()
    if not ch then return nil end
    local okk, kids = pcall(function() return ch:GetChildren() end)
    if not okk or not kids then return nil end
    for _, c in ipairs(kids) do
        local okcl, cl = pcall(function() return c.ClassName end)
        if okcl and cl == "Tool" then
            local okn, n = pcall(function() return c.Name end)
            if okn and type(n) == "string" and string.find(string.lower(n), "egg", 1, true) then
                return c, n
            end
        end
    end
    return nil
end
_G.SEHUB_HELDEGG = heldEggTool

local function stowHeldEgg()
    local tool = heldEggTool()
    if not tool then return true end
    local okp, par = pcall(function() return tool.Parent end)
    if not okp or par == nil then return true end
    local lp = localPlayer()
    local bp = lp and lp:FindFirstChild("Backpack")
    if not bp then return false end
    pcall(function() tool.Parent = bp end)
    return heldEggTool() == nil
end
