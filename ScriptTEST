local function sweepEggNames()
    local prev = _G.FARM.eggName or {}
    local tried = _G.FARM.eggTried or {}
    local triedAt = _G.FARM.eggTriedAt or {}
    local TRY_WINDOW, TRY_SPACING = 25, 2.0
    local names, seen, ident, fresh = {}, {}, 0, 0
    for _, e in ipairs(eggSlots()) do
        local p = e.pos
        local key = string.format("%d_%d", p.X, p.Z)
        seen[key] = true
        local firstSeen = tried[key]
        if type(firstSeen) ~= "number" then firstSeen = nil end
        local lastTry = triedAt[key]
        if type(lastTry) ~= "number" then lastTry = 0 end

        local nm = prev[key]
        local nowT = tick()
        local withinWindow = (firstSeen == nil) or ((nowT - firstSeen) < TRY_WINDOW)
        local spacedOut = (nowT - lastTry) >= TRY_SPACING
        if nm == nil and withinWindow and spacedOut then
            local okp, par = pcall(function() return e.model.Parent end)
            if okp and par ~= nil then
                fresh = fresh + 1
                tried[key] = firstSeen or nowT
                triedAt[key] = nowT
                nm = eggNameFor(e.model, areaOf(p))
            end
        end
        if nm then
            names[key] = nm
            ident = ident + 1
        end
    end
    for key in pairs(tried) do
        if not seen[key] then tried[key] = nil; triedAt[key] = nil end
    end
    if (tick() - (_G.FARM.blockedAt or 0)) > 2.0 then
        _G.FARM.blockedAt = tick()
        local slots = eggSlots()
        local blocked, nblocked = {}, 0
        for i = 1, #slots do
            local a = slots[i]
            local aw = a.w or 1
            local ax, az = a.pos.X, a.pos.Z
            for j = 1, #slots do
                if i ~= j then
                    local b = slots[j]
                    local bw = b.w or 1
                    if bw > aw * 2 then
                        local reach = bw * 0.5 + 1.5
                        local dx, dz = ax - b.pos.X, az - b.pos.Z
                        if (dx * dx + dz * dz) < (reach * reach) then
                            blocked[string.format("%d_%d", a.pos.X, a.pos.Z)] = true
                            nblocked = nblocked + 1
                            break
                        end
                    end
                end
            end
        end
        _G.FARM.eggBlocked, _G.FARM.BlockedNow = blocked, nblocked
    end

    _G.FARM.eggName, _G.FARM.eggTried, _G.FARM.eggTriedAt = names, tried, triedAt
    _G.FARM.EggIdent, _G.FARM.EggFresh = ident, fresh
    return ident
end
