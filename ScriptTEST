local function viewportSize()
    local ok, cam = pcall(function() return workspace.CurrentCamera end)
    if ok and cam then
        local okv, v = pcall(function() return cam.ViewportSize end)
        if okv and v and v.X and v.X > 100 then return v end
    end
    local okp, pg = pcall(function()
        return game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
    end)
    if okp and pg then
        local best
        local okd, desc = pcall(function() return pg:GetDescendants() end)
        if okd and desc then
            for _, d in ipairs(desc) do
                local oks, s = pcall(function() return d.AbsoluteSize end)
                if oks and s and s.X and s.X > 100 then
                    if not best or (s.X * s.Y) > (best.X * best.Y) then best = s end
                end
            end
        end
        if best then return best end
    end
    return Vector2.new(1920, 1080)
end

local function rgb(r, g, b)
    local ok, c = pcall(function() return Color3.fromRGB(r, g, b) end)
    if ok and c then return c end
    local ok2, c2 = pcall(function() return Color3.new(r / 255, g / 255, b / 255) end)
    if ok2 and c2 then return c2 end
    return nil
end
local function setp(obj, key, value)
    if value == nil then return end
    pcall(function() obj[key] = value end)
end

local function measure(txt, size)
    if not TOAST.ruler then
        TOAST.ruler = newDrawing("Text")
        if TOAST.ruler then setp(TOAST.ruler, "Visible", false) end
    end
    local r = TOAST.ruler
    if not r then return #tostring(txt) * size * 0.55 end
    setp(r, "Font", 2); setp(r, "Size", size); setp(r, "Text", tostring(txt))
    local ok, b = pcall(function() return r.TextBounds end)
    if ok and b and b.X and b.X > 0 then return b.X end
    return #tostring(txt) * size * 0.55
end

local function wrapText(txt, size, maxW)
    local lines, cur = {}, ""
    for word in string.gmatch(tostring(txt), "%S+") do
        local try = (cur == "") and word or (cur .. " " .. word)
        if cur ~= "" and measure(try, size) > maxW then
            lines[#lines + 1] = cur
            cur = word
        else
            cur = try
        end
    end
    if cur ~= "" then lines[#lines + 1] = cur end
    if #lines == 0 then lines[1] = "" end
    return lines
end

local function toastPush(title, msg, dur, kind)
    if not Drawing then return false end
    local accent = TOAST_KIND[kind or "info"] or TOAST_KIND.info

    local innerMax = TOAST.maxW - TOAST.pad * 2 - TOAST.bar
    local titleW = measure(title, TOAST.titleSize)
    local body = wrapText(msg, TOAST.bodySize, innerMax)
    local widest = titleW
    for _, l in ipairs(body) do
        local w = measure(l, TOAST.bodySize)
        if w > widest then widest = w end
    end
    local cardW = math.max(TOAST.minW, math.min(TOAST.maxW, widest + TOAST.pad * 2 + TOAST.bar + 6))
    local lineH = TOAST.bodySize + TOAST.lineGap
    local cardH = TOAST.pad * 2 + TOAST.titleSize + 5 + (#body * lineH) - TOAST.lineGap

    local t = {
        born = tick(), until_ = tick() + (dur or 3),
        w = cardW, h = cardH, body = body, parts = {},
    }

    local h1 = newDrawing("Text")
    if not h1 then return false end
    setp(h1, "Font", 2); setp(h1, "Size", TOAST.titleSize)
    setp(h1, "Color", rgb(accent[1], accent[2], accent[3]))
    setp(h1, "Outline", true); setp(h1, "Text", tostring(title)); setp(h1, "Visible", true)
    setp(h1, "ZIndex", 12)
    t.parts.h1 = h1

    t.lines = {}
    for i, l in ipairs(body) do
        local tl = newDrawing("Text")
        if tl then
            setp(tl, "Font", 2); setp(tl, "Size", TOAST.bodySize)
            setp(tl, "Color", rgb(226, 232, 240))
            setp(tl, "Outline", true); setp(tl, "Text", l); setp(tl, "Visible", true)
            setp(tl, "ZIndex", 12)
            t.lines[i] = tl
        end
    end

    local shadow = newDrawing("Square")
    if shadow then
        setp(shadow, "Filled", true); setp(shadow, "Color", rgb(0, 0, 0))
        setp(shadow, "Size", Vector2.new(cardW + 4, cardH + 4)); setp(shadow, "ZIndex", 9)
        setp(shadow, "Visible", true)
        t.parts.shadow = shadow
    end
    local bg = newDrawing("Square")
    if bg then
        setp(bg, "Filled", true); setp(bg, "Color", rgb(17, 21, 30))
        setp(bg, "Size", Vector2.new(cardW, cardH)); setp(bg, "ZIndex", 10)
        setp(bg, "Visible", true)
        t.parts.bg = bg
    end
    local bar = newDrawing("Square")
    if bar then
        setp(bar, "Filled", true); setp(bar, "Color", rgb(accent[1], accent[2], accent[3]))
        setp(bar, "Size", Vector2.new(TOAST.bar, cardH)); setp(bar, "ZIndex", 11)
        setp(bar, "Visible", true)
        t.parts.bar = bar
    end

    table.insert(TOAST.list, 1, t)
    while #TOAST.list > 5 do
        local old = table.remove(TOAST.list)
        for _, p in pairs(old.parts) do dropDrawing(p) end
        for _, p in ipairs(old.lines or {}) do dropDrawing(p) end
    end
    return true
end

local function toastLayout()
    local okv, vp = pcall(viewportSize)
    if not okv or not vp then return end
    local now = tick()
    for i = #TOAST.list, 1, -1 do
        local t = TOAST.list[i]
        if now > t.until_ then
            for _, p in pairs(t.parts) do dropDrawing(p) end
            for _, p in ipairs(t.lines or {}) do dropDrawing(p) end
            table.remove(TOAST.list, i)
        end
    end

    local yCursor = vp.Y - TOAST.margin
    for _, t in ipairs(TOAST.list) do
        local inA  = math.min(1, (now - t.born) / 0.18)
        local outA = math.min(1, math.max(0, (t.until_ - now) / 0.35))
        local a = math.min(inA, outA)
        local slide = (1 - inA) * 40

        local x = vp.X - t.w - TOAST.margin + slide
        local y = yCursor - t.h
        yCursor = y - TOAST.gap

        if t.parts.shadow then
            setp(t.parts.shadow, "Position", Vector2.new(x - 2, y - 2))
            setp(t.parts.shadow, "Transparency", 0.35 * a)
        end
        if t.parts.bg then
            setp(t.parts.bg, "Position", Vector2.new(x, y))
            setp(t.parts.bg, "Transparency", 0.93 * a)
        end
        if t.parts.bar then
            setp(t.parts.bar, "Position", Vector2.new(x, y))
            setp(t.parts.bar, "Transparency", a)
        end
        local tx = x + TOAST.bar + TOAST.pad
        setp(t.parts.h1, "Position", Vector2.new(tx, y + TOAST.pad - 2))
        setp(t.parts.h1, "Transparency", a)
        local ly = y + TOAST.pad + TOAST.titleSize + 3
        for i, tl in ipairs(t.lines or {}) do
            setp(tl, "Position", Vector2.new(tx, ly + (i - 1) * (TOAST.bodySize + TOAST.lineGap)))
            setp(tl, "Transparency", a)
        end
    end
end

local NOTIFY_LAST = {}
local function notify(title, msg, dur, kind)
    local key = tostring(title) .. "\0" .. tostring(msg)
    local now = tick()
    if NOTIFY_LAST[key] and (now - NOTIFY_LAST[key]) < 8 then return end
    NOTIFY_LAST[key] = now
    if not NOTIFY_LAST.__n then NOTIFY_LAST.__n = 0 end
    NOTIFY_LAST.__n = NOTIFY_LAST.__n + 1
    if NOTIFY_LAST.__n > 60 then
        for k, t in pairs(NOTIFY_LAST) do
            if type(t) == "number" and k ~= "__n" and (now - t) > 30 then NOTIFY_LAST[k] = nil end
        end
        NOTIFY_LAST.__n = 0
    end

    if not kind then
        local m = string.lower(tostring(msg))
        if string.find(m, "unreadable") or string.find(m, "stale") or string.find(m, "no safe zone")
           or string.find(m, "cannot") or string.find(m, "failed") then kind = "warn"
        elseif string.find(m, "complete") or string.find(m, "collected") or string.find(m, "owned")
           or string.find(m, "saved") or string.find(m, "restored") then kind = "good"
        end
    end
    if not toastPush(title, msg, dur or 3, kind) then
        if Lib and Lib.Notify then pcall(function() Lib.Notify(title, msg, dur or 2) end) end
    end
end
