local function buildAreas()
    local pts = {}
    for _, e in ipairs(eggSlots()) do pts[#pts + 1] = e.pos end
    if #pts == 0 then return {} end
    table.sort(pts, function(a, b) return a.X < b.X end)
    local groups, cur = {}, { pts[1] }
    for i = 2, #pts do
        if (pts[i].X - pts[i - 1].X) > AREA_GAP then
            groups[#groups + 1] = cur
            cur = {}
        end
        cur[#cur + 1] = pts[i]
    end
    groups[#groups + 1] = cur
    local out = {}
    for _, g in ipairs(groups) do
        local sum = Vector3.new(0, 0, 0)
        for _, p in ipairs(g) do sum = sum + p end
        local centre = sum / #g
        out[#out + 1] = { centre = centre, n = #g, name = nameForX(centre.X) }
    end
    return out
end

